CMD:bansosrubel50(playerid, params[])
{
    if(admin_level[playerid] < 11)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    foreach(new i : Player)
    {
        if(PlayerInfo[i][pLogin])
        {
		PlayerInfo[i][pRouble] += 50;
  		OnPlayerUpdateAccountsPer(i, "pRouble", PlayerInfo[i][pRouble]);
        }
    }
	format(format_string, sizeof(format_string), "(( {FF0000} %s Telah Memberi 50 Rouble Untuk Ke Semua Player Yang Online.",GetName(playerid));
	SendClientMessageToAll(COLOR_WHITE, format_string);
    return 1;
}
CMD:bansoslevel(playerid, params[])
{
    if(admin_level[playerid] < 11)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    foreach(new i : Player)
    {
        if(PlayerInfo[i][pLogin])
        {
		PlayerInfo[i][pLevel] += 1;
		OnPlayerUpdateAccountsPer(i, "pLevel", PlayerInfo[i][pLevel]);
        }
    }
	format(format_string, sizeof(format_string), "(( {FF0000} %s Telah Memberi 1 Level Untuk Ke Semua Player Yang Online.",GetName(playerid));
	SendClientMessageToAll(COLOR_WHITE, format_string);
    return 1;
}
CMD:bansosrolet(playerid, params[])
{
    if(admin_level[playerid] < 11)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    foreach(new i : Player)
    {
        if(PlayerInfo[i][pLogin])
        {
		PlayerInfo[i][pFreeRoulet] += 5;
		OnPlayerUpdateAccountsPer(i, "pFreeRoulet", PlayerInfo[i][pFreeRoulet]);
        }
    }
	format(format_string, sizeof(format_string), "(( {FF0000} %s Telah Memberi 5 Roulette Gratis Untuk Ke Semua Player Yang Online (/roulette).",GetName(playerid));
	SendClientMessageToAll(COLOR_WHITE, format_string);
    return 1;
}
CMD:givemoneyall(playerid, params[])
{
    new amount;

    if(admin_level[playerid] < 11)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "i", amount))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /givemoneyall [amount]");
    }
    if(amount < 1 || amount > 2000000)
    {
        return SCM(playerid, COLOR_SYNTAX, "The amount specified must range between $1 and $200000.");
    }

    foreach(new i : Player)
    {
        if(PlayerInfo[i][pLogin])
        {
            GivePlayerMoneyEx(i, amount, "All In One");
        }
    }
	format(format_string, sizeof(format_string), "(( {FF0000} %s Telah Memberi Uang 2 juta Untuk Ke Semua Player Yang Online.",GetName(playerid), amount);
	SendClientMessageToAll(COLOR_WHITE, format_string);
    return 1;
}
CMD:smenu(playerid, params[])
{
	if(!IsACop(playerid) && !IsAMedic(playerid)) return SendError(playerid, "Anda bukan seorang anggota polisi maupun dokter");
	if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Anda tidak berada di dalam kendaraan");

	ShowPlayerDialog(playerid, 7227, DIALOG_STYLE_LIST, "Vehicle Siren", "LSPD Car\n\
	SFPD Car\n\
	LVPD Car\n\
	Police Ranger\n\
	Sultan\n\
	Cheetah\n\
	Bullet\n\
	HPV1000\n\
	Enforcer\n\
	SWAT\n\
	Ambulance\n\
	Hapus Siren", "Select", "Close");
	return 1;
}
CMD:vipbalon(playerid, params[])
{
	if(PlayerInfo[playerid][pPrison] != 0) return Send(playerid, COLOR_GREY, "Tidak Bisa Digunakaan Saat Dipenjara");
    if(PlayerInfo[playerid][pVip] < 3) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP GOLD");
    {
        SetPlayerAttachedObject(playerid, 0, 19336, 1, -1.090, 0.000, 0.000, 90.000, 90.000, 0.000, 1.000, 1.000, 1.000);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
        SendClientMessage(playerid, COLOR_BLUE, "/Vipbalon1 Untuk Selesai");
        return 1;
	}
}
CMD:vipbalon1(playerid, params[])
{
    if(PlayerInfo[playerid][pVip] < 3) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP GOLD");
    {
        new Float:x, Float:y, Float:z;
	    GetPlayerPos(playerid, x, y, z), SetPlayerPos(playerid, x, y, z+0.5);
        RemovePlayerAttachedObject(playerid, 0);
        SendClientMessage(playerid, COLOR_BLUE, "Selesai Menerbangkan Balon");
        return 1;
	}
}
