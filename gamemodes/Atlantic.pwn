   GPickup,
   Text3D: GLabel,
	Float: GposX,
	Float: GposY,
	Float: GposZ,
	Float: GposA
}
new GarkotInfo[MAX_GARKOT][gkinfo];
new IdGarkot[MAX_GARKOT];



SaveGarkot()
{
    new file[128];
	for(new i= 1; i < MAX_GARKOT; i++)
	{
        if(IdGarkot[i] == 0) continue;
	    format(file, sizeof(file), "Garkot/%d.ini", i);
	    if(INI_Open(file))
	    {
	        INI_WriteFloat("PosX",GarkotInfo[i][GposX]);
        	INI_WriteFloat("PosY",GarkotInfo[i][GposY]);
        	INI_WriteFloat("PosZ",GarkotInfo[i][GposZ]);
            INI_WriteFloat("PosA",GarkotInfo[i][GposA]);
        	INI_Save();
			INI_Close();
		}
	}
	return 1;
}
stock AntiFlyHack(playerid)
{
    new AnimLib[30], AnimName[30];
    GetAnimationName(GetPlayerAnimationIndex(playerid), AnimLib, sizeof(AnimLib), AnimName, sizeof(AnimName));
    if(GetPlayerSpeed(playerid) > 60 && strcmp(AnimLib, "SWIM", true) == 0 && strcmp(AnimName, "SWIM_TREAD", true) == 0)
    {
        ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ff0000}Anda Terdeteksi Menggunakan Cheat Fly-Hack{ffffff} Anda Akan Di Kick", "Oke", "");
        SetTimerEx("KickTimer",3000,0,"i",playerid);
    }
    if(GetPlayerSpeed(playerid) > 60 && strcmp(AnimLib, "SWIM", true) == 0 && strcmp(AnimName, "SWIM_BREAST", true) == 0)
    {
        ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ff0000}Anda Terdeteksi Menggunakan Cheat Fly-Hack{ffffff} Anda Akan Di Kick", "Oke", "");
        SetTimerEx("KickTimer",3000,0,"i",playerid);
    }
    if(GetPlayerSpeed(playerid) > 60 && strcmp(AnimLib, "SWIM", true) == 0 && strcmp(AnimName, "SWIM_crawl", true) == 0)
    {
        ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ff0000}Anda Terdeteksi Menggunakan Cheat Fly-Hack{ffffff} Anda Akan Di Kick", "Oke", "");
        SetTimerEx("KickTimer",3000,0,"i",playerid);
    }
    if(GetPlayerSpeed(playerid) > 60 && strcmp(AnimLib, "PARACHUTE", true) == 0 && strcmp(AnimName, "FALL_SKYDIVE_ACCEL", true) == 0)
    {
        ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ff0000}Anda Terdeteksi Menggunakan Cheat Fly-Hack{ffffff} Anda Akan Di Kick", "Oke", "");
        SetTimerEx("KickTimer",3000,0,"i",playerid);
    }
}
stock IsWeaponWithAmmo(weaponid)
{
    switch(weaponid)
    {
        case 16..18, 22..39, 41..42: return 1;
        default: return 0;
    }
    return 0;
}
stock GetPlayerWeaponAmmo(playerid,weaponid)
{
    new wd[2][13];
    for(new i; i<13; i++) GetPlayerWeaponData(playerid,i,wd[0][i],wd[1][i]);
    for(new i; i<13; i++)
    {
        if(weaponid == wd[0][i]) return wd[1][i];
    }
    return 0;
}
stock AntiAmmo(playerid)
{
    new Ammo = GetPlayerAmmo(playerid);
    if(Ammo == 1000)
    {
        Info(playerid, "Anda Telah Membawa Lebih Ammo");
    }
    return 1;
}
stock ShowInfo(playerid, pesan[])
{
  	if(IsPlayerAndroid(playerid))
	{
		PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0);
	}
	else
	{
		PlayerPlaySound(playerid, 5201, 0.0, 0.0, 0.0);
  	}
  	ShowNotify(playerid, pesan, 1);
  	return 1;
}
