		PlayerTextDrawHide(playerid, LoginnTD[playerid][1]);
		CancelSelectTextDraw(playerid);
        return 1;
    }
    if(clickedid == TxDWhatsIndex[3])
	{
		callcmd::rtd(playerid);
	}
	if(clickedid == TxDWhatsConv[7]) {
		ShowPlayerDialog(playerid, 1244, DIALOG_STYLE_LIST, "{c0c0c0}Lebih banyak pilihan:{ffffff} Whatsapp", "{c0c0c0}Hapus itu{ffffff} Percakapan\n{c0c0c0}Tutup{ffffff} Percakapan", "Pilih", "Batal");
	}
	if(clickedid == TxDWhatsConv[6]) {
		ShowPlayerDialog(playerid, 1233, DIALOG_STYLE_INPUT, "Percakapan", "{c0c0c0}Sistem dari {ffffff}WhatsApp\n{ffffff}Masukkan pesan yang akan dikirim ke pemain:", "Mengirim", "Tutup");

	}
	if(clickedid == TxDWhatsIndex[15]) {
		ShowPlayerDialog(playerid, 1222, DIALOG_STYLE_INPUT, "Buat Percakapan", "{c0c0c0}Sistem dari {ffffff}WhatsApp\n{ffffff}Catatan: {c0c0c0}Nama panggilan apa pun yang dimasukkan di sini akan menciptakan percakapan \n(Masih tidak memeriksa apakah Anda sedang online/memiliki ponsel)\n{ffffff}[Perkembangan]", "Membuat", "Tutup");
	}
	if(clickedid == TxDWhatsIndex[17]) {

		new
		count2 = 0;
		for(new i = CountPagIndexWpp[playerid]; i < sizeof(PaginacaoWppIndex[]); i++){
			if(count2 == 4){
				break;
			}
			if(!isnull(PaginacaoWppIndex[playerid][i][wCriador])) {
				count2 ++;
			}
		}
		new count_bounds = 0;
		for(new i = CountPagIndexWpp[playerid]+count2; i < sizeof(PaginacaoWppIndex[]); i++){
			if(count_bounds == 4){
				break;
			}
			if(!isnull(PaginacaoWppIndex[playerid][i][wCriador])) {
				count_bounds ++;
			}
		}
		new count = count2;
		new inicio = CountPagIndexWpp[playerid];
		new fim = CountPagIndexWpp[playerid] + count;

		ReloadWhatsapp(playerid, inicio, fim);
		if(count_bounds <= 0) {
			TextDrawHideForPlayer(playerid, TxDWhatsIndex[17]);
		}

	}
	if(clickedid == TxDWhatsIndex[16]) {

		if(CountPagIndexWpp[playerid] <= 0) {

			CountPagIndexWpp[playerid] = 4;
			AbrirWhatsapp(playerid);
			return 1;
		}
		//new count = CountPagIndexWpp[playerid],
		new count2 = 0;
		for(new i = CountPagIndexWpp[playerid]-CountPagIndexWppVoltar[playerid]; i < sizeof(PaginacaoWppIndex[]); i++){
			if(count2 == 4){
				break;
			}
			if(!isnull(PaginacaoWppIndex[playerid][i][wCriador])) {
				count2 ++;
			}
		}
		new inicio = (CountPagIndexWpp[playerid] - 4) - (1*CountPagIndexWppVoltar[playerid]);
		if(inicio < 0) inicio = 0;
		new fim = inicio+4;
		//

		//

		CountPagIndexWpp[playerid] -= (inicio+(1*CountPagIndexWppVoltar[playerid]));

		if(CountPagIndexWpp[playerid] <= 0) {

			CountPagIndexWpp[playerid] = 4;
			AbrirWhatsapp(playerid);
			return 1;
		}
		ReloadWhatsapp(playerid, inicio, fim, true);
	}
