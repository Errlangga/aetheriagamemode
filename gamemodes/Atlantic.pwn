						//GiveVehicle(i, 541, 0, 0, 0, 0, 0);
					    format(gString, 120, "(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and got Bullet. ))", GetName(i));
					    SCMTA(COLOR_CLIENT, gString);
				    }
				}
			}
           	case 13..22:
   			{
                format(gString, 65, "ticket (RAINBOW)~n~~w~~h~you have %d crates.", totalcrates(i));
                PlayerTextDrawSetPreviewModel(i, CratePTD[0], 1581);
                PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
            	if(CrateTime[i] <= 0)
				{
					KillTimer(TimerCratesEx[i]);
					CrateModel[i] = -1;
					PlayerInfo[i][pRouble] += 1;
				    format(gString, 120,"(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and got Rainbow Ticket. ))", GetName(i));
				    SCMTA(COLOR_CLIENT, gString);
				}
            }
           	case 23..33:
	   		{
                format(gString, 65, "ticket (VIP)~n~~w~~h~you have %d crates.", totalcrates(i));
                PlayerTextDrawSetPreviewModel(i, CratePTD[0], 1581);
                PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
            	if(CrateTime[i] <= 0)
				{
					KillTimer(TimerCratesEx[i]);
					CrateModel[i] = -1;
					PlayerInfo[i][pRouble] += 1;
				    format(gString, 120,"(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and got Vip Ticket. ))", GetName(i));
				    SCMTA(COLOR_CLIENT,gString);
				}
            }
   			case 34..46:
	   		{
                format(gString, 65, "Cheetah~n~~w~~h~you have %d crates.", totalcrates(i));
				PlayerTextDrawSetPreviewModel(i, CratePTD[0], 415);
				PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
                if(CrateTime[i] <= 0)
				{
					if(u_car_1 == -1)
					{
						PlayerInfo[i][pCrates][4] ++; save_crates(i); SCM(i, COLOR_LIGHTGREEN, "You don't have a free slot");  CrateModel[i] = -1; KillTimer(TimerCratesEx[i]); return true;
					}
					else
					{
