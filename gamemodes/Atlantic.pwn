	else SetPlayerSkinEx(playerid,140);// wanita
	format(String, 188, "%s Telah Membuka Bajunya",Name(playerid));
	SetPlayerAttachedObject(playerid, 3, 2704, 5, 0.1, 0.02, -0.05, 0, 0, 0, 1, 1, 1);
    ApplyAnimation(playerid, "goggles", "goggles_put_on", 4.0, 0, 0, 0, 0, 0, 1);
    ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	SetPlayerChatBubble(playerid, "Telah Membuka Bajunya",COLOR_PURPLE,20.0,10000);
	return 1;
}
CMD:pakaibaju(playerid, params[])
{
	SetPlayerSkin(playerid,PlayerInfo[playerid][pSkin]);
    format(String, 188, "%s Telah Memakai Bajunya",Name(playerid));
    RemovePlayerAttachedObject(playerid, 3);
	ApplyAnimation(playerid, "goggles", "goggles_put_on", 4.0, 0, 0, 0, 0, 0, 1);
    ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	SetPlayerChatBubble(playerid, "Telah Memakai Bajunya",COLOR_PURPLE,20.0,10000);
	return 1;
}
