stock SetVehicleLights(vehicleid, playerid)
{
	//new engine,lights,alarm,doors,bonnet,boot,objective;
	GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
	if(lights == VEHICLE_PARAMS_ON)
	{
		SetVehicleParamsEx(vehicleid,engine,VEHICLE_PARAMS_OFF,alarm,doors,bonnet,boot,objective);
		SendClientMessage(playerid, COLOR_RED, "Lampu Mobil OFF.");
	}
	else if(lights == VEHICLE_PARAMS_OFF || lights == VEHICLE_PARAMS_UNSET)
	{
		SetVehicleParamsEx(vehicleid,engine,VEHICLE_PARAMS_ON,alarm,doors,bonnet,boot,objective);
		SendClientMessage(playerid, COLOR_GREEN, "Lampu Mobil ON.");
	}
	return 1;
}

forward CBugFreezeOver(playerid);
public CBugFreezeOver(playerid)
{
	TogglePlayerControllable(playerid, true);

	pCBugging[playerid] = false;
	return 1;
}
//paket ilegal
forward TimePaket();
public TimePaket()
{
    new rand = random(5);
    StatusPacket = 1;
    DestroyDynamicPickup(IDPacket);
    DestroyDynamic3DTextLabel(PacketLabel);
    PacketLabel = CreateDynamic3DTextLabel("[PACKET ILEGAL]\n{FFFFFF}/takepacket", COLOR_BLUE, RandomPacket[rand][0], RandomPacket[rand][1], RandomPacket[rand][2], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
    IDPacket = CreateDynamicPickup(1575, 23, RandomPacket[rand][0], RandomPacket[rand][1], RandomPacket[rand][2], 0, 0);
    PosPacket[0] = RandomPacket[rand][0];
    PosPacket[1] = RandomPacket[rand][1];
    PosPacket[2] = RandomPacket[rand][2];
    foreach(Player, i)
    if(IsAGang(i))
	{
    SCM(i, COLOR_BLUE, "==========[ PAKET ILEGAL ]==========");
    SCM(i, -1, "Paket Ilegal Telah Aktif");
	SCM(i, -1, "Gunakan Cmd: /findpacket");
    SCM(i, -1, "NOTE: SIAPA CEPAT DIA DAPAT");
	SCM(i, -1, "===============================");
	}
	else if(IsAMafia(i))
	{
    SCM(i, COLOR_BLUE, "==========[ PAKET ILEGAL ]==========");
    SCM(i, -1, "Paket Ilegal Telah Aktif");
	SCM(i, -1, "Gunakan Cmd: /findpacket");
    SCM(i, -1, "NOTE: SIAPA CEPAT DIA DAPAT");
	SCM(i, -1, "===============================");
	}
	else if(PlayerInfo[i][pFamily] != -1)
	{
    SCM(i, COLOR_BLUE, "==========[ PAKET ILEGAL ]==========");
    SCM(i, -1, "Paket Ilegal Telah Aktif");
	SCM(i, -1, "Gunakan Cmd: /findpacket");
    SCM(i, -1, "NOTE: SIAPA CEPAT DIA DAPAT");
	SCM(i, -1, "===============================");
	}
	KillTimer(TimePacket);
	TimePacket = SetTimer("TimePaket", 600000, 0);
	return 1;
}
//vote
forward VoteEnd(playerid);
public VoteEnd(playerid)
{
	new string[128];
    format(string, sizeof(string), "[HASIL VOTE]{FFFFFF} YES: %d | NO: %d", VoteY, VoteN);
    SendClientMessageToAll(COLOR_GREEN, string);
    VoteOn = 0;
	return 1;
}
forward DiscoStatus(playerid);
public DiscoStatus(playerid)
{
    DestroyDynamic3DTextLabel(PlayerInfo[playerid][pDisco]);
    return 1;
}
forward KickTimer(playerid);
public KickTimer(playerid)
{
    Kick(playerid);
    return 1;
}
forward KickCheat(playerid);
public KickCheat(playerid)
{
    Kick(playerid);
    return 1;
}
forward OnPlayerCarTroll(playerid, vehicleid, trolledid, trolltype);
public OnPlayerCarTroll(playerid, vehicleid, trolledid, trolltype)
{
    if(trolledid == INVALID_PLAYER_ID) return 0;
    new code[50];
    code = "car troller";

    SCMF(playerid, COLOR_RED, "[BOB-CHEAT]:{FFFFFF} Kamu tertangkap cheat %s!", code);
    DetectTroll(playerid);
    return 1;
}
forward OnPlayerGunCheat(playerid, weaponid, ammo, hacktype);
public OnPlayerGunCheat(playerid, weaponid, ammo, hacktype)
{
    if(admin_level[playerid] <= 10 && admin_logged[playerid]) return 0;
    if(weaponid == 25 && ammo == 5 && (hacktype == 1 || hacktype == 2)) {
        for (new i = 0; i <= 12; i++)
        {
            new wWepId, aAmmo;
            GetPlayerWeaponData(playerid, i, wWepId, aAmmo);
            if(wWepId == WEAPON_SHOTGUN) {
                if(aAmmo >= 5) SetPlayerAmmoEx(playerid, WEAPON_SHOTGUN, aAmmo - 5);
                else SetPlayerAmmoEx(playerid, WEAPON_SHOTGUN, 0);
            }
        }
        return 0;
    }
    new code[50];
    code = "weapon hack";
    wepHack[playerid] = true;
    ResetWeapons(playerid);
    DetectSpawnWep(playerid);
    return 1;
}
public OnPlayerTeleport(playerid, Float:distance)
{
    if(!admin_level[playerid])
    {
        if(!IsPlayerInRangeOfPoint(playerid, 4.0, pData[playerid][pPosX], pData[playerid][pPosY], pData[playerid][pPosZ]))
        {
            {
			Kick(playerid);
            }
        }
    }
    return 1;
}

stock DetectSpawnWep(playerid)
{
    ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ff0000}INFO: Anda Terdeteksi Menggunakan Cheat Weapons-Hack{ffffff} Akun Anda Akan Terblokir\n\n{ff0000}System Bot Malavida \n\n{ffffff}Developer: {ff0000}Biboys", "Oke", "");
    SetTimerEx("KickCheat",3000,0,"i",playerid);
    return 1;
}

stock DetectTroll(playerid)
{
    ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ff0000}INFO: Anda Terdeteksi Menggunakan Cheat Troll-Car/Swing Car{ffffff} Akun Anda Akan Terblokir\n\n{ff0000}System Bot Malavida a\n\n{ffffff}Developer: {ff0000}Biboys", "Oke", "");
    ResetWeapons(playerid);
    SetTimerEx("KickCheat",1000,0,"i",playerid);
    return 1;
}

stock DetectTele(playerid)
{
    ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ff0000}INFO: Anda Terdeteksi Menggunakan Cheat Teleport-Hack / Air-Break{ffffff} Akun Anda Akan Terblokir\n\n{ff0000}System Bot Malavida \n\n{ffffff}Developer: {ff0000}Biboys", "Oke", "");
    ResetWeapons(playerid);
    SetTimerEx("KickCheat",1000,0,"i",playerid);
    return 1;
}

stock OnPlayerRapid(playerid)
{
    ShowPlayerDialogEx(playerid, DIALOG_MAX_DUIT_MF, DIALOG_STYLE_MSGBOX, "Cheat Detect", "{ffffff}INFO: {ff0000}Anda Terdeteksi Menggunakan Cheat Rapid-Fire/Silent-Aim/No-Reload{ffffff}\n\n Akun Anda Akan Terblokir Jika Melakukan Cheat Lagi\n\n{ff0000}System Bot Malavida \n\n{ffffff}Developer: {ff0000}Biboys", "Oke", "");
    ResetWeapons(playerid);
    SetTimerEx("KickCheat",3000,0,"i",playerid);
    return 1;
}
epublic: OnPlayerArmourHack(playerid, Float:original, Float:anticheat)
{
