DCMD:wl(playerid, channel, params[])
{
    if(_:WLandUNWL == 0)
    WLandUNWL = DCC_FindChannelById("1256245617802608740");

	new player[200], DonaldspasiBebekWL[200], string[200];
	if(isnull(params)) return DCC_SendChannelMessage(channel, "**Info**: ***!wl [Player_Name]***");
	format(player,sizeof(player),"/whitelist/%s.txt", params);

	format(string,sizeof(string), "**Info**: ***Nama `%s` sudah ada di Server!***", params);
	if(dini_Exists(player)) return DCC_SendChannelMessage(channel, string);

	dini_Create(player);

    format(DonaldspasiBebekWL,sizeof(DonaldspasiBebekWL),"NAMA IC: %s \nBERHASIL DITAMBAHKAN WHITELIST KE DALAM SERVER!\n", params);

	return 1;
}

DCMD:unwl(playerid, channel, params[])
{
    if(_:WLandUNWL == 0)
    WLandUNWL = DCC_FindChannelById("1256245617802608740");

	new player[200], DonaldspasiBebekWL[200], string[200];
	if(isnull(params)) return DCC_SendChannelMessage(channel, "**Info**: ***!unwl [Player_Name]***");
	format(player,sizeof(player),"/whitelist/%s.txt", params);

	format(string,sizeof(string), "***Info: Nama `%s` Tidak ada di Server!***", params);
	if(dini_Create(player)) return DCC_SendChannelMessage(channel, string);

	dini_Remove(player);

    format(DonaldspasiBebekWL,sizeof(DonaldspasiBebekWL),"NAMA IC: %s \nBERHASIL MENGHAPUS WHITELIST DI DALAM SERVER!\n", params);
	return 1;
}
