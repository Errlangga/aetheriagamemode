CMD:tgak (playerid)
{
	if(GetPVarInt(playerid,"pTimeRp4") > gettime()) return 1;
	format(String, 188, "%s Take a 'Ak-47' and Ready to Shoot Anytime",ReturnName(playerid));
	ProxDetector(25.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPVarInt(playerid, "pTimeRp4", gettime() + 30);
 	return 1;
}
