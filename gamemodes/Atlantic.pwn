public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
	if(PlayerInfo[playerid][gEditID] != -1 && Iter_Contains(Gates, PlayerInfo[playerid][gEditID]))
	{
		new id = PlayerInfo[playerid][gEditID];
		if(response == EDIT_RESPONSE_UPDATE)
		{
			SetDynamicObjectPos(objectid, x, y, z);
			SetDynamicObjectRot(objectid, rx, ry, rz);
		}
		else if(response == EDIT_RESPONSE_CANCEL)
		{
			SetDynamicObjectPos(objectid, gPosX[playerid], gPosY[playerid], gPosZ[playerid]);
			SetDynamicObjectRot(objectid, gRotX[playerid], gRotY[playerid], gRotZ[playerid]);
			gPosX[playerid] = 0; gPosY[playerid] = 0; gPosZ[playerid] = 0;
			gRotX[playerid] = 0; gRotY[playerid] = 0; gRotZ[playerid] = 0;
			Servers(playerid, " You have canceled editing gate.");
			Gate_Save(id);
		}
		else if(response == EDIT_RESPONSE_FINAL)
		{
			SetDynamicObjectPos(objectid, x, y, z);
			SetDynamicObjectRot(objectid, rx, ry, rz);
			if(PlayerInfo[playerid][gEdit] == 1)
			{
				gData[id][gCX] = x;
				gData[id][gCY] = y;
				gData[id][gCZ] = z;
				gData[id][gCRX] = rx;
				gData[id][gCRY] = ry;
				gData[id][gCRZ] = rz;
				if(IsValidDynamic3DTextLabel(gData[id][gText])) DestroyDynamic3DTextLabel(gData[id][gText]);
				new str[64];
				format(str, sizeof(str), "Gate ID: %d", id);
				gData[id][gText] = CreateDynamic3DTextLabel(str, COLOR_WHITE, gData[id][gCX], gData[id][gCY], gData[id][gCZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1, -1, 10.0);

				PlayerInfo[playerid][gEditID] = -1;
				PlayerInfo[playerid][gEdit] = 0;
				Servers(playerid, " You have finished editing gate closing position.");
				gData[id][gStatus] = 0;
				Gate_Save(id);
			}
			else if(PlayerInfo[playerid][gEdit] == 2)
			{
				gData[id][gOX] = x;
				gData[id][gOY] = y;
				gData[id][gOZ] = z;
				gData[id][gORX] = rx;
				gData[id][gORY] = ry;
				gData[id][gORZ] = rz;

				PlayerInfo[playerid][gEditID] = -1;
				PlayerInfo[playerid][gEdit] = 0;
				Servers(playerid, " You have finished editing gate opening position.");

				gData[id][gStatus] = 1;
				Gate_Save(id);
			}
		}
	}
	return 1;
}
public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
   	new vehicleid = GetPlayerVehicleID(playerid);
    new seat0 = GetPlayerInVehicleSeat(vehicleid, 0);
    new seat1 = GetPlayerInVehicleSeat(vehicleid, 1);
    new seat2 = GetPlayerInVehicleSeat(vehicleid, 2);
    new seat3 = GetPlayerInVehicleSeat(vehicleid, 3);

    if(IsPlayerInAnyVehicle(playerid))
    {
        SetPlayerCheckpoint(seat0, fX, fY, fZ, 3);
        SetPlayerCheckpoint(seat1, fX, fY, fZ, 3);
        SetPlayerCheckpoint(seat2, fX, fY, fZ, 3);
        SetPlayerCheckpoint(seat3, fX, fY, fZ, 3);
        SendClientMessage(playerid,COLOR_YELLOW, "Waypoint sharing active");
    }
    if(PlayerData[playerid][pTogTP] == 1)
    {
        SetPVarFloat(playerid,"teleportX",fX), SetPVarFloat(playerid,"teleportY",fY), SetPVarFloat(playerid,"teleportZ",fZ);
        SetPlayerInterior(playerid,0), SetPlayerVirtualWorld(playerid, 0);
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) t_SetPlayerPos(playerid, GetPVarFloat(playerid,"teleportX"), GetPVarFloat(playerid,"teleportY"), GetPVarFloat(playerid,"teleportZ"));
        else SetVehiclePos(GetPlayerVehicleID(playerid), GetPVarFloat(playerid,"teleportX"), GetPVarFloat(playerid,"teleportY"), GetPVarFloat(playerid,"teleportZ"));
        GameTextForPlayer(playerid, "~g~BERHASIL", 3000, 1);
    }
    return 1;
}
forward Kicked(playerid);
