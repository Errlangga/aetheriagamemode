stock GiveVehicle(playerid, model)
{
    new u_car_1 = GetPlayerFreeCarSlot(playerid);

    CarInfo[playerid][cModel][u_car_1] = model;
    CarInfo[playerid][cColor1][u_car_1] = 0;
    CarInfo[playerid][cColor2][u_car_1] = 0;
    CarInfo[playerid][cFuel][u_car_1] = 100.0;
    CarInfo[playerid][cProbeg][u_car_1] = 0.0;
    CarInfo[playerid][cCost][u_car_1] = 100000;
    CarInfo[playerid][cWheels][u_car_1] = 0;
    CarInfo[playerid][cSpoiler][u_car_1] = 0;
    CarInfo[playerid][cBumper1][u_car_1] = 0;
    CarInfo[playerid][cBumper2][u_car_1] = 0;
    CarInfo[playerid][cPaintJobs][u_car_1] = 255;
    CarInfo[playerid][cNitro][u_car_1] = 0;
    CarInfo[playerid][cHydrawlic][u_car_1] = 0;
    CarInfo[playerid][cHood][u_car_1] = 0;
    CarInfo[playerid][cRoof][u_car_1] = 0;
    CarInfo[playerid][cSideskirt][u_car_1] = 0;
    CarInfo[playerid][cLamps][u_car_1] = 0;
    CarInfo[playerid][cExhaust][u_car_1] = 0;
    CarInfo[playerid][cStereo][u_car_1] = 0;
    CarInfo[playerid][cVentRight][u_car_1] = 0;
    CarInfo[playerid][cVentLeft][u_car_1] = 0;
    CarInfo[playerid][cHeal][u_car_1] = 1000.0;
    CarInfo[playerid][cLock][u_car_1] = 0;
    CarInfo[playerid][cDamagePanel][u_car_1] = 0;
    CarInfo[playerid][cDamageDoors][u_car_1] = 0;
    CarInfo[playerid][cDamageLights][u_car_1] = 0;
    CarInfo[playerid][cDamageTires][u_car_1] = 0;

    player_car_park[playerid][u_car_1][0] = 523.1088;
	player_car_park[playerid][u_car_1][1] = -1830.2756;
	player_car_park[playerid][u_car_1][2] = 5.6328;
	player_car_park[playerid][u_car_1][3] = 261.5410;

    SavePlayerCarPark(playerid);
    SaveCars(playerid);
}
FormatNumber( number ) {
   new Str[ 15 ];
   format( Str, 15, "%d", number );
   if( strlen( Str ) < sizeof( Str ) ) {
      if( number >= 1000 && number < 10000 ) strins(  Str, ",", 1, sizeof( Str ) );
      else if( number >= 10000 && number < 100000 ) strins( Str, ",", 2, sizeof( Str ) );
      else if( number >= 100000 && number < 1000000 ) strins( Str, ",", 3, sizeof( Str ) );
      else if( number >= 1000000 && number < 10000000 ) strins( Str, ",", 1, sizeof( Str ) ),strins( Str, ",", 5, sizeof( Str ) );
      else if( number >= 10000000 && number < 100000000 ) strins( Str, ",", 2, sizeof( Str ) ),strins( Str, ",", 6, sizeof( Str ) );
      else if( number >= 100000000 && number < 1000000000 ) strins( Str, ",", 3, sizeof( Str ) ),strins( Str, ",", 7, sizeof( Str ) );
      else if( number >= 1000000000 && number < 10000000000 )
           strins( Str, ",", 1, sizeof( Str ) ),
           strins( Str, ",", 5, sizeof( Str ) ),
           strins( Str, ",", 9, sizeof( Str ) );
      else format( Str, 10, "%d", number );
   }
   return Str;
}
CMD:crateforall(playerid, params[])
{
	new type, value;
	if(sscanf(params, "ii", type, value))
	{
		SCM(playerid, COLOR_GREY, "Syntax: {FFFFFF}/crateforall [crate type] [value]");
		SCM(playerid, COLOR_WHITE, "Rare (0) | Epic (1) | Legendary (2) | Transcendent (3) | Vehicle (4)");
		return true;
	}

	foreach(Player, i) PlayerInfo[i][pCrates][type] += value, save_crates(i);

	gString[0] = EOS;
	format(gString, 75, "Admin %s Memberikan Sejumlah tiket %d gatcha %s.", GetName(playerid), value, CrateName[type]);
	SCMTA(COLOR_YELLOW, gString);
	return true;
}
