CMD:unwarn(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Enter: /unwarn [id pemain]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Player is offline!");
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain tidak login!");//+;
	if(PlayerInfo[params[0]][pWarn] == 0) return Send(playerid, COLOR_GREY, "Pemain ini tidak memiliki peringatan!");
    new str[124], dateban[3][6], count = 0;

    String = "Hari dan waktu\t\tSiapa Anda\t\tPenyebab\n";
    for(new i; i < PlayerInfo[params[0]][pWarn]; i++)
	{
 		TimestampToDate(WarnInfo[params[0]][i][wWarnDate],dateban[i][0],dateban[i][1],dateban[i][2],dateban[i][3],dateban[i][4],dateban[i][5], 3);

		format(str, 124, "%02d-%02d-%02d %02d:%02d\t%s\t%s\n", dateban[i][0], dateban[i][1], dateban[i][2], dateban[i][3], dateban[i][4], WarnInfo[params[0]][i][wAdminWarn], WarnInfo[params[0]][i][wReasonWarn]);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, WarnInfo[playerid][i][wID]);
 	}
    SPD(playerid, 193, DIALOG_STYLE_LIST, "Informasi Peringatan", String, "Select", "Exit");
	SetPVarInt(playerid, "SavePlayer", params[0]);
    return 1;
}
CMD:warninfo(playerid, params[])
{
	if(!PlayerInfo[playerid][pWarn]) return Send(playerid, COLOR_GREY, "Anda tidak memiliki peringatan yang valid!");

	String = "";
	strcat(String, "{ffff00}Hari dan waktu\t\tSiapa anda\t\tPenyebab\n\n");
	new str[164];

	new dateban[3][6];
    for(new i; i < PlayerInfo[playerid][pWarn]; i++)
	{
 		TimestampToDate(WarnInfo[playerid][i][wWarnDate],dateban[i][0],dateban[i][1],dateban[i][2],dateban[i][3],dateban[i][4],dateban[i][5], 3);

		format(str, 164, ""W"%02d-%02d-%02d %02d:%02d:%02d\t%s\t%s\n", dateban[i][0], dateban[i][1], dateban[i][2], dateban[i][3], dateban[i][4], dateban[i][5], WarnInfo[playerid][i][wAdminWarn], WarnInfo[playerid][i][wReasonWarn]);
		strcat(String, str);
	}
	if(!GetPVarInt(playerid, "Inform")) Send(playerid, 0x98FB98FF, "Peringatan secara otomatis dihapus dalam 7 hari sejak tanggal terjadi nya warn.");
	SetPVarInt(playerid, "Inform", 1);
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Informasi peringatan", String, "Close", "");
	return 1;
}
CMD:book(playerid, params[])
{
    if(PlayerInfo[playerid][pProducts][1] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki buku telepon, Anda dapat membelinya di toko 24/7");

    format(MySQLStr, 144, "SELECT `nName`, `nNumber`, `nID`, `plID` FROM `book` WHERE `plID` = %d", PlayerInfo[playerid][pID]);
	mysql_tquery(mMysql, MySQLStr, "LoadMyNumber", "d", playerid);
	return 1;
}
CMD:offleaders(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

	format(MySQLStr, 144, "SELECT `pID`, `pName`,`pfWarn`, `pLeader` FROM `accounts` WHERE `pLeader` > '0'");
	mysql_tquery(mMysql, MySQLStr, "ShowPlayerOffLeaders","d", playerid);
	return 1;
}

publics: ShowPlayerOffLeaders(playerid)
{
    new rows;
    cache_get_row_count(rows);

    if(!rows) return Send(playerid, COLOR_GREY, "Leaderboard kosong.");

    new str[128], count = 0;
    String = "";

    new names[MAX_PLAYER_NAME], leader, fwarn, sql_id;

    for(new i = 0; i < rows; i++)
    {
        cache_get_value_int(i, "pID", sql_id);
        cache_get_value_name(i, "pName", names, MAX_PLAYER_NAME);
    	cache_get_value_int(i, "pLeader", leader);
    	cache_get_value_int(i, "pfWarn", fwarn);

        format(str, 128, "%s\t\t%s\t%d/3\n", names, FracInfo[leader][fName], fwarn);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, sql_id);
	}
	return SPD(playerid, 195, DIALOG_STYLE_TABLIST, "{ffff00}Offline Leaders Control Panel", String, "Select", "Close");
}

CMD:offsupports(playerid)
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;

    new Cache: result = mysql_query(mMysql, "SELECT s.*, a.`pName`, a.`pOnline` FROM `supports` s, `accounts` a WHERE a.`pID` = s.`user_id`");

    new rows = cache_num_rows();

    if(!rows) return SCM(playerid, COLOR_GREY, "Tidak ada dukungan yang ditemukan.");

    new player_name[MAX_PLAYER_NAME], last_date[16], sql_id, reports_today;

    new count = 0;

    String = "";

    new str[48];

    for(new i; i < rows; i++)
    {
        cache_get_value_int(i, "user_id", sql_id);
        cache_get_value_name(i, "pName", player_name, MAX_PLAYER_NAME);
        cache_get_value_name(i, "pOnline", last_date, 16);
        cache_get_value_int(i, "reports_day", reports_today);

        format(str, 48, "%i. %s\t%i\t%s\n", i + 1, player_name, reports_today, last_date);
        strcat(String, str);

        SetPlayerListitemValue(playerid, count++, sql_id);
    }

    cache_delete(result);

    return SPD(playerid, 9137, DIALOG_STYLE_TABLIST, "Daftar Dukungan", String, "Select", "Close");
}

CMD:offadmins(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;

	format(MySQLStr, 144, "SELECT `Name`, `pAdmin`, `pAdminKey`, `pDataNaz` FROM `admin` WHERE `pAdmin` <= '6'");
	mysql_tquery(mMysql, MySQLStr, "OnMySQL_Query","dd", playerid, 18);
	return 1;
}
CMD:take(playerid, params[])
{
	if(!IsACop(playerid)) return 1;

	if(PlayerInfo[playerid][pRank] < 3) return Send(playerid, COLOR_GREY, "Dimungkinkan untuk memilih lisensi/item hanya dari peringkat 3.");
	if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Enter: /take [id pemain]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Player is offline!");
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain tidak login!");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Seorang pemain di AFK.");//+
	if(!ProxDetectorS(3.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Pemain harus berada di dekat Anda.");

	SPD(playerid, 185, DIALOG_STYLE_LIST, "Panel", "{ffffff}1. Cabut SIM\n2. Cabut SIM untuk penerbangan\n3. Singkirkan SIM untuk transportasi air\n4. Singkirkan lisensi untuk senjata\n5. Singkirkan logam dan amunisi\n6. Singkirkan narkoba\n7. Singkirkan senjata", "Accept", "Exit");
	player_take_player[playerid] = params[0];
	return 1;
}
CMD:frisk(playerid, params[])
{
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /frisk [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(PlayerInfo[params[0]][pLevel] < 3) return Send(playerid, -1,"Pemain masih level 2");//+;
	if(GetPVarInt(params[0], "AFK_Time") > 2) return SendClientMessage(playerid, 0xB4B5B7FF, "Pemain ini ada di AFK.");
	if(!ProxDetectorS(8.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Anda harus berada di dekat pemain.");
	if(params[0] == playerid) return Send(playerid, COLOR_GREY,"Anda tidak dapat menggeledah diri sendiri.");

	SendPlayerOffer(playerid, params[0], OFFER_TYPE_FRISK);

	return SCM(params[0], COLOR_GREY, "Untuk persetujuan anda digeledah , tekan Y(/accept) atau untuk penolakan N(/cancel)");
}
CMD:chat(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
    if(!admin_global_chat[playerid]) admin_global_chat[playerid] = 1, Send(playerid, COLOR_GREY, "Anda telah mengaktifkan mendengarkan Obrolan global!");
	else admin_global_chat[playerid] = 0, Send(playerid, COLOR_GREY, "Anda mematikan penyadapan Obrolan global!");
	return 1;
}

CMD:arep(playerid)
{
	if(admin_level[playerid] == 0 && PlayerInfo[playerid][pSupport] == 0) return 1;

	String = "";

	new str[64], to_player = -1;

	new count = 0;

	for(new i; i < MAX_REPORTS; i++)
	{
	    to_player = report_info[i][r_id];

	    if(to_player == INVALID_PLAYER_ID) continue;

		if(report_info[i][r_type] == 0 && admin_level[playerid] == 0) continue;

	    format(str, 64, "%s\t%s[%i]\t%i\n", report_info[i][r_type] ? ("Question") : ("Complaint"), GetPlayerNameEx(to_player), to_player, report_info[i][r_time] / 60);
	    strcat(String, str);

	    SetPlayerListitemValue(playerid, count++, i);
	}

	if(count == 0) return SCM(playerid, COLOR_GREY, "Tidak ada pertanyaan.");

	return SPD(playerid, 9947, DIALOG_STYLE_TABLIST, "Daftar Pertanyaan", String, "Select", "Close");
}

alias:report("rep");
CMD:report(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

    if(sscanf(params, "s[144]", params[0])) return Send(playerid,-1,"Enter: /report(/rep) [komplain]");

    PlayerSendMessageToReport(playerid, 0, params);

    return 1;
}

CMD:ask(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

    if(sscanf(params, "s[144]", params[0])) return Send(playerid,-1,"Enter: /ask [question]");

    PlayerSendMessageToReport(playerid, 1, params);

    return 1;
}

CMD:todo(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
    if(sscanf(params, "s[128]", params[0])) return Send(playerid,-1,"Masuk: /todo [teks] * [tindakan]");
	if(strfind(params, "*", true) == -1) return SendClientMessage(playerid,-1,"Masuk: /todo [teks] * [tindakan]");

 	new arrCoords[2][128];
  	sscanf(params[0],"p<*>s[128]s[128]",arrCoords[0],arrCoords[1]);

   	if(PlayerInfo[playerid][pSex] == 1) format(String, 244, "- %s {DD90FF}- ceritanya %s, %s",arrCoords[0], Name(playerid), arrCoords[1]);
    else format(String, 244, "- %s {DD90FF}kata %s, %s",arrCoords[0], Name(playerid), arrCoords[1]);
    ProxDetector(20.0, playerid, String, COLOR_RAZGOVOR1,COLOR_RAZGOVOR2,COLOR_RAZGOVOR3,COLOR_RAZGOVOR4,COLOR_RAZGOVOR5);
	return 1;
}
CMD:try(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[128]", params[0])) return Send(playerid, -1, "Masuk: /try [tindakan]");
	if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_LIGHTRED, format_string);
		return 1;
	}
	new randomchik = RandomEx(0,2);
	format(String, 188, "{DD90FF}%s %s %s", Name(playerid), params[0], (!randomchik)?("{63C600}| Semoga beruntung") : ("{FF6600}| Gagal"));
	ProxDetector(20.0, playerid, String, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFA);
	return 1;
}
CMD:ado(playerid, params[])
{
    new result[100], string[140];
    if(sscanf(params, "s[200]", result))
    {
        SendClientMessage(playerid, 0xCECECEFF, "Gunakan:/ado [teks]");
        SendClientMessage(playerid, 0xCECECEFF, "[Petunjuk]: Gunakan:/ado off Untuk Menghapus!");
        return 1;
    }
    if(strlen(result) >100) return SendClientMessage(playerid, 0xCECECEFF, "Informasi: Maksimal Text 100 Huruf!");
    if(strcmp(result, "off", true) == 0)
    {
        if(adostatus[playerid] == 0) return Error(playerid, "kamu sedang tidak menggunakan cmd (/ado)!");
        DestroyDynamic3DTextLabel(PlayerInfo[playerid][pAdo]);
        SendClientMessage(playerid, 0xCECECEFF, "ADO dihapus!");
        adostatus[playerid] = 0;
        return 1;
    }
    if(adostatus[playerid] == 0)
    {
        new Float:AdoX, Float:AdoY, Float:AdoZ;
        GetPlayerPos(playerid, AdoX, AdoY, AdoZ);
        format(string, sizeof(string), "* %s *\n(( %s ))", result, GetPlayerNameEx(playerid));
        PlayerInfo[playerid][pAdo] = CreateDynamic3DTextLabel(string, 0xC2A2DAFF, AdoX, AdoY, AdoZ, 40.0);
        SendClientMessage(playerid, 0xCECECEFF, "Anda telah melampirkan ADO di tempat Anda saat ini!");
        adostatus[playerid] = 1;
    }
    else
    {
        format(string, sizeof(string), "* %s * \n(( %s ))", result, GetPlayerNameEx(playerid));
        UpdateDynamic3DTextLabelText(PlayerInfo[playerid][pAdo], 0xC2A2DAFF, string);
        return 1;
    }
    return 1;
}
CMD:ame(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
    if(sscanf(params, "s[144]", params[0])) return Send(playerid, -1,"Enter: /me [tindakan]");
    if(CheckIP(params[0]))
    {
        PlayerInfo[playerid][pMuted] = 600;
        Send(playerid, COLOR_LIGHTRED, "Anda dilarang oleh Hat karena dicurigai mengiklankan.");
        format(format_string, sizeof(format_string), "[A] %s[%d] || Kecurigaan iklan: [ %s ]", Name(playerid),playerid,params[0]);
        SendAdminMessage(COLOR_LIGHTRED, format_string);
        return 1;
    }
    format(String, 188, "{FFFFFF}ACTION : {DD90FF}%s", params[0]);
    ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
    SetPlayerChatBubble(playerid,params[0],0xDD90FFFF,20.0,10000);
    return 1;
}
