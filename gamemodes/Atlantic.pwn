#define GQUEST_FIRST_TEXT \
	"\n\t{ffffff}Hei!! Siapa kamu? \n\tAku tidak mengenalmu. Keluar dari jalan\n\n\tMeskipun, tunggu, kau dari %s, aku punya sidekick di sana, jika Kau tahu kita melakukannya bersama-sama...\n\n\
	\tApa yang Anda lupa di daerah istry ini? Ini tidak benar-benar titik, aku punya gudang penuh amunisi dan logam\n\
	\tTapi aku tidak ingin melakukan semua ini, aku bisa mengambil semuanya kepada Anda jika Anda membantu saya dengan beberapa bisnis\n"

new quest_name[][] =
{
	"Pengiriman transportasi",
	"Mari kita cat",
	"Pertikaian atas wilayah",
	"Mencuri klub",
	"Penanda",
	"Pencurian dokumen",
	"Kluhi dari kantor polisi"
};

new quest_info[][] =
{
	"\n\t{FFFFFF}Untuk memulai, Anda perlu menemukan mobil yang saya curi, \n\tteman-teman saya mengatakan mereka melihatnya di daerah itu %s\n\
	\tPergi ke sana dan cari tahu apa yang terjadi pada mobil saya, \n\tjika seseorang menjaganya, curi dan bawa segera ke sini.\n\n",

	"\n\t{FFFFFF}Anda mengirim mobil, saya sudah takut mereka akan mengubahnya menjadi besi tua,\n\
	\tTidak ada yang mengenal Anda, Anda perlu melukis 2 grafiti untuk menyatakan dirinya,\n\tpergi ke toko 24/7 dan beli sendiri semprotan cat\n\
	\tLalu pergi dan cari grafiti di seluruh ghetto, segera setelah Anda menemukannya, mulailah melukis di atasnya.\n\n",

	"\n\t{FFFFFF}Lagi-lagi Anda, halo, Anda tepat waktu, \n\tSaya diberitahu di sini bahwa orang-orang yang berkelahi dengan Anda\n\
	\tmemulai sesuatu yang besar, Anda harus menempatkannya secepat mungkin\n\
	\tAnda perlu berpartisipasi dan menang dalam satu tangkapan untuk wilayah tersebut dengan geng Anda\n\n",

    "\n\t{FFFFFF}Teman-teman saya ingin mengambil Pasukan Darat sekaligus, tetapi mereka tidak akan berhasil\n\
	\tjika saya tidak mendapatkan Kartu Kunci untuk mereka sehingga mereka dapat melewati pos pemeriksaan \n\ttanpa masalah.\n\
	\tSaya ingin Anda menyelinap ke pangkalan militer dan mencoba membunuh salah satu militer\n\
	\tKartu kunci yang perlu Anda ambil akan keluar\n\
	\n\n\tPergi ke salah satu Pangkalan Militer dan bawakan saya Kartu Kunci di semua biaya!\n\n",

	"\n\t{FFFFFF}Hai, saya dihubungi oleh pelanggan reguler saya dan meminta bantuan, \n\
	\tSaya perlu cepat menyiapkan barang untuknya, \n\tlebih tepatnya, barang sudah siap, tetapi bawa\n\
	\tbuka koordinat yang ditentukan dan letakkan bookmark di sana. \n\tAnda harus melakukannya dengan cepat..\n\
 	\n\tSecepat mungkin!\n\n",

	"\n\t{FFFFFF}Anda tepat waktu, kemarin mobil kedua saya disita ke tempat parkir, \n\tjika mereka membuka bagasi, aku akan melakukannya\n\
	\tAda banyak obat terlarang, saya menyembunyikannya secara khusus agar tidak ada yang menemukannya\n\
	\tDan betapa jahatnya polisi menabraknya, \n\tSaya tidak tahu berapa banyak waktu yang tersisa\n\
	\tSampai mereka menggeledahnya, saya harus mengeluarkannya dari tempat parkir sesegera mungkin.\n\
	\tAnda perlu mendapatkan dokumen dari arsip polisi dengan data mobil\n\
	\tAgar lelaki saya dapat dengan aman menjemputnya dari sana\n\
	\tPergi ke kantor polisi dan temukan arsip segera setelah Anda temukan\n\
	\ttemukan nomor mobil saya di daftar dan ambil dokumennya, buat: {ff0000}Glendale\n\
	\t{ffffff}Jangan melihat nomornya, kalau tidak Anda akan membawa dokumen ke mobil lain!\n",

	"\n\t{FFFFFF}Dengar, aku tidak punya waktu untuk mengatakan, kau harus melakukannya untukku!\n\n\
	\tAnda perlu entah bagaimana masuk ke database polisi dan menghapus nama saya dari database\n\
	\tAnda dapat pergi ke pangkalan melalui mobil polisi, tetapi untuk ini Anda perlu\n\
	\tKunci akses polisi, Anda hanya bisa mendapatkannya \n\tjika Anda merampok atau membunuh seorang polisi\n\
	\tIni sangat berbahaya, tetapi saya meminta Anda untuk melakukannya untuk saya, \n\tsegera setelah Anda mendapatkan kunci akses\n\
	\tPergi ke kantor polisi, duduk di mobil polisi dan pergi ke database\n\
	\tHapus nama saya dan keluar dari sana, jangan meninggalkan jejak!\n\n"
};

new quest_text_end[][] =
{
	"\n\t{FFFFFF}Bagus sekali, Anda menyelesaikan tugas pertama., \n\ttetap bekerja dengan baik dan Anda akan mendapatkan akses ke gudang saya, \n\torang-orang dari geng yang Anda lawan mencuri mencuri mobil saya\n\
	\tSaya harus melakukan beberapa panggilan untuk menyelesaikan semua masalah.\n\n",

	"\n\t{FFFFFF}Dan Anda belajar dengan cepat... \n\tSaya pikir kamu butuh waktu lebih lama untuk pergi..\n\
	\tSaya punya tugas baru untuk Anda, mereka memberi tahu saya di sini, \n\tbahwa orang-orang yang kamu lawan sedang melakukan sesuatu yang besar\n\
	\tMereka perlu diberlakukan sebelum mereka melakukan bisnis., \n\tAnda perlu memenangkan tangkapan wilayah satu kali\n\n",

	"\n\t{FFFFFF}Anda seharusnya melihat wajah teman saya yang menonton dari samping untuk menangkap Anda\n\
	\tAwalnya saya bahkan tidak percaya, tetapi ketika dia mulai menceritakan secara detail... \n\
	\tAku bahkan takut berurusan denganmu sekarang, hanya bercanda.. \n\n\tdatang kepadaku nanti.\n\n",

	"\n\t{FFFFFF}Bagaimana Anda bisa mendapatkannya? Untuk mendapatkannya, Anda harus melewati banyak rintangan\n\
	\tAnda hebat, dengan setiap tugas Anda membuktikan kesetiaan Anda, saya menghargai orang-orang seperti itu\n\
	\tSaya masih punya beberapa tugas untuk Anda, tetapi lebih lanjut tentang itu nanti.\n\n",

	"\n\t{FFFFFF}Saya baru tahu bahwa pelanggan reguler saya terikat\n\t sekarang dia berkolaborasi dengan polisi\n\
	 \tAku benar-benar sial, sial, \n\tSaya harus menyelesaikan masalah ini entah bagaimana.\n\n",

	"\n\t{FFFFFF}Apakah Anda memasuki stasiun dan mencuri dokumen? Anda memiliki telur baja\n\
	\tAnda mempertaruhkan kebebasan Anda untuk saya, saya tidak akan pernah melupakannya\n\
	\tAnda terbukti layak menerima persediaan gudang saya, datang kepada saya nanti\n\
	\tDan saya akan menunjukkan kepada Anda apa dan bagaimana di sini.\n\n",

	"\n\t{FFFFFF}Anda melakukan pekerjaan dengan baik, mereka bisa mengikat saya hari ini\n\
	\tAnda menyelamatkan hidup saya, saya tidak bisa tidak terima kasih\n\t\
	\tDi halaman belakang ada van, ada semua sumber daya gudang saya,\n\
	\tAnda memutuskan apa yang harus dilakukan dengan mereka, beberapa akan memberikan nenek yang baik untuk kebaikan seperti itu\n\n\
	\tAnda bisa menjualnya untuk {3399FF}175.000{FFFFFF} baik mengambil {ff0000}gudang{FFFFFF} gengnya, \n\tAnda yang memutuskan\n\n"
};

