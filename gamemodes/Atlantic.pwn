	new string[512];
	format(string, sizeof string,"{ffffff}Nama:{7fffd4} %s\n\n{ffffff}Nama Character Anda Belum Di Whitelist Oleh Administrator Malavida \nJika Anda Ingin Di Whitelist Di Kota Malavida , Silahkan Verifikasi Di Whatsapp Kami :\n{ffff00}https://chat.whatsapp.com/MVRP",GetName(playerid));
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX,"{7fff00}Panel Whitelist Malavida ", string, "Oke","Keluar");
	SetTimerEx("KickPlayer1", 1000, 0, "i", playerid);
	return 1;
}

forward Kicked1(playerid);
