CMD:createactor(playerid, params[])
{
    if(admin_level[playerid] < 6) return PermissionError(playerid);

    static
        model,
        id;

    /*new Float:x,
        Float:y,
        Float:z,
        Float:angle;*/

    if(sscanf(params, "d", model)) return Usage(playerid, "/createactor [Model ID]");

    if(model < 0 || model > 299) return Error(playerid, "Invalid skin model id. 0-299 only!");
    id = Actor_Create(playerid, model);
    printf("DEBUG: Modelid %d", model);

    if(id == -1) return Error(playerid, "You can't create more actor");

    return 1;
}

epublic: OnActorCreate(acid)
{
    if(acid == -1 || !aData[acid][aada])
        return 0;

    aData[acid][aid] = cache_insert_id();
    Actor_Save(acid);

    return 1;
}

CMD:editactor(playerid, params[])
{
    if(admin_level[playerid] < 5) return PermissionError(playerid);

    static
        id,
        type[25],
        string[256];

    if(sscanf(params, "ds[25]S()[256]", id, type, string))
    {
        Usage(playerid, "/editactor <ID Actor><Type>");
        SendClientMessage(playerid, -1, "{173a2a}TYPE: {ffffff}Location, Name, Model, Delete");
        return 1;
    }

    if((id < 0 || id >= MAX_AKTOR) || !aData[id][aada]) return Error(playerid, "Invalid ID");

    if(!strcmp(type, "location", true))
    {
        GetPlayerPos(playerid, aData[id][aposx], aData[id][aposy], aData[id][aposz]);
        GetPlayerFacingAngle(playerid, aData[id][aposa]);

        aData[id][aposx] += 1.0 * floatsin(-aData[id][aposa], degrees);
		aData[id][aposy] += 1.0 * floatcos(-aData[id][aposa], degrees);

        aData[id][aworld] = GetPlayerVirtualWorld(playerid);
        aData[id][aint] = GetPlayerInterior(playerid);

        Actor_Refresh(id);
        Actor_Save(id);
    }
    else if(!strcmp(type, "name", true))
    {
        new nam[128];
        if(sscanf(string, "s[128]", nam)) return Usage(playerid, "/editactor <id aktor><name><nama aktor>");
        if(strlen(nam) < 1 || strlen(nam) > 128) return Error(playerid, "Only 1-128 character");

        format(aData[id][anama], 128, nam);
        Actor_Refresh(id);
        Actor_Save(id);
    }
    else if(!strcmp(type, "model", true))
    {
        new idmod;
        if(sscanf(string, "d", idmod)) return Usage(playerid, "/editactor <id aktor><model><id skin>");
        if(idmod < 0 || idmod > 299) return Error(playerid, "Invalid skin model id. 0-299 only!");

        aData[id][amodel] = idmod;
        Actor_Refresh(id);
        Actor_Save(id);
    }
    else if(!strcmp(type, "delete", true))
    {
        new delac[128];
        mysql_format(mMysql, delac, sizeof(delac), "DELETE FROM actor WHERE aid=%d", id);
        mysql_tquery(mMysql, delac);
    }
    return 1;
}
CMD:sellpacket(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "Turun dari kendaraan terlebih dahulu");
	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, COLOR_GREY, "level anda belum cukup");
	if(AmbilPacket[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Belum Mengambil Paket");
	if(!IsPlayerInRangeOfPoint(playerid, 5, 2244.5522,-2147.8166,13.5468)) return SendClientMessage(playerid, COLOR_GREY, "Anda Tidak Berada Ditempat Pengantaran Paket");
    {
        new YogGanteng[116];
        StatusPacket = 0;
        AmbilPacket[playerid] = 0;
        PosPacket[0] = 0;
	    PosPacket[1] = 0;
	    PosPacket[2] = 0;
        ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
        RemovePlayerAttachedObject(playerid, 2);
        GivePlayerMoney(playerid, 200000);
	    PlayerInfo[playerid][pCash] += 200000;
   		PlayerInfo[playerid][pMetall] +=50;
		OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
	    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
	    GameTextForPlayer(playerid, "~g~+Rp.200k+50logam", 2000, 1);
        format(YogGanteng, sizeof(YogGanteng), "%s[%d] {FFFF00}Berhasil Mengirim Paket Ilegal", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_YELLOW, YogGanteng);
    }
    return 1;
}
CMD:takepacket(playerid, params[])
{
	if(GetFractionMemberAmount(FRACTION_LSPD) < 3) return Send(playerid, COLOR_GREY, "Polisi kurang dari 3 orang.");
	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, COLOR_GREY, "level anda belum cukup");
	if(AmbilPacket[playerid] == 1) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Sudah Mengambil Paket");
    if(StatusPacket == 2) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Sudah Diambil Player Lain");
	if(IsPlayerInRangeOfPoint(playerid, 5, PosPacket[0], PosPacket[1], PosPacket[2]))
    {
        new YogGanteng[116];
        StatusPacket = 2;
        AmbilPacket[playerid] = 1;
        DestroyDynamicPickup(IDPacket);
        DestroyDynamic3DTextLabel(PacketLabel);
        ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
        SetPlayerAttachedObject(playerid, 2, 1575, 5,0.3,0.1,0.0,0.0,270.0,0.0, 1, 1, 1, 0xFF00FF00);
        SetPlayerCheckpoint(playerid, 2244.5522,-2147.8166,13.5468, 2.0);
        format(YogGanteng, sizeof(YogGanteng), "%s[%d] {FFFFFF}Telah Mengambil Paket Ilegal, Buru Dia Sekarang", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_YELLOW, YogGanteng);
        SendClientMessage(playerid, COLOR_YELLOW, "Cepat Antar Packet Ke Label Merah, Anda Diincar Banyak Orang");
    }
    return 1;
}
CMD:findpacket(playerid, params[])
{
	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, COLOR_GREY, "level anda belum cukup");
	if(GetFractionMemberAmount(FRACTION_LSPD) < 3) return Send(playerid, COLOR_GREY, "Polisi kurang dari 3 orang.");
    if(StatusPacket == 0) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Paket Tidak Ditemukan");
    if(StatusPacket == 2) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Sudah Diambil Player Lain");
    if(StatusPacket == 1)
    {
    SetPlayerCheckpoint(playerid, PosPacket[0], PosPacket[1], PosPacket[2], 2.0);
    SendClientMessage(playerid, COLOR_YELLOW, "Cepat Ambil Packet Dilabel Merah, Keburu Diambil Orang");
    }
	return 1;
}
CMD:startpacket(playerid, params[])
{
    if(StatusPacket != 0) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Sudah Aktif");
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    KillTimer(TimePacket);
	TimePacket = SetTimer("TimePaket", 5000, 0);
	return 1;
}
CMD:bobol(playerid, params[])
{
	if(!IsAGang(playerid)) return SCM(playerid, COLOR_GREY, "Kayaknya Elu Warga? Ini khusus Badside.");
	new gang_attack = PlayerInfo[playerid][pMember];
	if(GetFractionMemberAmount(gang_attack) < 5) return Send(playerid,COLOR_GREY, "Ada kurang dari 5 orang di geng Anda.!");
	if(GetFractionMemberAmount(FRACTION_LSPD) < 5) return Send(playerid, COLOR_GREY, "Polisi kurang dari 5 orang.");
	if(IsPlayerInRangeOfPoint(playerid, 15.0, 1561.922,-1219.542,1390.268))
	{
	if(!IsAGang(playerid) && !IsAMafia(playerid) && PlayerInfo[playerid][pMember] != FRACTION_BIKER) return SCM(playerid, COLOR_GREY, "{FF0000}Anda Tidak Bisa Ngehack Bank");
	{
	TogglePlayerControllableEx(playerid, 0);
  	timer_robbank[playerid] = SetTimerEx("HackBankLs", 60000, false, "d", playerid);
    SetPVarInt(playerid, "fHack", 1);
    PlayerPlaySound(playerid,1133,0.0,0.0,0.0);
	SendClientMessageToAll(COLOR_LIGHTRED, "||----------------BERITA TERKINI----------------||");
    SendClientMessageToAll(COLOR_LIGHTGREEN, " Bank lokal Los Santos telah dibobol oleh penjahat.");
    SendClientMessageToAll(COLOR_LIGHTGREEN, " Bank saat ini sedang dirampok. ");
    SendClientMessageToAll(COLOR_LIGHTGREEN, " Aparat atau polisi segera menuju ke bank!");
    SendClientMessageToAll(COLOR_LIGHTRED, "||----------------BERITA TERKINI----------------||");
    SendClientMessage(playerid, COLOR_YELLOW, "Anda Sedang Mengbobol Bank Silakan Tunggu 1 Menit.....");
          }
    }
    return 1;
}
