		format(String, 244, "{0099FF}BiZ '%s'\n"W"Harga Untuk 1 Liter: %d$\n\n{EBBD00}Pengisian bahan bakar kendaraan\tidak: %d$\n{66CC00}/buyfuelst Untuk membeli",BizzAInfo[i][aMessage], BizzAInfo[i][aPrice], BizzAInfo[i][aBuyPrice]);
		Update3DTextLabelText(BizzAInfo[i][aLabel], -1, String);
		SaveABizz(i);
	}
    return SCM(playerid, -1, "Anda telah melalui semua bisnis dan pompa bensin di server!");
}

