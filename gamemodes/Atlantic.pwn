stock CheckHospitalHealth(playerid)
{
	if(PlayerInfo[playerid][pBolnica])
	{
		new Float:hp;
		GetPlayerHealth(playerid, hp);
		if(hp < 80) return Send(playerid, 0xFDEAA8FF, "Dalam kondisi ini, Anda tidak dapat meninggalkan rumah sakit...");

		if(player_lecenie[playerid] != -1 || GetPVarInt(playerid, "OplataLecenie") > 0)
		{
			format(String, sizeof(String), ""W"Anda keluar dari rumah sakit.\nPembayaran untuk layanan publik adalah: %d$", GetPVarInt(playerid, "OplataLecenie"));
			SPD(playerid,9995,DIALOG_STYLE_MSGBOX,"Checkout", String, "Close","");

			PlayerLeaveHospitalBed(playerid);
		}

		PlayerInfo[playerid][pBolnica] = 0;
	}

	return 0;
}

