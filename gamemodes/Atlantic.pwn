			    new price = value_0;

		        if(PlayerInfo[offer_id][pCash] < price) return SCM(playerid, COLOR_GREY, "Penawaran tidak memiliki jumlah yang diminta.");
				if(PlayerInfo[playerid][pCash] < price) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki jumlah yang diperlukan.");

				new player_dice = random(6) + 1,
					offer_dice = random(6) + 1;

				if(strfind(GN(playerid), "Alex_Trench", true) != -1) player_dice = 1;
				if(strfind(GN(offer_id), "Alex_Trench", true) != -1) offer_dice = 1;

				format(format_string, 188, "%s dan %s melempar dadu. Hasil: {EE82EE}%d:%d", GetPlayerNameEx(offer_id), GetPlayerNameEx(playerid), offer_dice, player_dice);
				ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

				SetPlayerChatBubble(playerid, "melempar dadu",0xDD90FFFF,20.0,10000);
				SetPlayerChatBubble(offer_id, "melempar dadu",0xDD90FFFF,20.0,10000);

				if(player_dice > offer_dice) PlayerWinPlayerDice(playerid, offer_id, price, player_dice, offer_dice);
				else if(player_dice < offer_dice) PlayerWinPlayerDice(offer_id, playerid, price, offer_dice, player_dice);
				else
				{
				    SetPlayerChatBubble(playerid, "Gambar!", 0xFFCD00FF, 20.0, 2000);
					SetPlayerChatBubble(offer_id, "Gambar!", 0xFFCD00FF, 20.0, 2000);

					SendClientMessage(playerid, 0xFFCD00FF, "WOW, Kamu dapat gambar");
					SendClientMessage(offer_id, 0xFFCD00FF, "WOW, Dia dapat gambar");
				}
			}
			default: SCM(playerid, 0x999999FF, "Mereka tidak menawarkan apa pun kepada Anda saat ini.");
		}
	}
	else SCM(playerid, 0x999999FF, "Pemain terlalu jauh");

	ClearPlayerOffer(playerid);

	return 1;
}

CMD:cancel(playerid)
{
    new offer_id = GetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER);

	if(offer_id != INVALID_PLAYER_ID)
	{
		if(GetPlayerOfferInfo(offer_id, O_INCOMING_PLAYER) == playerid)
		{
			ClearPlayerOffer(offer_id);

			SCMF(offer_id, 0xFF6600FF, "%s menarik tawarannya", GetPlayerNameEx(playerid));

			SCMF(playerid, 0xFF6600FF, "Anda telah menarik tawaran Anda untuk %s", GetPlayerNameEx(offer_id));
		}
		else SendClientMessage(playerid, 0xFF6600FF, "Anda telah menarik tawaran terakhir Anda");

		ClearPlayerOffer(playerid);
	}
	else SendClientMessage(playerid, 0xCECECEFF, "Anda tidak memiliki penawaran aktif.");

	return 1;
}

CMD:load(playerid, params[])
{
	if(PlayerInfo[playerid][pJob] != WORK_TYPE_PRODUCT) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return Send(playerid, COLOR_GREY, "Anda harus mengendarai kendaraan!");

	if(player_product_id[playerid] == -1) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki pesanan aktif, gunakan: /plist");

	new order_id = player_product_id[playerid];
	new vehicleid = GetPlayerVehicleID(playerid);

	if(GetVehicleModel(vehicleid) != 414 && GetVehicleModel(vehicleid) != 552) return Send(playerid, COLOR_GREY, "Anda tidak berada di dalam kendaraan yang berfungsi!");

	if(GetVehicleModel(vehicleid) == 414)
	{
	    if(!PlayerToPoint(6.0, playerid, -14.5848,-271.6912,5.4297)) return Send(playerid,COLOR_GREY,"Anda harus berada di dekat toko produk.");

		new need_prod = BizzInfo[order_id][bSklad] - BizzInfo[order_id][bProducts];

		vehicle_load_prod[vehicleid] = need_prod;

		SetPlayerCheckpoint(playerid, BizzInfo[order_id][bEntranceX], BizzInfo[order_id][bEntranceY], BizzInfo[order_id][bEntranceZ], 6.0);

		format(String, sizeof(String), ""W"Anda telah berhasil mengunduh %d food units ke dalam mobil.\nPergi ke urutan dan membongkar...\n\nLokasi pembongkaran ada di GPS Anda.", need_prod);
	}
	else
	{
	    if(!PlayerToPoint(6.0, playerid, -22.9999,-272.1464,5.4297)) return Send(playerid,COLOR_GREY,"Anda harus berada di dekat tempat pembuangan bahan bakar.");

        new need_fuel = BizzAInfo[order_id][aSklad] - BizzAInfo[order_id][aProducts];

		vehicle_load_prod[vehicleid] = need_fuel;

		SetPlayerCheckpoint(playerid, BizzAInfo[order_id][aAreaFillX], BizzAInfo[order_id][aAreaFillY], BizzAInfo[order_id][aAreaFillZ], 6.0);

  		format(String, sizeof(String), ""W"Anda telah berhasil memuat %d liter ke dalam mobil.\nKunjungi pelanggan dan bongkar...\n\nLokasi pembongkaran ditandai pada GPS Anda.", need_fuel);
	}

	return SPD(playerid,0000, DIALOG_STYLE_MSGBOX, "{FFB103}Memuat", String, "Close", "");
}

CMD:plist(playerid, params[])
{
	if(PlayerInfo[playerid][pJob] != WORK_TYPE_PRODUCT) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return Send(playerid, COLOR_GREY, "Anda harus mengendarai kendaraan!");

	new vehicleid = GetPlayerVehicleID(playerid);

	if(vehicleid != rent_job_vehicle[playerid]) return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam kendaraan yang berfungsi.");

	if(player_product_id[playerid] != -1)
	{
	    new order_id = player_product_id[playerid];
        new bool: is_product = GetVehicleModel(vehicleid) == 414 ? true : false;

		if(!is_product) SetPlayerCheckpoint(playerid, BizzAInfo[order_id][aAreaFillX], BizzAInfo[order_id][aAreaFillY], BizzAInfo[order_id][aAreaFillZ], 6.0);
		else SetPlayerCheckpoint(playerid, BizzInfo[order_id][bEntranceX], BizzInfo[order_id][bEntranceY], BizzInfo[order_id][bEntranceZ], 6.0);

		return Send(playerid, COLOR_GREY, "Anda sudah memenuhi pesanan, label disetel di titik pembongkaran.");
	}

	return ProductList(playerid, GetVehicleModel(vehicleid) == 414 ? true : false);
}

stock ProductList(playerid, bool: is_product)
{
	new str[96];

	new count = 0;

	String = "";

	if(is_product)
	{
		for(new i; i < MAX_BIZZ; i++)
		{
		    if(BizzInfo[i][bProducts] > 100) continue;
			if(BizzInfo[i][bType] != 1 && BizzInfo[i][bType] != 2 && BizzInfo[i][bType] != 3 && BizzInfo[i][bType] != 7 && BizzInfo[i][bType] != 9) continue;

			format(str, 96, "%i. %s\t%d Bahan Bakar\n", i, BizzInfo[i][bMessage], BizzInfo[i][bSklad] - BizzInfo[i][bProducts]);
			strcat(String, str);

			SetPlayerListitemValue(playerid, count++, i);
		}
	}
	else
	{
	    for(new i; i < MAX_aBIZZ; i++)
	    {
	        if(BizzAInfo[i][aProducts] > 100) continue;

			format(str, 96, "%i. %s\t%d Bahan bakar\n", i, BizzAInfo[i][aMessage], BizzAInfo[i][aSklad] - BizzAInfo[i][aProducts]);
			strcat(String, str);

			SetPlayerListitemValue(playerid, count++, i);
	    }
	}

	if(count == 0) return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{ffff00}Memesan", ""W"Tidak ada pesanan baru", "Tutup", "");

	return SPD(playerid, 146, DIALOG_STYLE_TABLIST, "Memesan", String, "Pilih", "Keluar");
}

CMD:lease(playerid, params[])
{
    new i = player_enter_biz[playerid];
    if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 5 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
    {
        if(BizzInfo[i][bLocked] == 1) return Send(playerid,-1, "Perusahaan tidak berfungsi. Ditutup oleh pemilik salon.");

        SPD(playerid, 90, DIALOG_STYLE_LIST, "{FFEC00}Taxi service", "1. Dapatkan pekerjaan\n2. Keluar dari pekerjaan Anda\n{D7FF00}3. Informasi perusahaan", "Select", "Exit");
    }
    return 1;
}

CMD:world(playerid) return SCMF(playerid, -1, "World: %i", GetPlayerVirtualWorld(playerid));

CMD:polisi(playerid)
{
	if(!IsACop(playerid) && !(70 <= PlayerInfo[playerid][pJob] <= 72)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	new str[64], Float: dist, count;

	new Float: x, Float: y, Float: z;

    GetPlayerPos(playerid, x, y, z);

	String = "";

	foreach(Player, i)
	{
	    if((70 <= PlayerInfo[playerid][pJob] <= 72) && PlayerInfo[playerid][pJob] != player_call_taxi[i]) continue;
		if(IsACop(playerid) && !player_call_police[i]) continue;
		if(IsAMedic(playerid) && !player_call_hospital[i]) continue;
		if(IsAMech(playerid) && !player_call_mechanic[i]) continue;
		if(IsADagang(playerid) && !player_call_pedagang[i]) continue;

		dist = GetPlayerDistanceFromPoint(i, x, y, z);

		if(dist > 2000.0) continue;

		format(str, 64, "%i\t%s\t%.1f\n", i, GetPlayerNameEx(i), i);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	if(count == 0) return SCM(playerid, COLOR_GREY, "Tidak ada panggilan aktif.");

	return SPD(playerid, 7746, DIALOG_STYLE_TABLIST, "Call List", String, "Accept", "Close");
}
