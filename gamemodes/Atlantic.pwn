stock GetPlayerABizzBySqlName(name[])
{
	new h_id = 0;

	format(format_string, 188, "SELECT `aID` FROM bizz_fuel WHERE aOwner = '%s' AND aOwned = 1 LIMIT 1", name);
	new Cache: result = mysql_query(mMysql, format_string, true);

	if(cache_num_rows()) cache_get_value_int(0, "aID", h_id);

	cache_delete(result);

	return h_id;
}

