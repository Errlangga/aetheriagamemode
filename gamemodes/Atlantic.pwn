{
    if(IsACop(playerid) || (admin_level[playerid] > 1 || admin_logged[playerid]))
    {
        for(new i; i < MAX_HOUSES; i++)
    	{
        	if(!PlayerToPoint(3.0, playerid, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez])) continue;

			if(HouseInfo[i][hLock] == 0) return Send(playerid, -1, "Pintu rumah ini terbuka.");

