CMD:barrage(playerid)
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0) return SCM(playerid, COLOR_GREY, "Hanya tersedia di luar ruangan.");

	String = "";

	new str[64], count = 0;

	for(new i; i < MAX_BARRAGE_OBJ; i++)
	{
	    if(player_barrage[playerid][i] == 0) continue;

	    new b_id = player_barrage_id[playerid][i];

		format(str, 64, "%i. %s\n", i + 1, barrage_names[b_id]);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	strcat(String, "- Buat barikade");

	return SPD(playerid, 8180, DIALOG_STYLE_LIST, "Barricade Menu", String, "Select", "Close");
}

CMD:tie(playerid, params[])
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid, COLOR_GREY, "Anda harus duduk di kursi pengemudi.");

	new to_player;

    if(sscanf(params, "u", to_player)) return Send(playerid, -1,"Enter: /tie [id pemain]");

    if(GetPlayerVehicleID(playerid) != GetPlayerVehicleID(to_player)) return Send(playerid, COLOR_GREY,"Anda tidak berada di kendaraan yang sama dengan pemain ini.");

    if(!player_tie[to_player])
    {
        SCMF(playerid, -1, "Anda menautkan %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s menghubungkan Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s diikat %s",Name(playerid), GetPlayerNameEx(to_player));
    }
    else
    {
        SCMF(playerid, -1, "Anda melepaskan %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s melepaskan Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s untied %s",Name(playerid), GetPlayerNameEx(to_player));
    }

	TogglePlayerControllable(to_player, player_tie[to_player]);

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_tie[to_player] ? ("Dilepaskan") : ("diikat"),0xDD90FFFF,20.0,10000);

    player_tie[to_player] = !player_tie[to_player];

	return 1;
}

CMD:gag(playerid, params[])
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	new to_player;

    if(sscanf(params, "u", to_player)) return Send(playerid, -1,"Enter: /gag [id pemain]");

    if(!ProxDetectorS(5.0, playerid, to_player)) return Send(playerid, COLOR_GREY,"Orang itu jauh dari Anda!");

    if(!player_gag[to_player])
    {
		if(!player_tie[to_player]) return SCM(playerid, COLOR_GREY, "Player tidak terhubung.");

        SCMF(playerid, -1, "Anda telah menyumbat %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s mencekikmu", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s tersedak %s",Name(playerid), GetPlayerNameEx(to_player));
    }
    else
    {
        SCMF(playerid, -1, "Anda telah menghapus lelucon dari %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s mencekikmu", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s Melepas lelucon %s",Name(playerid), GetPlayerNameEx(to_player));
    }

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_gag[to_player] ? ("Menyisipkan lelucon") : ("menghapus lelucon"),0xDD90FFFF,20.0,10000);

    player_gag[to_player] = !player_gag[to_player];

	return 1;
}

CMD:bag(playerid, params[])
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	new to_player;

    if(sscanf(params, "u", to_player)) return Send(playerid, -1,"Enter: /bag [id pemain]");

    if(!ProxDetectorS(5.0, playerid, to_player)) return Send(playerid, COLOR_GREY,"Orang itu jauh dari Anda!");

    if(!player_bag[to_player])
    {
        if(!player_tie[to_player]) return SCM(playerid, COLOR_GREY, "Player tidak terhubung.");

        SCMF(playerid, -1, "Anda menaruh tas di kepala %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s taruh tas di kepala Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s menaruh tas di kepala %s",Name(playerid), GetPlayerNameEx(to_player));

        TextDrawBoxColor(black_display[to_player], 0x000000ff);
		TextDrawShowForPlayer(playerid, black_display[to_player]);
    }
    else
    {
        SCMF(playerid, -1, "Anda mengeluarkan tas dari kepala %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s mengambil tas Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s mengambil tas dari kepala %s",Name(playerid), GetPlayerNameEx(to_player));

        TextDrawHideForPlayer(playerid, black_display[playerid]);
    }

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_bag[to_player] ? ("Taruh di tas") : ("melepas tas"),0xDD90FFFF,20.0,10000);

    player_bag[to_player] = !player_bag[to_player];

	return 1;
}

CMD:blist(playerid)
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	new m_id = PlayerInfo[playerid][pMember];

	String = "";

	new str[64], count = 0;

	for(new i; i < MAX_BIZZ; i++)
	{
		if(BizzInfo[i][bMafia] != m_id) continue;

		format(str, 64, "%i. %s\n", i, BizzInfo[i][bMessage]);
		strcat(String, str);

		count++;
	}

	if(count == 0) return SCM(playerid, COLOR_GREY, "Tidak ada bisnis di bawah kendali mafia Anda.");

	return SPD(playerid, 0000, DIALOG_STYLE_LIST, "Daftar Bisnis", String, "Tutup", "");
}

alias:elecation("election");
CMD:elecation(playerid)
{
	if(admin_level[playerid] < 7) return 1;

	return SPD(playerid, 3661, DIALOG_STYLE_LIST, "Panel kontrol pemilihan", "- Mulai/Hentikan pemilihan\n- Daftar partai", "Pilih", "Tutup");
}

CMD:rheal(playerid)
{
	if(PlayerInfo[playerid][pRepairKit] == 0) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki kit perbaikan.");

	new vehicleid = GetNearestVehicle(playerid);

	if(!vehicleid) return SCM(playerid, COLOR_GREY, "Tidak ada kendaraan di sekitar.");

	new Float: health;
	GetVehicleHealth(vehicleid, health);

	if(health == 1000.0) return SCM(playerid, COLOR_GREY, "Transportasi ini utuh.");

    PlayerInfo[playerid][pRepairKit]--;

    OnPlayerUpdateAccountsPer(playerid, "pRepairKit", PlayerInfo[playerid][pRepairKit]);

	RepairVehicle(vehicleid);

	return SCM(playerid, COLOR_YELLOW, "Anda telah memperbaiki kendaraan.");
}

CMD:referals(playerid)
{
	mysql_format(mMysql, format_string, 144, "SELECT `pName`, `pLevel` FROM `accounts` WHERE `pReferal` = %i", GetPlayerAccountID(playerid));
	new Cache: result = mysql_query(mMysql, format_string);

	new rows = cache_num_rows();

	if(!rows) return SCM(playerid, COLOR_GREY, "Tidak ada yang menunjukkan Anda sebagai referral.");

	String = "";

	new str[64], name[MAX_PLAYER_NAME], level;

	for(new i; i < rows; i++)
	{
	    cache_get_value(i, "pName", name);
	    cache_get_value_int(i, "pLevel", level);

	    format(str, 64, "%i. %s\t%i\n", i + 1, name, level);
	    strcat(String, str);
	}

	cache_delete(result);

	return SPD(playerid, 0000, DIALOG_STYLE_TABLIST, "Daftar pemain yang diundang", String, "Tutup", "");
}

alias:animlist("anim");
CMD:animlist(playerid)
{
	if(!PlayerCuffed{playerid}) SPD(playerid,1994,DIALOG_STYLE_LIST, "Animation List","[0] Tarian\n[1] Posisi\n[2] Lainnya\n[3] Pasangan\n[4] Rap", "Select", "Cancel");
	else SCM(playerid,COLOR_GREY,"Apakah Anda diborgol atau diikat!");
	return true;
}

CMD:rcancel(playerid)
{
	if(rent_vehicle_id[playerid] == INVALID_VEHICLE_ID) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki kendaraan sewaan.");

	return SPD(playerid, 4745, DIALOG_STYLE_MSGBOX, "Transport lease", "Apakah Anda benar-benar ingin menghentikan sewa?", "Ya", "Tidak");
}
CMD:movehouse(playerid, params[])
{
	if(admin_level[playerid] < 8) return true;
 	new h_id;
	extract params -> new hid; else return Send(playerid, -1,"/movehouse [ID rumah]");
	if(PlayerInfo[playerid][pDutyAdmin] == 0) return SCM(playerid, COLOR_RED, "Anda Belum Duty Sebagai Admin.");
	if(hid > MAX_HOUSES-1 || hid <= 0) return Send(playerid, -1, "Tidak ada rumah dengan ID ini ditemukan.");
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	HouseInfo[hid][hEntrancex] = x;
	HouseInfo[hid][hEntrancey] = y;
	HouseInfo[hid][hEntrancez] = z;
	DestroyPickup(HouseInfo[hid][hPickup]);
	DestroyDynamicMapIcon(HouseInfo[hid][hMIcon]);
	DestroyDynamicArea(HouseInfo[hid][hAreaEnter]);
	if(HouseInfo[hid][hOwned] == 0)
	{
		if(HouseInfo[hid][hKlass] == 5) HouseInfo[hid][hPickup] = CreatePickup(1273, 23, HouseInfo[hid][hEntrancex], HouseInfo[hid][hEntrancey], HouseInfo[hid][hEntrancez],-1);
		else HouseInfo[hid][hPickup] = CreatePickup(1273, 23, HouseInfo[hid][hEntrancex], HouseInfo[hid][hEntrancey], HouseInfo[hid][hEntrancez],-1);
	}
	if(HouseInfo[hid][hOwned] == 1)
	{
		if(HouseInfo[hid][hSlet] == 2) HouseInfo[hid][hPickup] = CreatePickup(1272, 23, HouseInfo[hid][hEntrancex], HouseInfo[hid][hEntrancey], HouseInfo[hid][hEntrancez],-1);
		else if(HouseInfo[hid][hKlass] == 5) HouseInfo[hid][hPickup] = CreatePickup(1272, 23, HouseInfo[hid][hEntrancex], HouseInfo[hid][hEntrancey], HouseInfo[hid][hEntrancez],-1);
		else HouseInfo[hid][hPickup] = CreatePickup(1272, 23, HouseInfo[hid][hEntrancex], HouseInfo[hid][hEntrancey], HouseInfo[hid][hEntrancez],-1);
	}
	HouseInfo[hid][hAreaEnter] = CreateDynamicSphere(HouseInfo[hid][hEntrancex], HouseInfo[hid][hEntrancey], HouseInfo[hid][hEntrancez],1.2,0);
	SaveHouse(hid);
	SCMF(playerid, -1, "Kamu telah memindahkan rumah (ID: %i)", hid);
    UpdatePickupHouse(h_id);
	new query[512];
    mysql_format(mMysql, query, sizeof(query), "INSERT INTO `house` (`hID`, `hEntrancex`, `hEntrancey`, `hEntrancez`, `hOwner`) VALUES ('%i','%f','%f','%f','%s','%d')", h_id, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey], HouseInfo[h_id][hEntrancez], HouseInfo[h_id][hOwner], HouseInfo[h_id][hValue]);
    mysql_tquery(mMysql, query, "OnHousesCreated", "is",  h_id, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey], HouseInfo[h_id][hEntrancez], HouseInfo[h_id][hOwner], HouseInfo[h_id][hValue]);
	return 1;
}
CMD:accept(playerid)
{
    new offer_id = GetPlayerOfferInfo(playerid, O_INCOMING_PLAYER);
	new offer_type = GetPlayerOfferInfo(playerid, O_INCOMING_TYPE);

	new value_0 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[0];
	new value_1 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[1];
    new value_2 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[2];
    //new value_3 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[3];

    if(offer_id == INVALID_PLAYER_ID) return 1;

	if(!IsPlayerConnected(offer_id) || !PlayerInfo[offer_id][pLogin]) return SCM(playerid, COLOR_GREY, "Pemohon telah meninggalkan permainan.");

	if(GetPlayerOfferInfo(offer_id, O_OUTCOMIG_PLAYER) == playerid)
	{
		ClearPlayerOffer(offer_id);
	}
	else offer_type = -1;
	
	switch(offer_type)
	{
    	case OFFER_TYPE_SHARELOC:
	    {
	        new Float:x, Float:y, Float:z;
	        GetPlayerPos(offer_id, x, y, z);
			SetPlayerCheckpoint(playerid, x, y, z, 2.0);

			SCM(offer_id, COLOR_YELLOW, "Anda Telah Berhasil Share Lokasi Anda Sekarang");
	    }
	    default: SCM(playerid, 0x999999FF, "Mereka tidak menawarkan apa pun kepada Anda saat ini.");
	}


	if(ProxDetectorS(15.0, playerid, offer_id))
	{
		switch(offer_type)
		{
 			case OFFER_TYPE_FRISK:
			{
			    MeAction(offer_id,"Menggeledah orang didepan dengan kedua tangan kanan");
			   	SCMF(offer_id, COLOR_YELLOW, "Ditemukan [%d] Rupiah", PlayerInfo[playerid][pCash]);
				SCMF(offer_id, COLOR_YELLOW, "Ditemukan [%d] Obat-obatan", PlayerInfo[playerid][pDrugs]);
			    SCMF(offer_id, COLOR_YELLOW, "Ditemukan [%d] Logam", PlayerInfo[playerid][pMetall]);
			    SCMF(offer_id, COLOR_YELLOW, "Ditemukan [%d] Kartid", PlayerInfo[playerid][pPatron]);
			    format(String, 64, "%s Menggeledah %s", Name(offer_id) ,Name(playerid)), ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
			}
			case OFFER_TYPE_HI:
			{
			    new Float:angle;
			    GetPlayerFacingAngle(offer_id, angle);
				SetPlayerFacingAngle(playerid, angle + 180.0);
			    SetPlayerChatBubble(playerid,"menjabat tangannya",COLOR_PURPLE,30.0,10000);
			    SetPlayerChatBubble(offer_id,"menjabat tangannya",COLOR_PURPLE,30.0,10000);
			    ApplyAnimation(playerid,"GANGS","hndshkfa",4.0,0,0,0,0,0,1);
			    ApplyAnimation(offer_id,"GANGS","hndshkfa",4.0,0,0,0,0,0,1);
		    }
		    case OFFER_TYPE_FAMILY:
		    {
		        new offer_family = GetPlayerData(offer_id, pFamily);

				SetPlayerData(playerid, pFamily, offer_family);
				SetPlayerData(playerid, pFamilyRang, 1);

				CreatePlayer3DFamily(playerid);

				format(format_string, 96, "%s[%i] {FFFFFF}bergabung dengan keluarga!",  GetPlayerNameEx(playerid), playerid);
				SendFamilyMessage(offer_family, format_string);

				format(format_string, 144, "UPDATE `accounts` SET `family` = %i, `family_rang` = 1 WHERE `pName` = '%s'", offer_family, GetPlayerNameEx(playerid));
				mysql_tquery(mMysql, format_string);
		    }
      		case OFFER_TYPE_DRAG:
            {
            new dragby = GetPVarInt(playerid, "DragBy");
            if(dragby == INVALID_PLAYER_ID || dragby == playerid)
                return Error(playerid, "Player itu Disconnect.");

            if(!NearPlayer(playerid, dragby, 5.0))
                return Error(playerid, "Kamu harus didekat Player.");

            pData[playerid][pDragged] = 1;
            pData[playerid][pDraggedBy] = dragby;

            pData[playerid][pDragTimer] = SetTimerEx("DragUpdate", 1000, true, "ii", dragby, playerid);
            format(String, 188, "* %s grabs %s and starts dragging them, (/undrag).", ReturnName(dragby), ReturnName(playerid));
            ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
            return true;
            }

            case OFFER_TYPE_PAINTJOB:
            {
                new offer_vehicleid = GetPlayerVehicleID(offer_id);

                GivePlayerMoneyEx(playerid, -value_1, "Mengganti warna kendaraan");

                ChangeVehiclePaintjob(offer_vehicleid, value_1);
                switch(value_1)
                {
                    case 0,1,2: CarInfo[playerid][cPaintJobs] = value_1;
                }
                
                PlayerInfo[playerid][pComponent] -= 1;
                OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);

                SCMF(offer_id, -1, "- %s menerima tawaran.", GetPlayerNameEx(playerid));
                SCMF(playerid, -1, "- Anda menerima tawaran dari %s.", GetPlayerNameEx(offer_id));

                SaveCars(playerid);

                format(format_string, 144, "UPDATE `accounts` SET `%e` = %i WHERE `pID` = %i", GetTuningName(value_1), value_1, GetPlayerAccountID(playerid));
                mysql_tquery(mMysql, format_string);
            }
            case OFFER_TYPE_PAINTCAR:
            {
                new offer_vehicleid = GetPlayerVehicleID(playerid);

                GivePlayerMoneyEx(playerid, -value_2, "Mengganti warna kendaraan");
                GivePlayerMoneyEx(offer_id, value_2, "Mengganti warna kendaraan");

                ChangeVehicleColor(offer_vehicleid, value_0, value_1);

                CarInfo[playerid][cColor1][UseCar(playerid)] = value_0;
                CarInfo[playerid][cColor2][UseCar(playerid)] = value_1;

                SCMF(offer_id, -1, "- %s menerima tawaran.", GetPlayerNameEx(playerid));
                SCMF(playerid, -1, "- Anda menerima tawaran dari %s.", GetPlayerNameEx(offer_id));

                SaveCars(playerid);
            }
		   	case OFFER_TYPE_SELLCAR: // ini buat jual mobil ke player
		    {
		        new price = value_0;

                new u_car_0 = GetPlayerUseListitem(offer_id); //ID penjual mobil
                new u_car_1 = GetPlayerFreeCarSlot(playerid); //ID pembeli mobil

                if(u_car_1 == -1)
                {
                    ClearPlayerOffer(playerid);

                    return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Tidak Memiliki Slot Kosong");
                }
                
                if(player_spawn_car_slot[playerid] != -1) return SendError(playerid, "Silakan Menyuruh Pemain Ini Untuk Membongkar Kendaraan Dia Terlebih Dahulu");

                if(PlayerInfo[playerid][pCash] < price) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Jumlah Uang Anda Tidak Cukup Untuk Membeli Kendaraan Ini");

                CarInfo[playerid][cModel][u_car_1] = CarInfo[offer_id][cModel][u_car_0];
                CarInfo[playerid][cSost][u_car_1] = CarInfo[offer_id][cSost][u_car_0];
                CarInfo[playerid][cColor1][u_car_1] = CarInfo[offer_id][cColor1][u_car_0];
                CarInfo[playerid][cColor2][u_car_1] = CarInfo[offer_id][cColor2][u_car_0];
                CarInfo[playerid][cPaintJobs][u_car_1] = CarInfo[offer_id][cPaintJobs][u_car_0];
                CarInfo[playerid][cFuel][u_car_1] = CarInfo[offer_id][cFuel][u_car_0];
                CarInfo[playerid][cCost][u_car_1] = CarInfo[offer_id][cCost][u_car_0];
                CarInfo[playerid][cProbeg][u_car_1] = CarInfo[offer_id][cProbeg][u_car_0];
                CarInfo[playerid][cHeal][u_car_1] = CarInfo[offer_id][cHeal][u_car_0];
                CarInfo[playerid][cWheels][u_car_1] = CarInfo[offer_id][cWheels][u_car_0];
                CarInfo[playerid][cSpoiler][u_car_1] = CarInfo[offer_id][cSpoiler][u_car_0];
                CarInfo[playerid][cBumper1][u_car_1] = CarInfo[offer_id][cBumper1][u_car_0];
                CarInfo[playerid][cBumper2][u_car_1] = CarInfo[offer_id][cBumper2][u_car_0];
                CarInfo[playerid][cNitro][u_car_1] = CarInfo[offer_id][cNitro][u_car_0];
                CarInfo[playerid][cHydrawlic][u_car_1] = CarInfo[offer_id][cHydrawlic][u_car_0];
                CarInfo[playerid][cHood][u_car_1] = CarInfo[offer_id][cHood][u_car_0];
                CarInfo[playerid][cRoof][u_car_1] = CarInfo[offer_id][cRoof][u_car_0];
                CarInfo[playerid][cSideskirt][u_car_1] = CarInfo[offer_id][cSideskirt][u_car_0];
                CarInfo[playerid][cLamps][u_car_1] = CarInfo[offer_id][cLamps][u_car_0];
                CarInfo[playerid][cExhaust][u_car_1] = CarInfo[offer_id][cExhaust][u_car_0];
                CarInfo[playerid][cStereo][u_car_1] = CarInfo[offer_id][cStereo][u_car_0];
                CarInfo[playerid][cVentRight][u_car_1] = CarInfo[offer_id][cVentRight][u_car_0];
                CarInfo[playerid][cVentLeft][u_car_1] = CarInfo[offer_id][cVentLeft][u_car_0];
                CarInfo[playerid][cGun][u_car_1] = CarInfo[offer_id][cGun][u_car_0];
                CarInfo[playerid][cAmmo][u_car_1] = CarInfo[offer_id][cAmmo][u_car_0];
                CarInfo[playerid][cFood][u_car_1] = CarInfo[offer_id][cFood][u_car_0];
                CarInfo[playerid][cDrink][u_car_1] = CarInfo[offer_id][cDrink][u_car_0];
                CarInfo[playerid][cBatu][u_car_1] = CarInfo[offer_id][cBatu][u_car_0];
