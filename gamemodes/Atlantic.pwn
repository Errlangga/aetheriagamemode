                CarInfo[offer_id][cStereo][u_car_0] = 0;
                CarInfo[offer_id][cVentRight][u_car_0] = 0;
                CarInfo[offer_id][cVentLeft][u_car_0] = 0;
                CarInfo[offer_id][cHeal][u_car_0] = 1000.0;
                CarInfo[offer_id][cLock][u_car_0] = 0;
                CarInfo[offer_id][cGun][u_car_0] = 0;
                CarInfo[offer_id][cAmmo][u_car_0] = 0;
                CarInfo[offer_id][cFood][u_car_0] = 0;
                CarInfo[offer_id][cDrink][u_car_0] = 0;
                CarInfo[offer_id][cBatu][u_car_0] = 0;
                CarInfo[offer_id][cBatuk][u_car_0] = 0;
                CarInfo[offer_id][cMetall][u_car_0] = 0;
                CarInfo[offer_id][cComponent][u_car_0] = 0;
                CarInfo[offer_id][cDamagePanel][u_car_0] = 0;
                CarInfo[offer_id][cDamageDoors][u_car_0] = 0;
                CarInfo[offer_id][cDamageLights][u_car_0] = 0;
                CarInfo[offer_id][cDamageTires][u_car_0] = 0;
                CarInfo[offer_id][cGarkot][u_car_0] = 0;
                CarInfo[offer_id][cInGarkot][u_car_0] = 0;

                player_home_car[playerid][u_car_1] = player_home_car[offer_id][u_car_0];

                player_home_car[offer_id][u_car_0] = INVALID_VEHICLE_ID;

                RemovePlayerFromVehicle(offer_id);

                KurangPlayerUang(playerid, price);
                KasihPlayerUang(offer_id, price);

                SCMF(playerid, COLOR_GREEN, "[SUCCES] {FFFFFF}Anda Telah Berhasil Membeli Kendaraan Dari %s", GetPlayerNameEx(offer_id));
                SCMF(offer_id, COLOR_GREEN, "[SUCCES] {FFFFFF}Anda Telah Berhadil Menjual Kendaraan Kepada %s", GetPlayerNameEx(playerid));

                SaveCars(offer_id);
                SaveCars(playerid);
                
				SavePlayerPerfomanceTune(offer_id);
				SavePlayerPerfomanceTune(playerid);
            }

/*////////////////!!!!!!!!!!!!!!!!!!!! ///////////
==============================================================*/

			// case OFFER_TYPE_PAINTJOB:
			// {
