forward OnPlayerEnterDynamicArea(playerid, areaid);
public OnPlayerEnterDynamicArea(playerid, areaid)
{
	if(areaid == Healing)
	{
		SCM(playerid, COLOR_GREEN, "Anda memasukin healing peace");
        pData[playerid][TempatHealing] = true;
	}
	//toll
	if(areaid == PintuToll[0] || areaid == PintuToll[1])
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            GameTextForPlayer(playerid, "~r~/paytoll~w~~n~atau~r~ klakson~w~~n~untuk membuka akses toll", 5000, 4);
            DiToll[playerid] = 1;
        }
	}
    foreach(Player, i)
	{
        if(GetPVarType(i, "BBArea"))
	    {
	        if(areaid == GetPVarInt(i, "BBArea"))
	        {
	            new station[256];
	            GetPVarString(i, "BBStation", station, sizeof(station));
	            if(!isnull(station))
				{
					PlayStream(playerid, station, GetPVarFloat(i, "BBX"), GetPVarFloat(i, "BBY"), GetPVarFloat(i, "BBZ"), 30.0, 1);
				 	SendClientMessage(playerid, -1, "You have entered an boombox area");
	            }
				return 1;
	        }
	    }
	}
    if(GetPVarInt(playerid, "next_area") >= gettime()) return 1;

	if(areaid == mayor_weather_area) SetPlayerWeather(playerid, 12);

	if(areaid == army_vv_enters[0])
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(playerid);

			SetVehiclePos(vehicleid, 291.2160,1821.9142,17.6406);
			SetVehicleZAngle(vehicleid, 265.9204);
	    }
	    else
	    {
	        SetPlayerPos(playerid, 291.2160,1821.9142,17.6406);
			SetPlayerFacingAngle(playerid, 265.9204);
	    }

	    SetPVarInt(playerid, "next_area", gettime() + 3);
	}

	if(areaid == army_vv_enters[1])
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(playerid);

			SetVehiclePos(vehicleid, 280.1693,1821.4052,17.6406);
			SetVehicleZAngle(vehicleid, 91.3529);
	    }
	    else
	    {
	        SetPlayerPos(playerid, 280.1693,1821.4052,17.6406);
			SetPlayerFacingAngle(playerid, 91.3529);
	    }

	    SetPVarInt(playerid, "next_area", gettime() + 3);
	}

	if(areaid == army_vv_enters[2])
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(playerid);

			SetVehiclePos(vehicleid, 349.2613,1793.7356,18.0919);
			SetVehicleZAngle(vehicleid, 236.9679);
	    }
	    else
	    {
	        SetPlayerPos(playerid, 349.2613,1793.7356,18.0919);
			SetPlayerFacingAngle(playerid, 236.9679);
	    }

	    SetPVarInt(playerid, "next_area", gettime() + 3);
	}

	if(areaid == army_vv_enters[3])
	{
	    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			new vehicleid = GetPlayerVehicleID(playerid);

			SetVehiclePos(vehicleid, 341.7746,1804.3756,18.1475);
			SetVehicleZAngle(vehicleid, 35.5160);
	    }
	    else
	    {
	        SetPlayerPos(playerid, 341.7746,1804.3756,18.1475);
			SetPlayerFacingAngle(playerid, 35.5160);
	    }

	    SetPVarInt(playerid, "next_area", gettime() + 3);
	}

	if(city_zones_id[0] <= areaid <= city_zones_id[2])
	{
	    new index = _:(areaid - city_zones_id[0]);

	    SetPVarInt(playerid, "city_id", index);

	}

	if(quest_area[0] <= areaid <= quest_area[1])
	{
	    ShowPlayerBegQuests(playerid);
	}

	if(areaid == rob_unload_area)
	{
		if(player_rob_id[playerid] == -1) return 1;

		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;

		new rob_id = player_rob_id[playerid];

		new vehicleid = rob_info[rob_id][r_vehicleid];

		if(GetPlayerVehicleID(playerid) != vehicleid) return 1;

		new amount = rob_info[rob_id][r_loaded];

		if(amount == 0)
		    return SCM(playerid, COLOR_GREY, "Van itu kosong.");

		new reward = 950 * amount;

		new partnerid = GetPlayerRobPartnerID(playerid);

		if(partnerid == INVALID_PLAYER_ID)
		{
		    GivePlayerMoneyEx(playerid, reward, "penjualan furnitur");

		    SCMF(playerid, -1, "Kamu punya {91d29a}$%i "W"untuk penjualan furnitur.", reward);

            player_rob_id[playerid] = -1;
		}
		else
		{
		    GivePlayerMoneyEx(playerid, reward / 2, "penjualan furnitur");
		    GivePlayerMoneyEx(partnerid, reward / 2, "penjualan furnitur");

		    SCMF(playerid, -1, "Kamu punya {91d29a}$%i "W"untuk penjualan furnitur.", reward / 2);
		    SCMF(partnerid, -1, "Kamu punya {91d29a}$%i "W"untuk penjualan furnitur.", reward / 2);

		    player_rob_id[playerid] = player_rob_id[partnerid] = -1;
		}

        DestroyVehicle(vehicleid);

		for(new x; x < 2; x++) rob_info[rob_id][r_player][x] = INVALID_PLAYER_ID;
		rob_info[rob_id][r_vehicleid] = INVALID_VEHICLE_ID;
	}

	if(rob_house_area[0] <= areaid <= rob_house_area[sizeof rob_house_area - 1])
	{
	    if(player_rob_id[playerid] == -1) return 1;

	    new index = _:(areaid - rob_house_area[0]);

	    new h_id = player_enter_home[playerid];

	    if(rob_obj_taked[h_id][index] == true) return 1;

	    SCM(playerid, 0xBC8F8Fff, "Anda telah mendekati subjek yang Anda bisa "W"untuk mencuri{BC8F8F}, gunakan: "W"ALT");
	}

	if(areaid == rob_area)
	{
	    if(!IsAGang(playerid)) return SCM(playerid, COLOR_GREY, "Saya tidak punya apa-apa untuk memberitahu Anda.");

	    if(player_rob_id[playerid] == -1)
	    	SPD(playerid, 1771, DIALOG_STYLE_MSGBOX, "Marvin Merchants", ROB_FIRST_TEXT, "Selanjutnya", "Batalkan");
	}

    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_DRUGMARK && player_quest_info[playerid][quest_status] == 1)
    {
		new mark_id = player_quest_info[playerid][quest_progress];

		if(areaid == stash_quest_area[mark_id])
		{
		    player_quest_info[playerid][quest_status] = 2;

            OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 6.1, 0, 0, 0, 0, 0,1);

            if(PlayerInfo[playerid][pWanted] < 3)
            {
	            PlayerInfo[playerid][pWanted] = 3;
				SetPlayerCriminal(playerid, "Tidak dikenal", "Tab obat");
				SetPlayerWantedLevel(playerid, 3);
			}

            SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 4);
		}
    }

    if(areaid == getmoney_quest_area)
	{
	    if(player_quest_info[playerid][quest_id] != GQUEST_TYPE_MONEY) return 1;

		new vehicleid = GetPlayerVehicleID(playerid);

		if(vehicleid == INVALID_VEHICLE_ID || playerid != quest_vehicle_owner[vehicleid]) return 1;

		PlayerEndQuests(playerid);

		GivePlayerMoneyEx(playerid, 5000, "pencarian");

		SCM(playerid, -1, "Anda menyelesaikan tugas dan menerima $5000");

		DestroyVehicle(vehicleid);

		quest_vehicle_owner[vehicleid] = INVALID_PLAYER_ID;
	    player_quest_info[playerid][quest_vehicle_id] = INVALID_VEHICLE_ID;
	}

	if(areaid == jackcar_quest_area)
	{
	    if(player_quest_info[playerid][quest_id] != GQUEST_TYPE_CARJACK) return 1;

		new vehicleid = GetPlayerVehicleID(playerid);

		if(vehicleid == INVALID_VEHICLE_ID || playerid != quest_vehicle_owner[vehicleid]) return 1;

		player_quest_info[playerid][quest_status] = 2;

		OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

		SCM(playerid, -1, "Tugas selesai, buka {71E00B}Penunggang"W".");

		DestroyVehicle(vehicleid);

		quest_vehicle_owner[vehicleid] = INVALID_PLAYER_ID;
	    player_quest_info[playerid][quest_vehicle_id] = INVALID_VEHICLE_ID;
	}

 	if(areaid == warehouse_area)
	{
	    if(!IsAGang(playerid)) return SCM(playerid, COLOR_GREY, "Anda bukan anggota geng.");

	    //if(!(5 <= DayOfWeak() <= 7)) return SCM(playerid, COLOR_GREY, "Tidak ada pekerjaan hari ini, datanglah lain kali.");

	    if(player_quest_info[playerid][quest_block] != 0)
	        return SCM(playerid, COLOR_GREY, "Saya belum memiliki pekerjaan untuk Anda.");

	    new q_id = player_quest_info[playerid][quest_id];
	    new q_status = player_quest_info[playerid][quest_status];

	    if(q_id > GQUEST_TYPE_KEYPDSTEAL) return SCM(playerid, COLOR_GREY, "Tidak ada lagi pekerjaan untuk Anda di sini.");

	    if(q_id == 0 && q_status == 0)
		{
		    new member = PlayerInfo[playerid][pMember];
		    format(String, strlen(GQUEST_FIRST_TEXT), GQUEST_FIRST_TEXT, FracInfo[member][fName]);
			SPD(playerid, 9471, DIALOG_STYLE_MSGBOX, "Pertemuan pertama", String, "Jawab", "Batalkan");
		}
		else if(q_status == 0) SPD(playerid, 9471, DIALOG_STYLE_MSGBOX, "Ryder", ""W"Saya punya tugas baru untuk Anda", "Ya", "Tidak");
		else if(q_status == 1) SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Ryder", ""W"Anda belum menyelesaikan tugas, pergi dan selesaikan itu.", "Tutup", "");
		else
		{
		    //GivePlayerQuestReward(playerid);

		    player_quest_info[playerid][quest_id]++;
		    player_quest_info[playerid][quest_status] = 0;
		    player_quest_info[playerid][quest_progress] = 0;

		    OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_id", player_quest_info[playerid][quest_id]);
		    OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 0);
		    OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_progress", 0);

		    if(q_id != GQUEST_TYPE_GRAFFITI)
			{
				player_quest_info[playerid][quest_block] = 30;
		    	OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_block", 30);
		    }

		    if(q_id != GQUEST_TYPE_KEYPDSTEAL) SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Ryder", quest_text_end[q_id], "Tutup", "");
		    else SPD(playerid, 9475, DIALOG_STYLE_MSGBOX, "Ryder", quest_text_end[q_id], "Selanjutnya", "");
		}
	}

	if(areaid == stash_area)
	{
	    if(PlayerInfo[playerid][pDrugMarkAmount] != 0)
	        return SCM(playerid, COLOR_GREY, "Anda belum mengambil nick terakhir, gunakan: /drugs");

	    SPD(playerid, 7791, DIALOG_STYLE_MSGBOX, "Daftar Produk", "Apakah Anda ingin membeli obat?", "Ya", "Tidak");
	}
	
    if(areaid == dealerlcrp)
	{
		new u_car_1 = GetPlayerFreeCarSlot(playerid);
		if(u_car_1 == -1)
		{
  		return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemain Ini Tidak Memiliki Slot Kosong");
    	}
        ShowPlayerDialog(playerid, 1589, DIALOG_STYLE_LIST, "Dealer Malavida ", "1. Dealership Motorcycle\n2. Dealership Compact Cars\n3. Dealership Luxury Cars\n4. Dealership Truck Vans & Saloon Cars\n5. Dealership Racer Street\n6. Dealership Trucker", "Pilih", "Tutup");
	}

    if(areaid == claim_npcls)
	{
        ShowPlayerDialog(playerid, 1559, DIALOG_STYLE_LIST, "Nama Gua Kris", "Kamu Baru Disini ya?\nMau Ambil Staterpack?", "Iya", "Tutup");
	}

    if(quest_frac_area[0] <= areaid <= quest_frac_area[4])
	{
	    if(!IsAGang(playerid)) return 1;

	    new index = _:(areaid - quest_frac_area[0]);

	    if(GetFractionGangID(playerid) != index) return 1;

	    if(player_quest_info[playerid][quest_vehicle_id] != GetPlayerVehicleID(playerid)) return 1;

	    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_MATS && player_quest_info[playerid][quest_status] == 1)
	    {
	        wh_ammo_gang[index] += 5000;
			wh_drugs_gang[index] += 500;

			format(format_string, 128, "[F] Pemain %s[%i] dikirim ke pangkalan 5000 pt dan 500 g. obat-obatan.", GetPlayerNameEx(playerid), playerid);
			SendFrac(PlayerInfo[playerid][pMember],COLOR_GREEN,format_string);

			DeletePlayerQuestData(playerid);

			PlayerEndQuests(playerid);
	    }
	}

	if(graffiti_area[0] <= areaid <= graffiti_area[MAX_GRAFFITI - 1])
	{
	    if(!IsAGang(playerid)) return 1;

	    new index = _:(areaid - graffiti_area[0]);

	    GameTextForPlayer(playerid, graffiti_colored[index], 3000, 4);

	    if(graffiti_block[index] > gettime())
	        return SCM(playerid, COLOR_GREY, "Pengecatan ulang tidak tersedia dalam satu jam berikutnya.");

	    if(PlayerInfo[playerid][pMember] == graffiti_fraction[index])
	        return SCM(playerid, COLOR_GREY, "Geng Anda sudah memiliki grafiti ini.");

	    PlayerTextDrawTextSize(playerid, graffiti_player_td[playerid], 273.6195, 0.0000);

     	graffiti_player_id[playerid] = index;

	    graffiti_player_progress[playerid] = 0;
	}

	if(areaid == duel_area)
	{
	    if(!IsAGang(playerid))
	        return SCM(playerid, COLOR_GREY, "Tinggalkan, Anda tidak diterima di sini.");

	    new str[46];

	    String = "";

	    for(new i, z = sizeof duel_weapons_id; i < z; i++)
	    {
	        format(str, 46, "%i. %s\n", i + 1, duel_weapons_name[i]);
	        strcat(String, str);
	    }

	    SPD(playerid, 9981, DIALOG_STYLE_LIST, "Pilih senjata pertama Anda", String, "Pilih", "Tutup");
	}

	if(wh_pickup[0] <= areaid <= wh_pickup[sizeof wh_pickup - 1])
	{
	    new index = areaid - wh_pickup[0];

	    if(PlayerInfo[playerid][pMember] != wh_pickup_gang[index])
	        return SCM(playerid, COLOR_GREY, "Anda tidak memiliki akses ke gudang ini..");

		if(PlayerInfo[playerid][pRank] < wh_rang_gang[index])
		    return SCMF(playerid, COLOR_GREY, "Gudang tersedia dari %i peringkat.", wh_rang_gang[index]);

		ShowPlayerWarehouseDialog(playerid);
	}

	if(ship_rent[0] <= areaid <= ship_rent[sizeof ship_rent - 1])
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT) return 1;

		SetPlayerUseListitem(playerid, areaid - ship_rent[0]);
		new b_id = GetPlayerUseListitem(playerid);

		if(!strcmp(ship_rent_type[b_id], "towtruck", true)) {
			if(!IsAMech(playerid)) return SCM(playerid, COLOR_GREY, "Rent towtruck hanya tersedia untuk mekanik!");
		}

		format(format_string, sizeof(format_string), ""W"Kamu yakin ingin menyewa %s?\nHarga: $15000\n{afafaf}- Transport hilang jika tidak duduk dalam 1 menit untuk sepeda\n{afafaf}- Transport hilang jika tidak duduk dalam 10 menit untuk kapal & towtruck", ship_rent_type[b_id]);

		SPD(playerid, 4378, DIALOG_STYLE_MSGBOX, "Sewa", format_string, "Ya", "Tidak");
	}


    if(player_bone_table[playerid] == -1)
	{
	    if(casino_info_area[0] <= areaid <= casino_info_area[sizeof casino_info_area - 1])
	    {
	        new index = _:(areaid - casino_info_area[0]);
	        return PlayerEnterToBoneTable(playerid, index);
	    }
	}

	if(areaid == hotel_reception_area)
	{
		if(GetPlayerHouse(playerid) != -1) return SCM(playerid, COLOR_GREY, "Anda sudah memiliki rumah.");
		if(GetPlayerHouseLodger(playerid) != -1) return SCM(playerid, COLOR_GREY, "Anda sudah terdaftar di suatu tempat, gunakan: /leavelodger");
	    if(PlayerInfo[playerid][pHotel] != -1) return SCM(playerid, COLOR_GREY, "Anda sudah memiliki kamar hotel.");

	    command_text = "";

	    new str[64], count = 0;

	    for(new i; i < MAX_HOTELS; i++)
	    {
	        if(hotel_info[i][hOwned] == 1) continue;

	        if(count == 20) break;

	        //SetPlayerListitemValue(playerid, count++, i);

	        format(str, 64, "\n[%i] lantai. %i nom. %i, harga: $%i", i + 1, hotel_info[i][hFloor] + 1, hotel_info[i][hNumber], hotel_info[i][hPrice]);
			strcat(command_text, str);

			count++;
	    }

	    strcat(command_text, "\n\nMasukkan angka:");

	    return ShowPlayerDialog(playerid, 4373, DIALOG_STYLE_INPUT, "Daftar kamar yang tersedia", command_text, "Sewa", "Tutup");
	}

    if(hotel_areas[0] <= areaid <= hotel_areas[sizeof hotel_areas - 1])
	{
	    if(player_hotel_id[playerid] != -1) return 1;

	    new index = _:(areaid - hotel_areas[0]);

	    new floor = player_hotel_floor[playerid];

		new h_id = g_entrance_flat[floor][index];

	    new is_owned = hotel_info[h_id][hOwned];

	    if(is_owned == 0) return 1;

	    SetPlayerUseListitem(playerid, h_id);

	    command_text = "";

		new str[64];

	    format(str, 64, "Pemilik: %s", hotel_info[h_id][hOwner]);
	    strcat(command_text, str);

	    format(str, 32, "\nNomor apartemen: %i", index + 1);
	    strcat(command_text, str);

	    format(str, 16, "\nLantai: %i", floor + 1);
	    strcat(command_text, str);

		return ShowPlayerDialog(playerid, 4872, DIALOG_STYLE_MSGBOX, "Entri angka", command_text, "Masuk", "Tutup");
	}

    if(areaid == race_area)
    {
        if(PlayerInfo[playerid][pLicenses][0] != 1) return Send(playerid,-1,"Anda tidak memiliki SIM.");

        if(race_state != 1) return SCM(playerid, COLOR_GREY, "Pendaftaran saat ini ditutup.");

		if(player_race_reg{playerid}) return SPD(playerid, 1872, DIALOG_STYLE_MSGBOX, "Balapan", "{FFFFFF}Apakah Anda ingin membatalkan balapan", "Ya", "Tidak");

		SPD(playerid, 1871, DIALOG_STYLE_MSGBOX, "Balapan", "{FFFFFF}Anda ingin balapan?", "Ya", "Tidak");
    }
    else if(areaid == hotel_lift)
    {
        ShowPlayerDialog(playerid, 4771, DIALOG_STYLE_INPUT, "Pemilihan lantai", "Masukkan nomor lantai:\n1 hingga 7", "Pilih", "Tutup");
    }
    else if(areaid == family_create_area)
    {
        if(PlayerInfo[playerid][pFamily] != -1) return SCM(playerid, COLOR_GREY, "Anda sudah menjadi anggota keluarga!");

		if(PlayerInfo[playerid][pRouble] < 1000) return SCM(playerid,0xafafafff,"Kamu tidak punya cukup rubel.");

		ShowPlayerCreateFamilyDialog(playerid, 0);
    }
    else if(areaid == tune_engine_area)
    {
        new use_car = GetPlayerUseHomeCar(playerid);

        if(use_car == -1) return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam transportasi pribadi.");

		new vehicleid = GetPlayerVehicleID(playerid);

        if(IsABoat(vehicleid) || IsABike(vehicleid) || IsAPlane(vehicleid) || NoPerfomance(vehicleid)) return Send(playerid, 0xafafafff, "Anda tidak dapat menginstal peningkatan pada jenis transportasi ini!");

		ShowPlayerTuneEngine(playerid);
    }
    else if(areaid == tune_brake_area)
    {
        new use_car = GetPlayerUseHomeCar(playerid);

        if(use_car == -1) return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam transportasi pribadi.");

        new vehicleid = GetPlayerVehicleID(playerid);

        if(IsABoat(vehicleid) || IsABike(vehicleid) || IsAPlane(vehicleid) || NoPerfomance(vehicleid)) return Send(playerid, 0xafafafff, "Anda tidak dapat menginstal peningkatan pada jenis transportasi ini!");
        ShowPlayerTuneBrake(playerid);
    }
    else if(areaid == trash_unload)
    {
        if(PlayerInfo[playerid][pJob] != 4) return 1;

        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return true;//Send(playerid,-1,"pemain tidak mengemudi");

        new vehicleid = GetPlayerVehicleID(playerid);

        if(VehInfo[vehicleid][vFr] != 4) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak berada di truk sampah!");

		new amount = trash_vehicle_amount[vehicleid];

        if(amount <= 0) return SendClientMessage(playerid, COLOR_GREY, "Sampah kosong!");

        new salary = amount * 10;

        new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
        if(partner_id != INVALID_PLAYER_ID && PlayerInfo[partner_id][pJob] == 4)
        {
            new partner_salary = salary / 2;

			GivePlayerPayCheck(partner_id, partner_salary);

			SCMF(partner_id, -1, "Anda menurunkan truk sampah, diterima: {91d29a}$%i", partner_salary);

			salary /= 2;
        }

        GivePlayerPayCheck(playerid, salary);

		SCMF(playerid, -1, "Anda menurunkan truk sampah, diterima: {91d29a}$%i", salary);

		if(partner_id != INVALID_PLAYER_ID)
		{
		    SendClientMessage(playerid, -1, "Pembayaran dibagi antara Anda dan pasangan!");
		    SendClientMessage(partner_id, -1, "Pembayaran dibagi antara Anda dan pasangan!");
		}
		DisablePlayerCheckpoint(playerid);
		UpdateVehicleTrashInfo(vehicleid, -amount);
    }
    else if(areaid == collector_unload)
    {
        if(PlayerInfo[playerid][pJob] != 5) return 1;

        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return Send(playerid,-1,"Anda tidak berada dalam mobil koleksi!");

        new vehicleid = GetPlayerVehicleID(playerid);

        if(VehInfo[vehicleid][vFr] != 5) return SendClientMessage(playerid, COLOR_GREY, "Anda bukan mobil pengumpul!");

        new amount = collector_vehicle_amount[vehicleid];

        if(amount <= 0) return SendClientMessage(playerid, COLOR_GREY, "Tidak ada uang di kolektor!");

        new salary = amount * 10;

        new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
        if(partner_id != INVALID_PLAYER_ID && PlayerInfo[partner_id][pJob] == 5)
        {
            new partner_salary = salary / 2;

			GivePlayerPayCheck(partner_id, partner_salary);

			SCMF(partner_id, -1, "Anda membawa uang, diterima: {91d29a}$%i", partner_salary);

			salary /= 2;
        }

        GivePlayerPayCheck(playerid, salary);

		SCMF(playerid, -1, "Anda membawa uang, diterima: {91d29a}$%i", salary);

		if(partner_id != INVALID_PLAYER_ID)
		{
		    SendClientMessage(playerid, -1, "Pembayaran dibagi antara Anda dan pasangan!");
		    SendClientMessage(partner_id, -1, "Pembayaran dibagi antara Anda dan pasangan!");
		}
		DisablePlayerCheckpoint(playerid);

		UpdateVehicleCollectorInfo(vehicleid, -amount);
    }
    for(new i=1; i <= TotalActor; i++)
	{
		if(areaid == ActorInfo[i][aAreaActors]) return player_enter_actors[playerid] = i;
	}
 	//

  	for(new i=1; i <= TotalAtms; i++)
    {
        if(areaid == AtmsInfo[i][aAreaEnters])
		{
		    if(PlayerInfo[playerid][pJob] == 5 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID) return 1;

		    SetPlayerUseListitem(playerid, i);

			return MenuAtms(playerid);
		}
	}
	for(new i=1; i <= TotalABizz; i++)
    {
        if(areaid == BizzAInfo[i][aEntranceArea])
		{
		    //GameTextForPlayer(playerid, "~w~use key: ~g~y", 5000, 1);
		    return player_enter_fuel[playerid] = i;
		}
	}

	if(0 <= player_enter_home[playerid] <= MAX_HOUSES-1)
	{
	    new h_id = player_enter_home[playerid];

	    if(areaid != HouseInfo[h_id][hStoreArea]) return 1;

	    ShowPlayerHouseStore(playerid);
	}

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		for(new b; b < TotalBizz; b++)
	    {
	        if(areaid == BizzInfo[b][bEntranceArea])
			{
			    if(BizzInfo[b][bType] == 14) return 1;

			    if(BizzInfo[b][bEntranceCost] > 0 && GetPlayerBizz(playerid) != b && GetPVarInt(playerid, "EntranceOplataBizz") != b)
				{
				    SetPlayerUseListitem(playerid, b);

					format(String, 144, ""W"Penerimaan dibayar dan dibayar {FF9900}%d$\nAnda yakin ingin masuk %s?", BizzInfo[b][bEntranceCost], BizzInfo[b][bMessage]);
					return SPD(playerid, 63, DIALOG_STYLE_MSGBOX, "Login", String, "Ya", "Tidak");
				}

				return PlayerEnterToBizz(playerid, b);
			}

			if(areaid == BizzInfo[b][bExitArea])
			{
		        if(player_reg_pb[playerid] != -1)
		        {
		            GivePlayerMoneyEx(playerid, 2000, "registrasi PB terganggu");

		            SCM(playerid, COLOR_GREY, "Registrasi terputus, uang dikembalikan.");

	                GiveBusinessMoney(b, -500, -1);

		            player_reg_pb[playerid] = -1;
		        }

				SetPVarInt(playerid, "next_area", gettime() + 3);

		    	SetPlayerInterior(playerid,0), SetPlayerVirtualWorld(playerid,0);
				return SetPlayerPos(playerid, BizzInfo[b][bEntranceX], BizzInfo[b][bEntranceY], BizzInfo[b][bEntranceZ]);
			}
		}
	}

	return 1;
}

epublic: StressBerkurang(playerid)
{
	UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]-1);
}

public OnPlayerLeaveDynamicArea(playerid, areaid)
{
    if(player_bone_table[playerid] != -1) PlayerLeaveBoneTable(playerid);

	if(areaid == mayor_weather_area) SetPlayerWeather(playerid, weather_id);

    if(graffiti_area[0] <= areaid <= graffiti_area[MAX_GRAFFITI - 1])
	{
	    //new index = _:(areaid - graffiti_area[0]);

		if(!IsAGang(playerid)) return 1;

		if(graffiti_player_progress[playerid] != 0) PlayerStopRestyleGraffiti(playerid);
	}

    for(new i; i < MAX_HOUSES; i++)
	{
    	if(areaid != HouseInfo[i][hAreaEnter]) continue;

	    for(new x = 0; x < 3; x++) PlayerTextDrawHide(playerid, UseLAlt[playerid][x]);

	    break;
 	}

 	if(player_enter_fuel[playerid] != 0)
	{
	    for(new i = 0; i < 3; i++) PlayerTextDrawHide(playerid, UseLAlt[playerid][i]);
	 	return player_enter_fuel[playerid] = 0;
 	}
 	if(player_enter_actors[playerid] != 0) return player_enter_actors[playerid] = 0;
 	new r = GetNearestRadar(areaid);
	if(r != -1)
	{
		if(GetPVarInt(playerid, "v_radar") != 0) DeletePVar(playerid, "v_radar");
	}

	if(areaid == Healing)
	{
		SCM(playerid, COLOR_GREEN, "Anda telah meninggalkan Healing Peace");
	    PlayerInfo[playerid][TempatHealing] = false;
	    KillTimer(stresstimer[playerid]);
	}
	return true;
}
public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	printf("[D-PICKUP] %s[%i]: %i / %i", GetPlayerNameEx(playerid), playerid, _:pickupid, _:ac_pickups[playerid][1]);

    if(ac_pickups[playerid][1] == pickupid) return 0;

    ac_pickups[playerid][1] = pickupid;
	GetPlayerPos(playerid, PosPic[playerid][1][0], PosPic[playerid][1][1], PosPic[playerid][1][2]);

	if(ship_work_pickups[0] <= pickupid <= ship_work_pickups[sizeof ship_work_pickups - 1])
	{
	    if(!player_ship_worked[playerid]) return SCM(playerid, COLOR_GREY, "Anda tidak bekerja di platform.");

	    if(player_ship_oil[playerid] == false) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki minyak, pergi ke tingkat yang lebih rendah dan kumpulkan.");

	    new index = _:(pickupid - ship_work_pickups[0]);

        if(gettime() < ship_repair_cd[index]) return SCM(playerid, COLOR_GREY, "Perbaikan tidak diperlukan di sini.");

	    ship_repair_cd[index] = gettime() + 60;

	    TogglePlayerControllable(playerid, false);

	    ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 1, 0, 0, 0, 0,1);

        player_ship_oil[playerid] = false;

	    SetTimerEx("PlayerEndRepairShip", 10000, false, "i", playerid);
	}

	if(ship_oil_pickups[0] <= pickupid <= ship_oil_pickups[sizeof ship_oil_pickups - 1])
	{
	    if(!player_ship_worked[playerid]) return SCM(playerid, COLOR_GREY, "Anda tidak bekerja di platform.");

	    if(player_ship_oil[playerid]) return SCM(playerid, COLOR_GREY, "Anda sudah memiliki minyak, pergi gemukkan gigi.");

	    ApplyAnimation(playerid,"MISC","GRAB_R",4.0, 0, 0, 0, 0, 0,1);

        player_ship_oil[playerid] = true;

        SCM(playerid, COLOR_GREEN, "Anda mengambil minyak, pergi meminyaki persneling.");
	}

	if(pickupid == ship_pickup)
	{
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
	    if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID) return SCM(playerid, COLOR_GREY, "Untuk memulai, batalkan mobil sewaan: /rcancel");

	    if(!player_ship_worked[playerid])
	    {
	        SCM(playerid, COLOR_GREEN, "Anda memulai hari kerja.");

	        SetPVarInt(playerid, "old_skin", GetPlayerSkin(playerid));
		    SetPlayerSkin(playerid, 50);

		    //player_ship_oil[playerid] = true;

		    pTemp[playerid][pWorkSalary] = 0;

			SetPlayerAttachedObject(playerid, 2, 19621, 6, 0.0829, 0.1529, 0.0479, 0.0000, 0.0000, 0.0000, 1.0000, 1.0000, 1.0000);
	    }
	    else
	    {
	        new salary = pTemp[playerid][pWorkSalary];
	        if(salary != 0)
	        {
	            SCMF(playerid, COLOR_GREEN, "Anda menghasilkan: $%i", salary);
      			//GivePlayerMoneyEx(playerid, salary, "gaji platform"); //TEST
	        }

	        SetPlayerSkin(playerid, GetPVarInt(playerid, "old_skin"));

	        SCM(playerid, COLOR_GREY, "Anda menyelesaikan hari kerja.");

	        RemovePlayerAttachedObject(playerid, 2);
	    }

	    player_ship_worked[playerid] = !player_ship_worked[playerid];
	}

	if(pickupid == army_armour)
	{
	    if(!IsAArmy(playerid)) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk tentara.");

	    new m_id = PlayerInfo[playerid][pMember];

	    if(FracInfo[m_id][fBank][0] < 50 && FracInfo[m_id][fBank][1] < 50) return SCM(playerid, COLOR_GREY, "Tidak ada persediaan amunisi.");

	    FracInfo[m_id][fBank][0] -= 50;
	    FracInfo[m_id][fBank][1] -= 50;

		SetPlayerArmour(playerid, 100.0);
	}

	if(pickupid == army_vvs_wh[0]) SetPPos(playerid, 316.3870,-168.2380,999.5938,359.8360, 6, 5, false);
    if(pickupid == army_vvs_wh[1]) SetPPos(playerid, 338.9280,2470.7336,20.2886,3.5308, 0, 0, true);

    if(pickupid == army_vmf_wh[0]) SetPPos(playerid, 316.3870,-168.2380,999.5938,359.8360, 6, 2, false);
    if(pickupid == army_vmf_wh[1]) SetPPos(playerid, -1369.0739,499.0473,11.1953,269.6160, 0, 0, false);

	if(IsAArmy(playerid))
	{
	    if(pickupid == ship_ammo_pickup)
	    {
	        if(GetPVarInt(playerid, "take_mats"))
				return SCM(playerid, COLOR_GREY, "Anda telah mengambil kotak amunisi.");

			if(ship_ammo_amount < 500 || ship_metall_amount < 500)
			    return SCM(playerid, COLOR_GREY, "Ada sedikit persediaan amunisi.");

			UpdateShipAmmo(-500, -500);

			GivePlayerAmmoBox(playerid);
	    }

		for(new i; i < MAX_VEHICLES; i++)
		{
		    if(pickupid != army_veh_pickup[i]) continue;

		    new limit_amount = GetVehicleModel(i) == 470 ? 5 : 20;

			if(GetPVarInt(playerid, "take_mats"))
			{
			    if(army_veh_amount[i] == limit_amount)
			        return SCM(playerid, COLOR_GREY, "Kendaraan ini sudah penuh..");

            	army_veh_amount[i]++;

            	RemovePlayerAmmoBox(playerid);
			}
			else
			{
			    if(army_veh_amount[i] == 0)
			        return SCM(playerid, COLOR_GREY, "Tidak ada kotak amunisi dalam transportasi.");

			 	army_veh_amount[i]--;

			 	GivePlayerAmmoBox(playerid);
			}

			format(format_string, 64, "Amunisi dimuat: %i/%i", army_veh_amount[i], limit_amount);
			UpdateDynamic3DTextLabelText(army_veh_3d[i], -1, format_string);

			return SCMF(playerid, COLOR_GREEN, "Kotak yang tersisa: %i/%i", army_veh_amount[i], limit_amount);
		}
	}

	if(pickupid == player_quest_info[playerid][quest_pickup_id])
	{
	    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_KEYSTEAL && player_quest_info[playerid][quest_status] == 1)
        {
            player_quest_info[playerid][quest_status] = 2;

            OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

            SCM(playerid, COLOR_GREEN, "Anda mengambil kartu kunci.");

            SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 3);

            player_quest_info[playerid][quest_pickup_id] = 0;
            DestroyDynamicPickup(pickupid);
        }
	}

    if(pickupid == PlayerInfo[playerid][pDrugPickup]) DeletePlayerDrugMark(playerid, true);

	else if(pickupid == croupier_job)
	{
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
	    format(format_string, 128, "Apakah kamu mau %s Hari kerja dealer?", player_croupier_job{playerid} == 0 ? ("untuk memulai") : ("untuk menyelesaikan"));
	    SPD(playerid, 3487, DIALOG_STYLE_MSGBOX, "Pekerjaan Croupier", format_string, "Ya", "Tidak");
	}
	else if(pickupid == school_pickup[0]) SetPPos(playerid, -2038.9879,-132.5310,-50.9140 + 0.5,0.0428, 1, 1, true);
	else if(pickupid == school_pickup[1]) SetPPos(playerid, -2044.0111,-117.8024,35,1860.3180, 0, 0, false);
	else if(pickupid == school_exham_pickup)
	{
		if(PlayerInfo[playerid][pLicenses][0] == 1) return SendClientMessage(playerid, COLOR_GREY, "Anda memiliki SIM.");

		if(1 <= player_road_school[playerid] <= 2) return SendClientMessage(playerid, COLOR_GREY, "Anda sudah memulai tes mengemudi.");

       	String = "";
		strcat(String, ""W"Semua gerakan di negara bagian harus dilakukan secara ketat sesuai dengan aturan di bawah ini:\n\n");
		strcat(String,""G"1) Ketentuan umum:\n");
		strcat(String,""W"1.Kecepatan yang diizinkan untuk t/s di kota - "G"60"W" km/h, keluar kota - "G"110"W" km/h, di jalan raya - "G"150"W" km/h.\n");
		strcat(String,"2.Jika perlu, pengemudi harus melewati t/s dengan sinyal khusus (Polisi, Layanan Penyelamatan, Ambulans) , yaitu: secara bertahap melambat, berpelukan.\n");
		strcat(String,"3.Penyeberangan negara tidak diatur. Akses yang diizinkan untuk melarang sinyal lalu lintas.\n");
		strcat(String,"4.Atas permintaan petugas penegak hukum, pengemudi harus berhenti dan memenuhi semua persyaratan yang tercantum dari petugas penegak hukum.\n");
		strcat(String,"5.Jika terjadi kecelakaan(Kecelakaan lalu lintas) driver diperlukan: \n");
		strcat(String,"  a) Tetap di tempat kecelakaan;\n");
		strcat(String,"  b) Hubungi petugas penegak hukum;\n");
		strcat(String,"  c) Panggil ambulans jika situasinya mengharuskannya.\n");
		strcat(String,"6.Pengemudi harus melewati pejalan kaki di tempat-tempat khusus untuk menyeberang (persimpangan, tanda khusus).\n");
		strcat(String,"7.Pengemudi wajib memarkir kendaraan hanya di tempat parkir, atau di sisi jalan, saat mengemudi dengan hanya 2 roda.\n");

		SPD(playerid, 8436, DIALOG_STYLE_MSGBOX, ""W"Aturan lalu lintas [1|2]", String, "Selanjutnya", "Tutup");
	}
	else if(pickupid == steal_pickup)
    {
        if(PlayerInfo[playerid][pMember] != 7) return SendClientMessage(playerid, COLOR_GREY, "Hanya tersedia untuk pengendara sepeda motor.!");

        if(player_fuel_steal[playerid] == 0) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak memiliki bahan bakar untuk dijual. Untuk memulai, merampok pom bensin.");

        new reward = player_fuel_steal[playerid] * 50;

        RemovePlayerAttachedObject(playerid, 3);

        GivePlayerMoneyEx(playerid, reward, "pencurian bahan bakar");

        SCMF(playerid, COLOR_GREEN, "Kamu punya $%i untuk perubahan %i menyala bahan bakar.", reward, player_fuel_steal[playerid]);

        player_fuel_steal[playerid] = 0;
    }
    if(pickupid == tzer[0])
	{
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
        if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID) return SCM(playerid, COLOR_GREY, "Untuk memulai, batalkan mobil sewaan: /rcancel");

		if(player_job[playerid] == 0) ShowPlayerDialog(playerid, 1133, DIALOG_STYLE_MSGBOX, "Gudang biji-bijian", ""W"Apakah Anda ingin mulai bekerja sebagai pemuat?", "Mulai", "Tutup");
		else if(player_job[playerid] == 2) return ShowPlayerDialog(playerid, 1133, DIALOG_STYLE_MSGBOX, "Gudang biji-bijian", ""W"Apakah Anda ingin menyelesaikan pekerjaan loader?", "Sampai selesai", "Tutup");
	}
	else if(pickupid == tzer[1])
	{
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
	    if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID) return SCM(playerid, COLOR_GREY, "Untuk memulai, batalkan mobil sewaan: /rcancel");

		if(player_job[playerid] == 0) ShowPlayerDialog(playerid, 1134, DIALOG_STYLE_MSGBOX, "Penebang kayu", ""W"Apakah Anda ingin memulai penebang pohon?", "Mulai", "Tutup");
		else if(player_job[playerid] == 1) return ShowPlayerDialog(playerid, 1134, DIALOG_STYLE_MSGBOX, "Penebang kayu", ""W"Apakah Anda ingin menyelesaikan pekerjaan penebang pohon?", "Sampai selesai", "Tutup");
	}
	if(pickupid == tJob3)
	{
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
	    if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID) return SCM(playerid, COLOR_GREY, "Untuk memulai, batalkan mobil sewaan: /rcancel");

		if(player_job[playerid] == 0) ShowPlayerDialog(playerid, 1135, DIALOG_STYLE_MSGBOX, "Produsen produk", ""W"Apakah Anda ingin memulai pengumpul produk?", "Mulai", "Tutup");
		else if(player_job[playerid] == 3) return ShowPlayerDialog(playerid, 1135, DIALOG_STYLE_MSGBOX, "Produsen produk", ""W"Apakah Anda ingin menyelesaikan pekerjaan pengumpul produk?", "Sampai selesai", "Tutup");
	}
	if(pickupid == tzer[8])
	{
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
	    if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID) return SCM(playerid, COLOR_GREY, "Untuk memulai, batalkan mobil sewaan: /rcancel");

		if(player_job[playerid] == 0) ShowPlayerDialog(playerid, 1136, DIALOG_STYLE_MSGBOX, "Nelayan", ""W"Apakah Anda ingin mulai bekerja sebagai nelayan?", "Mulai", "Tutup");
		else if(player_job[playerid] == 4) return ShowPlayerDialog(playerid, 1136, DIALOG_STYLE_MSGBOX, "Nelayan", "Apakah Anda ingin menyelesaikan pekerjaan seorang nelayan?", "Sampai selesai", "Tutup");
	}
	if(pickupid == tzer[9])
    {
        if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
        if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID) return Info(playerid, "Jika Anda Ingin Bekerja Silahkan /rcancel Terlebih Dahulu");

        if(PlayerInfo[playerid][pJob] == 0) ShowPlayerDialog(playerid, 1137, DIALOG_STYLE_MSGBOX, "Gojek Delivery", ""W"Apakah Anda Ingin Mulai Bekerja Sebagai Gojek?", "Mulai", "Tutup");
        else if(PlayerInfo[playerid][pJob] == 10) return ShowPlayerDialog(playerid, 1137, DIALOG_STYLE_MSGBOX, "Gojek Delivery", "Apakah Anda Ingin Menyelesaikan Pekerjaan Anda?", "Selesai", "Tutup");
    }
	else if(pickupid >= tzer[2] && pickupid <= tzer[7])
	{
		if(player_job[playerid] != 3 || GetPVarInt(playerid,"CHECKPOINTID") == 5) return true;
		if(GetPVarInt(playerid,"Metall") == 1) return SendClientMessage(playerid,0xB4B5B7FF,"Kesalahan: Anda sudah mengambil logamnya");
		SetPVarInt(playerid,"Metall",1);
		GameTextForPlayer(playerid,"~b~+1kg",3000,1);
		return true;
	}
	else if(pickupid == gangenter[0])
	{ // keluar vagos
        SetPlayerPos(playerid,2792.9011,-1618.1428,10.9219);
	    SetPlayerInterior(playerid,0);
	    SetPlayerVirtualWorld(playerid,0);
	    SetPlayerFacingAngle(playerid,70.0132);
	}
	else if(pickupid == gangenter[1]) // pintu masuk vagos
	{
        SetPlayerPos(playerid,1371.6512,85.6622,1024.0400);
	    SetPlayerInterior(playerid,4);
	    SetPlayerVirtualWorld(playerid,5);
	    SetPlayerFacingAngle(playerid, 2.0701);
	}
 	else if(pickupid == gangenter[2]) // pintu keluar karang
	{
        SetPlayerPos(playerid,2733.5886,-1952.7562,13.5469);
	    SetPlayerInterior(playerid,0);
	    SetPlayerVirtualWorld(playerid,0);
	    SetPlayerFacingAngle(playerid,88.9246);
	}
	else if(pickupid == gangenter[3]) // pintu masuk karang
	{
        SetPlayerPos(playerid,1371.6512,85.6622,1024.0400);
	    SetPlayerInterior(playerid,4);
	    SetPlayerVirtualWorld(playerid,8);
	    SetPlayerFacingAngle(playerid, 2.0701);
	}
	else if(pickupid == gangenter[4]) // Keluar Aztec
	{
        SetPlayerPos(playerid,2185.9148,-1812.0192,13.5469);
	    SetPlayerInterior(playerid,0);
	    SetPlayerVirtualWorld(playerid,0);
	    SetPlayerFacingAngle(playerid, 359.0100);
	}
	else if(pickupid == gangenter[5]) // Pintu masuk Aztec
	{
        SetPlayerPos(playerid,1371.6512,85.6622,1024.0400);
	    SetPlayerInterior(playerid,1);
	    SetPlayerVirtualWorld(playerid,6);
	    SetPlayerFacingAngle(playerid, 2.0701);
	}
	else if(pickupid == gangenter[6]) // alur keluar
	{
        SetPlayerPos(playerid,2495.4038,-1688.0726,13.5778);
	    SetPlayerInterior(playerid,0);
	    SetPlayerVirtualWorld(playerid,0);
	    SetPlayerFacingAngle(playerid, 358.4357);
	}
	else if(pickupid == gangenter[7]) // pintu masuk alur
	{
        SetPlayerPos(playerid,1371.6512,85.6622,1024.0400);
	    SetPlayerInterior(playerid,3);
	    SetPlayerVirtualWorld(playerid,891);
	    SetPlayerFacingAngle(playerid, 2.0701);
	}
 	else if(pickupid == gangenter[8]) // ballas keluar
	{
        SetPlayerPos(playerid,2000.1888,-1117.2360,26.7813);
	    SetPlayerInterior(playerid,0);
	    SetPlayerVirtualWorld(playerid,0);
	    SetPlayerFacingAngle(playerid, 179.0305);
	}
	else if(pickupid == gangenter[9]) // pintu masuk ballas
	{
        SetPlayerPos(playerid,1371.6512,85.6622,1024.0400);
	    SetPlayerInterior(playerid,2);
	    SetPlayerVirtualWorld(playerid,850);
	    SetPlayerFacingAngle(playerid,2.0701);
	}
   	for(new b; b < TotalBizz; b++)
	{
		if(pickupid == BizzInfo[b][bPickupHeal])
		{
			if(PlayerInfo[playerid][pCash] < 500) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki $500.");
		    new Float:health;
    		GetPlayerHealth(playerid, health);
		    if(health > 90) return Send(playerid, 0xafafafff, "Anda tidak perlu perawatan.");
		    SetPlayerHealthEx(playerid, 100);
			GivePlayerMoneyEx(playerid, -500, "perawatan dalam bisnis");
			GiveBusinessMoney(b, 500);
			break;
		}
	}
	if(player_enter_home[playerid] != -1)
	{
		for(new i; i < MAX_HOUSES; i++)
		{
			if(pickupid == HouseInfo[i][hAreaHeal])
			{
			    if(HouseInfo[i][hHel] <= 0) return Send(playerid, -1, "Tidak ada kotak P3K di rumah ini, Anda dapat membelinya di toko 24/7");
				format(String, 128, ""W"Anda yakin ingin menggunakan lemari obat di rumah?\nKotak P3K: {33AA33}%d pcs.", HouseInfo[i][hHel]);
				SPD(playerid, 36, DIALOG_STYLE_MSGBOX, "Kotak P3K", String, "Ya", "Tidak");
				return SetPVarInt(playerid, "UseHealHome", i);
		    }
	   	}
 	}

	if(pickupid == zavodd[0]) {
	    SetPlayerInterior(playerid,2);
	    SetPlayerPos(playerid, 2575.1619,-1292.2260,1044.1250);
	}
	else if(pickupid == zavodd[1]) {
	    if(player_job[playerid] == 3)
		{
			player_job[playerid] = 0;
			DeletePVar(playerid,"Metall");
			if(PlantObject[playerid] != -1)
			{
				DestroyObject(PlantObject[playerid]);
				PlantObject[playerid] = -1;
			}
			RemovePlayerAttachedObject(playerid, 0);
			SendClientMessage(playerid, 0xB4B5B7FF, "Anda meninggalkan pabrik dan dibiarkan tanpa gaji");
			if(IsPlayerAttachedObjectSlotUsed(playerid,1)) RemovePlayerAttachedObject(playerid,1);
			if(IsPlayerAttachedObjectSlotUsed(playerid,2)) RemovePlayerAttachedObject(playerid,2);
			DeletePVar(playerid,"CHECKPOINTID");
			DisablePlayerCheckpoint(playerid);
			DeletePVar(playerid,"JobMoney");
			SetPlayerSkinEx(playerid,PlayerInfo[playerid][pSkin]);
		}
	    SetPlayerInterior(playerid,0);
	    SetPlayerPos(playerid, -1007.6013,-692.5248,32.0078);
	}
	else if(pickupid == mayor_jobs) {
	    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
	    SPD(playerid,228,DIALOG_STYLE_LIST,"Berkelanjutan online","{ffffff}1. Pengemudi Buldoser [level 2]\n2. Sopir bus [level 2]\n3. Pembersih jalan [level 3]\n4. Pengemudi truk sampah [level 5]\n5. Kolektor [level 6]\n6. Penangan kontainer [level 6]\n7. Pengemudi truk [level 7]\n8. Pilot [level 9]","Tenang","Batalkan");
	}
	return 1;
}
public OnPlayerPickUpPickup(playerid, pickupid)
{
    printf("[PICKUP] %s[%i]: %i / %i", GetPlayerNameEx(playerid), playerid, _:pickupid, _:ac_pickups[playerid][0]);

	if(pickupid == mayor_enters[0]) SetPPos(playerid, 1462.6122,-1805.4554,33.4243,205.6409, 0, 0, false);
    if(pickupid == mayor_enters[1]) SetPPos(playerid, 1387.3358,-20.8174,1000.9287,269.0969, 3, 2, true);
    if(pickupid == mayor_enters[2])
	{
	    if(PlayerInfo[playerid][pMember] != FRACTION_MAYOR && !IsACop(playerid) && !IsAArmy(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki akses.");
		SetPPos(playerid, 1395.3113,-21.6393,2000.9967,2.7168, 3, 2, true);
	}
	if(pickupid == mayor_enters[3]) SetPPos(playerid, 1383.1571,-36.0661,1000.9287,271.3943, 3, 2, true);
	
	if(pickupid == buycom)
	{
        SPD(playerid, 5555, DIALOG_STYLE_LIST, "Pembelian Component", "1. 5 Component\t{00FF00}Rp.100.000\n2. 50 Component\t{00FF00}Rp.1.000.000\n3. 100 Component\t{00FF00}Rp.5.000.000", "Beli", "Batal");
    }
	if(pickupid == lshosp_pickups) SetPPos(playerid, 1153.7563,-1323.3326,-2.7189,4.3646, 8, 6, true);
	if(pickupid == sfhosp_pickups[2]) SetPPos(playerid, -642.7250,-918.5214,1436.1736,4.3646, 8, 8, true);
	if(pickupid == lvhosp_pickups[2]) SetPPos(playerid, -642.7250,-918.5214,1436.1736,4.3646, 8, 9, true);

	if(pickupid == lshosp_roof_pickup)
	{
		if(CheckHospitalHealth(playerid)) return 1;

		switch(GetPlayerVirtualWorld(playerid))
		{
		    case 6: SetPPos(playerid, 1161.4312,-1326.3079,31.4985,2.8989, 0, 0, false);
		    case 8: SetPPos(playerid, -2727.6323,624.7358,33.2969,180.7024, 0, 0, false);
		    case 9: SetPPos(playerid, 1606.6919,1789.0757,30.4688,1.6141, 0, 0, false);
		}
	}

	if(pickupid == ship_enter_pickups[0] && ship_pos_id == 3) SetPlayerPos(playerid, 2550.4058,-2652.4631,5.7499);
	if(pickupid == ship_enter_pickups[1] && ship_pos_id == 6) SetPlayerPos(playerid, 2589.5679,-3797.1455,5.7499);

	if(election_status)
	{
		if(pickupid == elecation_enter[0]) SetPPos(playerid, 1387.9913,-21.2610,2001.4272,97.5509, 5, 5, true);
		if(pickupid == elecation_enter[1]) SetPPos(playerid, 1400.4969,-35.9991,1000.9287,92.4609, 3, 2, true);
	}

    if(pickupid == mayor_ammo)
	{
	    if(GetPVarInt(playerid, "take_mats"))
	    {
	        new m_id = FRACTION_MAYOR;

	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000)
				return SCM(playerid, COLOR_GREY, "Sudah ada banyak persediaan amunisi.");

	        SCM(playerid, COLOR_GREEN, "Kamu menaruh amunisi di gudang Balai Kota.");
	        SCMF(playerid, -1, "Status gudang: %i/100000", FracInfo[m_id][fBank][0]);

	        FracInfo[m_id][fBank][0] += 250;
	        FracInfo[m_id][fBank][1] += 250;

	        return RemovePlayerAmmoBox(playerid);
	    }

	    if(PlayerInfo[playerid][pMember] != FRACTION_MAYOR)
	        return SCM(playerid, COLOR_GREY, "Anda tidak memiliki akses ke gudang ini.");

	    if(!(1 <= PlayerInfo[playerid][pRank] <= 2)) return SCM(playerid, COLOR_GREY, "Hanya dapat diakses oleh penjaga keamanan.");

	    ShowPlayerAmmoDialog(playerid);
	}

	if(pickupid == sfpd_ammo)
	{
	    if(GetPVarInt(playerid, "take_mats"))
	    {
	        new m_id = FRACTION_SFPD;

	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000)
				return SCM(playerid, COLOR_GREY, "Sudah ada banyak persediaan amunisi.");

	        SCM(playerid, COLOR_GREEN, "Anda menaruh amunisi di gudang SFPD.");
	        SCMF(playerid, -1, "Status gudang: %i/100000", FracInfo[m_id][fBank][0]);

	        FracInfo[m_id][fBank][0] += 250;
	        FracInfo[m_id][fBank][1] += 250;

	        return RemovePlayerAmmoBox(playerid);
	    }

	    if(PlayerInfo[playerid][pMember] != FRACTION_SFPD)
	        return SCM(playerid, COLOR_GREY, "Anda tidak memiliki akses ke gudang ini.");

	    ShowPlayerAmmoDialog(playerid);
	}

	if(pickupid == lvpd_ammo)
	{
	    if(GetPVarInt(playerid, "take_mats"))
	    {
	        new m_id = FRACTION_LVPD;

	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000)
				return SCM(playerid, COLOR_GREY, "Sudah ada banyak persediaan amunisi.");

	        SCM(playerid, COLOR_GREEN, "Anda menaruh amunisi di gudang LVPD.");
	        SCMF(playerid, -1, "Status gudang: %i/100000", FracInfo[m_id][fBank][0]);

	        FracInfo[m_id][fBank][0] += 250;
	        FracInfo[m_id][fBank][1] += 250;

	        return RemovePlayerAmmoBox(playerid);
	    }

	    if(PlayerInfo[playerid][pMember] != FRACTION_LVPD)
	        return SCM(playerid, COLOR_GREY, "Anda tidak memiliki akses ke gudang ini.");

	    ShowPlayerAmmoDialog(playerid);
	}

	if(pickupid == fbi_ammo)
	{
	    if(GetPVarInt(playerid, "take_mats"))
	    {
	        new m_id = FRACTION_FBI;

	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000)
				return SCM(playerid, COLOR_GREY, "Sudah ada banyak persediaan amunisi.");

	        SCM(playerid, COLOR_GREEN, "Anda menempatkan amunisi di gudang FBI.");
	        SCMF(playerid, -1, "Status Stok: %i/100000", FracInfo[m_id][fBank][0]);

	        FracInfo[m_id][fBank][0] += 250;
	        FracInfo[m_id][fBank][1] += 250;

	        return RemovePlayerAmmoBox(playerid);
	    }

	    if(PlayerInfo[playerid][pMember] != FRACTION_FBI)
	        return SCM(playerid, COLOR_GREY, "Anda tidak memiliki akses ke gudang ini..");

	    ShowPlayerAmmoDialog(playerid);
	}

    if(pickupid == sfpd_pickups[0]) SetPPos(playerid,216.4706,120.8032,999.0156,271.5949, 10, 2, false);
    if(pickupid == sfpd_pickups[1]) SetPPos(playerid,-1591.7317,716.3325,-5.2422,269.8219, 0, 0, false);
    if(pickupid == sfpd_pickups[2]) SetPPos(playerid,246.2745,110.5266,1003.2188,1.8333, 10, 2, false);
    if(pickupid == sfpd_pickups[3]) SetPPos(playerid,-1606.0498,716.4554,12.0750,1.0646, 0, 0, false);
    if(pickupid == sfpd_pickups[4]) SetPPos(playerid, 316.3870,-168.2380,999.5938,359.8360, 6, 7, false);
    if(pickupid == sfpd_pickups[5]) SetPPos(playerid, -1606.2729,675.0623,-5.2422,3.4274, 0, 0, false);

    if(pickupid == lvpd_pickups[0]) SetPPos(playerid,238.6655,141.8196,1003.0234,359.0121, 3, 8, false);
    if(pickupid == lvpd_pickups[1]) SetPPos(playerid,2292.3699,2451.3799,10.8203,88.6744, 0, 0, false);
    if(pickupid == lvpd_pickups[2]) SetPPos(playerid,289.0522,170.9561,1007.1794,1.1440, 3, 8, false);
    if(pickupid == lvpd_pickups[3]) SetPPos(playerid,2337.5764,2455.3809,14.9688,115.9530, 0, 0, false);
    if(pickupid == lvpd_pickups[4])
    {
        SPD(playerid, 5126, DIALOG_STYLE_LIST, "Pilih tempat", "- Gudang senjata\n- Atap", "Pilih", "Tutup");
    }
    if(lvpd_pickups[5] <= pickupid <= lvpd_pickups[6]) SetPPos(playerid, 2292.4429,2468.9202,10.8203,88.8389, 0, 0, false);

    if(pickupid == sfhosp_pickups[0]) SetPPos(playerid,-643.034,-899.383,1436.17,181.046, 8, 8, false);
    if(pickupid == sfhosp_pickups[1])
	{
	    if(CheckHospitalHealth(playerid)) return 1;

		SetPPos(playerid,-2655.4536,635.1159,14.4531,181.8861, 0, 0, false);
	}

    if(pickupid == lvhosp_pickups[0]) SetPPos(playerid,-643.034,-899.383,1436.17,181.046, 8, 9, false);
    if(pickupid == lvhosp_pickups[1])
	{
	    if(CheckHospitalHealth(playerid)) return 1;

		SetPPos(playerid,1606.9171,1818.9822,10.8203,2.0018, 0, 0, false);
	}

	if(pickupid == yakuza_enter[0]) SetPPos(playerid,2533.4961,-1286.0798,2054.6406,271.1607, 1, 1, false);
	if(pickupid == yakuza_enter[1]) SetPPos(playerid,2631.2766,1824.2800,11.0234,89.0400, 0, 0, false);

	if(pickupid == mechanik_enter[0]) SetPPos(playerid,2533.4961,-1286.0798,2054.6406,271.1607, 1, 2, false);
	if(pickupid == mechanik_enter[1]) SetPPos(playerid,939.3159,1733.3010,8.8516,271.7543, 0, 0, false);

	if(pickupid == rm_enter[0]) SetPPos(playerid,2533.4961,-1286.0798,2054.6406,271.1607, 1, 3, false);
	if(pickupid == rm_enter[1]) SetPPos(playerid,1458.1165,2773.3064,10.8203,270.2503, 0, 0, false);

	if(pickupid == pd_enter_pickup) SetPPos(playerid,860.032, -2085.93, 1003.50, 180.066, 6, 1, false);

    if(pickupid == warehouse_pickup[0]) SetPPos(playerid,1979.0916,-2025.3134,1019.5756,181.5865, 1, 1, true);
	if(pickupid == warehouse_pickup[1]) SetPPos(playerid,1940.0271,-2068.1433,13.5427,272.4800, 0, 0, false);

	if(pickupid == stash_pickup[0]) SetPPos(playerid,318.5356,1115.9697,1083.8828,0.4612, 5, 1, true);
	if(pickupid == stash_pickup[1]) SetPPos(playerid,869.7160,-26.2785,63.8801,222.2349, 0, 0, false);

    if(wh_army_pickup[0] <= pickupid <= wh_army_pickup[2])
    {
        if(form_fraction[playerid] != PlayerInfo[playerid][pMember]) return 1;

        new m_id = -1;

		switch(GetPlayerVirtualWorld(playerid))
		{
		    case 3: m_id = FRACTION_ARMY_LS;
		    case 5: m_id = FRACTION_ARMY_LV;
		    case 2: m_id = FRACTION_ARMY_SF;
		}

        if(GetPVarInt(playerid, "take_mats"))
	    {
	        if(FracInfo[m_id][fBank][0] + 250 > 200000 || FracInfo[m_id][fBank][1] + 250 > 200000)
				return SCM(playerid, COLOR_GREY, "Sudah ada banyak persediaan amunisi.");

	        SCM(playerid, COLOR_GREEN, "Anda menempatkan amunisi di gudang tentara.");

	        FracInfo[m_id][fBank][0] += 250;
	        FracInfo[m_id][fBank][1] += 250;

	        UpdateArmyWarehouse3D(m_id);

	        return RemovePlayerAmmoBox(playerid);
	    }
	    new limit = GetPlayerBackpackLimit(playerid);

		if(PlayerInfo[playerid][pPatron] >= limit && PlayerInfo[playerid][pMetall] >= limit) return SCM(playerid, COLOR_GREY, "Anda memiliki kantong penuh.");

        new rand_ammo = PlayerInfo[playerid][pPatron] >= limit ? limit - PlayerInfo[playerid][pPatron] : 1 + random(4);
        new rand_weapon = PlayerInfo[playerid][pMetall] >= limit ? limit - PlayerInfo[playerid][pMetall] : 2 + random(3);

        static string[64], str[32];

        string = "";

        if(FracInfo[m_id][fBank][0] > rand_weapon && PlayerInfo[playerid][pMetall] + rand_weapon < limit) //Logam
        {
	    	if(!IsAArmy(playerid)) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk tentara.");
            PlayerInfo[playerid][pMetall] += rand_weapon;
            FracInfo[m_id][fBank][0] -= rand_weapon;

            format(str, 32, "~n~~y~gun unit: +%i", rand_weapon);
        	strcat(string, str);
        }

        if(FracInfo[m_id][fBank][1] > rand_ammo && PlayerInfo[playerid][pPatron] + rand_ammo < limit) //Cartridge
        {
	    	if(!IsAArmy(playerid)) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk tentara.");
            PlayerInfo[playerid][pPatron] += rand_ammo;
            FracInfo[m_id][fBank][1] -= rand_ammo;

            format(str, 32, "~n~~b~ammo: +%i", rand_ammo);
        	strcat(string, str);
        }

		GameTextForPlayer(playerid, str, 1200, 4);

		UpdateArmyWarehouse3D(m_id);
    }

    if(ac_pickups[playerid][0] == pickupid) return 0;

	ac_pickups[playerid][0] = pickupid;
	GetPlayerPos(playerid, PosPic[playerid][0][0], PosPic[playerid][0][1], PosPic[playerid][0][2]);

    if(pickupid == bm_pickup)
	{
        if(pData[playerid][pLevel] < 3) return Error(playerid, "Kamu Belom Cukup Umur Say.");

	    new Dstring[1280];
	    format(Dstring, sizeof(Dstring), "Weapon\tLogam\n\
		Shotgun(ammo 50)\t100\n");
	    format(Dstring, sizeof(Dstring), "%sDesert Eagle(ammo 50)\t200\n", Dstring);
	    format(Dstring, sizeof(Dstring), "%sAK-47(ammo 50)\t350\n", Dstring);
	    format(Dstring, sizeof(Dstring), "%sMP5(ammo 50)\t500\n", Dstring);
	    Dialog(playerid, DIALOG_BM_GUN, DIALOG_STYLE_TABLIST_HEADERS, "Create Gun", Dstring, "Create", "Cancel");
	}

    if(pickupid == elecation_bulletin)
	{
	    if(PlayerInfo[playerid][pLevel] < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari level 2.");

	    if(PlayerInfo[playerid][pElecVote]) return SCM(playerid, COLOR_GREY, "Anda sudah memberikan suara.");
	    if(GetPVarInt(playerid, "can_vote")) return SCM(playerid, COLOR_GREY, "Anda sudah menerima buletin.");

		SetPVarInt(playerid, "can_vote", 1);

		SCM(playerid, COLOR_GREEN, "Anda mengambil buletin.");
	}

	if(pickupid == elecation_vote)
	{
        if(!GetPVarInt(playerid, "can_vote")) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki buletin.");

        new str[64], count = 0;

		String = "";

		for(new i; i < MAX_ELECATIONS; i++)
		{
		    if(strlen(elecation_info[i][e_name]) < 4) continue;

		    format(str, 64, "%i. %s\t%s\n", i + 1, elecation_info[i][e_name], elecation_info[i][e_owner]);
		    strcat(String, str);

		    SetPlayerListitemValue(playerid, count++, i);
		}

		return SPD(playerid, 3481, DIALOG_STYLE_TABLIST, "Daftar pesta", String, "Pilih", "Tutup");
	}

    if(pickupid == docsteal_quest_pickup)
	{
	    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_DOCSTEAL && player_quest_info[playerid][quest_status] == 1)
        {
            SPD(playerid, 8818, DIALOG_STYLE_LIST, "Daftar dokumen transportasi", "Voodoo\nPerenniel\nEsperanto\nOceanic\nGlendale\nHermes\nVirgo\nMalavida \nBuccaneer", "Untuk mengambil", "Tutup");
        }
	}

	for(new h; h < MAX_HOUSES; h++)
	{
    	if(pickupid != HouseInfo[h][hPickup]) continue;

		if(player_rob_id[playerid] != -1 && HouseInfo[h][hLock] == 1)
		{
		    new rob_id = player_rob_id[playerid];

			new h_id = rob_info[rob_id][r_house];

			if(h_id == h) return SCM(playerid, COLOR_GREEN, "Tahan dan tahan tombol ALT untuk mulai mendobrak pintu.");
		}

	    new klass[16];
		switch(HouseInfo[h][hKlass])
		{
			case 0: klass = "Kelas rendah";
		    case 1: klass = "Kelas menengah";
		    case 2: klass = "Kelas tinggi";
		    case 3: klass = "Kelas atas";
		    case 4: klass = "Rumah mewah";
		    case 5: klass = "Rumah VIP";
		}

		SetPVarInt(playerid, "house_want_enter", h);

  		if(HouseInfo[h][hOwned])
		{
			format(String, 344, ""W"Pemilik:\t{01FCFF}%s\n"W"Nomor rumah:\tNo.%d\n\nTipe rumah:\t%s\nBiaya:\t%d$\nSewa:\t%d$/hari", HouseInfo[h][hOwner], h, klass, HouseInfo[h][hValue], HouseInfo[h][hTakings]);
			SPD(playerid,9,DIALOG_STYLE_MSGBOX, "Rumah itu sibuk", String, "Masuk", "Batalkan");
		}
		else
		{
			format(String, 244, ""W"Anda yakin ingin membeli rumah ini?\n\nBiaya: %d$\nSewa harian: %d$", HouseInfo[h][hValue], HouseInfo[h][hTakings]);
			SPD(playerid,13,DIALOG_STYLE_MSGBOX,"Membeli rumah", String, "Ya","Tidak");
		}

		return 1;
	}

	//
	if(Cloakroom[0] <= pickupid <= Cloakroom[sizeof Cloakroom - 1])
	{
		if(pickupid == Cloakroom[0] && PlayerInfo[playerid][pMember] != FRACTION_LSPD) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota LSPD");
		if(pickupid == Cloakroom[1] && PlayerInfo[playerid][pMember] != FRACTION_FBI) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota FBI");
		if(pickupid == Cloakroom[2] && PlayerInfo[playerid][pMember] != FRACTION_ARMY_LS) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota CB");
		if(pickupid == Cloakroom[3] && PlayerInfo[playerid][pMember] != FRACTION_MAYOR) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota Pemerintah");
		if(pickupid == Cloakroom[4] && PlayerInfo[playerid][pMember] != FRACTION_NEWS) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota Penyiar Radio");
        if(pickupid == Cloakroom[5] && PlayerInfo[playerid][pMember] != FRACTION_ARMY_SF) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota Angkatan Laut");
        if(pickupid == Cloakroom[6] && PlayerInfo[playerid][pMember] != FRACTION_ARMY_LV) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota Darat");
        if(pickupid == Cloakroom[7] && PlayerInfo[playerid][pMember] != FRACTION_SFPD) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota SFPD");
        if(pickupid == Cloakroom[8] && PlayerInfo[playerid][pMember] != FRACTION_LVPD) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota LVPD");
        if(pickupid == Cloakroom[9] && PlayerInfo[playerid][pMember] != FRACTION_SFMEDICS) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota Dokter SF");
        if(pickupid == Cloakroom[10] && PlayerInfo[playerid][pMember] != FRACTION_LVMEDICS) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota Dokter LV");
        if(pickupid == Cloakroom[11] && PlayerInfo[playerid][pMember] != FRACTION_LSMEDICS) return Send(playerid,COLOR_GREY,!"Kamu Bukan Anggota Dokter LS");
        if(pickupid == Cloakroom[12] && PlayerInfo[playerid][pMember] != FRACTION_PEDAGANG) return Send(playerid,COLOR_YELLOW,!"Anda bukan Anggota Pedagang");
        if(pickupid == Cloakroom[13] && PlayerInfo[playerid][pMember] != FRACTION_MECHANIK) return Send(playerid,COLOR_YELLOW,!"Anda bukan Anggota mekanik");

		return SPD(playerid,163,DIALOG_STYLE_MSGBOX, "Tempat Ganti", "{FFFFFF}Pilih Pakaian", "Dinas", "Biasa");
	}
	else if(pickupid == pizza_work_pickup)
	{
	    if(PlayerInfo[playerid][pJob] != 0) return SCM(playerid, COLOR_GREY, "Mulailah dengan memulai /leave");

        pizza_player_house[playerid] = -1;

	    PlayerInfo[playerid][pJob] = WORK_TYPE_PIZZA;

	    SCM(playerid, -1, "Anda telah berhasil menjadi pengantar pizza");
	    SCM(playerid, 0xa86cfcff, "? {FFCC00}[Petunjuk]: {ffffff}Kepala ke halaman belakang dan ambil pizza.");
	}
	else if(pickupid == pizza_take_pickup)
	{
	    if(PlayerInfo[playerid][pJob] != WORK_TYPE_PIZZA) return SCM(playerid, COLOR_GREY, "Anda tidak bekerja di restoran pizza.");

	    if(GetPVarInt(playerid, "take_pizza") == 1) return SCM(playerid, COLOR_GREY, "Anda sudah makan pizza.");

		if(GetPlayerSkin(playerid) != 155)
		{
		    SetPVarInt(playerid, "old_skin", GetPlayerSkin(playerid));
		    SetPlayerSkin(playerid, 155);
		}

	    SetPVarInt(playerid, "take_pizza", 1);

		SetPlayerAttachedObject(playerid, 4, 2814, 6, 0.0579, -0.0310, -0.1430, -108.9999, -13.1000, -2.0999, 1.0000, 1.0000, 1.0000);

        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);

	    SCM(playerid, -1, "Kamu dapat pizza, tekan ALT di dekat Vespa untuk meletakkannya.");
	    SCM(playerid, -1, "Jika Anda ingin membuang pizza, gunakan cmd: /drop");
	}

	for(new h; h < TotalBizz; h++)
	{
	    if(pickupid != BizzInfo[h][bPickup]) continue;

		if(PlayerToPoint(2.0,playerid,BizzInfo[h][bBarX],BizzInfo[h][bBarY],BizzInfo[h][bBarZ]) && GetPlayerVirtualWorld(playerid) == BizzInfo[h][bVirtualWorld])
		{
		    player_use_bizbar[playerid] = h;
			switch(BizzInfo[h][bType])
			{
			    case 1: PC_EmulateCommand(playerid, "/drink");
			    case 2: PC_EmulateCommand(playerid, "/eat");
			    case 3,7: PC_EmulateCommand(playerid, "/buy");
			    case 5: PC_EmulateCommand(playerid, "/lease");
			    case 6: PC_EmulateCommand(playerid, "/clothes");
			    case 8: ShowPlayerBizzAmmoMenu(playerid);
			    case 23:
			    {
			        if(PlayerInfo[playerid][pLevel] < 1) return SCM(playerid, COLOR_GREY, "Tersedia dari level 1.");

			        if(pb_state != 1) return SCM(playerid, COLOR_GREY, "Pendaftaran saat ini ditutup.");

			        if(player_reg_pb[playerid] != -1) return SCM(playerid, COLOR_GREY, "Anda sudah terdaftar.");

                    if(PlayerInfo[playerid][pCash] < 2000) return SCM(playerid, COLOR_GREY, "diperlukan $2.000 untuk pendaftaran");

                    PlayerInfo[playerid][pCash] -= 2000;

                    GiveBusinessMoney(h, 500, 1);

                    pb_reward += 2000;

			        player_reg_pb[playerid] = pb_next_team;

			        pb_next_team = !pb_next_team;

			        SCMF(playerid, -1, "Anda terdaftar di Paint Ball, tim Anda: %s", player_reg_pb[playerid] ? ("Merah") : ("Biru"));
			    }
   			}
			return 1;
		}
	}
	for(new i = 1; i <= TotalEnters; i++)
	{
		if(pickupid == EntersInfo[i][pickPickup])
		{
		    switch(EntersInfo[i][pickID])
		    {
		        case 5: // Pembayaran Properti
				{
					new text[32], text1[36], text2[32];
					if(GetPlayerHouse(playerid) == -1) text = "{FF6C00}Tidak di rumah";
					else format(text, sizeof(text), "{36DE00}Nomor rumah%d", GetPlayerHouse(playerid));

					if(GetPlayerBizz(playerid) == -1) text1 = "{FF6C00}Tidak ada bisnis";
					else format(text1, sizeof(text1), "{36DE00}%s (No%d)", BizzInfo[GetPlayerBizz(playerid)][bMessage], GetPlayerBizz(playerid));

					if(GetPlayerABizz(playerid) == 0) text2 = "{FF6C00}Tidak ada pom bensin";
					else format(text2, sizeof(text2), "{36DE00}%s (No%d)", BizzAInfo[GetPlayerABizz(playerid)][aMessage], GetPlayerABizz(playerid));

				    format(String, 244, "{ffffff}1. Pembayaran rumah\t%s\n{ffffff}2. Pembayaran bisnis\t%s\n{ffffff}3. Pembayaran untuk pom bensin\t%s", text, text1, text2);
					SPD(playerid,107, DIALOG_STYLE_LIST,"Pembayaran Properti", String, "Pilih", "Keluar");
					ProxDetectorBot(20.0, player_enter_actors[playerid], "Halo! Apa yang ingin kamu bayar?",COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE5,COLOR_FADE5);
				}
				case 6:
				{
				    SetPlayerUseListitem(playerid, 0);

					MenuAtms(playerid);//BankDialog(playerid);
				}
				case 8: // karena rasa sakit
				{
					if(CheckHospitalHealth(playerid)) return 1;

					t_SetPlayerPos(playerid,EntersInfo[i][pickPosX], EntersInfo[i][pickPosY],EntersInfo[i][pickPosZ]), SetPlayerFacingAngle(playerid, EntersInfo[i][pickPosA]);
					SetPlayerInterior(playerid, EntersInfo[i][pickPosI]), SetPlayerVirtualWorld(playerid, EntersInfo[i][pickPosV]);
					SetCameraBehindPlayer(playerid);
					use_bd(playerid);
				}
				case 9:
				{
				    if(PlayerInfo[playerid][pJob] == 1) return Send(playerid, COLOR_GREY, "Anda sudah bekerja sebagai distributor makanan/bahan bakar. Gunakan /leave untuk berhenti.");

					format(format_string, sizeof(format_string), "Penempatan kerja: {09E097}Pengangkut Makanan/Bahan Bakar\n"W"Anda sekarang: %s\n\nAnda yakin ingin mendapatkan pekerjaan ini?", NamesJob(playerid));
					SPD(playerid, 152, DIALOG_STYLE_MSGBOX,"Penempatan kerja", format_string, "Ya", "Tidak");
				}
				case 20: return 1; //gudang tentara terpencil
 				case 23: // mats LSPD
				{
				    if(GetPVarInt(playerid, "take_mats"))
				    {
				        new m_id = FRACTION_LSPD;

				        if(FracInfo[m_id][fBank][0] + 250 > 100000 || FracInfo[m_id][fBank][1] + 250 > 100000)
							return SCM(playerid, COLOR_GREY, "Sudah ada banyak persediaan amunisi.");

				        SCM(playerid, COLOR_GREEN, "Anda menaruh amunisi di gudang LSPD.");
						SCMF(playerid, -1, "Status Stok: %i/100000", FracInfo[m_id][fBank][0]);

				        FracInfo[m_id][fBank][0] += 250;
				        FracInfo[m_id][fBank][1] += 250;

				        return RemovePlayerAmmoBox(playerid);
				    }

				    if(PlayerInfo[playerid][pMember] != 1) return Send(playerid, COLOR_GREY, "Hanya karyawan LSPD yang dapat menggunakan gudang..");

				    return ShowPlayerAmmoDialog(playerid);
	   			}
				/*case 18:
				{
				    format(String, sizeof(String), "1. Penciptaan keluarga\n2. Informasi\n3. Total keluarga di negara bagian: {fbec5d}%d", TotalFamily);
					SPD(playerid, 204, DIALOG_STYLE_LIST, "{E5D81E}Informasi Keluarga", String, "Pilihan", "Keluar");
					return 1;
				}*/
				case 25:
				{
				    if(player_news_live[playerid]) return SCM(playerid, COLOR_GREY, "Anda tidak dapat meninggalkan gedung saat di udara (/leave).");

				    SetPPos(playerid, EntersInfo[i][pickPosX], EntersInfo[i][pickPosY],EntersInfo[i][pickPosZ], EntersInfo[i][pickPosA], EntersInfo[i][pickPosI], EntersInfo[i][pickPosV], true);
				}
				default:
				{
				    SetPPos(playerid, EntersInfo[i][pickPosX], EntersInfo[i][pickPosY],EntersInfo[i][pickPosZ], EntersInfo[i][pickPosA], EntersInfo[i][pickPosI], EntersInfo[i][pickPosV], true);

					use_bd(playerid);
				}
      		}
			return true;
		}
	}
	return 1;
}

public OnVehicleMod(playerid, vehicleid, componentid)
{
    if(GetPlayerUseHomeCar(playerid) == -1) return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam transportasi pribadi.");

	SCMF(playerid, -1, "{33AA33}Komponen telah berhasil diinstal! "W"Judul: %s(ID: %d, Model: %s). {43CD80}Harga: %d$", VehicleComponent[componentid-1000][cType], VehicleComponent[componentid-1000][cID], VehicleComponent[componentid-1000][cName], VehicleComponent[componentid-1000][cCost]);
	return 1;
}

public OnVehiclePaintjob(playerid, vehicleid, paintjobid)
{
	//GetPlayerOwnableCar(playerid);
	if(vehicleid == INVALID_VEHICLE_ID)
	{
		if(GetPlayerUseHomeCar(playerid) == 0)
			return SendClientMessage(playerid, 0x999999FF, "Anda tidak memiliki transportasi pribadi");
		else
			return SendClientMessage(playerid, 0x999999FF, "Transportasi pribadi Anda tidak diunggah ke server");
	}

	if(vehicleid != GetPlayerVehicleID(playerid))
	return SendClientMessage(playerid, 0xCECECEFF, "Anda harus berada di kendaraan pribadi Anda");

	return 1;
}
public OnEnterExitModShop(playerid, enterexit, interiorid)
{
	return 1;
}
public OnVehicleRespray(playerid, vehicleid, color1, color2)
{
	new use_car = GetPlayerUseHomeCar(playerid);

    if(use_car == -1 || GetPlayerInterior(playerid) != 0) return 1;
    TuneCost[playerid] = 0, NewColor[playerid][0] = color1, NewColor[playerid][1] = color2;
	new bumper1 = GetVehicleComponentInSlot(use_car, CARMODTYPE_FRONT_BUMPER);
	new bumper2 = GetVehicleComponentInSlot(use_car, CARMODTYPE_REAR_BUMPER);
	new spoiler = GetVehicleComponentInSlot(use_car, CARMODTYPE_SPOILER);
	new nitro = GetVehicleComponentInSlot(use_car, CARMODTYPE_NITRO);
	new wheels = GetVehicleComponentInSlot(use_car, CARMODTYPE_WHEELS);
	new gydra = GetVehicleComponentInSlot(use_car, CARMODTYPE_HYDRAULICS);
	new hood = GetVehicleComponentInSlot(use_car, CARMODTYPE_HOOD);
	new roof = GetVehicleComponentInSlot(use_car, CARMODTYPE_ROOF);
	new sideskirt = GetVehicleComponentInSlot(use_car, CARMODTYPE_SIDESKIRT);
	new lamps = GetVehicleComponentInSlot(use_car, CARMODTYPE_LAMPS);
	new exhaust = GetVehicleComponentInSlot(use_car, CARMODTYPE_EXHAUST);
	new stereo = GetVehicleComponentInSlot(use_car, CARMODTYPE_STEREO);
	new v_right = GetVehicleComponentInSlot(use_car, CARMODTYPE_VENT_RIGHT);
	new v_left = GetVehicleComponentInSlot(use_car, CARMODTYPE_VENT_LEFT);

	new str[124];

	command_text = ""W"Tuning dipasang di mobil Anda:\n";

	if(CarInfo[playerid][cColor1][use_car]!=color1) TuneCost[playerid]+=5000, strcat(command_text,"\nWarna primer. Harga: 5000$");
	if(CarInfo[playerid][cColor2][use_car]!=color2) TuneCost[playerid]+=2500, strcat(command_text,"\nwarna komplementer. Harga: 2500$");
	if(CarInfo[playerid][cBumper1][use_car]!=bumper1) TuneCost[playerid]+=VehicleComponent[bumper1-1000][cCost], format(str,64,"\nBumper depan(%s). Harga: %i$",VehicleComponent[bumper1-1000][cName],VehicleComponent[bumper1-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cBumper2][use_car]!=bumper2) TuneCost[playerid]+=VehicleComponent[bumper2-1000][cCost], format(str,64,"\nBumper belakang(%s). Harga: %i$",VehicleComponent[bumper2-1000][cName],VehicleComponent[bumper2-1000][cCost]), strcat(command_text,str);
    if(CarInfo[playerid][cSpoiler][use_car]!=spoiler) TuneCost[playerid]+=VehicleComponent[spoiler-1000][cCost], format(str,64,"\nSpoiler(%s). Harga: %i$",VehicleComponent[spoiler-1000][cName],VehicleComponent[spoiler-1000][cCost]), strcat(command_text,str);
    if(CarInfo[playerid][cNitro][use_car]!=nitro) TuneCost[playerid]+=VehicleComponent[nitro-1000][cCost], format(str,64,"\nNitro(%s). Harga: %i$",VehicleComponent[nitro-1000][cName],VehicleComponent[nitro-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cWheels][use_car]!=wheels) TuneCost[playerid]+=VehicleComponent[wheels-1000][cCost], format(str,64,"\nDisk(%s). Harga: %i$",VehicleComponent[wheels-1000][cName],VehicleComponent[wheels-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cHydrawlic][use_car]!=gydra) TuneCost[playerid]+=VehicleComponent[gydra-1000][cCost], format(str,64,"\nHidraulik(%s). Harga: %i$",VehicleComponent[gydra-1000][cName],VehicleComponent[gydra-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cHood][use_car]!=hood) TuneCost[playerid]+=VehicleComponent[hood-1000][cCost], format(str,64,"\nBonnet(%s). Harga: %i$",VehicleComponent[hood-1000][cName],VehicleComponent[hood-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cRoof][use_car]!=roof) TuneCost[playerid]+=VehicleComponent[roof-1000][cCost], format(str,64,"\nAtap(%s. Harga: %i$",VehicleComponent[roof-1000][cName],VehicleComponent[roof-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cSideskirt][use_car]!=sideskirt) TuneCost[playerid]+=VehicleComponent[sideskirt-1000][cCost], format(str,64,"\nRok(%s). Harga: %i$",VehicleComponent[sideskirt-1000][cName],VehicleComponent[sideskirt-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cLamps][use_car]!=lamps) TuneCost[playerid]+=VehicleComponent[lamps-1000][cCost], format(str,64,"\nPerlengkapan(%s). Harga: %i$",VehicleComponent[lamps-1000][cName],VehicleComponent[lamps-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cExhaust][use_car]!=exhaust) TuneCost[playerid]+=VehicleComponent[exhaust-1000][cCost], format(str,64,"\nKnalpot(%s). Harga: %i$",VehicleComponent[exhaust-1000][cName],VehicleComponent[exhaust-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cStereo][use_car]!=stereo) TuneCost[playerid]+=VehicleComponent[stereo-1000][cCost], format(str,64,"\nStereo (%s). Harga: %i$",VehicleComponent[stereo-1000][cName],VehicleComponent[stereo-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cVentRight][use_car]!=v_right) TuneCost[playerid]+=VehicleComponent[v_right-1000][cCost], format(str,64,"\nVentilasi yang tepat(%s). Harga: %i$",VehicleComponent[v_right-1000][cName],VehicleComponent[v_right-1000][cCost]), strcat(command_text,str);
	if(CarInfo[playerid][cVentLeft][use_car]!=v_left) TuneCost[playerid]+=VehicleComponent[v_left-1000][cCost], format(str,64,"\nVentilasi kiri(%s). Harga: %i$",VehicleComponent[v_left-1000][cName],VehicleComponent[v_left-1000][cCost]), strcat(command_text,str);

	format(str,80,"\n\nBiaya penyimpanan semua komponen akan menjadi {43CD80}%i$",TuneCost[playerid]), strcat(command_text,str);
	format(str,80,""W"Klik 'Untuk membeli' untuk menyimpan penyetelan atau 'Tolak' untuk membatalkan.");

	if(TuneCost[playerid]) SPD(playerid,49,DIALOG_STYLE_MSGBOX,"Menyimpan tuning",command_text,"Untuk membeli","Tolak");
	return 1;
}

