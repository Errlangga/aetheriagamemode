        }
  		if(IsPlayerInRangeOfPoint(playerid, 10.0, 617.7245,1499.9868,8.2038))
        {
        callcmd::taruhminyak(playerid, "");
        }
		if(IsPlayerInRangeOfPoint(playerid, 10.0, 1939.4403,-1867.6506,13.8741))
