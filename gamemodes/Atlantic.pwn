	for(new i; i < sizeof(TxDBordasCell); i++) {
		TextDrawHideForPlayer(playerid, TxDBordasCell[i]);
	}
	PlayerTextDrawHide(playerid, TxDWhatsConvP[playerid][0]);
	PlayerTextDrawHide(playerid, TxDWhatsConvP[playerid][1]);

	for(new d; d < sizeof(WppIndexConv[]); d++){
		for(new e; e < sizeof(WppIndexConv[][]); e++) {
			PlayerTextDrawHide(playerid, WppIndexConv[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(WppIndexConv[]); d++){
		for(new e; e < sizeof(WppIndexConv[][]); e++) {
			PlayerTextDrawHide(playerid, WppIndexConv[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(TxDConvDir[]); d++){
		for(new e; e < sizeof(TxDConvDir[][]); e++) {
			PlayerTextDrawHide(playerid, TxDConvDir[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(TxDConvEsq[]); d++){
		for(new e; e < sizeof(TxDConvEsq[][]); e++) {
			PlayerTextDrawHide(playerid, TxDConvEsq[playerid][d][e]);
		}
	}
	for(new i; i < sizeof(TxDWhatsConv); i++){
		TextDrawHideForPlayer(playerid, TxDWhatsConv[i]);
	}
	for(new i; i < sizeof(TxDWhatsIndex); i++)
	{
		TextDrawHideForPlayer(playerid, TxDWhatsIndex[i]);
		PlayerTextDrawHide(playerid, TxDWhatsIndext[playerid][0]);
	}
    //
    CancelSelectTextDraw(playerid);
    return 1;
}
static stock AbrirConversa(playerid, nick_criador[], nick_wpp[])
{
	for(new d; d < sizeof(WppIndexConv[]); d++)
	{
		for(new e; e < sizeof(WppIndexConv[][]); e++)
		{
			PlayerTextDrawHide(playerid, WppIndexConv[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(TxDConvDir[]); d++)
	{
		for(new e; e < sizeof(TxDConvDir[][]); e++)
		{
			PlayerTextDrawHide(playerid, TxDConvDir[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(TxDConvEsq[]); d++)
	{
		for(new e; e < sizeof(TxDConvEsq[][]); e++)
		{
			PlayerTextDrawHide(playerid, TxDConvEsq[playerid][d][e]);
		}
	}
	for(new i; i < sizeof(TxDWhatsIndex); i++)
	{
		TextDrawHideForPlayer(playerid, TxDWhatsIndex[i]);
		PlayerTextDrawHide(playerid, TxDWhatsIndext[playerid][0]);
	}
	for(new i; i < sizeof(TxDWhatsConv); i++)
	{
		TextDrawShowForPlayer(playerid, TxDWhatsConv[i]);
	}
	new BigStrBra[500];
	format(BigStrBra, sizeof BigStrBra, "SELECT * FROM `mensagens` WHERE (`de` = '%s' AND `para` = '%s') OR (`de` = '%s' AND `para` = '%s') ORDER BY `gettime` DESC limit 4", nick_criador, nick_wpp, nick_wpp, nick_criador);
	wppRes = db_query(WppDB, BigStrBra);
	new count = 3;
	new index_Conv = GetPVarInt(playerid, "Conversa_Aberta_Index");

	if(!strcmp(InfoWppPagina[playerid][index_Conv][wCriador], NP(playerid)))
	{
	    new online;
   		new statusonl[28];
    	cache_get_value_int(0, "pLogin", online);
		if(online == 0) statusonl = "Online";
		else statusonl = "Offline";
		new string[1028];
		format(string, sizeof(string), "%s", statusonl);
		PlayerTextDrawSetString(playerid, TxDWhatsConvP[playerid][0], InfoWppPagina[playerid][index_Conv][wNick]);
		PlayerTextDrawSetString(playerid, TxDWhatsConvP[playerid][1], string);
		//
		PlayerTextDrawShow(playerid, TxDWhatsConvP[playerid][0]);
		PlayerTextDrawShow(playerid, TxDWhatsConvP[playerid][1]);
	}
	else
	{
		PlayerTextDrawSetString(playerid, TxDWhatsConvP[playerid][0], InfoWppPagina[playerid][index_Conv][wCriador]);
		//
		PlayerTextDrawShow(playerid, TxDWhatsConvP[playerid][0]);
		PlayerTextDrawShow(playerid, TxDWhatsConvP[playerid][1]);
	}
	if(db_num_rows(wppRes)) {

		do {
			new de[24],
			para[24],
			data[64],
			msg[120];
			db_get_field_assoc(wppRes, "de", de, (24 + 1));
			db_get_field_assoc(wppRes, "para", para, (24 + 1));
			db_get_field_assoc(wppRes, "data",data, 63 + 1);
			db_get_field_assoc(wppRes, "mensagem", msg, 119 + 1);
			new
			len = strlen(msg),
			len2 = strlen(msg);
			new count2 = 0;
			while(len--) {
				switch(msg[len]) {
					case ' ': msg[len] = '_';
				}
			}
			for(new idx3 = 0; idx3 < len2; idx3++) {

				if(count2 >= 27) {

					strins(msg, "~n~", idx3);
					count2 = 0;
					continue;
				}
				count2++;
			}

			if(strlen(msg) >= 60)
			{
				strdel(msg, 60, strlen(msg));
				strins(msg, "...", 60);
			}

			if(!strcmp(de, NP(playerid)))
			{
				PlayerTextDrawSetString(playerid, TxDConvDir[playerid][count][1], msg);
				PlayerTextDrawSetString(playerid, TxDConvDir[playerid][count][2], data);

				for(new dd; dd < sizeof(TxDConvDir[][]); dd++)
				{
					PlayerTextDrawShow(playerid, TxDConvDir[playerid][count][dd]);
				}
				SelectTextDraw(playerid, 0xC0C0C0FF);
			}
			else
			{
				PlayerTextDrawSetString(playerid, TxDConvEsq[playerid][count][1], msg);
				PlayerTextDrawSetString(playerid, TxDConvEsq[playerid][count][2], data);

				for(new dd; dd < sizeof(TxDConvEsq[][]); dd++)
				{
					PlayerTextDrawShow(playerid, TxDConvEsq[playerid][count][dd]);
				}
				SelectTextDraw(playerid, 0xC0C0C0FF);
			}

			count--;
		}
		while(db_next_row(wppRes));
	}
	db_free_result(wppRes);
	return 1;
}
//comando de exemplo/uso do AbrirWhatsapp
CMD:whatsapp(playerid)
{
	if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki ponsel.");
    if(pData[playerid][pProgress] == 1) return Error(playerid, "Anda masih memiliki activity progress!");
    DeletePVar(playerid, "Conversa_Aberta_Index");
    AbrirWhatsapp(playerid);

    // PlayerTextDrawShow(playerid, PlayerText:a);
    return 1;
}
CMD:hwa(playerid)
{
	FecharWhatsapp(playerid);
	return 1;
}
CMD:shp(playerid)
{
	SimpanHp(playerid);
	return 1;
}

CMD:rtd(playerid)
{
	LoadingPlayerBar[playerid] = 0;
	ferchartd(playerid);
	return 1;
}
//comando para testes
CMD:wa(playerid, params[])
{
	//if(PlayerInfo[playerid][Admin] > 5) return true;
	new de[24], para[24], mensagem[100];
	if(sscanf(params, "s[24]s[24]s[100]", de, para, mensagem)) return Info(playerid, "Use: /teswa [Dari] [Ke] [pesan]");
	new
	len = strlen(mensagem);
	while(len--) {
		switch(mensagem[len]) {
			case ' ': mensagem[len] = '_';
		}
	}
	CriarMensagemWpp(playerid, de, para, mensagem);
	AbrirConversa(playerid, de, para);
	// FecharWhatsapp(playerid);
	return 1;
}
stock NP(playerid)
{
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof( name ));
    return name;
}
