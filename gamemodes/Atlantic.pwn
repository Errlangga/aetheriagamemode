CMD:resetgun(playerid, params[]) {
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	extract params -> new to_player; else return Send(playerid, -1, "USAGE: /resetgun [playerid]");
	if(!IsPlayerConnected(to_player)) return SCM(playerid, -1, "Pemain tidak konek!");
	if(!PlayerInfo[to_player][pLogin]) return SCM(playerid, COLOR_GREY, "Tidak ada pemain yang ditemukan!");
	format(format_string, 96, "[A] Administrator %s mereset senjata %s.", Name(playerid), Name(to_player));
	SendAdminMessage(COLOR_GREY, format_string);
	ResetWeapons(to_player);
	return 1;
}

CMD:checkgun(playerid, params[]) {
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	extract params -> new to_player; else return Send(playerid, -1, "USAGE: /checkgun [playerid]");
	if(!IsPlayerConnected(to_player)) return SCM(playerid, -1, "Pemain tidak konek!");
	if(!PlayerInfo[to_player][pLogin]) return SCM(playerid, COLOR_GREY, "Tidak ada pemain yang ditemukan!");
	SCMF(playerid, 0xFFFF00FF, "---- %s's guns ----", Name(to_player));
	for(new i; i < 13; i++) {
		GetPlayerWeaponData(to_player, i, PlayerInfo[to_player][pGun][i], PlayerInfo[to_player][pAmmo][i]);
		if(PlayerInfo[to_player][pGun][i] > 0) {
			SCMF(playerid, -1, "%s - %i ammo", GetWeaponNames(PlayerInfo[to_player][pGun][i]), PlayerInfo[to_player][pAmmo][i]);
		}
	}
	return 1;
}
CMD:use(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 4) return Error(playerid, "Anda harus level 4 untuk akses lemari ini.");
    for(new i = 0; i < sizeof(YogInfo); i++)
	{
		if(PlayerToPoint(3.0, playerid, YogInfo[i][YStoreX],YogInfo[i][YStoreY],YogInfo[i][YStoreZ]) && GetPlayerInterior(playerid) == YogInfo[i][YInt] && GetPlayerVirtualWorld(playerid) == YogInfo[i][YVw])
		{
			Dialog(playerid, 1053,DIALOG_STYLE_MSGBOX,
			"Lemari Barang",
			"{ffff00}PERHATIAN{ffffff}\n\
			Untuk Menyimpan Barang Dilemari Rumah\n\
			Pastikan Pintu Rumah Anda Selalu Terkunci Untuk Menghindari Pencurian",
			"Oke",""
			);
		}
    }
    return 1;
}
CMD:clemari(playerid, params[])
{
    if(PlayerInfo[playerid][pVip] < 3) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP GOLD");
    if(GetPlayerMoney(playerid) < 5500000) return SCM(playerid, COLOR_GREY, "Uang anda tidak cukup!");
    PlayerInfo[playerid][pCash] -= 5500000;
	GivePlayerMoney(playerid, -5500000);
	OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
 	SendClientMessage(playerid, COLOR_YELLOW, "[MVRP] Anda Telah Membuat Lemari ");
	GameTextForPlayer(playerid, "-5500000", 5000, 1);
	
	// new h_id = player_enter_home[playerid];
	new Float: YPos[3], string[254];
	new id = YogValid();
	GetPlayerPos(playerid, YPos[0], YPos[1], YPos[2]);
	IdYog[id] = 1;
	YogInfo[id][YStoreX] = YPos[0];
	YogInfo[id][YStoreY] = YPos[1];
	YogInfo[id][YStoreZ] = YPos[2];
	YogInfo[id][YVw] = GetPlayerVirtualWorld(playerid);
	YogInfo[id][YInt] = GetPlayerInterior(playerid);

	format(string, sizeof(string), "Lemari ID: %d\n{FFFFFF}Gunakan /use", id);
	YogInfo[id][YLabel] = CreateDynamic3DTextLabel(string, COLOR_YELLOW, YogInfo[id][YStoreX], YogInfo[id][YStoreY], YogInfo[id][YStoreZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, YogInfo[id][YVw], YogInfo[id][YInt]);
	SetPlayerPos(playerid, YPos[0], YPos[1], YPos[2]+1);
	SaveYog();
	return 1;
}
CMD:dlemari(playerid, params[])
{
	if(admin_level[playerid] < 3) return 1;
    if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Usage: /dlemari [id lemari]");
	new file[128];
    IdYog[params[0]] = 0;
    YogInfo[params[0]][YTshirt] = 0;
    YogInfo[params[0]][YDrugs] = 0;
    YogInfo[params[0]][YGun] = 0;
    YogInfo[params[0]][YAmmo] = 0;
    YogInfo[params[0]][YCompo] = 0;
	YogInfo[params[0]][YStoreX] = 0.0;
	YogInfo[params[0]][YStoreY] = 0.0;
	YogInfo[params[0]][YStoreZ] = 0.0;
    YogInfo[params[0]][YVw] = 0;
    YogInfo[params[0]][YInt] = 0;
    DestroyDynamic3DTextLabel(YogInfo[params[0]][YLabel]);
    SendClientMessage(playerid, COLOR_WHITE, "Berhasil Menghapus Lemari");
    SaveYog();
	format(file, sizeof(file), "YogLemari/%d.ini", params[0]);
	if(fexist(file)) fremove(file);
	return 1;
}
CMD:reviveall(playerid, params[])
{
    if(admin_level[playerid] < 1)
        return Info(playerid, "Anda Tidak Bisa Menggunakan Command Ini");

    foreach(new i : Player)
    {
        if(IsPlayerConnected(i))
        {
            if(PlayerInfo[i][pInjured] == 1)
            {
                update_int_mysql(i, "pInjured", 0);
                OnPlayerUpdateAccountsPer(i, "pInjured", 0);
                SetPlayerData(i, pInjured, 0);
                TogglePlayerControllable(i, 1);
                SetPlayerHealthEx(i, 100.0);
                ClearAnimations(i, 1);
                SetPlayerData(i, pDelayDeath, 0);
                update_int_mysql(i, "pDelayDeath", 0);
                format(String, 213, "Admin %s Telah Me Revive Semua Players", GetPlayerNameEx(playerid));
                PlayerTextDrawHide(i, DEATHTD[i][i]);
            }
        }
    }
    SendClientMessageToAll(COLOR_YELLOW, String);
    return 1;
}
CMD:setblood(playerid, params[])
{
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        SetPlayerHealth(i, 100);
    }
    SendClientMessageToAll(-1, "Semua darah player telah diubah oleh staff menjadi 100");
    return 1;
}

CMD:sethbeall(playerid, params[])
{
	if(admin_level[playerid] < 8) return 1;
	{
		new money;
		if(sscanf(params, "d", money)) return SendClientMessage(playerid, COLOR_WHITE, "USAGE: /sethbeall [amount]");

		foreach(Player, p)
		{
			PlayerInfo[p][pSatiety] = money;
			PlayerInfo[p][pThirst] = money;
			UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]);
			UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]);
			format(String, sizeof(String), "SERVER: {FFFFFF}Administrator %s telah mengubah status character kalian menjadi %d", PlayerInfo[playerid][pAname],money);
			SendClientMessage(p,COLOR_LIGHTBLUE,String);
		}
	}
	return 1;
}

epublic: DragUpdate(playerid, targetid)
{
    if(pData[targetid][pDragged] && pData[targetid][pDraggedBy] == playerid)
    {
        static
        Float:fX,
        Float:fY,
        Float:fZ,
        Float:fAngle;

        GetPlayerPos(playerid, fX, fY, fZ);
        GetPlayerFacingAngle(playerid, fAngle);

        fX -= 3.0 * floatsin(-fAngle, degrees);
        fY -= 3.0 * floatcos(-fAngle, degrees);

        SetPlayerPos(targetid, fX, fY, fZ);
        SetPlayerInterior(targetid, GetPlayerInterior(playerid));
        SetPlayerVirtualWorld(targetid, GetPlayerVirtualWorld(playerid));
        ApplyAnimation(targetid, "PED", "BIKE_fall_off", 4.1, 0, 1, 1, 1, 0, 1);
        //ApplyAnimation(targetid,"PED","WALK_civi",4.1,1,1,1,1,1);
    }
    return 1;
}
CMD:drag(playerid, params[])
{
    new otherid;
    if(sscanf(params, "u", otherid))
        return Usage(playerid, "/drag [playerid/PartOfName] || /undrag [playerid]");

    if(otherid == INVALID_PLAYER_ID)
        return Error(playerid, "Player itu Disconnect.");

    if(otherid == playerid)
        return Error(playerid, "Kamu tidak bisa menarik diri mu sendiri.");

    if(!NearPlayer(playerid, otherid, 5.0))
        return Error(playerid, "Kamu harus didekat Player.");
        
    if(pData[otherid][pPrison] != 0)
        return Error(playerid, "kamu tidak bisa drag orang yang di penjara.");
        
    if(pData[otherid][pInjured] == 0)
        return Error(playerid, "kamu tidak bisa drag orang yang tidak mati.");
    SendPlayerOffer(playerid, otherid, OFFER_TYPE_DRAG);
    SetPVarInt(otherid, "DragBy", playerid);
    Servers(otherid, "%s Telah menawari drag kepada anda, /accept drag untuk menerimanya /deny drag untuk membatalkannya.", ReturnName(playerid));
    Servers(playerid, "Anda berhasil menawari drag kepada player %s", ReturnName(otherid));
    return 1;
}

CMD:undrag(playerid, params[])
{
    new otherid;
    if(sscanf(params, "u", otherid)) return Usage(playerid, "/undrag [playerid]");
    if(pData[otherid][pDragged])
    {
        DeletePVar(playerid, "DragBy");
        DeletePVar(otherid, "DragBy");
        pData[otherid][pDragged] = 0;
        pData[otherid][pDraggedBy] = INVALID_PLAYER_ID;

        KillTimer(pData[otherid][pDragTimer]);
        format(String, 188, "** %s releases %s from their grip.", ReturnName(playerid), ReturnName(otherid));
        ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
    }
    return 1;
}
