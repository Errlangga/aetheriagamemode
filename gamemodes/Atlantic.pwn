CMD:delallado(playerid, params[])
{
    if(admin_level[playerid] < 2) return 1;

    SendClientMessage(playerid, 0xCECECEFF, "ADO Semua player dihapus!");
    SendClientMessageToAll(0xCECECEFF, "ADO: ADO Semua player dihapus oleh seorang admin!");
    foreach(new i : Player)
    {
        if(IsPlayerConnected(i))
        {
            DestroyDynamic3DTextLabel(PlayerInfo[i][pAdo]);
            adostatus[i] = 0;
        }
    }
    return 1;
}
