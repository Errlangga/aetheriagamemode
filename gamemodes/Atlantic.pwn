CMD:phone(playerid, params[])
{
    if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki ponsel.");
    if(pData[playerid][pProgress] == 1) return Error(playerid, "Anda masih memiliki activity progress!");
    for(new i = 0; i < 21; i++)
    {
		TextDrawShowForPlayer(playerid, PhoneTD[i]);
	}
	TextDrawShowForPlayer(playerid, FINGERPRINT);
	TextDrawShowForPlayer(playerid, TANGGAL);
	TextDrawShowForPlayer(playerid, JAMLOCKSCREEN);
	new dayc, monthc, yearc;
    getdate(yearc,monthc,dayc);
   	new string[256];
	format(string, sizeof string, "%02d %s %02d", dayc, GetMonthName(monthc), yearc);
	TextDrawSetString(TANGGAL, string);
	SelectTextDraw(playerid, COLOR_BLUE);
	PlayerPlaySound(playerid, 3600, 0,0,0);
	return 1;
}
CMD:togtw(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	new string[128], newTwStatus[128];
	if(!twStatus) {
		newTwStatus = "dibuka";
		twStatus = true;
	}
	else {
		newTwStatus = "ditutup";
		twStatus = false;
	}
	format(string, sizeof string, "[Twitter]: Twitter telah %s!", newTwStatus);
	SendClientMessageToAll(0x00C2ECFF, string);
	return 1;
}
// Vexy WPP
static stock ReloadWhatsapp(playerid, inicio, fim, bool:voltando = false) {
	for(new i; i < sizeof(TxDWhatsIndex); i++)
	{
		TextDrawShowForPlayer(playerid, TxDWhatsIndex[i]);
		PlayerTextDrawShow(playerid, TxDWhatsIndext[playerid][0]);
	}
	for(new d; d < sizeof(WppIndexConv[]); d++){
		for(new e; e < sizeof(WppIndexConv[][]); e++) {
			PlayerTextDrawHide(playerid, WppIndexConv[playerid][d][e]);
		}
	}
	new index = 0,
	contador = 0;
	for(new i = inicio; i < fim; i++)
	{
		if(index == 4){
			break;
		}
		if(!isnull(PaginacaoWppIndex[playerid][i][wCriador])) {
			if(!strcmp(PaginacaoWppIndex[playerid][i][wCriador], NP(playerid))) {
				//nick
				PlayerTextDrawSetString(playerid, WppIndexConv[playerid][index][3], PaginacaoWppIndex[playerid][i][wNick]);
				PlayerTextDrawSetString(playerid, WppIndexConv[playerid][index][4], PaginacaoWppIndex[playerid][i][wUltima_mensagem]);
				contador++;
				strmid(InfoWppPagina[playerid][index][wNick], PaginacaoWppIndex[playerid][i][wNick], 0, strlen(PaginacaoWppIndex[playerid][i][wNick]), 24);
				strmid(InfoWppPagina[playerid][index][wCriador], NP(playerid), 0, strlen(NP(playerid)), 24);

				strmid(InfoWppPagina[playerid][index][wUltima_mensagem], PaginacaoWppIndex[playerid][i][wUltima_mensagem], 0, strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]), 24);

			}
			else {
				// nick_criador
				PlayerTextDrawSetString(playerid, WppIndexConv[playerid][index][3], PaginacaoWppIndex[playerid][i][wCriador]);
				PlayerTextDrawSetString(playerid, WppIndexConv[playerid][index][4], PaginacaoWppIndex[playerid][i][wUltima_mensagem]);
				strmid(InfoWppPagina[playerid][index][wCriador], PaginacaoWppIndex[playerid][i][wCriador], 0, strlen(PaginacaoWppIndex[playerid][i][wCriador]), 24);
				strmid(InfoWppPagina[playerid][index][wNick], NP(playerid), 0, strlen(NP(playerid)), 24);
				strmid(InfoWppPagina[playerid][index][wUltima_mensagem], PaginacaoWppIndex[playerid][i][wUltima_mensagem], 0, strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]), 24);

				contador++;
			}
			for(new d; d < sizeof(WppIndexConv[][]); d++){
				PlayerTextDrawShow(playerid, WppIndexConv[playerid][index][d]);
			}

			index++;
		}
	}
	if(!voltando) CountPagIndexWpp[playerid] += contador;
	CountPagIndexWppVoltar[playerid] = contador;
	return 1;
}
static stock AbrirWhatsapp(playerid)
{
	/*for(new i; i < sizeof(TextdrawCelular[]); i++)
	{
		PlayerTextDrawHide(playerid, TextdrawCelular[playerid][i]);
	}*/
	for(new i; i < sizeof(TxDBordasCell); i++) {
		TextDrawShowForPlayer(playerid, TxDBordasCell[i]);
	}
	for(new i; i < sizeof(PaginacaoWppIndex[]); i++){
		PaginacaoWppIndex[playerid][i][wCriador][0] = EOS;
		PaginacaoWppIndex[playerid][i][wNick][0] = EOS;
		PaginacaoWppIndex[playerid][i][wUltima_mensagem][0] = EOS;
	}
	PlayerTextDrawHide(playerid, TxDWhatsConvP[playerid][0]);
	PlayerTextDrawHide(playerid, TxDWhatsConvP[playerid][1]);

	for(new d; d < sizeof(WppIndexConv[]); d++){
		for(new e; e < sizeof(WppIndexConv[][]); e++) {
			PlayerTextDrawHide(playerid, WppIndexConv[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(WppIndexConv[]); d++){
		for(new e; e < sizeof(WppIndexConv[][]); e++) {
			PlayerTextDrawHide(playerid, WppIndexConv[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(TxDConvDir[]); d++){
		for(new e; e < sizeof(TxDConvDir[][]); e++) {
			PlayerTextDrawHide(playerid, TxDConvDir[playerid][d][e]);
		}
	}
	for(new d; d < sizeof(TxDConvEsq[]); d++){
		for(new e; e < sizeof(TxDConvEsq[][]); e++) {
			PlayerTextDrawHide(playerid, TxDConvEsq[playerid][d][e]);
		}
	}
	for(new i; i < sizeof(TxDWhatsConv); i++){
		TextDrawHideForPlayer(playerid, TxDWhatsConv[i]);
	}
	for(new i; i < sizeof(TxDWhatsIndex); i++)
	{
		TextDrawShowForPlayer(playerid, TxDWhatsIndex[i]);
		PlayerTextDrawShow(playerid, TxDWhatsIndext[playerid][0]);
	}
	TextDrawHideForPlayer(playerid, TxDWhatsIndex[16]);
	PaginaIndexWpp[playerid] = 4;
	format((QueryVexy[0] = EOS, QueryVexy), 256, "SELECT * FROM `conversas` WHERE `criador` = '%s' OR `nick` = '%s' ORDER BY `ultima_mensagem_tempo` DESC limit 50;", NP(playerid), NP(playerid));
	wppRes = db_query(WppDB, QueryVexy);
	new count = 0;
	if(db_num_rows(wppRes)) {

		do {
			db_get_field_assoc(wppRes, "criador", PaginacaoWppIndex[playerid][count][wCriador], (24 + 1));
			db_get_field_assoc(wppRes, "nick", PaginacaoWppIndex[playerid][count][wNick], (24 + 1));
			db_get_field_assoc(wppRes, "ultima_mensagem",PaginacaoWppIndex[playerid][count][wUltima_mensagem], 127 + 1);
			count++;
		}
		while(db_next_row(wppRes));
	}
	if(count == 0){
		Info(playerid, "[WhatsApp]:Anda masih belum melakukan percakapan! Buat satu dengan mengklik tombol dengan '+'");
	}
	if(count <= 4) {
		TextDrawHideForPlayer(playerid, TxDWhatsIndex[17]);
	}
	db_free_result(wppRes);
	new contador = 0;
	for(new i; i < 4; i++){

		if(!strcmp(PaginacaoWppIndex[playerid][i][wCriador], NP(playerid))) {
			//nick
			PlayerTextDrawSetString(playerid, WppIndexConv[playerid][i][3], PaginacaoWppIndex[playerid][i][wNick]);
			if(strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]) >= 10) {
				strdel(PaginacaoWppIndex[playerid][i][wUltima_mensagem], 10, strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]));
				strins(PaginacaoWppIndex[playerid][i][wUltima_mensagem], "...", 10);

			}
			PlayerTextDrawSetString(playerid, WppIndexConv[playerid][i][4], PaginacaoWppIndex[playerid][i][wUltima_mensagem]);
			strmid(InfoWppPagina[playerid][i][wNick], PaginacaoWppIndex[playerid][i][wNick], 0, strlen(PaginacaoWppIndex[playerid][i][wNick]), 24);
			strmid(InfoWppPagina[playerid][i][wCriador], NP(playerid), 0, strlen(NP(playerid)), 24);

			strmid(InfoWppPagina[playerid][i][wUltima_mensagem], PaginacaoWppIndex[playerid][i][wUltima_mensagem], 0, strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]), 24);

			if(!isnull(PaginacaoWppIndex[playerid][i][wNick])) {
				for(new d; d < sizeof(WppIndexConv[][]); d++){
					PlayerTextDrawShow(playerid, WppIndexConv[playerid][i][d]);
				}
				contador++;
			}

		}
		else {
			// nick_criador
			if(strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]) >= 10) {
				strdel(PaginacaoWppIndex[playerid][i][wUltima_mensagem], 10, strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]));
				strins(PaginacaoWppIndex[playerid][i][wUltima_mensagem], "...", 10);
			}
			PlayerTextDrawSetString(playerid, WppIndexConv[playerid][i][3], PaginacaoWppIndex[playerid][i][wCriador]);
			PlayerTextDrawSetString(playerid, WppIndexConv[playerid][i][4], PaginacaoWppIndex[playerid][i][wUltima_mensagem]);
			strmid(InfoWppPagina[playerid][i][wCriador], PaginacaoWppIndex[playerid][i][wCriador], 0, strlen(PaginacaoWppIndex[playerid][i][wCriador]), 24);
			strmid(InfoWppPagina[playerid][i][wNick], NP(playerid), 0, strlen(NP(playerid)), 24);
			strmid(InfoWppPagina[playerid][i][wUltima_mensagem], PaginacaoWppIndex[playerid][i][wUltima_mensagem], 0, strlen(PaginacaoWppIndex[playerid][i][wUltima_mensagem]), 24);

			if(!isnull(PaginacaoWppIndex[playerid][i][wCriador])) {
				for(new d; d < sizeof(WppIndexConv[][]); d++){
					PlayerTextDrawShow(playerid, WppIndexConv[playerid][i][d]);
				}
				contador++;

			}
		}

	}
	CountPagIndexWpp[playerid] = contador;

	SelectTextDraw(playerid, 0xC0C0C0FF);
	return 1;
}
stock CriarMensagemWpp(playerid, criador[], para[], mensagem[])
{
    new
        stbra[500],
        data[50],
        VexyYear,
        VexyMonth,
        VexyDay,
        VexyHour,
        VexyMinute,
        VexySeconds
    ;
    gettime(VexyHour, VexyMinute, VexySeconds);
    getdate(VexyYear, VexyMonth, VexyDay);
    format(data, sizeof data, "%02d:%02d - %02d/%02d/%04d", VexyHour, VexyMinute, VexyDay, VexyMonth, VexyYear);
    format(stbra, sizeof stbra, "INSERT INTO `mensagens` (`de`, `para`, `mensagem`, `data`, `gettime`) VALUES ('%s', '%s', '%s', '%s', '%d');", criador, para, mensagem, data, gettime());
    if(db_free_result((db_query(WppDB, stbra))))
	{
        new bigstrbra[500];
        format(bigstrbra, sizeof bigstrbra, "UPDATE `conversas` SET `ultima_mensagem` = '%s', `ultima_mensagem_tempo` = '%d' WHERE (`criador` = '%s' AND `nick` = '%s') OR (`criador` = '%s' AND `nick` = '%s')", mensagem, gettime(), criador, para, para, criador);


        new id = GetplayeridVexy(para);
        if(IsPlayerConnected(id) && GetPVarType(playerid, "Conversa_Aberta_Index") != PLAYER_VARTYPE_NONE)
		{
            new index = GetPVarInt(id, "Conversa_Aberta_Index");
            if(!strcmp(InfoWppPagina[id][index][wCriador], NP(id)))
			{
                AbrirConversa(id, InfoWppPagina[playerid][id][wCriador], InfoWppPagina[playerid][index][wNick]);
            }
            else if(!strcmp(InfoWppPagina[id][index][wNick], NP(id)))
			{
                AbrirConversa(id, InfoWppPagina[playerid][id][wNick], InfoWppPagina[playerid][index][wCriador]);
            }
        }
        if(db_free_result((db_query(WppDB, bigstrbra))))
		{
            AbrirConversa(playerid, criador, para);
            //reload
        }
        return 1;
    }
    return 1;
}
stock GetplayeridVexy(const nick[]) {
    foreach(new i : Player){
        if(IsPlayerConnected(i)) {
            if(!strcmp(NP(i), nick, true)) {
                return i;
            }
        }
    }
    return INVALID_PLAYER_ID;
}
stock CriarConversaWpp(playerid, nick[])
{
	new stbra[500];
	format(stbra, sizeof stbra, "INSERT INTO `conversas` (`nick`, `criador`, `ultima_mensagem_tempo`) VALUES ('%s', '%s', '%d');", nick, NP(playerid), gettime());
	if(!db_free_result((db_query(WppDB, stbra))))
	{
		Info(playerid, "Tidak dapat membuat percakapan.");
	}
	else
	{
		AbrirWhatsapp(playerid);
	}
	return 1;
}
