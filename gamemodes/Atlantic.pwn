    switch(dialogid)
	{
		case DIALOG_TUNE:
        {
            if (response)
            {
                // new to_player = GetPVarInt(playerid, "P_MODIF_TO");
                new to_player = PlayerInfo[playerid][pSelectPlayerWs];
                if(!IsPlayerDriver(to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pelanggan harus mengemudi");

                new modelid = GetVehicleModel(GetPlayerVehicleID(to_player));

                switch (modelid)
                {
	                case 534 .. 536, 558 .. 562, 565, 567, 575, 576:
	                {
                        if (!strcmp(inputtext, "Wheels") || !strcmp(inputtext, "Hydraulics") || !strcmp(inputtext, "Nitro"))
                        {
                            new Query[99];

                            mysql_format(mMysql, Query, sizeof Query, "SELECT componentid,type FROM vehicle_components WHERE part='%e' ORDER BY type", inputtext);
                            mysql_tquery(mMysql, Query, "OnTuneLoad", "ii", playerid, 2);
                        }
                        else
                        {
                            new Query[113];

                            mysql_format(mMysql, Query, sizeof Query, "SELECT componentid,type FROM vehicle_components WHERE cars=%i AND part='%e' ORDER BY type", modelid, inputtext);
                            mysql_tquery(mMysql, Query, "OnTuneLoad", "ii", playerid, 2);
                        }
	                }
	                default:
	                {
                        new Query[101];

                        mysql_format(mMysql, Query, sizeof Query, "SELECT componentid,type FROM vehicle_components WHERE cars<=0 AND part='%e' ORDER BY type", inputtext);
                        mysql_tquery(mMysql, Query, "OnTuneLoad", "ii", playerid, 2);
	                }
                }
            }
        }
        case DIALOG_TUNE_2:
        {
            // new to_player = GetPVarInt(playerid, "P_MODIF_TO");
            new to_player = PlayerInfo[playerid][pSelectPlayerWs];
            new to_player_str[4];
            valstr(to_player_str, to_player);
            if (!response) return callcmd::tune(playerid, to_player_str);
            if(!IsPlayerDriver(to_player))
                return SendClientMessage(playerid, 0xCECECEFF, "Pelanggan harus mengemudi");
            if(PlayerInfo[playerid][pComponent] < 35) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Component Anda Tidak Cukup, Butuh 35");

            new vehicleid = GetPlayerVehicleID(to_player), componentid;
            new prefix[10];

            if (!sscanf(inputtext, "i", componentid)) {
                AddVehicleComponent(vehicleid, componentid);
                SCMF(playerid, -1, "{FFFF00}TUNE: {FFFFFF}Kamu memasangkan komponen {33AAFF}%s %s", VehicleComponent[componentid-1000][cType],VehicleComponent[componentid-1000][cName]);
                SCMF(to_player, -1, "{FFFF00}TUNE: {FFFFFF}Kamu memasangkan komponen {33AAFF}%s %s", VehicleComponent[componentid-1000][cType],VehicleComponent[componentid-1000][cName]);
                PlayerInfo[playerid][pComponent] -= 35;
				OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
            }
            else if(!sscanf(inputtext, "s[10]i", prefix, componentid)) {
                CarInfo[to_player][cHydrawlic][UseCar(to_player)] = 0;
                SCMF(playerid, -1, "{FFFF00}TUNE: {FFFFFF}Kamu melepas komponen {33AAFF}%s %s", VehicleComponent[componentid-1000][cType],VehicleComponent[componentid-1000][cName]);
                SCMF(to_player, -1, "{FFFF00}TUNE: {FFFFFF}Kamu melepas komponen {33AAFF}%s %s", VehicleComponent[componentid-1000][cType],VehicleComponent[componentid-1000][cName]);
                return RemoveVehicleComponent(vehicleid, 1087);
            }

            switch(componentid)
            {
                case 1000..1003,1014..1016,1023,1049,1050,1058,1060,1138,1139,1146,1147,1158,1162..1164: CarInfo[to_player][cSpoiler][UseCar(to_player)] = componentid;
                case 1004,1005,1011,1012: CarInfo[to_player][cHood][UseCar(to_player)] = componentid;
                case 1007,1017,1026,1027,1030,1031,1036,1039..1042,1047,1048,1051,1052,1056,1057,1062,1063,1069,1072,1090,1093..1095,1099,1101,1102,1106..1108,1119..1122,1124,1133,1134,1137: CarInfo[to_player][cSideskirt][UseCar(to_player)] = componentid;
                case 1008..1010: CarInfo[to_player][cNitro][UseCar(to_player)] = componentid;
                case 1013,1024: CarInfo[to_player][cLamps][UseCar(to_player)] = componentid;
                case 1018..1022,1028,1029,1034,1037,1043..1046,1059,1064.1066,1089,1092,1105,1113,1114,1126,1127,1129,1132,1135,1136:CarInfo[to_player][cExhaust][UseCar(to_player)] = componentid;
                case 1025,1073..1085,1096..1098: CarInfo[to_player][cWheels][UseCar(to_player)] = componentid;
                case 1006,1032,1033,1035,1038,1053..1055,1061,1067,1068,1088,1091,1103,1128,1130,1131: CarInfo[to_player][cRoof][UseCar(to_player)] = componentid;
                case 1086: CarInfo[to_player][cStereo][UseCar(to_player)] = componentid;
                case 1087: CarInfo[to_player][cHydrawlic][UseCar(to_player)] = componentid;
                case 1117,1152,1153,1155,1157,1160,1165,1166,1169..1174,1176,1179,1181,1182,1185,1188..1191: CarInfo[to_player][cBumper1][UseCar(to_player)] = componentid;
                case 1140,1141,1148..1151,1154,1156,1159,1161,1167,1168,1175,1177,1178,1180,1183,1184,1186,1187,1192,1193: CarInfo[to_player][cBumper2][UseCar(to_player)] = componentid;
                case 1142..1145: CarInfo[to_player][cVentRight][UseCar(to_player)] = componentid;
            }

            // sideskirts and vents that have left and right side should be applied twice
            switch (componentid)
            {
                case 1007, 1027, 1030, 1039, 1040, 1051, 1052, 1062, 1063, 1071, 1072, 1094, 1099, 1101, 1102, 1107, 1120, 1121, 1124, 1137, 1142 .. 1145: AddVehicleComponent(vehicleid, componentid);
            }

            SaveCars(to_player);

            PlayerInfo[playerid][pComponent] -= 35;
   			OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
        }
	    case HP_SMS:
	    {
	        if(response)
	        {
	        new nomor, text[116];
	        if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki kartu SIM.");
			if(PlayerInfo[playerid][pSummaNumber] <= 0) return Send(playerid, COLOR_GREY, "Pulsa Tidak Cukup");
			if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara");

			if(sscanf(inputtext, "p<,>ds[116]", nomor, text)) return SPD(playerid, HP_SMS, DIALOG_STYLE_INPUT, "Sms", "[nomor] [text]\nContoh: 164164, Assalamualaikum", "Kirim", "Batal");

			if(nomor < 0 || nomor > 999999) return Send(playerid, COLOR_GREY,"Nomor ponsel yang ditentukan tidak valid.");
		    if(nomor == PlayerInfo[playerid][pNumber]) return Send(playerid, COLOR_GREY, "Anda tidak dapat mengirim pesan kepada diri sendiri.");
		    new full = 0;

		    foreach(new i : Player)
			{
		        if(nomor == PlayerInfo[i][pNumber] && nomor != 0)
				{
		            if(PhoneOnline[i] != 0) return Send(playerid, COLOR_GREY, "Telepon pengirim mati");

		            full++;
		            PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
		            SetPlayerChatBubble(playerid, "SMS >>" ,COLOR_YELLOW,10.0,5000), SetPlayerChatBubble(i, "SMS <<",COLOR_YELLOW,10.0,5000);

		            SCMF(i, COLOR_YELLOW, "SMS: %s. Pengirim: %s(%i)[Telp. %d]", text, Name(playerid), playerid, PlayerInfo[playerid][pNumber]);
		            SCMF(playerid, COLOR_YELLOW, "SMS: %s. Penerima: %s(%i)[Telp. %d]", text, Name(i), i, PlayerInfo[i][pNumber]);

		            foreach(new x : admin_list) if(player_admin_sms[x]) SCMF(x, COLOR_YELLOW, "[A][SMS] %s[%i] -> %s[%i]: %s", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(i), i, text);

		            if(afk_time[i] > 5) Send(playerid, COLOR_GREY, "Pesan berhasil terkirim. Pemutar SMS dalam AFK.");

					PlayerInfo[playerid][pSummaNumber] -= strlen(text)*2/2;
					format(String, 18, "~y~-$%d", strlen(text)*2/2), GameTextForPlayer(playerid, String, 1500, 1), GameTextForPlayer(i, "~y~SMS", 1500, 1);
					break;
		   		}
			}
			if(full == 0) return Send(playerid, COLOR_GREY,"Nomor ini tidak ada atau pemilik nomor sedang luring.");
			}
	    }
		case HP_CALL:
	    {
	        if(response)
            {
                new number;
                if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki kartu SIM!");
                if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda Sedang Dimute, Mendapatkan Larangan Berbicara");

				if (sscanf(inputtext, "i", number))
				{
					return ShowPlayerDialog(playerid, HP_CALL, DIALOG_STYLE_INPUT, "{6688FF}Telepon", "Masukan Nomer Telepon:", "Call", "Batal");
				}

				PlayerInfo[playerid][pSummaNumber] -= 1000;
				format(String, 18, "~y~-$%d", 1000), GameTextForPlayer(playerid, String, 1500, 1);

				SetPlayerAttachedObject(playerid,0, 19513,6,0.101998,0.013999,-0.007999,79.899864,-178.999969,-4.200003,1.000000,1.000000,1.000000);
			    ApplyAnimation(playerid,"PED","phone_in", 4.1, 0, 1, 1, 1, 1, 1);
			    SetPVarInt(playerid, "UsingAnim", 1);
				if(Mobile[playerid] != -1) return Send(playerid, COLOR_GREY, "Anda sudah berbicara di telepon.");
				if(PlayerInfo[playerid][pSummaNumber] <= 0) return Send(playerid, COLOR_GREY, "Pulsa Tidak Cukup");

				format(String, 86, "%s mengeluarkan ponsel",Name(playerid));
				ProxDetector(10.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				if(number == PlayerInfo[playerid][pNumber]) return Send(playerid, COLOR_GREY, "Anda tidak dapat menyebut diri Anda sendiri, salurannya sibuk.");

			    if(number == 911) return SPD(playerid, 8949, DIALOG_STYLE_INPUT, "Panggilan polisi", "Jelaskan tempat Anda berada:", "Untuk menelepon", "Tutup");
				if(number == 03) return SPD(playerid, 8950, DIALOG_STYLE_INPUT, "Panggilan Ambulans", "Jelaskan tempat Anda berjalan:", "Untuk menelepon", "Tutup");

				for(new i = 70; i <= 72; i++)
				{
					if(!BizzInfo[i][bPhone] || number != BizzInfo[i][bPhone]) continue;

					SetPlayerUseListitem(playerid, i);

					return SPD(playerid, 8948, DIALOG_STYLE_INPUT, "Panggilan taksi", "Jelaskan tempat Anda berada:", "Untuk menelepon", "Tutup");
				}

				foreach(new i : Player)
				{
					if(PlayerInfo[i][pNumber] == number && number != 0)
					{
						Mobile[playerid] = i;

						if(PhoneOnline[Mobile[playerid]] > 0) return Send(playerid, COLOR_GREY, "Telepon pemanggil mati...");

						if(Mobile[Mobile[playerid]] == -1)
						{
						    Send(Mobile[playerid], -1, "Ponsel Anda berdering. Masuk {43CC0E}(/p)"W" untuk menjawab.");
			                PlayerPlaySound(Mobile[playerid], 20600, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

							format(String, 86, "%s telepon berdering", Name(i)), SetPlayerChatBubble(i, String, COLOR_PURPLE, 10.0, 5000);
							SetPlayerAttachedObject(playerid, 0, 19513,6,0.101998,0.013999,-0.007999,79.899864,-178.999969,-4.200003,1.000000,1.000000,1.000000);
							SetPlayerSpecialAction(playerid, 11);
							CellTime[playerid] = 1;
							break;
						}
					}
				}
			}
		}
		case HP_TWITTER:
	    {
