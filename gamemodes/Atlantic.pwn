	return 1;
}
stock GetXYInBackOfPlayer(const playerid, &Float:x, &Float:y, const Float:distance)
{
	new Float:a; GetPlayerPos(playerid, x, y, a); GetPlayerFacingAngle(playerid, a);
	if(IsPlayerInAnyVehicle(playerid))
	{
		new vid=GetPlayerVehicleID(playerid);
		if(vid>0 && vid<=MAX_VEHICLES) GetVehicleZAngle(vid, a);
	}
	x -= (distance * floatsin(-a, degrees)); y -= (distance * floatcos(-a, degrees));
}
epublic: SlapTest(playerid)
{
	new id = GetPVarInt(playerid, "HpIds");
	new Float: hp;
	GetPlayerHealth(id, hp);

	if(hp >= GetPVarFloat(playerid, "oldHP"))
	{
		format(String, sizeof(String), ""W"Pemain benar-benar pintar jika:\n\n- Anda memukul pemain pada permukaan datar\n- Pemain tidak berada di bawah tekstur\n- Pemain jatuh dari ketinggian maksimal tamparan\n\nINFO:\nHP pemain sebelum pukulan: %.0f\nHP pemain setelah pukulan: %.0f\n\n{FF7F50}Kemungkinannya adalah 80 persen bahwa pemain menggunakan GodMode...", GetPVarFloat(playerid, "oldHP"), hp);
	    SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{FF7F50}Mungkin seorang penipu!", String, "Ok", "");
	}
	return 1;
}
epublic: PodarokClear(playerid) return RemovePlayerAttachedObject(playerid,6),SetPlayerSpecialAction (playerid, SPECIAL_ACTION_NONE);

const UNOCCUPIED_SYNC = 209;

IPacket:UNOCCUPIED_SYNC(playerid, BitStream:bs)
{
    new unoccupiedData[PR_UnoccupiedSync];

    BS_IgnoreBits(bs, 8);
    BS_ReadUnoccupiedSync(bs, unoccupiedData);

    if(floatcmp(floatabs(unoccupiedData[PR_roll][0]), 1.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_roll][1]), 1.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_roll][2]), 1.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_direction][0]), 1.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_direction][1]), 1.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_direction][2]), 1.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_position][0]), 20000.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_position][1]), 20000.00000) == 1
        || floatcmp(floatabs(unoccupiedData[PR_position][2]), 20000.00000) == 1
    ) {
        return false;
    }

    return true;
}
main(){
	print("Official Malavida  2023"); }

stock GetNearestVehicleID(playerid, Float: radius = 0.0)
{
	if(radius == 0.0)
		radius = FLOAT_INFINITY;

	new vehicleid = INVALID_VEHICLE_ID;

	new Float: dist;
	new Float: pos_x, Float: pos_y, Float: pos_z;

	GetPlayerPos(playerid, pos_x, pos_y, pos_z);
	for(new idx; idx < MAX_VEHICLES; idx ++)
	{
		if(!IsValidVehicle(idx)) continue;
		if(!IsVehicleStreamedIn(idx, playerid)) continue;

		dist = GetVehicleDistanceFromPoint(idx, pos_x, pos_y, pos_z);
		if(dist < radius)
		{
			radius = dist,
			vehicleid = idx;
		}
	}
	return vehicleid;
}

stock GetXYInFront(&Float:x, &Float:y, Float: a, Float:distance)
{
    x += (distance * floatsin(-a, degrees));
    y += (distance * floatcos(-a, degrees));
}

stock GetXYInFrontOfVehicle(vehicleid, &Float:x, &Float:y, Float:distance)
{
    new Float:z, Float:angle;
    GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);
    x += (distance * floatsin(-angle, degrees));
    y += (distance * floatcos(-angle, degrees));
}

stock UpdateTrashAmount(trash_id, amount)
{
	trash_info[trash_id][t_amount] += amount;

	format(format_string, 48, "Status: %i/100", trash_info[trash_id][t_amount]);
	return UpdateDynamic3DTextLabelText(trash_info[trash_id][t_3d], COLOR_YELLOW, format_string);
}
stock UpdateCollectorAmount(collector_id, amount) return AtmsInfo[collector_id][c_amount] += amount;

stock GetPlayerInVehicleSeat(vehicleid, seat_id)
{
    foreach(new i : Player) if(GetPlayerVehicleID(i) == vehicleid && GetPlayerVehicleSeat(i) == seat_id) return i;

	return INVALID_PLAYER_ID;
}

stock UpdateVehicleTrashInfo(vehicleid, amount = 0)
{
    if(VehInfo[vehicleid][vFr] != 4) return 0;

    trash_vehicle_amount[vehicleid] += amount;

    format(format_string, 48, "Kapasitas: %i/500", trash_vehicle_amount[vehicleid]);

    if(_:trash_vehicle_3d[vehicleid] == 0)
		trash_vehicle_3d[vehicleid] = CreateDynamic3DTextLabel(format_string, COLOR_YELLOW, 0.0, 0.0, 0.0, 15.0, INVALID_PLAYER_ID, vehicleid, 0,0,0);
	else
		UpdateDynamic3DTextLabelText(trash_vehicle_3d[vehicleid], COLOR_YELLOW, format_string);

	return 1;
}
stock UpdateVehicleCollectorInfo(vehicleid, amount = 0)
{
    if(VehInfo[vehicleid][vFr] != 5) return 0;

    collector_vehicle_amount[vehicleid] += amount;

    format(format_string, 48, "Kapasitas: %i/200", collector_vehicle_amount[vehicleid]);

    if(_:collector_vehicle_3d[vehicleid] == 0)
		collector_vehicle_3d[vehicleid] = CreateDynamic3DTextLabel(format_string, COLOR_YELLOW, 0.0, 0.0, 0.0, 15.0, INVALID_PLAYER_ID, vehicleid, 0,0,0);
	else
		UpdateDynamic3DTextLabelText(collector_vehicle_3d[vehicleid], COLOR_YELLOW, format_string);

	return 1;
}

