public OnPlayerDisconnect(playerid, reason)
{
    if(pData[playerid][pDM] == 1)
    {
		ResetWeapons(playerid);
		return 1;
	}
	SavePlayerCarPark(playerid);
 	PlayerData[playerid][pTogTP] = 0;
	DestroyDynamic3DTextLabel(PlayerInfo[playerid][pAdo]);
 	adostatus[playerid] = 0;
	new idveh = GetPlayerVehicleID(playerid);
	for(new wiu; wiu<5; wiu++) DestroyDynamicObject(sirenPD[wiu][idveh]);
	for(new wiu; wiu<5; wiu++) sirenPD[wiu][idveh] = 0;
	HideProgressBar(playerid);
	SaveCars(playerid);
	LoadingPlayerBar[playerid] = 0;
	masked[playerid] = 0;
	DeleteClosestSpike(playerid);
	new szDisconnectReason[3][] =
	{
		"Crash",
		"Quit",
		"Kick"
	};
	format(String, 188, "%s pergi dari server (%s).", Name(playerid), szDisconnectReason[reason]);
 	ProxDetector(20.0, playerid, String,0xFFFF00FF,0xFFFF00FF,0xFFFF00FF,0xFFFF00FF,0xFFFF00FF);
    //MICIN ILEGAL
	DutyMicin[playerid] = 0;
    CPMicin[playerid] = 0;
	FecharWhatsapp(playerid);
	TextDrawHideForPlayer(playerid, CrateTD[0]);
	TextDrawHideForPlayer(playerid, CrateTD[1]);
	TextDrawHideForPlayer(playerid, CrateTD[2]);
	TextDrawHideForPlayer(playerid, CrateTD[3]);
	TextDrawHideForPlayer(playerid, CrateTD[4]);
	TextDrawHideForPlayer(playerid, CrateTD[5]);
	PlayerTextDrawHide(playerid, CratePTD[0]);
	PlayerTextDrawHide(playerid, CratePTD[1]);
    ResetPlayerVariables(playerid);
    pData[playerid][pDM] = 0;
    CrateModel[playerid] = -1;
    IsCrates[playerid] = 0;
    
    PlayerTextDrawDestroy(playerid, PlayerHbe[playerid][0]);
	PlayerTextDrawDestroy(playerid, PlayerHbe[playerid][1]);
	PlayerTextDrawDestroy(playerid, PlayerHbe[playerid][2]);
	PlayerTextDrawDestroy(playerid, PlayerHbe[playerid][3]);
	PlayerTextDrawDestroy(playerid, Box_HUd[playerid]);
	DestroyPlayerProgressBar(playerid, PlayerProgressBar[playerid][0]);
	DestroyPlayerProgressBar(playerid, PlayerProgressBar[playerid][1]);
	DestroyPlayerProgressBar(playerid, PlayerProgressBar[playerid][2]);

    DeletePVar(playerid, "DragBy");
    pData[playerid][pDragged] = 0;
    pData[playerid][pDraggedBy] = INVALID_PLAYER_ID;
    //PAKET ILEGAL
	if(AmbilPacket[playerid] == 1)
	{
	    new Float:x, Float:y, Float:z;
	    GetPlayerPos(playerid, x, y, z);
        StatusPacket = 1;
        AmbilPacket[playerid] = 0;
        PosPacket[0] = x;
	    PosPacket[1] = y;
	    PosPacket[2] = z;
	    DestroyDynamicPickup(IDPacket);
	    DestroyDynamic3DTextLabel(PacketLabel);
	    PacketLabel = CreateDynamic3DTextLabel("[PACKET ILEGAL]\n{FFFFFF}/takepacket", COLOR_BLUE, x, y, z, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	    IDPacket = CreateDynamicPickup(1575, 23, x, y, z, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
        SendClientMessageToAll(COLOR_YELLOW, "Paket Ilegal Terjatuh Cepat Cari");
    }
	
	for(new i; i <= 9; i++)
	{
		if(DialogSaya[playerid][i] == true)
		{
		    DialogSaya[playerid][i] = false;
		    DialogHauling[i] = false;
		    DestroyVehicle(TrailerHauling[playerid]);  //jika player disconnect maka trailer akan kembali seperti awal
		}
    }

	//TD LOGO
 	PlayerTextDrawDestroy(playerid, Textdraw0[playerid]);
    PlayerTextDrawDestroy(playerid, Textdraw1[playerid]);
	PlayerTextDrawDestroy(playerid, Textdraw2[playerid]);
	PlayerTextDrawDestroy(playerid, Textdraw3[playerid]);
	PlayerTextDrawDestroy(playerid, Textdraw4[playerid]);
    SaveSpawn(playerid);
    
	//job petani
	DutyGanjos[playerid] = 0;
    CPGanjos[playerid] = 0;
    BibitGanjos[playerid] = 0;
    PanenGanjos[playerid] = 0;
    
	//job ayam
	KerjaAyam[playerid] = 0;
	PutAyam[playerid] = 0;
    TakenAyam[playerid] = 0;

	//YOG MINER
	JobMiner[playerid] = 0;
	AntarMiner[playerid] = 0;
	AmbilBijih[playerid] = 0;

	

	//Drugs
	if(RegenTimer[playerid] != -1)
	{
	    KillTimer(RegenTimer[playerid]);
	    RegenTimer[playerid] = -1;
	}
	foreach(new i : Player)
	{
	    if(PlayerDrugData[i][DrugsOfferedBy] == playerid)
	    {
	        PlayerDrugData[i][DrugsOfferedBy] = INVALID_PLAYER_ID;
	        ShowPlayerDialog(i, -1, DIALOG_STYLE_MSGBOX, "Title", "Content", "Button1", "Button2");

            SendClientMessage(i, 0x3498DBFF, "DRUGS: {FFFFFF}The player who sent you an offer disconnected.");
	    }
	}
	foreach(new i : Player)
	{
	    if(PlayerDrugData[i][DrugsOfferedBy] == playerid)
	    {
	        PlayerDrugData[i][DrugsOfferedBy] = INVALID_PLAYER_ID;
	        ShowPlayerDialog(i, -1, DIALOG_STYLE_MSGBOX, "Title", "Content", "Button1", "Button2");

            SendClientMessage(i, 0x3498DBFF, "DRUGS: {FFFFFF}The player who sent you an offer disconnected.");
	    }
	}

	RemoveEffects(playerid);
	Player_SaveDrugs(playerid);
    //sv_stream_delete(player_stream[playerid]);
	if(pTemp[playerid][pTrucker] > -1 && PlayerInfo[playerid][pJob] == 6 && pTemp[playerid][pTrucker_Unit] != 0)
	{
	    GivePlayerMoneyEx(playerid, pTemp[playerid][pTrucker_Unit] * UNIT_PRICE, "menghemat uang untuk kargo");

	    AddPlayerNotify(playerid, "Anda telah mengembalikan uang untuk kehilangan muatan.");
	}

	new old_pay = PlayerInfo[playerid][pPayCheck];

	PlayerInfo[playerid][pPayCheck] += pTemp[playerid][pWorkSalary];
	PlayerInfo[playerid][pPayCheck] += GetPVarInt(playerid, "JobMoney");
	PlayerInfo[playerid][pPayCheck] += AmmountWood[playerid]*30;

	if(PlayerInfo[playerid][pPayCheck] != old_pay) OnPlayerUpdateAccountsPer(playerid, "pPayCheck", PlayerInfo[playerid][pPayCheck]);

	//

	if(family_player_3d[playerid] != Text3D:-1) DestroyDynamic3DTextLabel(family_player_3d[playerid]);

	//

	if(rent_vehicle_id[playerid] != INVALID_VEHICLE_ID)
	{
	    new vehicleid = rent_vehicle_id[playerid];

	    DestroyVehicle(vehicleid);

	    vehicle_rent_owner[vehicleid] = INVALID_PLAYER_ID;
	    rent_vehicle_id[playerid] = INVALID_VEHICLE_ID;
	}

	//

	for(new x; x < 2; x++)
	{
		for(new i; i < 8; i++)
		{
			if(cheat_ids[x][i] != playerid) continue;
			cheat_ids[x][i] = -1;

		}
	}

	if(GetPVarType(playerid, "PlacedBB"))
    {
        DestroyDynamicObject(GetPVarInt(playerid, "PlacedBB"));
        DestroyDynamic3DTextLabel(Text3D:GetPVarInt(playerid, "BBLabel"));
        if(GetPVarType(playerid, "BBArea"))
        {
            foreach(Player,i)
            {
                if(IsPlayerInDynamicArea(i, GetPVarInt(playerid, "BBArea")))
                {
                    StopAudioStreamForPlayer(i);
                    SendClientMessage(i, COLOR_LIGHTRED, " The boombox creator has disconnected from the server.");
                }
            }
        }
    }


    for(new i; i < MAX_BARRAGE_OBJ; i++)
	{
	    if(!player_barrage[playerid][i]) continue;

	    DestroyDynamicObject(player_barrage[playerid][i]);
	    player_barrage[playerid][i] = 0;

	    DestroyDynamic3DTextLabel(player_barrage_3d[playerid][i]);
	}

	for(new i; i < MAX_ADVERTS; i++) if(AdvertInfo[i][aEditor] == playerid) AdvertInfo[i][aEditor] = INVALID_PLAYER_ID;

    if(pTemp[playerid][uborka_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(pTemp[playerid][uborka_text]);
		pTemp[playerid][uborka_text] = Text3D:INVALID_3DTEXT_ID;
	}

    if(pTemp[playerid][bus_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(pTemp[playerid][bus_text]);
		pTemp[playerid][bus_text] = Text3D:INVALID_3DTEXT_ID;
	}

    if(GetPVarInt(playerid, "get_vehicle_drive"))
    {
        new old_vehicleid = GetPVarInt(playerid, "get_vehicle_drive");

        vehicle_driver[old_vehicleid] = INVALID_PLAYER_ID;
    }

	PlayerStopRobbery(playerid);

	for(new i; i < MAX_REPORTS; i++) if(report_info[i][r_id] == playerid) report_info[i][r_id] = INVALID_PLAYER_ID;

	if(rob_offer[playerid] != INVALID_PLAYER_ID)
	{
	    new r_offer = rob_offer[playerid];
	    rob_offer[r_offer] = INVALID_PLAYER_ID;
	}

	DeletePlayerQuestData(playerid);

    DeletePlayerDrugMark(playerid);
    
    PlayerInfo[playerid][pAname] = 0;

    OnDuty[playerid] = 0;

	RemovePlayerFromContainer(playerid);

    DestroyDeliveryObject(playerid);

    if(player_race_reg{playerid}) PlayerLeaveRace(playerid);

	if(Iter_Contains(admin_list, playerid)) Iter_Remove(admin_list, playerid);
    if(Iter_Contains(support_list, playerid)) Iter_Remove(support_list, playerid);

    for(new i, z = MAX_BONE_TABLES; i < z; i++)
		for(new x; x < 4; x++)
			if(bones_table_players[i][x] == playerid)
				bones_table_players[i][x] = INVALID_PLAYER_ID;

    foreach(new i : Player)
	{
	    if(player_taxi_passanger[i] != INVALID_PLAYER_ID)
        {
            player_taxi_passanger[i] = INVALID_PLAYER_ID;

            SendClientMessage(i, COLOR_GREY, "Penumpang meninggalkan permainan.");

			SearchNextClientForTaxi(GetPlayerVehicleID(i), playerid);

			break;
        }

	    if(player_search_player[i] == playerid)
	    {
	        DisablePlayerCheckpoint(i);
	        SCMF(i, COLOR_GREY, "Komunikasi terputus, pelacakan pemain %s[%d] dihentikan. (disconnect)", Name(player_search_player[i]), player_search_player[i]);
	        player_search_player[i] = -1;

	        break;
     	}

    	if(gSpectateID[i] == playerid) // jika off pemain sedang diawasi
    	{
        	StopSpectate(i);
        	GameTextForPlayer(i, "~w~RECON ~r~ OFF~n~ ~r~PLAYER DISCONNECT", 5000, 3);

        	break;
    	}
	}
	if(PlantObject[playerid] != -1)// Hapus objek dari pemain
	{
		DestroyObject(PlantObject[playerid]);
		PlantObject[playerid] = -1;
	}
	if(PlayerInfo[playerid][pWanted] > 0 && PlayerCuffed[playerid] > 0)
	{
	    ResetWeapons(playerid);

	    SetPlayerPrison(playerid, 1, PlayerInfo[playerid][pWanted] * 600);
	}
	if(pTemp[playerid][pWork] >= 1)
	{
		pTemp[playerid][pWork] = 0;
		if(pTemp[playerid][pWork] == 2)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
			if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
		}
	}
	if(player_gun_obj[playerid])
	{
		new objectid = player_gun_obj[playerid];
		if(IsValidDynamicObject(objectid)) DestroyDynamicObject(objectid);
	}

    PlayerLeaveHospitalBed(playerid);
    if(rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
	{
		SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
		player_jobvehicle_time[playerid] = 0;
		rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
	}
	if(PlayerInfo[playerid][pObject] > 0)
	{
	    DestroyDynamic3DTextLabel(PlayerInfo[playerid][pDText]);
	    DestroyDynamicObject(PlayerInfo[playerid][pObject]);
 	}
	if(PlayerInfo[playerid][pJob] == 2 && pTemp[playerid][pBusID] != 0)
	{
        spawned_bus(playerid);
 	}
 	if(PlayerInfo[playerid][pJob] == 3 && pTemp[playerid][puborkacar] != 0)
	{
        pTemp[playerid][puborkacar] = 0;
      	player_route_id[playerid] = 0;
        uborkaPos{playerid} = 0;
        SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
 	}//membersihkan
 	/*if(admin_level[playerid] > 0)
	{
	    PlayerInfo[playerid][pMember] = 0;
	    PlayerInfo[playerid][pLeader] = 0;
	    PlayerInfo[playerid][pRank] = 0;
	    PlayerInfo[playerid][pfWarn] = 0;
 	}*/
 	if(GetPVarInt(playerid, "GPS") != 0) DisablePlayerCheckpoint(playerid);
	// SAVED
    OnPlayerUpdateAccounts(playerid);
    PlayerInfo[playerid][pLogin] = 0;

    mysql_format(mMysql, MySQLStr, 96, "UPDATE `accounts` SET `pLogin` = 0 WHERE `pID` = %d", PlayerInfo[playerid][pID]);
	mysql_tquery(mMysql, MySQLStr);

    for(new i; i < MAX_PLAYER_VEHICLES; i++) if(player_home_car[playerid][i] != INVALID_VEHICLE_ID) DestroyVehicleEx(player_home_car[playerid][i]), DestroyVehicleLabel(player_home_car[playerid][i]); // delete home car
    if(GetPVarInt(playerid, "FillSost") > 0) KillTimer(KillTimer(FillTimer[playerid])); // jika off saat pengisian bahan bakar

	return 1;
}

ShowProgressbar(playerid, text[] = "", Times)
{
	LoadingPlayerBar[playerid] = 0;
	new Float:Value = LoadingPlayerBar[playerid]*101/100;
	new Timers = Times*1000/100;
	PlayerTextDrawTextSize(playerid, PROGRESSBAR[playerid][1], Value, 23.5);
	PlayerTextDrawSetString(playerid, PROGRESSBAR[playerid][2], text);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][0]);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][1]);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][2]);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][3]);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][4]);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][5]);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][6]);
	// TogglePlayerControllable(playerid, 0);
	TimerLoading[playerid] = SetTimerEx("UpdtLoading", Timers, true, "d", playerid);
	return 1;
}

stock UpdateLoading(playerid)
{
	new Float:Value = LoadingPlayerBar[playerid]*101.0/100;
	PlayerTextDrawTextSize(playerid, PROGRESSBAR[playerid][1], Value, 23.4);
	PlayerTextDrawShow(playerid, PROGRESSBAR[playerid][1]);
	return 1;
}

forward UpdtLoading(playerid);
public UpdtLoading(playerid)
{
	LoadingPlayerBar[playerid] += 1;
	UpdateLoading(playerid);
	if(LoadingPlayerBar[playerid] >= 100)
	{
		KillTimer(TimerLoading[playerid]);
		LoadingPlayerBar[playerid] = 0;
		HideProgressBar(playerid);
		// TogglePlayerControllable(playerid, 1);
	}
	return 1;
}

stock DestroyVehiclePd(vehicleid)
{
	DestroyVehicle(SAPDVehicles[playerid]);
	return 1:
}
stock SetVehicleToRespawnEx(vehicleid)
{
    SetVehicleToRespawn(vehicleid);
    return 1;
}
stock DestroyVehicleEx(vehicleid)
{
    DestroyVehicleLabel(vehicleid);
	DestroyVehicle(vehicleid);
	return 1;
}
public OnPlayerSpawn(playerid)
{
    ResetVariables(playerid);
	//date and time
	for( new w = 0; w < 2; w++) {
	    TextDrawShowForPlayer(playerid,GRPTERBARUANJAY2);
	}
	/*for(new j; j < 4; j++) {
		PlayerTextDrawShow(playerid, PlayerHbe[playerid][j]);
	}
	PlayerTextDrawShow(playerid, Box_HUd[playerid]);*/
	for(new j; j < 9; j++) {
		PlayerTextDrawShow(playerid, Hbe_Majestic[playerid][j]);
	}
	//Malavida LOGO
	for( new i = 0; i < 3; i++) {
	    TextDrawShowForPlayer(playerid,Malavida_Logo2[i]);
	}
	for(new lo; lo < 26; lo++) {
	
	}
    /*TextDrawShowForPlayer(playerid, Ryzoo[0]);
	TextDrawShowForPlayer(playerid, Ryzoo[1]);
	TextDrawShowForPlayer(playerid, Ryzoo[2]);
	TextDrawShowForPlayer(playerid, Ryzoo[3]);
	TextDrawShowForPlayer(playerid, Ryzoo[4]);
	TextDrawShowForPlayer(playerid, Ryzoo[5]);
	TextDrawShowForPlayer(playerid, Ryzoo[6]);
	TextDrawShowForPlayer(playerid, Ryzoo[7]);
	TextDrawShowForPlayer(playerid, Ryzoo[8]);*/
	
	//for(new idd; idd < 10; idd++) PlayerTextDrawShow(playerid, HBE[playerid][idd]);
	//PlayerTextDrawShow(playerid, HBEText[playerid]);
	//CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
	killer_id[playerid] = INVALID_PLAYER_ID;
	pDialog [ playerid ] = false ;
	if(PlayerInfo[playerid][pLogin] != 1) return KickD(playerid, "Anda harus memulai permainan!");
	if(PlayerInfo[playerid][pSkin] == -1) return SkinChar(playerid);
	//selamat datang
	//SendClientMessage(playerid, -1, "Selamat datang di server {ec174f}Malavida ");
	//SendClientMessage(playerid, -1, "untuk melihat command /help");
	format(format_string, sizeof(format_string), "{BF00FF}INFO || {FFFFFF}Welcome Back Malavidaans!, You Have Logged In As a [Level %d Player]", PlayerInfo[playerid][pLevel]);
    SendClientMessage(playerid, -1, format_string);
    
	format(format_string, sizeof(format_string), "{BF00FF}INFO || {FFFFFF}Total Player On Hari Ini {FFFF00}Itung Sendiri");
	SendClientMessage(playerid, -1, format_string);

	//TD LOGO
 	TextDrawShowForPlayer(playerid, tdnama[0]);
	TextDrawShowForPlayer(playerid, tdnama[1]);
	TextDrawShowForPlayer(playerid, tdnama[2]);
	TextDrawShowForPlayer(playerid, tdnama[3]);
	
	if(player_bag[playerid])
	{
	    player_bag[playerid] = false;
	    TextDrawHideForPlayer(playerid, black_display[playerid]);
	}

    player_gag[playerid] = false;

	if(player_tie[playerid])
	{
	    TogglePlayerControllable(playerid, true);
		player_tie[playerid] = false;
	}

    if(GetPVarInt(playerid, "VibClothes") != 0)
    {
        SetPlayerPos(playerid,216.7040,-98.6638,1005.2578);
		SetPlayerFacingAngle(playerid, 89.1646);

		SetPlayerCameraPos(playerid, 213.9831, -98.6852, 1005.1337);
		SetPlayerCameraLookAt(playerid, 214.9816, -98.6917, 1005.0933);

		SetPlayerVirtualWorld(playerid,playerid);
		SetPlayerInterior(playerid,15);

		return 1;
	}
	if(GetPVarInt(playerid, "LoginOgran") != -1) SetPVarInt(playerid, "LoginOgran", -1);
	LevelUpdate(playerid);

    SetPlayerMoneyCase(playerid);

	SetPlayerToTeamColor(playerid);
    if(pTemp[playerid][pWork]) pTemp[playerid][pWork] = 0;

	SetPlayerSpawn(playerid);

	//CreatePlayerSatietyBar(playerid);
	
	LoadPlayerToysSlot1(playerid); //Load Toys Slot 1 (Jika Pemain Tersebut Memiliki Toys Di Slot 1)
    LoadPlayerToysSlot2(playerid); //Load Toys Slot 2 (Jika Pemain Tersebut Memiliki Toys Di Slot 2)
    LoadPlayerToysSlot3(playerid); //Load Toys Slot 3 (Jika Pemain Tersebut Memiliki Toys Di Slot 3)
	return 1;
}
stock SetPlayerSpawn(playerid)
{
	SetPlayerHealth(playerid, PlayerInfo[playerid][pHP]);
	SetPlayerArmour(playerid, PlayerInfo[playerid][pArmour]);
	
    if(PlayerInfo[playerid][pMember] && PlayerInfo[playerid][pFrSkin])
	{
		SetPlayerSkinEx(playerid,PlayerInfo[playerid][pFrSkin]);
		form_fraction[playerid] = PlayerInfo[playerid][pMember];
	}
	else
 {
	    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);
	    form_fraction[playerid] = 0;
	}

    if(GetPVarInt(playerid, "spawn_after_duel"))
    {
	    SetPlayerHealth(playerid, 100.0);

		SetPPos(playerid, 2405.4067,-1470.8069,23.9574, 0.0, GetPlayerInterior(playerid), 0, false);

        DeletePVar(playerid, "spawn_after_duel");

	    return 1;
    }

    if(GetPVarFloat(playerid, "spec_X"))
    {
		SetPlayerPos(playerid, GetPVarFloat(playerid, "spec_X"), GetPVarFloat(playerid, "spec_Y"), GetPVarFloat(playerid, "spec_Z"));
		SetPlayerInterior(playerid, GetPVarInt(playerid, "spec_int"));
        SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "spec_world"));

		return 1;
    }
	if(PlayerInfo[playerid][pPrison] > 0)
	{
	    switch(PlayerInfo[playerid][pMestoPrison])
	    {
			case 2: SetPPos(playerid,198.4545,161.8394,1003.0300, 0.0, 3, 2, false); // FBI
			case 3: SetPPos(playerid,219.2213,109.6325,999.0156, 0.0, 10, 2, false); // SFPD
			case 4: SetPPos(playerid,198.4545,161.8394,1003.0300, 0.0, 3, 8, false); // LVPD
			default: SetPPos(playerid, 706.3516,-104.2773,21.6811, 0.0, 6, 1 , false); // LSPD
		}
		SetCameraBehindPlayer(playerid), ResetWeapons(playerid);
		return 1;
	}
	if(GetPVarFloat(playerid, "injured_X"))
    {
		SetPlayerPos(playerid, GetPVarFloat(playerid, "injured_X"), GetPVarFloat(playerid, "injured_Y"), GetPVarFloat(playerid, "injured_Z"));
		SetPlayerInterior(playerid, GetPVarInt(playerid, "injured_int"));
        SetPlayerVirtualWorld(playerid, GetPVarInt(playerid, "injured_world"));
        //TogglePlayerControllable(playerid, 0);
        //PlayerInfo[playerid][pBolnica] = 1;
        PlayerInfo[playerid][pInjured] = 1;
        //PlayerInfo[playerid][pInjured] = SetTimerEx("injured", 200, true, "i", playerid);
        ApplyAnimation(playerid, "WUZI", "CS_DEAD_GUY", 4.1, 0, 0, 0, 1, 0, 1);
        SetPlayerHealth(playerid, 9999999);
        for(new i; i < 12; i++) PlayerTextDrawShow(playerid, DEATHTD[playerid][i]);
		return 1;
    }
    if(pData[playerid][pDM] == 1)
    {
        //SpawnUnfrezee(playerid);
  		SpawnDeathMatch(playerid);// jika pemain terbunuh di zona DM, maka dia ada di sana
		SCM(playerid, -1, "Anda Telah Spawn kembali Di zona tempur!");
	}

/*    if(PlayerInfo[playerid][pWanted] >= 1) SetPlayerWantedLevel(playerid, PlayerInfo[playerid][pWanted]);
    if(PlayerInfo[playerid][pBolnica])
	{
		SetPPos(playerid, -628.0311,-920.1096,1436.1736, 359.0371, 8, 6, true);

		//if(1 <= PlayerInfo[playerid][pLevel] <= 3) SetPlayerVirtualWorld(playerid, 6);
		//else if(4 <= PlayerInfo[playerid][pLevel] <= 7) SetPlayerVirtualWorld(playerid, 8);
		//else SetPlayerVirtualWorld(playerid, 9);

		SetPlayerHealthEx(playerid, 10+random(10));

		if(admin_level[playerid] == 0 && admin_logged[playerid] == 0)
  			SPD(playerid,0000,DIALOG_STYLE_MSGBOX, "Rumah sakit",""W"Anda berada di Rumah Sakit Kota Los Santos!\nPergi ke tempat tidur gratis dan gunakan ALT\n\n"W"Perawatan Anda akan memakan waktu beberapa menit. Anda akan dikosongkan setelah pemulihan penuh.", "Baiklah", "");

		return 1;
 	}*/

 	if(GetPVarInt(playerid, "player_leave_as"))
 	{
 	    new shop_id = GetPVarInt(playerid, "player_leave_as") - 1;

 	  	SetPPos(playerid, as_exit_pos[shop_id][0], as_exit_pos[shop_id][1], as_exit_pos[shop_id][2], as_exit_pos[shop_id][3], 0, 0, true);

        DeletePVar(playerid, "player_leave_as");

        return 1;
 	}

	PlayerPlaySound(playerid, 1184 , 0.0, 0.0,0.0);

	new house = -1;

    new hotel_id = PlayerInfo[playerid][pHotel];

	if(GetPlayerHouse(playerid) != -1) house = GetPlayerHouse(playerid);
	if(GetPlayerHouseLodger(playerid) != -1) house = GetPlayerHouseLodger(playerid);

	if((house == -1 && hotel_id == -1) && (PlayerInfo[playerid][pSetSpawn] == 3 || PlayerInfo[playerid][pSetSpawn] == 5))
	{
		LoadingObject1(playerid);
	    PlayerInfo[playerid][pSetSpawn] = 0;
 	}

	if(PlayerInfo[playerid][pMember] == 0 && PlayerInfo[playerid][pSetSpawn] == 4)
	{
		LoadingObject1(playerid);
	    PlayerInfo[playerid][pSetSpawn] = 0;
 	}

    new f_house = -1;

 	if(PlayerInfo[playerid][pFamily] != -1)
 	{
	 	f_house = IsFamilyHaveHouse(PlayerInfo[playerid][pFamily]);

	 	if(PlayerInfo[playerid][pSetSpawn] == 6 && f_house == -1)
		{
			LoadingObject1(playerid);
		 	PlayerInfo[playerid][pSetSpawn] = 0;
		 	SCM(playerid, -1, "Keluarga tidak memiliki rumah, lokasi spawn telah berubah.");
	 	}
 	}
	if(PlayerInfo[playerid][pSetSpawn] == 3)
	{
		LoadingObject1(playerid);
  		entertimer[playerid] = SetTimerEx("enter",3000,false,"i",playerid);
		TogglePlayerControllable(playerid,0);
		return PlayerEnterToHouse(playerid, house, 1);
	}

	if(PlayerInfo[playerid][pSetSpawn] == 4)
	{
		LoadingObject1(playerid);
	    new member = PlayerInfo[playerid][pMember];
        entertimer[playerid] = SetTimerEx("enter",3000,false,"i",playerid);
		TogglePlayerControllable(playerid,0);
		return SetPPos(playerid, FracInfo[member][fSpawn][0], FracInfo[member][fSpawn][1], FracInfo[member][fSpawn][2], FracInfo[member][fSpawn][3], FracInfo[member][fInt], FracInfo[member][fVw], true);
	}
	if(PlayerInfo[playerid][pSetSpawn] == 5) return PlayerEnterToHotelNumber(playerid, hotel_id);
	if(PlayerInfo[playerid][pSetSpawn] == 6) return PlayerEnterToHouse(playerid, f_house, 1);

    if(PlayerInfo[playerid][pSetSpawn] == 0) return StockSpawn(playerid);
	if(PlayerInfo[playerid][pSetSpawn] == 1) return StockSpawn(playerid);
	StockSpawn(playerid);
  	return 1;
}
public OnPlayerDeath(playerid, killerid, reason)
{
    //MICIN ILEGAL
	DutyMicin[playerid] = 0;
    CPMicin[playerid] = 0;
    CrateModel[playerid] = -1;
    IsCrates[playerid] = 0;
    //PAKET ILEGAL
	if(AmbilPacket[playerid] == 1)
	{
	    new Float:x, Float:y, Float:z;
	    GetPlayerPos(playerid, x, y, z);
        StatusPacket = 1;
        AmbilPacket[playerid] = 0;
        PosPacket[0] = x;
	    PosPacket[1] = y;
	    PosPacket[2] = z;
	    DestroyDynamicPickup(IDPacket);
	    DestroyDynamic3DTextLabel(PacketLabel);
	    PacketLabel = CreateDynamic3DTextLabel("[PACKET ILEGAL]\n{FFFFFF}/takepacket", COLOR_BLUE, x, y, z, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
	    IDPacket = CreateDynamicPickup(1575, 23, x, y, z, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
        SendClientMessageToAll(COLOR_YELLOW, "Paket Ilegal Terjatuh Cepat Cari");
     }
	//job petani padi
	DutyGanjos[playerid] = 0;
    CPGanjos[playerid] = 0;
    BibitGanjos[playerid] = 0;
    PanenGanjos[playerid] = 0;
    
	//job ayam
	KerjaAyam[playerid] = 0;
	PutAyam[playerid] = 0;
    TakenAyam[playerid] = 0;
	//Drugs
	PlayerDrugData[playerid][DrugsCooldown] = 0;

    if(RegenTimer[playerid] != -1)
	{
	    KillTimer(RegenTimer[playerid]);
	    RegenTimer[playerid] = -1;
	}

	if(EffectTimer[playerid] != -1)
	{
	    KillTimer(EffectTimer[playerid]);
	    EffectTimer[playerid] = -1;
	}

	foreach(new i : Player)
	{
	    if(PlayerDrugData[i][DrugsOfferedBy] == playerid)
	    {
	        PlayerDrugData[i][DrugsOfferedBy] = INVALID_PLAYER_ID;
	        ShowPlayerDialog(i, -1, DIALOG_STYLE_MSGBOX, "Title", "Content", "Button1", "Button2");

            SendClientMessage(i, 0x3498DBFF, "DRUGS: {FFFFFF}The player who sent you an offer died.");
	    }
	}
    if(killer_id[playerid] != INVALID_PLAYER_ID)
	{
		killerid = killer_id[playerid];
		reason = killer_weapon[playerid];
	}

	if(player_fuel_steal[playerid] != 0) RemovePlayerAttachedObject(playerid, 3);

    follow_id[playerid] = INVALID_PLAYER_ID;

	if(player_take_collector[playerid] != -1)
	{
	    RemovePlayerAttachedObject(playerid, 4);
	}

    RemovePlayerAmmoBox(playerid, false);

	if(player_rob_id[playerid] != -1)
	{
	    new rob_id = player_rob_id[playerid];

	    format(format_string, 96, "[ROB]: "W"%s {6495ED}tidak mengatasi tugas itu.", GetPlayerNameEx(playerid));
	    SendMessageToRobPlayers(rob_id, 0x6495EDff, format_string);

    	PlayerStopRobbery(playerid);
	}

    RemovePlayerMask(playerid);

	SetPlayerHealth(playerid, 0.0);

	RemovePlayerFromContainer(playerid);

	DestroyDeliveryObject(playerid);

    foreach(Player, i) if(!IsPlayerMobile(i) && admin_level[i]) SendDeathMessageToPlayer(i, killerid, playerid, reason);

    if(player_race_reg{playerid}) PlayerLeaveRace(playerid);

	if(killerid != INVALID_PLAYER_ID && player_reg_pb[playerid] != -1 && player_reg_pb[killerid] != -1 && player_reg_pb[playerid] != player_reg_pb[killerid])
	{
		player_kills_pb[killerid]++;

		if(player_reg_pb[killerid] == 0) pb_blue_kills++;
		if(player_reg_pb[killerid] == 1) pb_red_kills++;

		foreach(Player, i)
			if(player_reg_pb[i] != -1)
   				SendDeathMessageToPlayer(i, killerid, playerid, reason);
	}

    //CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
    player_croupier_job{playerid} = 0;

    player_fuel_steal[playerid] = 0;

        //    new Float: xx, Float: yy;
	GetPlayerPos(playerid, xx, yy, zz);
	SetPVarFloat(playerid, "injured_X", xx);
	SetPVarFloat(playerid, "injured_Y", yy);
	SetPVarFloat(playerid, "injured_Z", zz);
	SetPVarInt(playerid, "injured_int", GetPlayerInterior(playerid));
	SetPVarInt(playerid, "injured_world", GetPlayerVirtualWorld(playerid));
	SetPlayerData(playerid, pInjured, 1);
	update_int_mysql(playerid, "pInjured", 1);
    SetPlayerData(playerid, pDelayDeath, 3 * 60);
	update_int_mysql(playerid, "pDelayDeath", 3 * 60);
 	ApplyAnimation(playerid, "WUZI", "CS_DEAD_GUY", 4.1, 0, 0, 0, 1, 0, 1);
  	SetPlayerHealth(playerid, 9999999);
  	for(new i; i < 12; i++) PlayerTextDrawShow(playerid, DEATHTD[playerid][i]);
  	
	if(killerid != INVALID_PLAYER_ID)
	{
		if(IsACop(killerid) && PlayerInfo[playerid][pWanted])
		{
			new place = 0;

		    if(PlayerInfo[killerid][pMember] == FRACTION_LSPD) place = 1;
			else if(PlayerInfo[killerid][pMember] == FRACTION_FBI) place = 2;
			else if(PlayerInfo[killerid][pMember] == FRACTION_SFPD) place = 3;
			else if(PlayerInfo[killerid][pMember] == FRACTION_LVPD) place = 4;

			SetPlayerPrison(playerid, place, (PlayerInfo[playerid][pWanted]*10)*60);

			SetPlayerWantedLevel(playerid, 0);

			SCMF(killerid, 0xFFFF00FF, "Anda menanam %s[%d] pada %d detik", Name(playerid), playerid, PlayerInfo[playerid][pPrison]);
		    SCMF(playerid, 0xFFFF00FF, "%s[%d] menanam Anda %d detik", Name(killerid), killerid, PlayerInfo[playerid][pPrison]);

			GivePlayerPayCheck(killerid, 300);
			PlayerInfo[playerid][pWanted] = 0;
			PlayerCuffed[playerid] = 0;

			if(follow_id[playerid] != INVALID_PLAYER_ID)
			{
				ClearAnimations(playerid, true);
		        follow_id[playerid] = INVALID_PLAYER_ID;
			}
		}

	    if(IsAArmy(playerid) && player_quest_info[killerid][quest_id] == GQUEST_TYPE_KEYSTEAL && player_quest_info[killerid][quest_status] == 1)
        {
            new Float: x, Float: y, Float: z;

            GetPlayerPos(playerid, x, y, z);

            if(player_quest_info[killerid][quest_pickup_id] != 0) DestroyDynamicPickup(player_quest_info[killerid][quest_pickup_id]);

            player_quest_info[killerid][quest_pickup_id] = CreateDynamicPickup(1581, 23, x, y, z, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), killerid);

            //SCM(killerid, COLOR_YELLOW, "Militer menjatuhkan kunci, segera mengambilnya.");
        }

		foreach(new i : capture_zone_list)
		{
			if(!PlayerToKvadrat(playerid,GZInfo[i][gPos][0], GZInfo[i][gPos][1],GZInfo[i][gPos][2],GZInfo[i][gPos][3])) continue;
			if(!PlayerToKvadrat(killerid,GZInfo[i][gPos][0], GZInfo[i][gPos][1],GZInfo[i][gPos][2],GZInfo[i][gPos][3])) continue;

			new gang_killer = PlayerInfo[killerid][pMember];
			new gang_killed = PlayerInfo[playerid][pMember];

            if(gang_killer == GZInfo[i][gFraction] && gang_killed == GZInfo[i][gAttack]) GZInfo[i][gKills][0]++;
			if(gang_killer == GZInfo[i][gAttack] && gang_killed == GZInfo[i][gFraction]) GZInfo[i][gKills][1]++;

			format(format_string, 144, "[G] %s terbunuh %s", GetPlayerNameEx(killerid), GetPlayerNameEx(playerid));
			SendFrac(gang_killer, -1, format_string);
			SendFrac(gang_killed, -1, format_string);

			break;
		}
	}

	if(!IsAArmy(playerid) && PlayerInfo[playerid][pPrison] == 0 && player_reg_pb[playerid] == -1 && duel_offer[playerid] == INVALID_PLAYER_ID)
	{
		PlayerInfo[playerid][pInjured] = 1;
	}

    PlayerLeaveHospitalBed(playerid);

    if(rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
	{
		SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
		player_jobvehicle_time[playerid] = 0;
		rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
	}
/*	if(pTemp[playerid][pWork] == 2)
	{
	    PlayerInfo[playerid][pWork] = 0;
		DeletePVar(playerid, "Derevo");
		PlayerInfo[playerid][pLessProgress] = 0;
		PlayerInfo[playerid][pLessStatus] = 0;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 3)) RemovePlayerAttachedObject(playerid, 3);
		if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
	}*/
	//

	DisablePlayerCheckpoint(playerid);
    DisablePlayerRaceCheckpoint(playerid);
	return 1;
}

public OnVehicleSpawn(vehicleid)
{
    for(new wiu; wiu<5; wiu++) if(sirenPD[wiu][vehicleid] != 0)
	{
		DestroyDynamicObject(sirenPD[wiu][vehicleid]);
	    sirenPD[wiu][vehicleid] = 0;
	}
    if(VehInfo[vehicleid][vStatus] == 1) Fuell[vehicleid] = MAX_VEHICLE_FUEL;

	if(taxi_veh_3d[vehicleid] != Text3D:0)
	{
		DestroyDynamic3DTextLabel(taxi_veh_3d[vehicleid]);
        taxi_veh_3d[vehicleid] = Text3D:0;
	}

	if(army_veh_pickup[vehicleid] != 0)
	{
	    army_veh_amount[vehicleid] = 0;

	    DestroyDynamic3DTextLabel(army_veh_3d[vehicleid]);
	    DestroyDynamicPickup(army_veh_pickup[vehicleid]);
	    army_veh_pickup[vehicleid] = 0;
	}

    pizza_veh_have{vehicleid} = 0;

	if(bd_veh_obj[vehicleid] != 0)
	{
	    DestroyDynamicObject(bd_veh_obj[vehicleid]);
	    bd_veh_obj[vehicleid] = 0;
	}

    for(new i; i < 5; i++) VehInfo[vehicleid][vEngineTune][i] = VehInfo[vehicleid][vBrakeTune][i] = 0;

    ClearVehicleData(vehicleid);

    if(VehInfo[vehicleid][vFr] == 4)
    {
        trash_vehicle_owner[vehicleid] = INVALID_PLAYER_ID;
        trash_vehicle_amount[vehicleid] = 0;

		if(_:trash_vehicle_3d[vehicleid] != 0)
		{
		    DestroyDynamic3DTextLabel(trash_vehicle_3d[vehicleid]);
			trash_vehicle_3d[vehicleid] = Text3D:0;
		}
	}
	if(VehInfo[vehicleid][vFr] == 5)
    {
        collector_vehicle_owner[vehicleid] = INVALID_PLAYER_ID;
        collector_vehicle_amount[vehicleid] = 0;
	}
	if(gruz_3d[vehicleid] != Text3D:0)
	{
	    DestroyDynamic3DTextLabel(gruz_3d[vehicleid]);
		gruz_3d[vehicleid] = Text3D:0;
	}

    //membersihkan
	foreach(new i: Player)
	{
	    if(vehicleid == rent_vehicle_id[i])
        {
            rent_vehicle_id[i] = INVALID_VEHICLE_ID;
            vehicle_rent_owner[vehicleid] = INVALID_PLAYER_ID;

            DestroyVehicle(vehicleid);

            break;
        }

        if(pTemp[i][pBusID] == vehicleid)
        {
            pTemp[i][pBusID] = 0;
         	player_route_id[i] = 0;
            busPos{i} = 0;
            Send(i, 0xafafafff, "Kendaraan kerja Anda telah ditarik!");
            break;
        }
        else if(pTemp[i][puborkacar] == vehicleid)
        {
            pTemp[i][puborkacar] = 0;
         	player_route_id[i] = 0;
            uborkaPos{i} = 0;
            Send(i, 0xafafafff, "Kendaraan kerja Anda telah ditarik!");
            break;
        }
	}
	SetVehicleParamsEx(vehicleid,0,0,0,0,0,0,0);
	return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
	new driver = VehiclePlayer(vehicleid);

	foreach(new i : admin_list) {
		if(IsWatchVehLog[i]) {
			SCMF(i, COLOR_YELLOW, "VEH-LOG:{FFFFFF} %s[%i] meledakkan kendaraan %s", Name(killerid), killerid, VehicleNames[GetVehicleModel(vehicleid) - 400]);
		}
	}

    for(new i; i < MAX_ROBBS; i++)
    {
        if(rob_info[i][r_vehicleid] != vehicleid) continue;

        SendMessageToRobPlayers(i, 0x6495EDff, "[ROB]: "W"Mobil {6495ED}meledak, perampokan gagal.");

        for(new x; x < 2; x++) if(rob_info[i][r_player][x] != INVALID_PLAYER_ID) PlayerStopRobbery(rob_info[i][r_player][x]);
    }

    // if(driver != -1) // mendapat id pemain yang mobilnya, jika -1 maka seri
    // {
    //     new value = 500 + random(100000);

    //     new u_car = PlayerInfo[driver][pUseCar];

    //     GivePlayerMoneyEx(driver, -value, "perbaikan mobil");
    //     SCMF(driver, -1, "Transportasi pribadi Anda telah rusak. Biaya perbaikan dalam {43CD80}%d$.", value);

	// 	CarInfo[driver][cHeal][u_car] = 1000.0;
	// 	CarInfo[driver][cDamagePanel][u_car] = 0, CarInfo[driver][cDamageDoors][u_car] = 0;
	// 	CarInfo[driver][cDamageLights][u_car] = 0, CarInfo[driver][cDamageTires][u_car] = 0;
	// 	return 1;
   	// }
    if(driver != -1) // mendapat id pemain yang mobilnya, jika -1 maka seri
    {
        new value = 500 + random(3500);

        new u_car = PlayerInfo[driver][pUseCar];

        GivePlayerMoneyEx(driver, -value, "perbaikan mobil");
        SCMF(driver, -1, "Transportasi pribadi Anda telah rusak. Biaya perbaikan dalam {43CD80}%d$.", value);

		CarInfo[driver][cHeal][u_car] = 1000.0;
		CarInfo[driver][cDamagePanel][u_car] = 0, CarInfo[driver][cDamageDoors][u_car] = 0;
		CarInfo[driver][cDamageLights][u_car] = 0, CarInfo[driver][cDamageTires][u_car] = 0;
		return 1;
   	}
    foreach(new i : Player)
	{
        if(vehicleid == rent_vehicle_id[i])
        {
            rent_vehicle_id[i] = INVALID_VEHICLE_ID;
            vehicle_rent_owner[vehicleid] = INVALID_PLAYER_ID;

            DestroyVehicle(vehicleid);
        }

		if(vehicleid == rent_job_vehicle[i] && pTemp[i][pTrucker] != -1)
		{
			SendClientMessage(i, -1, !"Trukmu hancur!");
	   		Trucker_StopJob(i);
	   		DisablePlayerCheckpoint(i);
	   		break;
		}
		if(vehicleid == rent_job_vehicle[i] && pTemp[i][pPilot] != 0)
		{
			SendClientMessage(i, -1, !"Pesawatmu hancur!");
			pTemp[i][pPilot] =
	   		pTemp[i][pPilot_Checkpoint] = 0;
	   		//pTemp[i][pPilotPlaneID] = -1;
	   		rent_job_vehicle[i] = INVALID_VEHICLE_ID;
	   		DisablePlayerRaceCheckpoint(i);
   			break;
		}
	}
	return 1;
}

public OnPlayerText(playerid, text[])
{
    if(OnDuty[playerid] == 1)
    {
        format(String, sizeof(String), "{FF0000}%s : {FFFFFF}(( %s ))", PlayerInfo[playerid][pAname], text);
        ProxDetector(20.0, playerid, String,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
        new animation = random(4);
		switch(animation)
		{
			case 0: ApplyAnimation(playerid, "GHANDS", "GSIGN5",4.1,0,1,1,1,1,1);
			case 1: ApplyAnimation(playerid, "GHANDS", "GSIGN4",4.1,0,1,1,1,1,1);
			case 2: ApplyAnimation(playerid, "GHANDS", "GSIGN1",4.1,0,1,1,1,1,1);
			case 3: ApplyAnimation(playerid, "PED", "IDLE_CHAT",4.1,0,1,1,1,1,1);
		}
		SetTimerEx("ClearAnim", 100*strlen(text), false, "d", playerid);
        return 0;
    }
    
    if(PlayerInfo[playerid][pLogin] == 0) return 0;
    if(GetPVarInt(playerid,"AntiSbiv") > gettime()) return false;

    if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara.") & 0;

    /*CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK);
    if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
	{
		SendClientMessage(playerid, 0x6B6B6BFF, "Jangan sampai banjir");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SendClientMessage(playerid, 0x6B6B6BFF, "Harap tunggu beberapa detik...");

		return 0;
	}*/
	if(strlen(text) > 90) return 0;
    if(PlayerInfo[playerid][pMuted] > 0)
	{
	    SetPlayerChatBubble(playerid,"Terdeteksi Flood",COLOR_PURPLE,15.0,10000);
 		PlayerMuted(playerid), SetPVarInt(playerid,"AntiFlood",gettime() + 1);
 		return 0;
 	}

	if(PlayerInfo[playerid][pInjured] == 1)
	{
	Send(playerid, COLOR_LIGHTRED, "Ketika Pingsan Tidak Bisa berbicara");
	return 0;
	}
 	if(CheckIP(text))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid), playerid, text);
		return SendAdminMessage(COLOR_LIGHTRED, format_string) & 0;
	}

	if(player_news_live[playerid])
	{
		if(PlayerInfo[playerid][pMember] == FRACTION_NEWS) format(format_string, 188, "[NEWS] %s: %s", GetPlayerNameEx(playerid), text);
		else format(format_string, 188, "[NEWS] | Tamu %s: %s", GN(playerid), text);
		return SendClientMessageToAll(0xFF8C00FF, format_string) & 0;
	}

    if(Mobile[playerid] != -1)
	{
		if(IsPlayerConnected(Mobile[playerid]) && Mobile[Mobile[playerid]] == playerid)
		
		SCMF(Mobile[playerid], COLOR_YELLOW, "[Nomor telepon] %s[%d]: %s", ReturnName(playerid), playerid, text);

        ProxDetector(10.0,playerid,text,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);

		return false;
	}
	SetPlayerChatBubble(playerid, text, 0x6495EDFF, 18.0, 5000);

	format(format_string, 188, "%s says: %s", ReturnName(playerid), text);
    ProxDetector(20.0, playerid, format_string, COLOR_RAZGOVOR1,COLOR_RAZGOVOR2,COLOR_RAZGOVOR3,COLOR_RAZGOVOR4,COLOR_RAZGOVOR5);
    new animation = random(4);
	switch(animation)
	{
		case 0: ApplyAnimation(playerid, "GHANDS", "GSIGN5",4.1,0,1,1,1,1,1);
		case 1: ApplyAnimation(playerid, "GHANDS", "GSIGN4",4.1,0,1,1,1,1,1);
		case 2: ApplyAnimation(playerid, "GHANDS", "GSIGN1",4.1,0,1,1,1,1,1);
		case 3: ApplyAnimation(playerid, "PED", "IDLE_CHAT",4.1,0,1,1,1,1,1);
	}
	SetTimerEx("ClearAnim", 100*strlen(text), false, "d", playerid);
    //
	return 0;
}
public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
    new Float: carhp;
    GetVehicleHealth(vehicleid, carhp);

	for(new i; i < MAX_PLAYER_VEHICLES; i++)
	{
	    if(GetPlayerVehicleID(playerid) == player_home_car[playerid][i])
		{
			new panels, doors1, lights1, tires;
			if(player_veh_damage[playerid] == 0)
			{
				if(carhp > 300 && carhp < 700)
				{
					if(CarInfo[playerid][cSost][i] > 0) return CarInfo[playerid][cSost][i] --;
					player_veh_damage[playerid] = 5;
				}
			}
			GetVehicleDamageStatus(vehicleid, panels, doors1, lights1, tires);

			CarInfo[playerid][cDamagePanel][i] = panels;
			CarInfo[playerid][cDamageDoors][i] = doors1;
			CarInfo[playerid][cDamageLights][i] = lights1;
			CarInfo[playerid][cDamageTires][i] = tires;
			CarInfo[playerid][cHeal][i] = carhp;
			return 1;
		}
	}

	if(IsPlayerInAnyVehicle(playerid))
    {
        new v = GetPlayerVehicleID(playerid);

		if(VehInfo[v][vFr] != 0)
		{
	    	if(player_veh_damage[playerid] == 0)
			{
		    	if(carhp > 300 && carhp < 600)
				{
					if(VehInfo[v][vSost] > 0) VehInfo[v][vSost] -= 1;
                    player_veh_damage[playerid] = 5;
				}
			}
		}
	}
	return 1;
}
public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
    if(PlayerInfo[playerid][pLogin] == 0) return 0;

	if(PlayerInfo[playerid][pMember] == FRACTION_NEWS)
		for(new i; i < MAX_ADVERTS; i++)
			if(AdvertInfo[i][aEditor] == playerid)
				AdvertInfo[i][aEditor] = INVALID_PLAYER_ID;

    printf("[CMD] %s[%i]: %s", GetPlayerNameEx(playerid), playerid, cmd);

    if(GetPVarInt(playerid,"AntiSbiv") > gettime())
	{
	    SCMF(playerid, COLOR_GREY, "Anda belum dapat menggunakan perintah: %i detik.", GetPVarInt(playerid,"AntiSbiv") - gettime());
		return false;
    }

    /*CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);
	if(pDialog[playerid] && strfind(cmd, "rentcar") == -1)
	{
		SendClientMessage(playerid,0xafafafff,"Anda tidak dapat menggunakan perintah saat dialog terbuka!");
		return 0;
	}
	if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
	{
		SendClientMessage(playerid, 0x6B6B6BFF, "Jangan sampai spam");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SendClientMessage(playerid, 0x6B6B6BFF, "Harap tunggu beberapa detik...");

		return 0;
	}*/
    return 1;
}
stock IsVehicleOccupiedEx(vehicleid)
{
	foreach(Player, i) if(GetPlayerState(i) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(i) == vehicleid) return 1;
	return 0;
}
public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	/*if(CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK))
	{
		SendClientMessage(playerid, 0x6B6B6BFF, "Jika Anda melanjutkan, Anda akan terputus dari server");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SendClientMessage(playerid, 0x6B6B6BFF, "Harap tunggu beberapa detik...");
		return 0;
	}*/
	
	if(ispassenger == 0 && vehicle_driver[vehicleid] != INVALID_PLAYER_ID)
	{
	    new Float: x, Float: y, Float: z;

    	GetPlayerPos(playerid, x, y, z);
    	SetPlayerPos(playerid, x, y, z);

    	SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Perhatikan", "{FFFFFF}Kendaraan ini sibuk!", "Tutup", "");

    	return 0;
	}


	GetVehicleParamsEx(vehicleid, engine,lights,alarm,doors,bonnet,boot,objective);

	if(doors || player_take_collector[playerid] != -1 || player_take_trash[playerid] != -1)
	{
		new Float: x, Float: y, Float: z;

		GetPlayerPos(playerid, x, y, z);
		SetPlayerPos(playerid, x, y, z);

		if(doors) SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Perhatikan", "{FFFFFF}Pintu ditutup!", "Tutup", "");

		else SCM(playerid, COLOR_GREY, "Sesuatu di tangan Anda menghentikan Anda dari duduk.");

		return 0;
	}

 	if(pTemp[playerid][pWork] == 1 || pTemp[playerid][pWork] == 2 || pTemp[playerid][pWork] == 3)
	{
		Send(playerid, COLOR_GREY, "Anda tidak bisa mendapatkan t / s saat bekerja");
		RemovePlayerFromVehicleEx(playerid);
		return ClearAnimations(playerid);
	}
	return 1;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
    //CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
    if(rent_job_vehicle[playerid] == vehicleid) player_jobvehicle_time[playerid] = 120;

	if(PlayerInfo[playerid][pJob] == WORK_TYPE_DELIVERY && rent_job_vehicle[playerid] == vehicleid) DisablePlayerCheckpoint(playerid);

	if(pizza_veh_have{vehicleid}) pizza_veh_time{vehicleid} = 30;

	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
	    if(player_road_school[playerid] == 2 && VehInfo[vehicleid][vStatus] == 67)
	    {
	        player_school_back[playerid] = 60;
	        SendClientMessage(playerid, COLOR_GREY, "Kembali ke transportasi atau ujian akan gagal.");

	        SetPVarInt(playerid, "school_vehicle", vehicleid);
	    }

        player_taxi_passanger[playerid] = INVALID_PLAYER_ID;
		vehicle_driver[vehicleid] = INVALID_PLAYER_ID;
	}
	else if(GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
	{
     	new driver_id = vehicle_driver[vehicleid];

	    if(driver_id != INVALID_PLAYER_ID && (70 <= PlayerInfo[driver_id][pJob] <= 72))
	    {
            if(player_taxi_passanger[driver_id] == playerid)
            {
                player_taxi_passanger[driver_id] = INVALID_PLAYER_ID;

				SearchNextClientForTaxi(vehicleid, playerid);
            }
		}
	}

    if(PlayerInfo[playerid][pJob] == 4 && trash_vehicle_owner[vehicleid] == playerid)
    {
        trash_player_back[playerid] = 120;
        //SendClientMessage(playerid, COLOR_RED, "Anda memiliki 90 detik untuk kembali ke transportasi atau akan hilang!");
    }
    if(PlayerInfo[playerid][pJob] == 5 && collector_vehicle_owner[vehicleid] == playerid)
    {
        collector_player_back[playerid] = 120;
        //SendClientMessage(playerid, COLOR_RED, "Anda memiliki 90 detik untuk kembali ke transportasi atau akan hilang!");
    }
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
    //CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
    if(newstate == PLAYER_STATE_ONFOOT) // jika pemain berjalan dan dia keluar dari mobil
 	{//membersihkan

 	    if(GetPVarInt(playerid, "get_vehicle_drive"))
 	    {
 	        new old_vehicleid = GetPVarInt(playerid, "get_vehicle_drive");

 	        vehicle_driver[old_vehicleid] = INVALID_PLAYER_ID;

 	        DeletePVar(playerid, "get_vehicle_drive");
 	    }

        if(PlayerInfo[playerid][pJob] == 2 && pTemp[playerid][pBusID] != 0)
        {
            DisablePlayerCheckpoint(playerid), pTemp[playerid][bus_timer] = 15;
            Send(playerid, COLOR_REDD, "Jika Anda tidak kembali ke bus dalam waktu 15 detik, itu akan ditarik!");
        }
        else if(PlayerInfo[playerid][pJob] == 3 && pTemp[playerid][puborkacar] != 0)
        {
            DisablePlayerCheckpoint(playerid), pTemp[playerid][uborka_timer] = 15;
            Send(playerid, COLOR_REDD, "Jika Anda tidak kembali ke kendaraan pembersih dalam 15 detik, itu akan ditarik!");
        }

        if(player_news_live[playerid])
		{
		    format(format_string, 144, "[R] %s[%i] meninggalkan udara sendirian.", GetPlayerNameEx(playerid), playerid);
	        SendFrac(FRACTION_NEWS, COLOR_GREEN, format_string);

		    SCM(playerid, COLOR_WHITE, "Anda meninggalkan siaran sendiri.");
		    player_news_live[playerid] = false;
		}

  		return 1;
  		//
  	}
	if(newstate == PLAYER_STATE_DRIVER)
	{
        if((GetTickCount()-GetPVarInt(playerid, "cartime")) < 1000) // enters veh as driver faster than 1 once
        {
            SetPVarInt(playerid, "carspam", GetPVarInt(playerid, "carspam")+1);
            if(GetPVarInt(playerid, "carspam") >= 5) // allows 5 seconds leeway to compensate for glitching, then kicks
            {
                new name[24];
                new string128[128];
                GetPlayerName(playerid,name,24);
                format(string128,sizeof(string128),"[hack][carspam] Kicked [%i]%s for CAR SPAM hacks",playerid,name);
                SendClientMessageToAll(0xFFFF00AA,string128);
                printf(string128);
                return Kick(playerid);
            }
        }
        SetPVarInt(playerid, "cartime", GetTickCount());
    }
  	if(newstate == PLAYER_STATE_DRIVER) // Driver pemain
	{
	    new vehicleid = GetPlayerVehicleID(playerid);

	    vehicle_driver[vehicleid] = playerid;

	    if(vehicle_rent_owner[vehicleid] != INVALID_PLAYER_ID && vehicle_rent_owner[vehicleid] != playerid)
		{
	        SCM(playerid, COLOR_GREY, "Anda tidak dapat naik transportasi sewaan orang lain.");
	        return RemovePlayerFromVehicleEx(playerid);
	    }

	    SetPVarInt(playerid, "get_vehicle_drive", vehicleid);
  		if(IsVehicleHaveFuel(vehicleid)) SCM(playerid, -1, "Untuk Menyalakan Mesin kendaraan gunakan: /engine / Tombol Y");
	    if(IsVehicleHaveFuel(vehicleid)) SCM(playerid, -1, "Untuk Buka Kunci kendaraan gunakan: /lock");
	    if(IsVehicleHaveFuel(vehicleid)) SCM(playerid, -1, "Jika Tidak Muncul Spedometer /showsp");

	    if((IsABike(vehicleid) || CarLicence(vehicleid)) && IsVehicleHaveFuel(vehicleid))
		{
			if(PlayerInfo[playerid][pLicenses][0] < 1 && !(1 <= player_road_school[playerid] <= 2) || (1 <= player_road_school[playerid] <= 2) && VehInfo[vehicleid][vStatus] != 67)
			{
			    Send(playerid, COLOR_GREY, "Anda tidak memiliki SIM!");
			    return RemovePlayerFromVehicleEx(playerid);
			}
		}

		SetPlayerArmedWeapon(playerid, 0);

		if(IsAPlane(vehicleid))
		{
			if(PlayerInfo[playerid][pLicenses][1] < 1) return RemovePlayerFromVehicleEx(playerid), Send(playerid, COLOR_GREY, "Anda tidak memiliki lisensi untuk transportasi udara!");
   		}
   		if(IsABoat(vehicleid))
		{
			if(PlayerInfo[playerid][pLicenses][2] < 1) return RemovePlayerFromVehicleEx(playerid), Send(playerid, COLOR_GREY, "Anda tidak memiliki lisensi untuk transportasi air!");
   		}

   		if(player_rob_id[playerid] != -1)
   		{
   		    new rob_id = player_rob_id[playerid];

			if(rob_info[rob_id][r_vehicleid] == vehicleid)
			{
			    if(rob_info[rob_id][r_loaded] != 0)
			    {
			        SetPlayerGPS(playerid, 789.8063,-606.8367,16.0630);

			        SendMessageToRobPlayers(rob_id, 0x6495EDff, "[ROB]: Kepala ke "W"tempat {6495ED}penjualan.");
			    }
			    else
			    {
				    if(rob_info[rob_id][r_house] == -1)
				    {
				        /*new try_search = 0;

				        SEARCH_HOUSE:

                        try_search++;

						if(try_search == MAX_HOUSES / 2)
						{
						    new partnerid = GetPlayerRobPartnerID(playerid);

						    if(partnerid != INVALID_PLAYER_ID) PlayerStopRobbery(partnerid);
						    PlayerStopRobbery(playerid);

						    return SCM(playerid, COLOR_GREY, "Tidak ada rumah yang dibeli, perampokan berhenti.");
						}

				        new h_id = random(MAX_HOUSES);

				        if(HouseInfo[h_id][hKlass] != 0 || HouseInfo[h_id][hOwned] == 0) goto SEARCH_HOUSE;*/

						for(new i; i < MAX_HOUSES; i++)
						{
						    if(HouseInfo[i][hKlass] != 0 || HouseInfo[i][hOwned] == 0 || rob_house_obj[i][0] != 0) continue;

				        	rob_info[rob_id][r_house] = i;

							SendMessageToRobPlayers(rob_id, 0xffff00ff, "SMS: Saya mengirimi Anda koordinat rumah yang harus Anda tembus, pergi ke sana. | Pengirim: Marvin Merchants");

							break;
						}

						if(rob_info[rob_id][r_house] == -1)
						{
						    new partnerid = GetPlayerRobPartnerID(playerid);

						    if(partnerid != INVALID_PLAYER_ID) PlayerStopRobbery(partnerid);
						    PlayerStopRobbery(playerid);

						    return SCM(playerid, COLOR_GREY, "Semua rumah yang tersedia sudah dirampok.");
						}
				    }

				    new h_id = rob_info[rob_id][r_house];

					SetPlayerGPS(playerid, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey], HouseInfo[h_id][hEntrancez]);
				}
			}
   		}

   		if(quest_vehicle_owner[vehicleid] != INVALID_PLAYER_ID)
   		{
   		    if(quest_vehicle_owner[vehicleid] != playerid)
   		    {
				SCM(playerid, COLOR_GREY, "Ini adalah kendaraan pencarian, Anda tidak dapat menggunakannya.");
   		        return RemovePlayerFromVehicleEx(playerid);
   		    }

   		    callcmd::gquest(playerid);
   		}

   		//
		if(VehInfo[vehicleid][vStatus] == 0)
		{
		    if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_KEYPDSTEAL && player_quest_info[playerid][quest_status] == 1 && player_quest_info[playerid][quest_progress] == 1 && (VehInfo[playerid][vFr] == FRACTION_LSPD || VehInfo[playerid][vFr] == FRACTION_SFPD || VehInfo[playerid][vFr] == FRACTION_LVPD))
		    {
		        //Kami tidak melakukan apa pun sehingga pemain dapat masuk ke mobil polisi dengan pencarian
		        SCM(playerid, COLOR_YELLOW, "[QUEST] {FFFFFF}Gunakan perintah: /kpk untuk meretas komputer");
		    }

		    else if(VehInfo[vehicleid][vFr] != form_fraction[playerid])
			{
				SCMF(playerid, COLOR_GREY, "Anda bukan anggota organisasi %s atau Anda tidak memulai hari kerja!", FracInfo[VehInfo[vehicleid][vFr]][fName]);
				return RemovePlayerFromVehicleEx(playerid);
			}

			else if(VehInfo[vehicleid][vModel] == 433 && VehInfo[vehicleid][vFr] == 3)
			{
			    if(PlayerInfo[playerid][pRank] < 4) return Send(playerid, COLOR_GREY, "Transportasi tersedia dari peringkat 4."), RemovePlayerFromVehicleEx(playerid);
				//GameTextForPlayer(playerid, "~w~USE ~g~/CARM", 3000, 1);
			}

			if(army_veh_pickup[vehicleid] != 0)
			{
			    SPD(playerid, 8613, DIALOG_STYLE_MSGBOX, "Pemuatan amunisi", "Anda ingin menyelesaikan pemuatan amunisi?", "Ya", "Tidak");
			}
		}
		else if(VehInfo[vehicleid][vStatus] == 67)
		{
		    if(player_road_school[playerid] == 0)
			{
			    RemovePlayerFromVehicleEx(playerid);
				return SendClientMessage(playerid, COLOR_GREY, "Anda tidak lulus ujian mengemudi.");
		    }

		    if(player_road_school[playerid] == 1)
		    {
		        player_road_school[playerid] = 2;
		        player_road_id[playerid] = 0;

		        SetPlayerSchoolPoint(playerid);
		    }
		    else if(player_road_school[playerid] == 2)
		    {
		        player_school_back[playerid] = 0;
		        SendClientMessage(playerid, COLOR_GREEN, "Anda kembali dalam transportasi.");

		        DeletePVar(playerid, "school_vehicle");
		    }
		}
		else if(VehInfo[vehicleid][vStatus] == 1)
		{
		    if(PlayerInfo[playerid][pJob] == VehInfo[vehicleid][vFr])
			{
			    if(rent_job_vehicle[playerid] != vehicleid)
				{
  					if(PlayerInfo[playerid][pJob] == 2 && GetVehicleModel(pTemp[playerid][pBusID]) == 431)
					{
					    new newcar = GetPlayerVehicleID(playerid);
					    if(pTemp[playerid][pBusID] == newcar) {
			                if(pTemp[playerid][bus_timer])pTemp[playerid][bus_timer] = 0;
			                ShowPlayerSpeed(playerid);
							SetNextCP(playerid,busPos{playerid});
							return 1;
			            }
					}
					if(PlayerInfo[playerid][pJob] == 3 && GetVehicleModel(pTemp[playerid][puborkacar]) == 574)
					{
		                if(pTemp[playerid][uborka_timer]) pTemp[playerid][uborka_timer] = 0;
		                ShowPlayerSpeed(playerid);
						SetNextCP(playerid,uborkaPos{playerid});
						return 1;
					}
					if(VehInfo[vehicleid][vFr] == 6 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
					{
					    Send(playerid,-1,!"Anda kembali ke truk!");
					}
					else if(VehInfo[vehicleid][vFr] == 7 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
					{
					    Send(playerid,-1,"Anda kembali ke pesawat");
					}
					else if(VehInfo[vehicleid][vFr] == WORK_TYPE_BULLDOZER)
					{
					    bd_player_state[playerid] = 1;

					    UpdatePlayerBulldozerMark(playerid);
					}
					else SPD(playerid, 149, DIALOG_STYLE_MSGBOX, "Penyewaan mobil", ""W"Yakin ingin menyewa kendaraan yang berfungsi?", "Ya", "Tidak"); // pekerjaan lain\nHarga sewa: $500
				}
				else
				{
					if(VehInfo[vehicleid][vFr] == 4) trash_player_back[playerid] = 0;
					if(VehInfo[vehicleid][vFr] == 5) collector_player_back[playerid] = 0;
					if(VehInfo[vehicleid][vFr] == WORK_TYPE_DELIVERY) UpdatePlayerDeliveryMark(playerid);
					if(VehInfo[vehicleid][vFr] == WORK_TYPE_PIZZA) UpdatePlayerPizzaMark(playerid);
					if(VehInfo[vehicleid][vFr] == WORK_TYPE_BULLDOZER)
					{
						if(bd_veh_obj[vehicleid] != 0) bd_player_state[playerid] = 2;

						UpdatePlayerBulldozerMark(playerid);
					}
				}
				GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
				if(engine == 0) SetVehicleParamsEx(vehicleid,1,lights,alarm,doors,bonnet,boot,objective);
    			/*if(VehInfo[vehicleid][vFr] == 6 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
				{
				    Send(playerid,-1,!"Anda kembali ke truk!");
				}*/
			}
			else
			{
		 		Send(playerid, COLOR_GREY, "Transportasi ini tidak tersedia untuk Anda!");
		 		RemovePlayerFromVehicleEx(playerid);
		 		return 1;
		 	}
		}

		ShowPlayerSpeed(playerid);
	}
	if(newstate == PLAYER_STATE_PASSENGER) // penumpang pemain
	{
	    new vehicleid = GetPlayerVehicleID(playerid);
	    //new driver_id = vehicle_driver[vehicleid];

		if(VehInfo[vehicleid][vStatus] == 1)
        {
            if(VehInfo[vehicleid][vFr] == 2)
            {
	            if(PlayerInfo[playerid][pCash] < 50)
	            {
					format(format_string, sizeof(format_string), "{DD90FF}%s[%d] menunjukkan tiket ke supir bus",Name(playerid),playerid);
					ProxDetector(20.0, playerid, format_string, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
					SetPlayerChatBubble(playerid,"menunjukkan tiket ke supir bus",0xDD90FFAA,20.0,10000);
				}
				else GivePlayerMoneyEx(playerid, -25, "perjalanan bus");
			}

			if(70 <= VehInfo[vehicleid][vFr] <= 72) SetPlayerAsClientForTaxi(playerid, vehicleid);
        }
	}
	return 1;
}
public OnPlayerEnterDynamicCP(playerid,checkpointid)
{
    for(new b; b < TotalBizz; b++)
	{
		if(checkpointid == BizzInfo[b][bPickup] && PlayerToPoint(2.0,playerid,BizzInfo[b][bBarX],BizzInfo[b][bBarY],BizzInfo[b][bBarZ]))
		{
		    player_use_bizbar[playerid] = b;
		    if(BizzInfo[b][bType] == 2) PC_EmulateCommand(playerid, "/eat");
		}
	}
	return 1;
}
public OnPlayerEnterCheckpoint(playerid)
{
	if(CPMicin[playerid] == 1)
    {
            CPMicin[playerid] = 0;
            TogglePlayerControllableEx(playerid, 0);
            ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Rob", 4.0, 1, 0, 0, 0, 0, 1);
	        SetTimerEx("TimeMicin", 10000, false, "d", playerid);
       		ShowProgressbar(playerid, "Progress..", 10);
        	SendClientMessage(playerid, COLOR_YELLOW, "Sedang Mengumpulkan Marijuana");
        	return 1;
    }
	if(CPGanjos[playerid] == 1)
    {
    	CPGanjos[playerid] = 2;
    	SetPlayerCheckpoint(playerid, -1067.5440,-1624.8320,76.3671, 1);
        TogglePlayerControllableEx(playerid, 0);
        ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Rob", 4.0, 1, 0, 0, 0, 0, 1);
        SetTimerEx("ClearFreeze", 10000, false, "d", playerid);
        GameTextForPlayer(playerid, "~w~menanam bibit padi", 4000, 3);
    	UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]-1);
		UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]-1);
		UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+1);
    	SendClientMessage(playerid,COLOR_YELLOW, "Silahkan pergi ke tanda selanjutnya");
    	return 1;
    }
    if(CPGanjos[playerid] == 2)
    {
        CPGanjos[playerid] = 3;
        SetPlayerCheckpoint(playerid, -1061.8175,-1625.3054,76.3671, 1);
        TogglePlayerControllableEx(playerid, 0);
        ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Rob", 4.0, 1, 0, 0, 0, 0, 1);
        SetTimerEx("ClearFreeze", 10000, false, "d", playerid);
        GameTextForPlayer(playerid, "~w~menanam bibit padi", 4000, 3);
 		UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]-1);
		UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]-1);
		UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+1);
        return 1;
    }
    if(CPGanjos[playerid] == 3)
    {
       CPGanjos[playerid] = 4;
       SetPlayerCheckpoint(playerid, -1039.3883,-1619.9635,76.3671, 1);
       TogglePlayerControllableEx(playerid, 0);
       ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Rob", 4.0, 1, 0, 0, 0, 0, 1);
       SetTimerEx("ClearFreeze", 10000, false, "d", playerid);
 	   GameTextForPlayer(playerid, "~w~menanam bibit padi", 4000, 3);
 	   UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]-1);
	   UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]-1);
	   UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+1);
       return 1;
    }
    if(CPGanjos[playerid] == 4)
    {
       CPGanjos[playerid] = 5;
       SetPlayerCheckpoint(playerid, -1073.1682,-1624.3367,76.3671, 1);
       TogglePlayerControllableEx(playerid, 0);
       ApplyAnimation(playerid, "ROB_BANK", "CAT_Safe_Rob", 4.0, 1, 0, 0, 0, 0, 1);
       SetTimerEx("ClearFreeze", 10000, false, "d", playerid);
 	   GameTextForPlayer(playerid, "~w~menanam bibit padi", 4000, 3);
 	   UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]-1);
	   UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]-1);
	   UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+1);
       return 1;
    }
    if(CPGanjos[playerid] == 5)
    {
       CPGanjos[playerid] = 0;
       PanenGanjos[playerid] = 1;
       ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
       SetPlayerAttachedObject(playerid, 5, 2901, 3, 0.1, 0.1, -0.1, 0.0, 270.0, 0.0, 1, 1, 1, 0xFF00FF00);
       GameTextForPlayer(playerid, "~w~Berhasil Memanen padi", 4000, 3);
       SendClientMessage(playerid,COLOR_YELLOW, "Letakan Hasil Panen Digudang, /gpsgudang");
    }
	new vehicleid = GetPlayerVehicleID(playerid);

    //CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);

	if(PlayerInfo[playerid][pJob] == 2 && pTemp[playerid][pBusID] != 0 && GetPlayerVehicleID(playerid) == pTemp[playerid][pBusID])
    {
        new	pos = busPos{playerid}, route = player_route_id[playerid];

        if(gBusCPs[route][pos][0] == gBusCPs[route][pos+1][0] && gBusCPs[route][pos][1] == gBusCPs[route][pos+1][1])
        {
            format(format_string,24+100,"Bus tiba di stasiun, berangkat dalam 10 detik!");//,r_name);
            ProxDetector(30.0,playerid,format_string,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff,0x44b2ffff);
            SetTimerEx("bus_stop",10000,false,"ii",playerid,route);
            DisablePlayerCheckpoint(playerid);
            return 1;
        }
        if(pos == 99 || gBusCPs[route][pos+1][0] == 0.0) busPos{playerid} = 0;
		else busPos{playerid}++;
		SetNextCP(playerid,busPos{playerid});
    }

    if(vehicleid != INVALID_VEHICLE_ID && player_product_id[playerid] != -1)
    {
        new order_id = player_product_id[playerid];

		new amount = vehicle_load_prod[vehicleid];

        new reward = amount;

        new bool: is_product = GetVehicleModel(vehicleid) == 414 ? true : false;

        if(is_product && PlayerToPoint(15.0, playerid, BizzInfo[order_id][bEntranceX], BizzInfo[order_id][bEntranceY], BizzInfo[order_id][bEntranceZ]))
        {
            if(amount == 0) return SCM(playerid, COLOR_GREY, "Anda belum mengunduh produk(/load).");

            BizzInfo[order_id][bProducts] += amount;

            SaveBizzPer(order_id, "bProducts", BizzInfo[order_id][bProducts]);

            SCMF(playerid, COLOR_GREEN, "Anda dibongkar %i pendapatan produk: $%i", amount, reward);

			GivePlayerMoneyEx(playerid, reward, "pendapatan untuk produk");

            vehicle_load_prod[vehicleid] = 0;
            player_product_id[playerid] = -1;
		}

		if(!is_product && PlayerToPoint(15.0, playerid, BizzAInfo[order_id][aAreaFillX], BizzAInfo[order_id][aAreaFillY], BizzAInfo[order_id][aAreaFillZ]))
        {
            if(amount == 0) return SCM(playerid, COLOR_GREY, "Anda belum memuat bahan bakar(/load).");

            BizzAInfo[order_id][aProducts] += amount;

            SaveABizzPer(order_id, "aProducts", BizzAInfo[order_id][aProducts]);

            SCMF(playerid, COLOR_GREEN, "Anda dibongkar %i pendapatan bahan bakar: $%i", amount, reward);

            GivePlayerMoneyEx(playerid, reward, "pendapatan bahan bakar");

            vehicle_load_prod[vehicleid] = 0;
            player_product_id[playerid] = -1;
		}
    }

    if(IsPlayerInAnyVehicle(playerid) && rent_job_vehicle[playerid] == GetPlayerVehicleID(playerid) && pTemp[playerid][pTrucker] > -1 && PlayerInfo[playerid][pJob] == 6)
	{
		switch(pTemp[playerid][pTrucker])
		{
			case 0:
			{
				TogglePlayerControllable(playerid, false);
				SPD(playerid, 232, DIALOG_STYLE_INPUT, CAPTION_NUMBER_OF_CARGO, INFO_NUMBER_OF_CARGO, ">", "X");
			}
		 	case 1:
		 	{
				TogglePlayerControllable(playerid, false);
				SendClientMessage(playerid, -1, !"Tunggu bongkar muat");
				SetTimerEx("@TruckerTimer", pTemp[playerid][pTrucker_Unit]*2, false, "i", playerid);
			}
		}
	}

	if(PlayerInfo[playerid][pJob] == WORK_TYPE_BULLDOZER && VehInfo[vehicleid][vFr] == WORK_TYPE_BULLDOZER)
	{
		if(bd_player_state[playerid] == 1)
		{
		    TogglePlayerControllable(playerid, false);

		    SetTimerEx("LoadPlayerBulldozer", 3000, false, "i", playerid);

		    SCM(playerid, -1, "Tunggu sampai buldoser selesai memuat.");
		}
		else if(bd_player_state[playerid] == 2)
		{
		    DestroyDynamicObject(bd_veh_obj[vehicleid]);
		    bd_veh_obj[vehicleid] = 0;

		    bd_player_state[playerid] = 1;

		    new reward = 200 + random(200);

		    SCMF(playerid, -1, "Ditambahkan ke gaji: $%i, akan dikreditkan ke akun PayDay Anda.", reward);

		    GivePlayerPayCheck(playerid, reward);

		    UpdatePlayerBulldozerMark(playerid);
		}

		return 1;
	}
	if(vehicleid == rent_job_vehicle[playerid] && PlayerInfo[playerid][pJob] == WORK_TYPE_DELIVERY)
	{
	    if(delivery_state_id[playerid] == 1)
	    {
	        if(crane_unload_use != INVALID_PLAYER_ID)
	            return SCM(playerid, COLOR_GREY, "Harap tunggu saat memuat sedang sibuk.");

	        if(crane_unload_refresh != 0)
	            return SCM(playerid, COLOR_GREY, "Tunggu sampai wadahnya siap.");

	    	new crane_id = MAX_CRANES;

	        crane_unload_use = playerid;
	        crane_unload_refresh = 30;

	        SetVehiclePos(vehicleid, crane_unload_veh[0], crane_unload_veh[1], crane_unload_veh[2]);
	        SetVehicleZAngle(vehicleid, crane_unload_veh[3]);

	        TogglePlayerControllable(playerid, false);

	        new time = 10000;

	        for(new i; i < 4; i++)
			{
		    	time = MoveDynamicObject(
					crane_unload_obj[i],
				  	crane_stop_pos[crane_id][i][0],
		 			crane_stop_pos[crane_id][i][1],
					crane_stop_pos[crane_id][i][2]-0.004,
					0.4,
					crane_stop_pos[crane_id][i][3],
					crane_stop_pos[crane_id][i][4],
					crane_stop_pos[crane_id][i][5]
				);
			}

			SCM(playerid, -1, "Pengunduhan dimulai, tunggu..");

	        SetTimerEx("LoadPlayerContainer", time, false, "i", playerid);
		}
		else if(2 <= delivery_state_id[playerid] <= 3)
		{
		    new crane_id = delivery_state_id[playerid] - 2;

		    if(crane_use[crane_id] != INVALID_PLAYER_ID)
		        return SCM(playerid, COLOR_GREY, "Situs ini sedang sibuk.");

			if(crane_refresh[crane_id] != 0)
			    return SCM(playerid, COLOR_GREY, "Tunggu sampai debit selesai..");

            crane_use[crane_id] = playerid;

		    SetVehiclePos(vehicleid, crane_veh_pos[crane_id][0], crane_veh_pos[crane_id][1], crane_veh_pos[crane_id][2]);
		    SetVehicleZAngle(vehicleid, crane_veh_pos[crane_id][3]);

		    TogglePlayerControllable(playerid, false);

		    DestroyDeliveryObject(playerid);

		    crane_obj[crane_id][2] = CreateDynamicObject
			(
				2935,
				crane_stop_pos[crane_id][2][0],
				crane_stop_pos[crane_id][2][1],
				crane_stop_pos[crane_id][2][2],
				crane_stop_pos[crane_id][2][3],
				crane_stop_pos[crane_id][2][4],
				crane_stop_pos[crane_id][2][5]
			);

		    new time = 10000;

	        for(new i = 1; i != -1; i--)
			{
		    	time = MoveDynamicObject(
					crane_obj[crane_id][i],
				  	crane_stop_pos[crane_id][i][0],
		 			crane_stop_pos[crane_id][i][1],
					crane_stop_pos[crane_id][i][2]-0.004,
					0.4,
					crane_stop_pos[crane_id][i][3],
					crane_stop_pos[crane_id][i][4],
					crane_stop_pos[crane_id][i][5]
				);
			}

		    SCM(playerid, -1, "Bongkar kontainer dimulai, tunggu.");

		    SetTimerEx("UnloadPlayerContainer", time, false, "i", playerid);
		}

		return 1;
	}
	if(GetPVarInt(playerid, "GPS") != 0)
	{
		SetPVarInt(playerid, "GPS", 0);
	}
	if(GetPVarInt(playerid,"CHECKPOINTID") == 3 && !IsPlayerInAnyVehicle(playerid) && player_job[playerid] == 2)
	{
		SetPlayerAttachedObject(playerid, 1, 1558, 1, 0.206000,0.440999,-0.036000,0.000000,270.000000,0.000000,-0.449999,-0.449999,-0.449999);
		SendClientMessage(playerid,-1,"Anda mengambil kotak itu, bawa ke trailer.");
		ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
		SetPlayerSpecialAction (playerid, SPECIAL_ACTION_CARRY);
		DisablePlayerCheckpoint(playerid);
		new rand = random(4);
		SetPlayerRaceCheckpoint(playerid,1,work_pos_gruzchiki[1][rand][0],work_pos_gruzchiki[1][rand][1],work_pos_gruzchiki[1][rand][2],0.0,0.0,0.0,3);
		SetPVarInt(playerid,"CHECKPOINTID",4);
	}
	if(GetPVarInt(playerid,"CHECKPOINTID") == 5 && !IsPlayerInAnyVehicle(playerid) && IsPlayerInRangeOfPoint(playerid, 5.0, 2564.6721,-1292.9766,1044.1250))
	{
		new bablo[33];
		SetPlayerSpecialAction (playerid, SPECIAL_ACTION_NONE);
		if(IsPlayerAttachedObjectSlotUsed(playerid,2)) RemovePlayerAttachedObject(playerid,2);
		GivePlayerMoneyEx(playerid, 25000, "pemuat"); //TEST
		SetPVarInt(playerid,"JobMoney",GetPVarInt(playerid,"JobMoney")+350);
		format(bablo,32,"~g~+25000$~n~~b~TOTAL:~w~ %i$",GetPVarInt(playerid,"JobMoney"));
		GameTextForPlayer(playerid,bablo, 5000, 1);
		ClearAnimations(playerid);
		DeletePVar(playerid,"CHECKPOINTID");
		DisablePlayerCheckpoint(playerid);
	}
	if(GetPVarInt(playerid,"Saw_"))
	{
		if(player_job[playerid] == 1 && !IsPlayerInAnyVehicle(playerid) && GetPVarInt(playerid,"Saw") != 1)
		{
			ApplyAnimation(playerid,"CHAINSAW","WEAPON_csaw",4.0,1,1,1,1,0);
			SetPVarInt(playerid,"AntiSbiv",gettime()+10);
			SetPVarInt(playerid,"Saw",1);
			DisablePlayerCheckpoint(playerid);
			SendClientMessage(playerid,0x27C400FF,"Anda mulai menggergaji pohon");
		}
	}
	//if(IsPlayerInVehicle(playerid, specialcar))
    if(PlayerInfo[playerid][pJob] == 3 && pTemp[playerid][puborkacar] != 0)
    {
        new pos = uborkaPos{playerid},route = player_route_id[playerid];
        if(pos == 99 || gUborkaCPs[route][pos+1][0] == 0.0) uborkaPos{playerid} = 0;
		else uborkaPos{playerid}++;
		SetNextCP(playerid,uborkaPos{playerid});
    }
    if(GetPVarInt(playerid, "Sad") == 1 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
    {
        TogglePlayerControllable(playerid, false);

        SetTimerEx("SadYablkJob",5000,0,"%i",playerid);
        GameTextForPlayer(playerid,"~y~+1",5200,5);
        AmmountWood[playerid] += 1;

        //format(string, 65,"%d",AmmountWood[playerid]);
        //PlayerTextDrawSetString(SADD[playerid],string);
        //format(string, 65,"%d",AmmountWood[playerid]*2);
        //PlayerTextDrawSetString(SADD1[playerid],string);

        ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,1,1,1,1,0);
        new rand = random(sizeof(derevo));
        SetPlayerCheckpoint
		(
			playerid,
			derevo[rand][0],
			derevo[rand][1],
			derevo[rand][2],
			3.0
	    );
        DeletePVar(playerid, "Sad");
        DisablePlayerCheckpoint(playerid);
        SetPVarInt(playerid, "Sad", 1);

        if(beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_APPLE && beg_quest_info[playerid][b_quest_status] == 1)
		{
		    beg_quest_info[playerid][b_quest_progress]++;
		    OnPlayerUpdateAccountsPer(playerid, "b_quest_progress", beg_quest_info[playerid][b_quest_progress]);

            SCMF(playerid, COLOR_YELLOW, "[QUEST] {FFFFFF}Masih mengumpulkan apel: %i/40", beg_quest_info[playerid][b_quest_progress]);

		    if(beg_quest_info[playerid][b_quest_progress] >= 40) //40 apel
		    {
		        SCM(playerid, COLOR_YELLOW, "[QUEST] {FFFFFF}Anda telah mengumpulkan jumlah apel yang tepat, menyelesaikan pekerjaan dan mengembalikannya.");

		        beg_quest_info[playerid][b_quest_status] = 2;

		        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
		    }
		}

        return true;
    }
    DisablePlayerCheckpoint(playerid);
	return 1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
	return 1;
}

