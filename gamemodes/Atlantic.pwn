public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(result == -1)
	{
		ShowError(playerid, "Command Tidak Dapat Ditemukan, Silakan Gunakan /mm");
		return 0;
	}

    return 1;
}

