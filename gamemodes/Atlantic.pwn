{
	return 1;
}
public OnPlayerUpdate(playerid)
{
    UpdateAll(playerid);
    if(pData[playerid][pDM] == 1)
    {
        UpdateScoreDisplay(playerid);
    }
	if(GetPlayerSpeed(playerid) > 210)
    {
        SetTimerEx("KickPlayer", 500, 0, "i", playerid);
		new fmt_msg[128];
		format(fmt_msg, sizeof fmt_msg, "BotCmd: %s has been kicked by BOT.", GetName(playerid));
        SCM(playerid, 0xFF5533FF, fmt_msg);
        SCM(playerid, 0xFF5533FF, "Reason: Speed Hack!");
    }
    if(GetPlayerSpeed(playerid) > 220)
    {
        SetTimerEx("KickPlayer", 500, 0, "i", playerid);
		new fmt_msg[128];
		format(fmt_msg, sizeof fmt_msg, "BotCmd: %s has been kicked by BOT.", GetName(playerid));
        SCM(playerid, 0xFF5533FF, fmt_msg);
        SCM(playerid, 0xFF5533FF, "Reason: Speed Hack!");
    }
    if(GetPlayerSpeed(playerid) > 230)
    {
        SetTimerEx("KickPlayer", 500, 0, "i", playerid);
		new fmt_msg[128];
		format(fmt_msg, sizeof fmt_msg, "BotCmd: %s has been kicked by BOT.", GetName(playerid));
        SCM(playerid, 0xFF5533FF, fmt_msg);
        SCM(playerid, 0xFF5533FF, "Reason: Speed Hack!");
    }
    //lapar haus
	if(PlayerInfo[playerid][pSatiety] < 10)
    {
       GameTextForPlayer(playerid, "~r~Kamu Mulai Lapar", 100, 1);
    }
	if(PlayerInfo[playerid][pThirst] < 25)
   	{
  	   GameTextForPlayer(playerid, "~r~Kamu Mulai Haus", 100, 1);
   	}
   	if(PlayerInfo[playerid][pStress] > 80)
   	{
  	   GameTextForPlayer(playerid, "~r~Kamu Mulai Stress", 100, 1);
   	}
	if(PlayerInfo[playerid][pLevel] < 3)
	{
 	SetPlayerHealth(playerid, 999999);
	}
 	if(25 == GetPlayerWeapon(playerid))
    {
	callcmd::tgsg(playerid);
	}
	if(24 == GetPlayerWeapon(playerid))
    {
	callcmd::tgde(playerid);
	}
	if(29 == GetPlayerWeapon(playerid))
    {
	callcmd::tgmp(playerid);
	}
	if(30 == GetPlayerWeapon(playerid))
    {
	callcmd::tgak(playerid);
	}
    	//anti Cheat
	if(PlayerInfo[playerid][pLevel] < 3)
    {
        ResetWeapons(playerid);
    }

    if(34 <= GetPlayerWeapon(playerid) <= 40)
    {
        if(admin_level[playerid] <= 10 && admin_logged[playerid]) return 0;
        ResetWeapons(playerid);
        Kick(playerid);
    }

    if(16 <= GetPlayerWeapon(playerid) <= 19)
    {
        ResetWeapons(playerid);
        KickD(playerid, "[BOT-MVRP]: TOBAT YA DEK SEBELUM DI BAN!!!!");
    }

    if(35 <= GetPlayerWeapon(playerid) <= 37)
    {
        ResetWeapons(playerid);
        KickD(playerid, "[BOT-MVRP]: TOBAT YA DEK SEBELUM DI BAN!!!!");
        return 1;
	}

	if(24 == GetPlayerWeapon(playerid))
	if(PlayerInfo[playerid][pCS] == 0)
    {
    	Info(playerid, "Anda Tidak Memili Cs");
        ResetWeapons(playerid);
	}
 	if(27 == GetPlayerWeapon(playerid))
 	if(PlayerInfo[playerid][pCS] == 0)
    {
   		Info(playerid, "Anda Tidak Memili Cs");
        ResetWeapons(playerid);
	}
	if(29 == GetPlayerWeapon(playerid))
	if(PlayerInfo[playerid][pCS] == 0)
    {
   		Info(playerid, "Anda Tidak Memili Cs");
        ResetWeapons(playerid);
	}
  	if(30 == GetPlayerWeapon(playerid))
  	if(PlayerInfo[playerid][pCS] == 0)
    {
   		Info(playerid, "Anda Tidak Memili Cs");
        ResetWeapons(playerid);
	}
   	if(31 == GetPlayerWeapon(playerid))
	if(PlayerInfo[playerid][pCS] == 0)
    {
   		Info(playerid, "Anda Tidak Memili Cs");
        ResetWeapons(playerid);
	}
	
//spike
    new panels, tires;
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        for(new i = 0; i < sizeof(SpikeInfo); i++)
  	    {
  	        if(IsPlayerInRangeOfPoint(playerid, 3.0, SpikeInfo[i][sX], SpikeInfo[i][sY], SpikeInfo[i][sZ]))
            {
  	            if(SpikeInfo[i][sCreated] == 1)
  	            {
  	                new carid = GetPlayerVehicleID(playerid);
		            GetVehicleDamageStatus(carid, panels, doors, lights, tires);
		            tires = encode_tires(1, 1, 1, 1);
		            UpdateVehicleDamageStatus(carid, panels, doors, lights, tires);
  	                return 0;
  	            }
  	        }
  	    }
  	}
    if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
 	{
  		for(new i = 0; i < sizeof(SpikeInfo); i++)
  		{
       		if(IsPlayerInRangeOfPoint(playerid, 3.0, SpikeInfo[i][sX], SpikeInfo[i][sY], SpikeInfo[i][sZ]))
           	{
            	if(SpikeInfo[i][sCreated] == 1)
            	{
               		new carid = GetPlayerVehicleID(playerid);
		            GetVehicleDamageStatus(carid, panels, doors, lights, tires);
		            tires = encode_tires(1, 1, 1, 1);
		            UpdateVehicleDamageStatus(carid, panels, doors, lights, tires);
					GameTextForPlayer(playerid,"~r~Spiked",4000,3);
		  			return 0;
        		}
	        }
  		}
  	}
	new hungerr1[256];
	format(hungerr1, sizeof(hungerr1), "%0.0f", PlayerInfo[playerid][pSatiety]);
	PlayerTextDrawSetString(playerid, Hbe_Majestic[playerid][6], hungerr1);

	new thirstt1[256];
	format(thirstt1, sizeof(thirstt1), "%0.0f", PlayerInfo[playerid][pThirst]);
	PlayerTextDrawSetString(playerid, Hbe_Majestic[playerid][7], thirstt1);
	
	new stress1[256];
	format(stress1, sizeof(stress1), "%0.0f", PlayerInfo[playerid][pStress]);
	PlayerTextDrawSetString(playerid, Hbe_Majestic[playerid][8], stress1);

  	if(pData[playerid][pSatiety] >= 30)
	{
		SetPlayerDrunkLevel(playerid, 0);
	}
	if(pData[playerid][pThirst] >= 30)
	{
		SetPlayerDrunkLevel(playerid, 0);
	}
	if(pData[playerid][pStress] <= 80)
	{
		SetPlayerDrunkLevel(playerid, 0);
	}
  	if(pData[playerid][pSatiety] <= 30)
	{
		SetPlayerDrunkLevel(playerid, 5000);
	}
	if(pData[playerid][pThirst] <= 30)
	{
		SetPlayerDrunkLevel(playerid, 5000);
	}
	if(pData[playerid][pStress] >= 80)
	{
		SetPlayerDrunkLevel(playerid, 5000);
	}
		    //KNOCK
	new Float:health;
	GetPlayerHealth(playerid, health);
	{
		if(health < 20)
		if(pData[playerid][pDM] == 1)
		{
  		SpawnDeathMatch(playerid);// jika pemain terbunuh di zona DM, maka dia ada di sana
		SCM(playerid, -1, "Anda Telah Spawn kembali Di zona tempur!");
		}
	}
	    //KNOCK
	new Float:hp;
	GetPlayerHealth(playerid, hp);
	{
		if(hp < 34)
		if(PlayerInfo[playerid][pInjured] == 0)
		{
  		if(pData[playerid][pDM] == 1) return 0;
		PlayerInfo[playerid][pInjured] = 1;
		}
	}
 	if(GetPlayerData(playerid, pInjured) == 1)
	{
/*        new mstr[64];
        format(mstr, sizeof(mstr), "/death untuk spawn ke rumah sakit");
		InfoTD_MSG(playerid, 1000, mstr);*/

//		SetPlayerData(playerid, P_HOSPITAL, true);
		RemovePlayerFromVehicleEx(playerid);
		SetPlayerChatBubble(playerid, "This Player Has Injured", 0xFF6347AA, 10.0, 5000);
        ApplyAnimation(playerid, "WUZI", "CS_DEAD_GUY", 4.1, 0, 0, 0, 1, 0, 1);
        SetPlayerHealth(playerid, 9999999);
        for(new i; i < 12; i++) PlayerTextDrawShow(playerid, DEATHTD[playerid][i]);
	}

    new vehicleid = GetPlayerVehicleID(playerid);

	if(vehicleid != INVALID_VEHICLE_ID && Fuell[vehicleid] < 1.0 && SpeedVehicle(playerid) != 0)
	{
		new Float:x,Float:y,Float:z;
	    GetVehiclePos(vehicleid,x,y,z);
		SetVehiclePos(vehicleid,x,y,z);
	}

    afk_tick[playerid]++;
	return 1;
}

