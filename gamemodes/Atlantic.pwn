		  callcmd::jualpadi(playerid);
		}
		return 1;
	}
	if(PRESSED(KEY_NO) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		callcmd::radial(playerid, "");
	}
	if(PRESSED(KEY_NO))
    {
    	callcmd::cancel(playerid);
    }
	if(PlayerInfo[playerid][pInjured] == 1)
	{
 		if(newkeys == KEY_NO)
	    {
		callcmd::acceptdeath(playerid);
	    }
