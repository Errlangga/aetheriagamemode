                    {
                        new weapon_id = CarInfo[playerid][cGun][car_id];
                        new ammo = CarInfo[playerid][cAmmo][car_id];
                        GivePlayerWeapon(playerid, weapon_id, ammo);
                        CarInfo[playerid][cGun][car_id] = 0;
