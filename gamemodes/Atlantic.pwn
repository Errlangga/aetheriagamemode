		else ShowPlayerDialog(playerid, DIALOG_NEONTYPES, DIALOG_STYLE_LIST, "Neon Settings", "Solid Neon/No Flash\nSimultaneous Flash\nAlternating Flash\nRemove All Neon", "Select", "Cancel");
