                CarInfo[playerid][cGarkot][u_car_1] = CarInfo[offer_id][cGarkot][u_car_0];
			    CarInfo[playerid][cInGarkot][u_car_1] = CarInfo[offer_id][cInGarkot][u_car_0];
                CarInfo[playerid][cComponent][u_car_1] = CarInfo[offer_id][cComponent][u_car_0];
                VehiclePlate[playerid][u_car_1] = VehiclePlate[offer_id][u_car_0];

                CarInfo[offer_id][cModel][u_car_0] = 0;
                CarInfo[offer_id][cColor1][u_car_0] = 0;
                CarInfo[offer_id][cColor2][u_car_0] = 0;
                CarInfo[offer_id][cFuel][u_car_0] = 100.0;
                CarInfo[offer_id][cProbeg][u_car_0] = 0.0;
                CarInfo[offer_id][cCost][u_car_0] = 100000;
