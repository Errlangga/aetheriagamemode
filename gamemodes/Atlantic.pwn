stock SavePlayerCarPark(playerid)
{
    format(MySQLStr, 312, "UPDATE `accounts` SET `car_park` = '%.1f,%.1f,%.1f,%.1f|%.1f,%.1f,%.1f,%.1f|%.1f,%.1f,%.1f,%.1f|%.1f,%.1f,%.1f,%.1f|%.1f,%.1f,%.1f,%.1f' WHERE `pID` = %i",
    player_car_park[playerid][0][0],player_car_park[playerid][0][1],player_car_park[playerid][0][2],player_car_park[playerid][0][3],
    player_car_park[playerid][1][0],player_car_park[playerid][1][1],player_car_park[playerid][1][2],player_car_park[playerid][1][3],
    player_car_park[playerid][2][0],player_car_park[playerid][2][1],player_car_park[playerid][2][2],player_car_park[playerid][2][3],
    player_car_park[playerid][3][0],player_car_park[playerid][3][1],player_car_park[playerid][3][2],player_car_park[playerid][3][3],
    player_car_park[playerid][4][0],player_car_park[playerid][4][1],player_car_park[playerid][4][2],player_car_park[playerid][4][3],
	GetPlayerAccountID(playerid));

	mysql_tquery(mMysql, MySQLStr);

	return 1;
}

stock StopGamePB(team_win)
{
	if(team_win == 0) SendClientMessageToAll(-1, "[PB] Tim biru menang.");
	else if(team_win == 1) SendClientMessageToAll(-1, "[PB] Tim merah menang.");
	else SendClientMessageToAll(-1, "[PB] Math of windows. Lower.");

	new count = 0;

	foreach(Player, i) if(player_reg_pb[i] == team_win) count++;

	new finish_reward = pb_reward / count;

	foreach(Player, i)
    {
        if(player_reg_pb[i] == -1) continue;

		if(player_reg_pb[i] == team_win) GivePlayerMoneyEx(i, finish_reward, "win PB");

        ResetPlayerWeapons(i);

        SetPlayerPos(i, -2161.8418,641.5208,1052.3750);
        SetPlayerFacingAngle(i, 84.9472);
        SetPlayerVirtualWorld(i, 1);
        SetPlayerInterior(i, 1);

        player_reg_pb[i] = -1;
	}

	pb_state = pb_time = 0;

	return 1;
}

