					format(String, 200, "{ffffff}Tingkat saat ini: 1 rubel 1200 $\n\nDi akun Anda {ffff00}%d {ffffff}rubel\n\nUntuk mentransfer dana, masukkan jumlah rubel yang diperlukan:", PlayerInfo[playerid][pRouble]); //PlayerInfo[playerid][pRouble] * 1200);
					SPD(playerid, 236, DIALOG_STYLE_INPUT, "Donate | Konverter media virtual", String, "Selanjutnya", "Kembali");
				}
				case 2:
				{
					SPD(playerid, 237,  DIALOG_STYLE_LIST, !"Donate | Akuisisi VIP",
					!"{ffffff}1. BRONZE VIP\t{a86cfc}250 rubel (30 hari)\n\
					{ffffff}2. SILVER VIP\t{a86cfc}500 rubel (30 hari)\n\
					{ffffff}3. GOLD VIP\t{a86cfc}1000 rubel (30 hari)\n\
					{ffffff}4. Informasi",
					!"Pilih", !"Kembali");
				}
				case 3:
				{
				    if(PlayerInfo[playerid][pRouble] < 1000) return SCM(playerid,0xafafafff,"Kamu tidak punya cukup rubel.");

					ShowPlayerCreateFamilyDialog(playerid, 1);
				}
				case 4:
				{
				    if(PlayerInfo[playerid][pInfSatiety]) return SCM(playerid, COLOR_GREY, "Anda sudah memiliki opsi ini.");
				    if(PlayerInfo[playerid][pRouble] < 250) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");

				    PlayerInfo[playerid][pInfSatiety] = 1;
				    PlayerInfo[playerid][pSatiety] = 100;
				    PlayerInfo[playerid][pRouble] -= 250;

				    OnPlayerUpdateAccountsPer(playerid,"pInfSatiety",1);
				    OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
					Send(playerid,-1,"Anda membeli kepuasan tak terbatas {a86cfc}250{ffffff} rubel");
				}
				case 5:
				{
					if(PlayerInfo[playerid][pRouble] < 100) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
					if(PlayerInfo[playerid][pWarn] == 0) return SendClientMessage(playerid,COLOR_GREY,"Anda tidak memiliki peringatan");

					PlayerInfo[playerid][pWarn]--;
					format(MySQLStr, 96, "DELETE FROM `warninfo` WHERE `plID` = %d AND `wID` = %d", PlayerInfo[playerid][pID], WarnInfo[playerid][GetPVarInt(playerid, "SaveLIstItem")][wID]), mysql_tquery(mMysql, MySQLStr, "", "");
					mysql_tquery(mMysql, MySQLStr);
					//
					PlayerInfo[playerid][pRouble] -= 100;
					OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
					Send(playerid,-1,"Anda telah diperingatkan {a86cfc}100{ffffff} rubel");
					return 1;
				}
				case 6:
				{
					for(new i; i < 4; i++)
					{
						if(PlayerInfo[playerid][pLicenses][i]) continue;

						if(PlayerInfo[playerid][pRouble] < 89) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
						PlayerInfo[playerid][pRouble] -= 89;
						OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);

						for(new x = i; x < 4; x++) PlayerInfo[playerid][pLicenses][x] = 1;

						SavePlayerLicenses(playerid);

						return SendClientMessage(playerid,-1, "Anda telah membeli lisensi untuk 89 rubel");
					}

					return Send(playerid,-1,"Anda sudah memiliki semua lisensi");
				}
				case 7: ShowRouleteInfo(playerid);
				case 8:
				{
				    if(PlayerInfo[playerid][pRouble] < 30) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
                    if(PlayerInfo[playerid][pSex] >= 2)
					{
						Send(playerid,-1,"DONATE: Anda mengubah jenis kelamin menjadi Pria untuk {a86cfc}30 {ffffff}rubel.");
						PlayerInfo[playerid][pSex]=1;
					}
					else if(PlayerInfo[playerid][pSex] <= 1)
					{
						Send(playerid,-1,"DONATE: Anda mengubah jenis kelamin menjadi Wanita untuk {a86cfc}30 {ffffff}rubel.");
						PlayerInfo[playerid][pSex]=2;

					}
					PlayerInfo[playerid][pRouble] -= 30;
					OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
					OnPlayerUpdateAccountsPer(playerid,"pSex",PlayerInfo[playerid][pSex]);
				}
				case 9:
				{
					if(PlayerInfo[playerid][pRouble] < 30) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
					Send(playerid,-1, "DONATE: Anda meningkatkan kepatuhan Anda terhadap hukum sebesar 10 per {a86cfc}30 {ffffff}rubel.");
					PlayerInfo[playerid][pRouble] -= 30;
					PlayerInfo[playerid][pZakon] += 10;
					OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
					OnPlayerUpdateAccountsPer(playerid,"pZakon",PlayerInfo[playerid][pZakon]);
				}
				case 10:
				{
				    if(admin_level[playerid]) return SCM(playerid, COLOR_GREY, "Administrator tidak dapat mengubah nama panggilan.");
				    if(PlayerInfo[playerid][pLeader]) return SCM(playerid, COLOR_GREY, "Seorang pemimpin tidak dapat mengubah nama panggilan.");

					SPD(playerid, 3267, DIALOG_STYLE_INPUT, "Ubah Nick", "Masukkan nama panggilan yang ingin Anda ubah saat ini:\nBiaya 300 rubel.", "Selanjutnya", "Kembali");
				}
			}
			return 1;
		}
		case 3267:
		{
		    if(!response) return pc_cmd_donate(playerid);

			if(!IsRpNickname(inputtext))
				return SCM(playerid, COLOR_GREY, "Nick harus dalam format: FirstName_LastName");

			mysql_format(mMysql, format_string, 144, "SELECT * FROM `accounts` WHERE `pName` = '%e'", inputtext);
		    new Cache: result = mysql_query(mMysql, format_string, true);

		    if(cache_num_rows() != 0)
		        return SCM(playerid, COLOR_GREY, "Julukan ini sudah diambil.");

			cache_delete(result);

		    SetPVarString(playerid, "change_name_donate", inputtext);

		    format(format_string, 144, "Nick terakhir: %s\nNama panggilan baru: %s\nBiaya: 300 gosok.\n\nApakah Anda setuju dengan perubahan itu?", GetPlayerNameEx(playerid), inputtext);
		    SPD(playerid, 3268, DIALOG_STYLE_MSGBOX, "Nick mengubah konfirmasi", format_string, "Sogalasen", "Kembali");
		}
		case 3268:
		{
		    new new_nick[MAX_PLAYER_NAME];

		    GetPVarString(playerid, "change_name_donate", new_nick, MAX_PLAYER_NAME);

			DeletePVar(playerid, "change_name_donate");

			if(!response) return SPD(playerid, 3267, DIALOG_STYLE_INPUT, "Nick berubah", "Masukkan nama panggilan yang ingin Anda ubah saat ini:\nBiaya 300 rubel.", "Selanjutnya", "Kembali");

			if(PlayerInfo[playerid][pRouble] < 300)
			    return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");

            PlayerInfo[playerid][pRouble] -= 300;

            PlayerChangeName(playerid, new_nick);

            SCMF(playerid, COLOR_WHITE, "Anda mengubah nama panggilan Anda menjadi %s", new_nick);
		}
  		case 236:
		{
			if(!response) return 1;//pc_cmd_home(playerid);
			new moneys;
			if(sscanf(inputtext,"i", moneys))
			{
				format(String, 200, "{ffffff}Tarif saat ini: 1 rubel 1200 $\n\nDi akun Anda {ffff00}%d {ffffff}rubel\n\nUntuk mentransfer dana, masukkan jumlah rubel yang diinginkan:", PlayerInfo[playerid][pRouble]); //PlayerInfo[playerid][pRouble] * 1200);
				SPD(playerid, 236, DIALOG_STYLE_INPUT, "Donate | Konverter media virtual", String, "Selanjutnya", "Kembali");
				return 1;
			}
			if(PlayerInfo[playerid][pRouble] < moneys) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
			if(moneys > 10000 || moneys < 1) return Send(playerid, -1, "Tidak mungkin kurang dari 1 dan lebih banyak 10000");
			//PlayerInfo[playerid][pCash] += moneys * 1200;
			GivePlayerMoneyEx(playerid, moneys * 1200, "dikonversi rubel menjadi virts");
			SCMF(playerid, -1, "Akun Anda telah berhasil dikreditkan ke {91d29a}$%d"W", dihabiskan: {91d29a}%i "W"rubel", moneys * 1200,moneys);
			PlayerInfo[playerid][pRouble] -= moneys;
			//OnPlayerUpdateAccountsPer(playerid,"pCash",PlayerInfo[playerid][pCash]);
			OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
			return 1;
		}
		case 237: //vip
		{
		    if(!response) return callcmd::donate(playerid);

		    //if(PlayerInfo[playerid][pVip] != 0) return SendClientMessage(playerid, COLOR_GREY, "Anda sudah memiliki VIP yang valid");


		    switch(listitem)
			{
		        case 0:
		        {
		            if(PlayerInfo[playerid][pVip] >= 1) return SendClientMessage(playerid, COLOR_GREY, "Kamu sudah memiliki VIP yang valid");
		            if(PlayerInfo[playerid][pRouble] < 250) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
		            PlayerInfo[playerid][pVip] = 1;
		            PlayerInfo[playerid][pVipTime] = gettime() + (86400 * 30);
		            PlayerInfo[playerid][pRouble] -= 150;
		            Send(playerid,-1,"Anda telah berhasil membeli {CD853F}BRONZE{ffffff} VIP selama 30 hari");
		            Send(playerid,-1,"{a86cfc}[Petunjuk]: "W"Anda memiliki perintah baru yang tersedia, gunakan: {999999}/vipinfo "W"| {999999}/viphelp");
		            OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
		            OnPlayerUpdateAccountsPer(playerid,"pVip",PlayerInfo[playerid][pVip]);
		            OnPlayerUpdateAccountsPer(playerid,"pVipTime",PlayerInfo[playerid][pVipTime]);
		        }
		        case 1:
		        {
		            if(PlayerInfo[playerid][pVip] >= 2) return SendClientMessage(playerid, COLOR_GREY, "Anda sudah memiliki VIP yang valid");
                    if(PlayerInfo[playerid][pRouble] < 500) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
		            PlayerInfo[playerid][pVip] = 2;
		            PlayerInfo[playerid][pVipTime] = gettime() + (86400 * 30);
		            PlayerInfo[playerid][pRouble] -= 300;
		            Send(playerid,-1,"Anda telah berhasil membeli {afafaf}SILVER{ffffff} VIP dengan harga 30 rubel");
		            Send(playerid,-1,"{a86cfc}[Petunjuk]: "W"Anda memiliki perintah baru yang tersedia, gunakan: {999999}/vipinfo "W"| {999999}/viphelp");
                    OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
                    OnPlayerUpdateAccountsPer(playerid,"pVip",PlayerInfo[playerid][pVip]);
                    OnPlayerUpdateAccountsPer(playerid,"pVipTime",PlayerInfo[playerid][pVipTime]);
		        }
		        case 2:
		        {
		            if(PlayerInfo[playerid][pVip] >= 3) return SendClientMessage(playerid, COLOR_GREY, "Anda sudah memiliki VIP yang valid");
		            if(PlayerInfo[playerid][pRouble] < 1000) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel.");
		            PlayerInfo[playerid][pVip] = 3;
		            PlayerInfo[playerid][pVipTime] = gettime() + (86400 * 30);
		            PlayerInfo[playerid][pRouble] -= 700;
		            Send(playerid,-1,"Anda telah berhasil membeli {ffff00}GOLD{ffffff} VIP selama 30 hari");
		            Send(playerid,-1,"{a86cfc}[Petunjuk]: "W"Anda memiliki perintah baru yang tersedia, gunakan: {999999}/vipinfo "W"| {999999}/viphelp");
		            OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
		            OnPlayerUpdateAccountsPer(playerid,"pVip",PlayerInfo[playerid][pVip]);
		            OnPlayerUpdateAccountsPer(playerid,"pVipTime",PlayerInfo[playerid][pVipTime]);
		        }
		        case 3:
		        {
		            ShowVIPHelp(playerid);// <<<
		        }
			}
			return true;
		}
		case 238: {
		    if(!response) return true;

			if(PlayerInfo[playerid][pFreeRoulet])
		    {
		        PlayerInfo[playerid][pFreeRoulet]--;
		        OnPlayerUpdateAccountsPer(playerid, "pFreeRoulet", PlayerInfo[playerid][pFreeRoulet]);

				SCMF(playerid, COLOR_YELLOW, "Putaran bebas tersisa: %i", PlayerInfo[playerid][pFreeRoulet]);
		    }
			else
			{
			    if(PlayerInfo[playerid][pRouble] < 40) return SCM(playerid,0xafafafff,"Anda tidak memiliki cukup rubel untuk menggulir roulette");

			    PlayerInfo[playerid][pRouble] -= 40;
		 		OnPlayerUpdateAccountsPer(playerid, "pRouble", PlayerInfo[playerid][pRouble]);
			}

			StartRulet(playerid);

			return true;
		}
