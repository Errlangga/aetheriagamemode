CMD:copotpaintjobws(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                extract params -> new pembeli; else return SendClientMessage(playerid, -1, "/copotpaintjob [ID Pemain]");

                if(PlayerInfo[playerid][pComponent] < 23) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Component Anda Tidak Cukup, Butuh 23");
                //if(sscanf(params, "ddd",params[0],params[1],params[2],params[3])) return SCM(playerid,COLOR_WHITE,"Masukkan: /changecolor [id pemain][id warna 1][id warna 2][slot]");

                if(!IsPlayerDriver(pembeli))
                    return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Mengemudi");

                new u_car = GetPlayerUseHomeCar(pembeli);

                if(u_car == -1)
                    return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Menggunakan Mobil Pribadi");

                SetPlayerUseListitem(pembeli, u_car);

                new u_car_0 = GetPlayerUseListitem(pembeli);
                new vehicleid = GetPlayerVehicleID(pembeli);

                CarInfo[pembeli][cPaintJobs][u_car_0] = 255;

                ChangeVehiclePaintjob(vehicleid, 255);
                SaveCars(pembeli);

                PlayerInfo[playerid][pComponent] -= 23;
                OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
            }
        }
    }
    return 1;
}

CMD:deletepcar(playerid, params[])
{
	if(admin_level[playerid] < 11 || !admin_logged[playerid]) return 1;
	extract params -> new to_player, slot; else return SCM(playerid, -1, "Gunakan: /deletepcar [id pemain] [slot]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");
	if(slot < 1 || slot > 5) return SCM(playerid, COLOR_GREY, "Slot dari 1 ke 3");
	slot--;
	if(CarInfo[to_player][cModel][slot] == 0) return SCM(playerid, COLOR_GREY, "Slot ini tidak digunakan..");

	new model = CarInfo[to_player][cModel][slot];

	new u_car = PlayerInfo[to_player][pUseCar];
	new vehicleid = player_home_car[to_player][u_car];
	if(vehicleid != INVALID_VEHICLE_ID && GetVehicleModel(vehicleid) == model) DestroyVehicleEx(vehicleid);

	strmid(VehicleNumberPlate[to_player][slot],"None", 0, strlen("None"), 9);
	CarInfo[to_player][cSost][slot] = 100, CarInfo[to_player][cFuel][slot] = float(100), CarInfo[to_player][cColor1][slot] = 1, CarInfo[to_player][cColor2][slot] = 1;
	CarInfo[to_player][cModel][slot] = 0, CarInfo[to_player][cCost][slot] = 0, CarInfo[to_player][cLock][slot] = 0, CarInfo[to_player][cProbeg][slot] = float(0);

	player_home_car[to_player][slot] = INVALID_VEHICLE_ID;

	for(new i; i < 5; i++) player_engine_tune[to_player][slot][i] = player_brake_tune[to_player][slot][i] = 0;

	SavePlayerPerfomanceTune(to_player);

	CarInfo[to_player][cHeal][slot] = float(1000);
	CarInfo[to_player][cDamagePanel][slot] = 0;
	CarInfo[to_player][cDamageDoors][slot] = 0;
	CarInfo[to_player][cDamageLights][slot] = 0;
	CarInfo[to_player][cDamageTires][slot] = 0;

	CompVehDel(to_player);
	SaveCars(to_player);
	SCMF(playerid, -1, "Kamu menghapus kendaraan %s (%s) (slot: %i)", Name(to_player), VehicleNames[model-400], slot + 1);
	SCMF(to_player, -1, "Kendaraanmu %s (slot: %i) telah dihapus", VehicleNames[model-400], slot + 1);
	return 1;
}
