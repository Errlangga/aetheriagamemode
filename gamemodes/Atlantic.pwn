CMD:setfreq(playerid, params[])
{
    new string[128], frequency;
    if(sscanf(params, "d", frequency))
    {
        Send(playerid, COLOR_WHITE, "{B0C4DE}SYNTAX:{FFFFFF} /setfreq [frequency]");
        Send(playerid, COLOR_WHITE, "[Hint] Set the frequency of your radio to 0 if you don't want to hear anything.");
        return 1;
    }

    if(frequency > 9999999 || frequency < -9999999) { Send(playerid, COLOR_GREY, "Frequency can not be lower than -9999999 or higher than 9999999!"); return 1; }
    if (pData[playerid][pRadio] == 0)
    {
        pData[playerid][pRadioFreq] = frequency;
        format(string, sizeof(string), "You have set the frequency of your portable radio to %d khz.",frequency);
        Send(playerid, COLOR_WHITE, string);
    }
    return 1;
}
CMD:treatment(playerid, params[])
{
    new targetid;

    if(!IsAMedic(playerid) && (admin_level[playerid] < 1 )) return SCM(playerid, COLOR_GREY, "Anda Bukan Profesi Medis");

    if(sscanf(params, "u", targetid))
    {
        return Info(playerid, "/treatment [playerid]");
    }

    if(!ProxDetectorS(4.0, playerid, targetid)) return SendClientMessage(playerid, 0xB4B5B7FF,"Pemain terlalu jauh");

    if(!IsPlayerConnected(targetid))
    {
        return Info(playerid, "Tidak Ada Player ID Seperti Itu");
    }

    UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pStress]);
    PlayerInfo[playerid][pStress] -= 100;

    SetPlayerDrunkLevel(targetid, 0);

    Info(targetid, "You Have Been Treatment By %s", Name(playerid));
    Info(playerid, "You Has Treatment %s", Name(targetid));
    return 1;
}
