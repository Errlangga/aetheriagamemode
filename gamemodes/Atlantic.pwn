public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
    if(clickedid == PENCETPASSWORD)
    {
        DialogMasukinPw(playerid);
        return 1;
    }
    if(clickedid == PENCETSING)
    {
        if(PlayerInfo[playerid][pPwMasuk] == 0) return ShowError(playerid, "Mohon Masukan Password Anda Terlebih Dahulu");
        mysql_format(mMysql, MySQLStr, 128, "SELECT * FROM `banlog` WHERE `nameplayer` = '%s' LIMIT 1", Name(playerid));
		mysql_tquery(mMysql, MySQLStr, "OnPlayerCheckBanAcc", "d", playerid);

		PlayerInfo[playerid][pPwMasuk] = 0;

		TextDrawHideForPlayer(playerid, LoginTD[0]);
