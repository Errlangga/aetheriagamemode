stock GiveMoneyToAll(money, message[])
{
    for(new idx; idx <MAX_PLAYERS; idx++)
    {
        new allmoney[980], fmt_str[980];
        format(allmoney, sizeof allmoney, "Bansos Dari Admin: {00FF00}%d$ {FFFFFF}%s", money, message);
        SendClientMessage(idx, 0xFFFFFFFF, allmoney);
        GivePlayerMoneyEx(idx, money, "");
        format(fmt_str, sizeof fmt_str, "%s %d$", money < 0 ? ("~r~") : ("~g~+"), money);
        GameTextForPlayer(idx, fmt_str, 4000, 1);
    }
    return 1;
}
