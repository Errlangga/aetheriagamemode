CMD:cad(playerid, params[])
{
 //   if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
	if(admin_level[playerid] < 1) return 1;
