CMD:idelegy(playerid, params[])
{
    new iString[2500] = "{0000FC}\n";
    strcat(iString, "- {F6F6F6}SPOILER:\t {C6C800}1003, 1146, 1147\n");
    strcat(iString, "- {F6F6F6}BUMPER DEPAN:\t {C6C800}1171, 1172\n");
    strcat(iString, "- {F6F6F6}BUMPER BELAKANG:\t {C6C800}1148, 1149\n");
