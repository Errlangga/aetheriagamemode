CMD:dutygojek(playerid)
{
    if(pData[playerid][pJob] != 10)
        return Error(playerid, "Anda Bukan Seorang Driver "GREEN_E"Gojek");

    switch(PlayerData[playerid][pDutyOjek])
    {
        case 0:
        {
            pData[playerid][pDutyOjek] = 1;
            SetPlayerColor(playerid, 0xFFC0CB);
            Info(playerid, "Anda sekarang On-Duty Job: "GREEN_E"Gojek");
            Everyone(COLOR_GREEN, "GOJEK INFO: {ffffff}%s Telah On-Duty Untuk Order "GREEN_E"GOJEK {ffffff}Gunakan /ordergojek", Name(playerid));
        }
        case 1:
        {
            pData[playerid][pDutyOjek] = 0;
            SetPlayerColor(playerid, -1);
            Info(playerid, "Anda Sekarang Off-Duty Job: "GREEN_E"Gojek");
        }
    }
    return 1;
}

CMD:checkorder(playerid, params[])
{
    if(pData[playerid][pJob] != 10)
        return Error(playerid, "Anda Bukan Seorang Driver "GREEN_E"Gojek");
        
    if(pData[playerid][pDutyOjek] != 1)
        return Error(playerid, "Anda Sedang Tidak Bekerja Jika Ingin Bekerja /dutygojek");

    Ojek_ShowCalls(playerid);
        
    new bool:found = false, str[290], Float: x, Float: y, Float: z;
    format(str, sizeof(str), "Nama\tLokasi\n");
    for(new i; i < MAX_PLAYERS; i++)
    {
        if(pData[i][pReqOjek] == 1)
        {
            GetPlayerPos(pData[playerid][pReqOjek1], x, y, z);
            format(str, sizeof(str), "%s%s\t%s\n", str, Name(pData[playerid][pReqOjek1]), GetLocation(x, y, z));
            found = true;
        }
    }
    if(found)
        SPD(playerid, DIALOG_REQOJEK, DIALOG_STYLE_TABLIST_HEADERS, "Request Gojek", str, "Select", "Close");
    else
        SPD(playerid, DIALOG_UNUSEDS, DIALOG_STYLE_MSGBOX, "Request Gojek", "Tidak Ada Yang Memesan", "Close", "");
    return 1;
}

CMD:ordergojek(playerid)
{
    if(pData[playerid][pLogin] != 1)
        return Error(playerid, "You must be to login!");
	if(GetPVarInt(playerid,"pTimeGojek") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 5 Menit");

    for(new i; i < MAX_PLAYERS; i++)
    {
        if(pData[i][pJob] == 10)
        {
            pData[i][pReqOjek1] = playerid;
            if(pData[i][pDutyOjek] == 1)
            {
                SendClientMessageEx(i, -1, ""GREEN_E"GOJEK INFO:"WHITE_E" %s[%d] Memesan Gojek /checkorder Untuk Menerima Pesanan!", Name(playerid), playerid);
            }
        }
    }
    pData[playerid][pReqOjek] = 1;
    Info(playerid, "Anda Sedang Memesan Gojek Tunggu Sebentar");
   	SetPVarInt(playerid, "pTimeGojek", gettime() + 300);
    return 1;
}

stock Ojek_ShowCalls(playerid)
{
    static
        string[2048];
        
    new Float: x, Float: y, Float: z;

    string[0] = 0;

    foreach (new i : Player) if (pData[i][pReqOjek] == 1)
    {
        GetPlayerPos(i, x, y, z);
        format(string, sizeof(string), "%s%d: %s (%s)\n", string, i, Name(i), GetLocation(x, y, z));
    }
    if (!strlen(string))
    {
        Error(playerid, "Tidak Ada Yang Memesan");
    }
    else ShowPlayerDialog(playerid, DIALOG_REQOJEK, DIALOG_STYLE_LIST, "Gojek Call", string, "Accept", "Cancel");
    return 1;
}
CMD:wscommand(playerid)
{
    Info(playerid, "/repairws /repaintws /tune /addnitro /repaintjobws /copotpaintjobws");
    return 1;
}
CMD:wshelp(playerid)
{
    Info(playerid, "/wsmenu /lockworkshop /myworkshop /wscommand");
    return 1;
}

CMD:wsmenu(playerid, params[])
{
    foreach(new id : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 4.0, wsData[id][wX], wsData[id][wY], wsData[id][wZ]))
        {
            if(!IsWorkshopOwner(playerid, id) && !IsWorkshopEmploye(playerid, id))
                return Error(playerid, "You're not the Owner or Employee of this Workshop");

            ShowWorkshopMenu(playerid, id);
        }
    }
    return 1;
}

ShowWorkshopMenu(playerid, id)
{
    pData[playerid][pMenuType] = 0;
    pData[playerid][pInWs] = id;

    new str[256], vstr[64];
    format(vstr, sizeof vstr,"Workshop (%s) Menu", wsData[id][wName]);
    format(str, sizeof str,"Set Workshop Name\nEmploye Menu\nComponent\t(%d/%d)\nMaterial\t(%d/%d)",
        wsData[id][wComp],
        MAX_WORKSHOP_INT,
        wsData[id][wMat],
        MAX_WORKSHOP_INT);
    ShowPlayerDialog(playerid, WS_MENU, DIALOG_STYLE_LIST, vstr, str, "Select", "Cancel");
    return 1;
}

CMD:createworkshop(playerid, params[])
{
    if(admin_level[playerid] < 6)
        return PermissionError(playerid);

    new query[512];
    new wid = Iter_Free(Workshop);
    if(wid == -1) return Error(playerid, "You cant create more workshop!");
    new price;
    if(sscanf(params, "d", price)) return Usage(playerid, "/createworkshop [price]");
    new totalcash[25];
    format(totalcash, sizeof totalcash,"%d00",price);
    price = strval(totalcash);
    format(wsData[wid][wOwner], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][0], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][1], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][2], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][3], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][4], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][5], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][6], MAX_PLAYER_NAME, "-");
    format(wsEmploy[wid][7], MAX_PLAYER_NAME, "-");
    format(wsData[wid][wName], 24, "-");
    GetPlayerPos(playerid, wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]);
    wsData[wid][wPrice] = price;
    wsData[wid][wStatus] = 0;

    Workshop_Refresh(wid);
    Iter_Add(Workshop, wid);

    mysql_format(mMysql, query, sizeof(query), "INSERT INTO workshop SET id=%d, owner='%s', price=%d, posx='%f', posy='%f', posz='%f', name='%s'", wid, wsData[wid][wOwner], wsData[wid][wPrice], wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ], wsData[wid][wName]);
    mysql_tquery(mMysql, query, "OnWorkshopCreated", "i", wid);
    Info(playerid, "Created Workshop ID:%d", wid);
    return 1;
}

epublic: OnWorkshopCreated(wid)
{
    Workshop_Save(wid);
    Workshop_Refresh(wid);
    return 1;
}

CMD:gotoworkshop(playerid, params[])
{
    new wid;
    if(admin_level[playerid] < 2)
        return PermissionError(playerid);

    if(sscanf(params, "d", wid))
        return Usage(playerid, "/gotoworkshop [id]");
    if(!Iter_Contains(Workshop, wid)) return Error(playerid, "The Workshop you specified ID of doesn't exist.");
    SetPlayerPos(playerid, wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    Info(playerid, "You has teleport to Workshop id %d", wid);
    return 1;
}

CMD:editworkshop(playerid, params[])
{
    static
        wid,
        type[24],
        string[128];

    if(admin_level[playerid] < 6)
        return PermissionError(playerid);

    if(sscanf(params, "ds[24]S()[128]", wid, type, string))
    {
        Usage(playerid, "/editworkshop [id] [name]");
        SendClientMessage(playerid, COLOR_YELLOW, "[NAMES]:{FFFFFF} location, status, owner, price, money, comp, mat, delete");
        return 1;
    }
    if((wid < 0 || wid >= MAX_WORKSHOP))
        return Error(playerid, "You have specified an invalid ID.");
    if(!Iter_Contains(Workshop, wid)) return Error(playerid, "The Workshop you specified ID of doesn't exist.");

    if(!strcmp(type, "location", true))
    {
        GetPlayerPos(playerid, wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]);
        Workshop_Save(wid);
        Workshop_Refresh(wid);

        SendAdminMessageEx(COLOR_RED, "%s has adjusted the location of Workshop ID: %d.", GetPlayerAdminNameEx(playerid), wid);
    }
    else if(!strcmp(type, "status", true))
    {
        new locked;

        if(sscanf(string, "d", locked))
            return Usage(playerid, "/editWorkshop [id] [locked] [0/1]");

        if(locked < 0 || locked > 1)
            return Error(playerid, "You must specify at least 0 or 1.");

        wsData[wid][wStatus] = locked;
        Workshop_Save(wid);
        Workshop_Refresh(wid);

        if(locked) {
            SendAdminMessageEx(COLOR_RED, "%s has Opened Workshop ID: %d.", GetPlayerAdminNameEx(playerid), wid);
        }
        else {
            SendAdminMessageEx(COLOR_RED, "%s has Closed Workshop ID: %d.", GetPlayerAdminNameEx(playerid), wid);
        }
    }
    else if(!strcmp(type, "price", true))
    {
        new price;

        if(sscanf(string, "d", price))
            return Usage(playerid, "/editWorkshop [id] [Price] [Amount]");

        wsData[wid][wPrice] = price;

        Workshop_Save(wid);
        Workshop_Refresh(wid);
        SendAdminMessageEx(COLOR_RED, "%s has adjusted the price of Workshop ID: %d to %d.", GetPlayerAdminNameEx(playerid), wid, price);
    }
    else if(!strcmp(type, "money", true))
    {
        new money;

        if(sscanf(string, "d", money))
            return Usage(playerid, "/editWorkshop [id] [money] [Ammount]");

        wsData[wid][wMoney] = money;
        Workshop_Save(wid);
        Workshop_Refresh(wid);
        SendAdminMessageEx(COLOR_RED, "%s has adjusted the money of Workshop ID: %d to %s.", GetPlayerAdminNameEx(playerid), wid, FormatMoney(money));
    }
    else if(!strcmp(type, "comp", true))
    {
        new amount;

        if(sscanf(string, "d", amount))
            return Usage(playerid, "/editWorkshop [id] [Comp] [Ammount]");

        wsData[wid][wComp] = amount;
        Workshop_Save(wid);
        Workshop_Refresh(wid);
        SendAdminMessageEx(COLOR_RED, "%s has adjusted the component of Workshop ID: %d to %d.", GetPlayerAdminNameEx(playerid), wid, amount);
    }
    else if(!strcmp(type, "mat", true))
    {
        new amount;

        if(sscanf(string, "d", amount))
            return Usage(playerid, "/editWorkshop [id] [mat] [Ammount]");

        wsData[wid][wMat] = amount;
        Workshop_Save(wid);
        Workshop_Refresh(wid);
        SendAdminMessageEx(COLOR_RED, "%s has adjusted the material of Workshop ID: %d to %d.", GetPlayerAdminNameEx(playerid), wid, amount);
    }
    else if(!strcmp(type, "owner", true))
    {
        new owners[MAX_PLAYER_NAME];

        if(sscanf(string, "s[24]", owners))
            return Usage(playerid, "/editWorkshop [id] [owner] [player name] (use '-' to no owner)");

        format(wsData[wid][wOwner], MAX_PLAYER_NAME, owners);

        Workshop_Save(wid);
        Workshop_Refresh(wid);
        SendAdminMessageEx(COLOR_RED, "%s has adjusted the owner of Workshop ID: %d to %s", GetPlayerAdminNameEx(playerid), wid, owners);
    }
    else if(!strcmp(type, "reset", true))
    {
        Workshop_Reset(wid);
        Workshop_Save(wid);
        Workshop_Refresh(wid);
        SendAdminMessageEx(COLOR_RED, "%s has reset Workshop ID: %d.", GetPlayerAdminNameEx(playerid), wid);
    }
    else if(!strcmp(type, "delete", true))
    {
        Workshop_Reset(wid);

        DestroyDynamic3DTextLabel(wsData[wid][wText]);
        DestroyDynamicPickup(wsData[wid][wPickup]);

        wsData[wid][wX] = 0;
        wsData[wid][wY] = 0;
        wsData[wid][wZ] = 0;
        wsData[wid][wPrice] = 0;
        wsData[wid][wText] = Text3D: INVALID_3DTEXT_ID;
        wsData[wid][wPickup] = -1;

        Iter_Remove(Workshop, wid);
        new query[128];
        mysql_format(mMysql, query, sizeof(query), "DELETE FROM workshop WHERE id=%d", wid);
        mysql_tquery(mMysql, query);
        SendAdminMessageEx(COLOR_RED, "%s has delete Workshop ID: %d.", GetPlayerAdminNameEx(playerid), wid);
    }
    return 1;
}

CMD:lockworkshop(playerid, params[])
{
    foreach(new wid : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 3.5, wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]))
        {
            if(!IsWorkshopOwner(playerid, wid) && !IsWorkshopEmploye(playerid, wid)) return Error(playerid, "Kamu bukan pengurus Workshop ini.");
            if(!wsData[wid][wStatus])
            {
                wsData[wid][wStatus] = 1;
                Workshop_Save(wid);

                GameTextForPlayer(playerid, "Workshop anda berhasil ~g~Dibuka!", 4000, 3);
                PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
                Everyone(COLOR_GREEN, "Workshop INFO: {ffffff}WORKSHOP %s TELAH BUKA", wsData[wid][wName]);
            }
            else
            {
                wsData[wid][wStatus] = 0;
                Workshop_Save(wid);

                GameTextForPlayer(playerid, "Workshop anda berhasil ~r~Ditutup", 4000, 3);
                PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
                Everyone(COLOR_GREEN, "Workshop INFO: {ffffff}WORKSHOP %s TELAH TUTUP", wsData[wid][wName]);
            }
            Workshop_Refresh(wid);
        }
    }
    return 1;
}
CMD:listws(playerid)
{
    new wid, _tmpstring[128], count = GetOwnedWorkshop(playerid), CMDSString[512];
    CMDSString = "";
    new lock[128];
    strcat(CMDSString,"No\tName(Status)\tLocation\n",sizeof(CMDSString));
    Loopp(itt, (count + 1), 1)
    {
        wid = ReturnPlayerWorkshopID(playerid, itt);
        if(wsData[wid][wStatus] == 1)
        {
            lock = "{7FFF00}Open{ffffff}";
        }
        else
        {
            lock = "{FF0000}Closed{ffffff}";
        }
        if(itt == count)
        {
            format(_tmpstring, sizeof(_tmpstring), "%d\t%s{ffffff}(%s)\t%s{ffffff}\n", itt, wsData[wid][wName], lock, GetLocation(wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]));
        }
        else format(_tmpstring, sizeof(_tmpstring), "%d\t%s{ffffff}(%s)\t%s{ffffff}\n", itt, wsData[wid][wName], lock, GetLocation(wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]));
        strcat(CMDSString, _tmpstring);
    }
    ShowPlayerDialog(playerid, DIALOG_MY_WS, DIALOG_STYLE_TABLIST_HEADERS, "List Workshop", CMDSString, "Track", "Cancel");
    return 1;
}
CMD:myworkshop(playerid)
{
    if(!GetOwnedWorkshop(playerid)) return Error(playerid, "You don't have any Workshop.");
    new wid, _tmpstring[128], count = GetOwnedWorkshop(playerid), CMDSString[512];
    CMDSString = "";
    new lock[128];
    strcat(CMDSString,"No\tName(Status)\tLocation\n",sizeof(CMDSString));
    Loopp(itt, (count + 1), 1)
    {
        wid = ReturnPlayerWorkshopID(playerid, itt);
        if(wsData[wid][wStatus] == 1)
        {
            lock = "{7FFF00}Open{ffffff}";
        }
        else
        {
            lock = "{FF0000}Closed{ffffff}";
        }
        if(itt == count)
        {
            format(_tmpstring, sizeof(_tmpstring), "%d\t%s{ffffff}(%s)\t%s{ffffff}\n", itt, wsData[wid][wName], lock, GetLocation(wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]));
        }
        else format(_tmpstring, sizeof(_tmpstring), "%d\t%s{ffffff}(%s)\t%s{ffffff}\n", itt, wsData[wid][wName], lock, GetLocation(wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]));
        strcat(CMDSString, _tmpstring);
    }
    ShowPlayerDialog(playerid, DIALOG_MY_WS, DIALOG_STYLE_TABLIST_HEADERS, "My Workshop", CMDSString, "Track", "Cancel");
    return 1;
}

CMD:cgarkot(playerid, params[])
{
	if(admin_level[playerid] < 8) return 1;
	new Float: Gpos[4], string[254];
	new id = ValidGarkot();
	GetPlayerPos(playerid, Gpos[0], Gpos[1], Gpos[2]);
	GetPlayerFacingAngle(playerid, Gpos[3]);
	IdGarkot[id] = 1;
	GarkotInfo[id][GposX] = Gpos[0];
	GarkotInfo[id][GposY] = Gpos[1];
	GarkotInfo[id][GposZ] = Gpos[2];
	GarkotInfo[id][GposA] = Gpos[3];
	format(string, sizeof(string), "{FFFF00}[GARKOT]\nGunakan Tombol 'Y'", id);
	GarkotInfo[id][GLabel] = CreateDynamic3DTextLabel(string, -1, GarkotInfo[id][GposX], GarkotInfo[id][GposY], GarkotInfo[id][GposZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	GarkotInfo[id][GPickup] = CreateDynamicPickup(19134, 23, GarkotInfo[id][GposX], GarkotInfo[id][GposY], GarkotInfo[id][GposZ], 0, 0);
	SetPlayerPos(playerid, Gpos[0], Gpos[1], Gpos[2]+1);
	SaveGarkot();
	return 1;
}
CMD:shareloc(playerid, params[])
{
    if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki ponsel.");
	if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki kartu SIM.");
	if(PhoneOnline[playerid] != 0) return Send(playerid,COLOR_GREY, "Ponsel Anda mati.");
	if(PlayerInfo[playerid][pSummaNumber] <= 0) return Send(playerid, COLOR_GREY, "Anda tidak punya uang di akun ponsel Anda.");
	if(sscanf(params, "u", params[0])) return SCM(playerid, COLOR_GREEN, "Gunakan /shareloc (playerid)");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_SHARELOC);

	return SCM(params[0], COLOR_GREY, "Untuk persetujuan SHARELOC, tekan Y(/accept) atau untuk penolakan N(/cancel)");
}
CMD:eat(playerid, params[])
{
    new i = player_use_bizbar[playerid];
    new inter = GetPlayerInterior(playerid);

	if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 2 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return Send(playerid,COLOR_GREY, "Restoran ditutup oleh pemilik!");

		if(inter == 10 || inter == 4)
		{
			format
			(
				String, 322,
				"{ffffff}0. Air Putih\t{32CD32}%d$\n\
				{ffffff}1. Es Teh\t{32CD32}%d$\n\
				{ffffff}2. Es Susu Perawan\t{32CD32}%d$\n\
				{ffffff}3. Bakso\t{32CD32}%d$\n\
				{ffffff}4. Soto Ayam\t{32CD32}%d$\n\
				{ffffff}5. Nasi Goreng\t{32CD32}%d$",

				BizzInfo[i][bPrice],BizzInfo[i][bPrice]*2,BizzInfo[i][bPrice]*3,
				BizzInfo[i][bPrice]*4,BizzInfo[i][bPrice]*5,BizzInfo[i][bPrice]*6);

			return SPD(playerid, 71, DIALOG_STYLE_LIST, "Menu Warung", String, "Pilih", "Keluar");
		}
		if(inter == 5 || inter == 9 || inter == 17 || inter == 1)
		{
			format
			(
				String, 322,
				"{ffffff}0. Air Putih\t{32CD32}%d$\n\
				{ffffff}1. Es Teh\t{32CD32}%d$\n\
				{ffffff}2. Es Susu Perawan\t{32CD32}%d$\n\
				{ffffff}3. Bakso\t{32CD32}%d$\n\
				{ffffff}4. Soto Ayam\t{32CD32}%d$\n\
				{ffffff}5. Nasi Goreng\t{32CD32}%d$",

				BizzInfo[i][bPrice],BizzInfo[i][bPrice]*2,BizzInfo[i][bPrice]*3,
				BizzInfo[i][bPrice]*4,BizzInfo[i][bPrice]*5,BizzInfo[i][bPrice]*6
			);

			return SPD(playerid, 71, DIALOG_STYLE_LIST, "Menu Makanan", String, "beli", "Keluar");
		}
	}
	return true;
}
CMD:setvip(playerid, params[])
{
    if(admin_level[playerid] < 11) return 1;
    if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /givevip [playerid]");
	SPD(playerid, 554, DIALOG_STYLE_LIST, "Menu GiveVIP", ""W"1. VIP Bronze\n2. VIP Silver\n3. VIP Gold", "Pilih", "Tutup");
	return 1;
}
CMD:staterpack(playerid)
{
	if(PlayerInfo[playerid][pWargaNew] == 1) return SCM(playerid, COLOR_GREEN, "kamu sudah klaim hadiah warga baru!!");
	PlayerInfo[playerid][pWargaNew] = 1;
    PlayerInfo[playerid][pLevel] += 1;
	PlayerInfo[playerid][pFreeRoulet] += 3;
	OnPlayerUpdateAccountsPer(playerid, "pFreeRoulet", PlayerInfo[playerid][pFreeRoulet]);
	OnPlayerUpdateAccountsPer(playerid, "pLevel", PlayerInfo[playerid][pLevel]);
	OnPlayerUpdateAccountsPer(playerid, "pWargaNew", PlayerInfo[playerid][pWargaNew]);
	GivePlayerMoneyEx(playerid, 30000000, "");
    SendClientMessage(playerid, COLOR_LIGHTBLUE, "Bob: {FFFFFF}Nih Kukasih 30 juta , 1 level sama 3 roulette(/roulette)");
	GameTextForPlayer(playerid,"~g~staterpack sukses", 1000, 0);
	return 1;
}
CMD:vote(playerid, params[]) //vote by : kybar
{
	new string[128];
	if(admin_level[playerid] < 5) return SendClientMessage(playerid, COLOR_GREY, "{007FFF}[EROR] {FFFFFF}Anda tidak memiliki izin untuk menggunakan perintah ini!");
	if(sscanf(params, "s[128]", params)) return SendClientMessage(playerid, COLOR_GREEN, "[USAGE]{FFFFFF} /vote [pertanyaan]");
	if(strlen(params) > 128) return SendClientMessage(playerid, COLOR_GREEN, "[VOTE]{FFFFFF} membuat kalimat VOTE harus 128 kata.");
	if(VoteOn) return SendClientMessage(playerid, COLOR_GREY, "[VOTE] Vote telah berlangsung");
	format(string, sizeof(string), "[VOTE]{FFFFFF}{ffff00}[VOTEASK] {FFFFFF} %s.", params);
	SendClientMessageToAll(COLOR_RED, string);
	format(string, sizeof(string), "[VOTE]{FFFFFF} Tekan '{33AA33}Y{FFFFFF}' untuk {33AA33}Yes, {FFFFFF}Tekan '{FF0000}N{FFFFFF}' untuk {FF0000}No.");
	SendClientMessageToAll(COLOR_RED, string);
	format(string, sizeof(string), "[VOTE]{FFFFFF} Vote akan berakhir dalam 1 menit.");
	SendClientMessageToAll(COLOR_RED, string);
	VoteOn = 1;
	VoteN = 0;
	foreach(Player, i)
	{
		VoteVoted[i] = 0;
	}
	VoteY = 0;
	SetTimer("VoteEnd", 60000, false);
	return 1;
}
CMD:createdoor(playerid, params[])
{
	if(admin_level[playerid] < 8)
		return PermissionError(playerid);

	new did = Iter_Free(Doors), mstr[128], query[248];
	if(did == -1) return Error(playerid, "You cant create more door!");
	new name[128];
	if(sscanf(params, "s[128]", name)) return Usage(playerid, "/createdoor [name]");
	format(dData[did][dName], 128, name);
	GetPlayerPos(playerid, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ]);
	GetPlayerFacingAngle(playerid, dData[did][dExtposA]);
	dData[did][dExtvw] = GetPlayerVirtualWorld(playerid);
	dData[did][dExtint] = GetPlayerInterior(playerid);
	format(dData[did][dPass], 32, "");
	dData[did][dIcon] = 19130;
	dData[did][dLocked] = 0;
	dData[did][dAdmin] = 0;
	dData[did][dVip] = 0;
	dData[did][dFaction] = 0;
	dData[did][dFamily] = -1;
	dData[did][dGarage] = 0;
	dData[did][dCustom] = 0;
	dData[did][dIntvw] = 0;
	dData[did][dIntint] = 0;
	dData[did][dIntposX] = 0;
	dData[did][dIntposY] = 0;
	dData[did][dIntposZ] = 0;
	dData[did][dIntposA] = 0;

	format(mstr,sizeof(mstr),"[ID: %d]\n{FFFFFF}%s\n{FFFFFF}Press {FF0000}ENTER {FFFFFF}to enter", did, dData[did][dName]);
	dData[did][dPickupext] = CreateDynamicPickup(19130, 23, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtvw], dData[did][dExtint]);
	dData[did][dLabelext] = CreateDynamic3DTextLabel( mstr, COLOR_YELLOW, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ]+0.35, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, dData[did][dExtvw], dData[did][dExtint]);
    Doors_Updatelabel(did);
	Iter_Add(Doors, did);

	mysql_format(mMysql, query, sizeof(query), "INSERT INTO doors SET ID=%d, extvw=%d, extint=%d, extposx=%f, extposy=%f, extposz=%f, extposa=%f, name='%s'", did, dData[did][dExtvw], dData[did][dExtint], dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA], name);
	mysql_tquery(mMysql, query, "OnDoorsCreated", "i", did);
	return 1;
}

epublic: OnDoorsCreated(id)
{
	Doors_Save(id);
	Doors_Updatelabel(id);
	return 1;
}

CMD:gotodoor(playerid, params[])
{
	new did;
	if(admin_level[playerid] < 2)
        return PermissionError(playerid);

	if(sscanf(params, "d", did))
		return Usage(playerid, "/gotodoor [id]");
	if(!Iter_Contains(Doors, did)) return Error(playerid, "The doors you specified ID of doesn't exist.");
	SetPlayerPosition(playerid, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);
    SetPlayerInterior(playerid, dData[did][dExtint]);
    SetPlayerVirtualWorld(playerid, dData[did][dExtvw]);
	PlayerInfo[playerid][pInDoor] = -1;
	PlayerInfo[playerid][pInHouse] = -1;
	PlayerInfo[playerid][pInBiz] = -1;
	Servers(playerid, "You has teleport to door");
	return 1;
}
CMD:editdoor(playerid, params[])
{
    static
        did,
        type[24],
        string[128];

    if(admin_level[playerid] < 8)
        return PermissionError(playerid);

    if(sscanf(params, "ds[24]S()[128]", did, type, string))
    {
        Usage(playerid, "/editdoor [id] [name]");
        SendClientMessage(playerid, COLOR_YELLOW, "[NAMES]:{FFFFFF} location, interior, password, name, locked, admin, vip, faction, family, custom, virtual");
        return 1;
    }
    if((did < 0 || did >= MAX_DOOR))
        return Error(playerid, "You have specified an invalid entrance ID.");
	if(!Iter_Contains(Doors, did)) return Error(playerid, "The doors you specified ID of doesn't exist.");

    if(!strcmp(type, "location", true))
    {
		GetPlayerPos(playerid, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ]);
		GetPlayerFacingAngle(playerid, dData[did][dExtposA]);

        dData[did][dExtvw] = GetPlayerVirtualWorld(playerid);
		dData[did][dExtint] = GetPlayerInterior(playerid);
        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has adjusted the location of entrance ID: %d.", PlayerInfo[playerid][pAname], did);
        SendAdminMessage(COLOR_RED, String);
    }
    else if(!strcmp(type, "interior", true))
    {
        GetPlayerPos(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ]);
		GetPlayerFacingAngle(playerid, dData[did][dIntposA]);

        dData[did][dIntvw] = GetPlayerVirtualWorld(playerid);
		dData[did][dIntint] = GetPlayerInterior(playerid);
        Doors_Save(did);
		Doors_Updatelabel(did);

       /*foreach (new i : Player)
        {
            if(pData[i][pEntrance] == EntranceData[id][entranceID])
            {
                SetPlayerPos(i, EntranceData[id][entranceInt][0], EntranceData[id][entranceInt][1], EntranceData[id][entranceInt][2]);
                SetPlayerFacingAngle(i, EntranceData[id][entranceInt][3]);

                SetPlayerInterior(i, EntranceData[id][entranceInterior]);
                SetCameraBehindPlayer(i);
            }
        }*/
        format(String, sizeof(String), "%s has adjusted the interior spawn of entrance ID: %d.", PlayerInfo[playerid][pAname], did);
        SendAdminMessage(COLOR_RED, String);
    }
    else if(!strcmp(type, "custom", true))
    {
        new status;

        if(sscanf(string, "d", status))
            return Usage(playerid, "/editdoor [id] [custom] [0/1]");

        if(status < 0 || status > 1)
            return Error(playerid, "You must specify at least 0 or 1.");

        dData[did][dCustom] = status;
        Doors_Save(did);
		Doors_Updatelabel(did);

        if(status) {
            //SendAdminMessage(COLOR_RED, "%s has enabled custom interior mode for entrance ID: %d.", pData[playerid][pAdminname], did);
        }
        else {
            //SendAdminMessage(COLOR_RED, "%s has disabled custom interior mode for entrance ID: %d.", pData[playerid][pAdminname], did);
        }
    }
    else if(!strcmp(type, "virtual", true))
    {
        new worldid;

        if(sscanf(string, "d", worldid))
            return Usage(playerid, "/editdoor [id] [virtual] [interior world]");

        dData[did][dExtvw] = worldid;

        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has adjusted the virtual of entrance ID: %d to %d.", PlayerInfo[playerid][pAname], did, worldid);
        SendAdminMessage(COLOR_RED, String);
    }
    else if(!strcmp(type, "password", true))
    {
        new password[32];

        if(sscanf(string, "s[32]", password))
            return Usage(playerid, "/editdoor [id] [password] [entrance pass] (use 'none' to disable)");

        if(!strcmp(password, "none", true)) {
            format(dData[did][dPass], 32, "");
        }
        else {
            format(dData[did][dPass], 32, password);
        }
        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has adjusted the password of entrance ID: %d to %s", PlayerInfo[playerid][pAname], did, password);
        SendAdminMessage(COLOR_RED, String);
    }
    else if(!strcmp(type, "locked", true))
    {
        new locked;

        if(sscanf(string, "d", locked))
            return Usage(playerid, "/editdoor [id] [locked] [locked 0/1]");

        if(locked < 0 || locked > 1)
            return Error(playerid, "Invalid value. Use 0 for unlocked and 1 for locked.");

        dData[did][dLocked] = locked;
        Doors_Save(did);
		Doors_Updatelabel(did);

        if(locked) {
            //SendAdminMessage(COLOR_RED, "%s has locked entrance ID: %d.", pData[playerid][pAdminname], did);
        } else {
            //SendAdminMessage(COLOR_RED, "%s has unlocked entrance ID: %d.", pData[playerid][pAdminname], did);
        }
    }
    else if(!strcmp(type, "name", true))
    {
        new name[128];

        if(sscanf(string, "s[128]", name))
            return Usage(playerid, "/editdoor [id] [name] [new name]");

        format(dData[did][dName], 128, ColouredText(name));

        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has adjusted the name of entrance ID: %d to \"%s\".", PlayerInfo[playerid][pAname], did, ColouredText(name));
        SendAdminMessage(COLOR_RED, String);
    }
	else if(!strcmp(type, "admin", true))
    {
        new level;

        if(sscanf(string, "d", level))
            return Usage(playerid, "/editdoor [id] [admin] [level]");

        if(level < 0 || level > 5)
            return Error(playerid, "Invalid value. Use 0 - 5 for level.");

        dData[did][dAdmin] = level;
        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has set entrance ID: %d to admin level %d.", PlayerInfo[playerid][pAname], did, level);
        SendAdminMessage(COLOR_RED, String);
    }
	else if(!strcmp(type, "vip", true))
    {
        new level;

        if(sscanf(string, "d", level))
            return Usage(playerid, "/editdoor [id] [VIP] [level]");

        if(level < 0 || level > 3)
            return Error(playerid, "Invalid value. Use 0 - 3 for level.");

        dData[did][dVip] = level;
        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has set entrance ID: %d to VIP level %d.", PlayerInfo[playerid][pAname], did, level);
        SendAdminMessage(COLOR_RED, String);
    }
	else if(!strcmp(type, "faction", true))
    {
        new fid;

        if(sscanf(string, "d", fid))
            return Usage(playerid, "/editdoor [id] [faction] [faction id]");

        if(fid < 0 || fid > 25)
            return Error(playerid, "Invalid value. Use 0 - 4 for type.");

        dData[did][dFaction] = fid;
        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has set entrance ID: %d to faction id %d.", PlayerInfo[playerid][pAname], did, fid);
        SendAdminMessage(COLOR_RED, String);
    }
	else if(!strcmp(type, "family", true))
    {
        new fid;

        if(sscanf(string, "d", fid))
            return Usage(playerid, "/editdoor [id] [family] [family id]");

        if(fid < -1 || fid > 9)
            return Error(playerid, "Invalid value. Use -1 - 9 for family id.");

        dData[did][dFamily] = fid;
        Doors_Save(did);
		Doors_Updatelabel(did);
		format(String, sizeof(String), "%s has set entrance ID: %d to family id %d.", PlayerInfo[playerid][pAname], did, fid);
        SendAdminMessage(COLOR_RED, String);
    }
	else if(!strcmp(type, "garage", true))
	{
		new gid;

        if(sscanf(string, "d", gid))
            return Usage(playerid, "/editdoor [id] [garage] [0 - 1]");

        if(gid < 0 || gid > 1)
            return Error(playerid, "Invalid value! Use 0 to disable, 1 to enable.");

		if(gid == 0)
		{
			dData[did][dGarage] = 0;
			format(String, sizeof(String), "%s has set entrance ID: %d to garage vehicle disable.", PlayerInfo[playerid][pAname], did);
			SendAdminMessage(COLOR_RED, String);
		}
		else
		{
			dData[did][dGarage] = 1;
			format(String, sizeof(String), "%s has set entrance ID: %d to garage vehicle enable.",PlayerInfo[playerid][pAname], did);
			SendAdminMessage(COLOR_RED, String);
		}
		Doors_Save(gid);
		Doors_Updatelabel(gid);
	}
	else if(!strcmp(type, "delete", true))
    {
		DestroyDynamic3DTextLabel(dData[did][dLabelext]);
		DestroyDynamicPickup(dData[did][dPickupext]);
		DestroyDynamic3DTextLabel(dData[did][dLabelint]);
		DestroyDynamicPickup(dData[did][dPickupint]);

		dData[did][dExtposX] = 0;
		dData[did][dExtposY] = 0;
		dData[did][dExtposZ] = 0;
		dData[did][dExtposA] = 0;
		dData[did][dExtvw] = 0;
		dData[did][dExtint] = 0;
		format(dData[did][dPass], 32, "");
		dData[did][dIcon] = 0;
		dData[did][dLocked] = 0;
		dData[did][dAdmin] = 0;
		dData[did][dVip] = 0;
		dData[did][dFaction] = 0;
		dData[did][dFamily] = -1;
		dData[did][dGarage] = 0;
		dData[did][dCustom] = 0;
		dData[did][dIntvw] = 0;
		dData[did][dIntint] = 0;
		dData[did][dIntposX] = 0;
		dData[did][dIntposY] = 0;
		dData[did][dIntposZ] = 0;
		dData[did][dIntposA] = 0;

		dData[did][dLabelext] = Text3D: INVALID_3DTEXT_ID;
		dData[did][dLabelint] = Text3D: INVALID_3DTEXT_ID;
		dData[did][dPickupext] = -1;
		dData[did][dPickupint] = -1;

		Iter_Remove(Doors, did);
		new query[128];
		mysql_format(mMysql, query, sizeof(query), "DELETE FROM doors WHERE ID=%d", did);
		mysql_tquery(mMysql, query);
		format(String, sizeof(String), "%s has delete door ID: %d.", PlayerInfo[playerid][pAname], did);
        SendAdminMessage(COLOR_RED, String);
	}
    return 1;
}

Family_Refresh(id)
{
	if(id != -1)
	{
		if(IsValidDynamic3DTextLabel(family_info[id][f_label]))
            DestroyDynamic3DTextLabel(family_info[id][f_label]);

        if(IsValidDynamicPickup(family_info[id][f_pickup]))
            DestroyDynamicPickup(family_info[id][f_pickup]);

		new tstr[258];
		format(tstr, sizeof(tstr), "[Family ID: %d]\nSafe Point", id);
		family_info[id][f_label] = CreateDynamic3DTextLabel(tstr, COLOR_YELLOW, family_info[id][f_locker][0], family_info[id][f_locker][1], family_info[id][f_locker][2]+0.7, 5.0);
        family_info[id][f_pickup] = CreateDynamicPickup(1239, 23, family_info[id][f_locker][0], family_info[id][f_locker][1], family_info[id][f_locker][2], id, -1, -1, 7);
	}
}

CMD:fedit(playerid, params[])
{
    static
        fid,
        type[24],
        string[128];

    if(admin_level[playerid] < 8)
        return PermissionError(playerid);

    if(sscanf(params, "ds[24]S()[128]", fid, type, string))
    {
        Usage(playerid, "/fedit [id] [name]");
        SendClientMessage(playerid, COLOR_YELLOW, "[NAMES]:{FFFFFF} locker");
        return 1;
    }
    if((fid < 0 || fid >= MAX_FAMILYS))
        return Error(playerid, "You have specified an invalid ID.");

    if(!strcmp(type, "locker", true))
    {
        GetPlayerPos(playerid, family_info[fid][f_locker][0], family_info[fid][f_locker][1], family_info[fid][f_locker][2]);

        new query[128];
		format(query, sizeof query, "UPDATE `family` SET `f_locker_x` = %f, `f_locker_y` = %f, `f_locker_z` = %f WHERE `f_id` = %i", family_info[fid][f_locker][0], family_info[fid][f_locker][1], family_info[fid][f_locker][2], fid);
		mysql_tquery(mMysql, query);

		Family_Refresh(fid);

		format(String, sizeof(String), "Admin %s has changed the family safepos ID: %d.", PlayerInfo[playerid][pAname], fid);
        SendAdminMessage(COLOR_RED, String);
    }
    return 1;
}

CMD:flocker(playerid)
{
	if(PlayerInfo[playerid][pFamily] == -1)
		return Error(playerid, "Anda bukan anggota family");
		
	new fid = PlayerInfo[playerid][pFamily];
	if(IsPlayerInRangeOfPoint(playerid, 3.0, family_info[fid][f_locker][0], family_info[fid][f_locker][1], family_info[fid][f_locker][2]))
    {
    	new cags[258];
    	format(cags, sizeof cags, "Drugs\t%d\nLogam\t%d\nMarijuana\t%d", family_info[fid][f_drugs], family_info[fid][f_logam], family_info[fid][f_micin]);
     	ShowPlayerDialog(playerid, DIALOG_F_LOCKER, DIALOG_STYLE_LIST, "Family Locker", cags, "Select", "Cancel");
    }
 	else
   	{
     	Error(playerid, "You aren't in range in area family safe.");
    }
	return 1;
}

CMD:cgate(playerid, params[])
{
	new object;
	if(admin_level[playerid] < 11 || !admin_logged[playerid])
		return PermissionError(playerid);

	new id = Iter_Free(Gates), str[128], query[248];
	if(id == -1) return Error(playerid, "You cant create more gate!");
	if(sscanf(params, "i", object)) return Usage(playerid, "/creategate [objectid]");

	GetPlayerPos(playerid, gData[id][gCX], gData[id][gCY], gData[id][gCZ]);
	gData[id][gModel] = object;
	gData[id][gCX] = gData[id][gCX] + 2;
	gData[id][gCY] = gData[id][gCY] + 2;
	gData[id][gCRX] = 0;
	gData[id][gCRY] = 0;
	gData[id][gCRZ] = 0;
	GetPlayerPos(playerid, gData[id][gOX], gData[id][gOY], gData[id][gOZ]);
	gData[id][gOX] = gData[id][gOX] + 2;
	gData[id][gOY] = gData[id][gOY] + 2;
	gData[id][gORX] = 0;
	gData[id][gORY] = 0;
	gData[id][gORZ] = 0;
	gData[id][gStatus] = 0;
	gData[id][gFamily] = -1;
	gData[id][gFaction] = 0;
	gData[id][gAdmin] = 0;
	gData[id][gVip] = 0;
	format(gData[id][gPass], 36, "");
	gData[id][gSpeed] = 2.0;
	// Creating
	gData[id][gObjID] = CreateDynamicObject(gData[id][gModel], gData[id][gCX], gData[id][gCY], gData[id][gCZ], gData[id][gCRX], gData[id][gCRY], gData[id][gCRZ], -1, -1, -1, 50.0, 50.0);

	format(str, sizeof(str), "Gate ID: %d", id);
	gData[id][gText] = CreateDynamic3DTextLabel(str, COLOR_WHITE, gData[id][gCX], gData[id][gCY], gData[id][gCZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1, -1, 10.0);
	gData[id][gStatus] = 0;
	Iter_Add(Gates, id);
	// Text
	Servers(playerid, "You has create gate");

	mysql_format(mMysql, query, sizeof(query), "INSERT INTO gates SET ID='%d', model='%d', cX='%f', cY='%f', cZ='%f', cRX='%f', cRY='%f', cRZ='%f', oX='%f', oY='%f', oZ='%f', oRX='%f', oRY='%f', oRZ='%f'",
	id, gData[id][gModel], gData[id][gCX], gData[id][gCY], gData[id][gCZ], gData[id][gCRX], gData[id][gCRY], gData[id][gCRZ], gData[id][gOX], gData[id][gOY], gData[id][gOZ], gData[id][gORX], gData[id][gORY], gData[id][gORZ]);
	mysql_tquery(mMysql, query, "OnGateCreated", "i", id);
	return 1;
}

epublic: OnGateCreated(id)
{
	Gate_Save(id);
	return 1;
}

CMD:gedit(playerid, params[])
{
    static
        id,
        type[24],
        string[128];

    if(admin_level[playerid] < 11 || !admin_logged[playerid])
        return PermissionError(playerid);

    if(sscanf(params, "ds[24]S()[128]", id, type, string))
    {
        Usage(playerid, "/gedit [id] [name]");
        Info(playerid, "object | admin | vip | faction | family | close | open | speed | password");
        return 1;
    }
    if((id < 0 || id >= MAX_GATES))
        return Error(playerid, "You have specified an invalid gate ID.");
	if(!Iter_Contains(Gates, id)) return Error(playerid, "The gate you specified ID of doesn't exist.");

	if(!strcmp(type, "object", true))
    {
		new object;

        if(sscanf(string, "d", object))
            return Usage(playerid, "/gedit [id] [Object] [objectid]");

        gData[id][gModel] = object;
		DestroyDynamicObject(gData[id][gObjID]);
		//gData[id][gObjID] = CreateDynamicObject(gData[id][gModel], gData[id][gCX], gData[id][gCY], gData[id][gCZ], gData[id][gCRX], gData[id][gCRY], gData[id][gCRZ]);
		gData[id][gObjID] = CreateDynamicObject(gData[id][gModel], gData[id][gCX], gData[id][gCY], gData[id][gCZ], gData[id][gCRX], gData[id][gCRY], gData[id][gCRZ], -1, -1, -1, 50.0, 50.0);
	    Servers(playerid, "You have set gate object ID.");
	    Gate_Save(id);
	}
	else if(!strcmp(type, "admin", true))
    {
		new admin;

        if(sscanf(string, "d", admin))
            return Usage(playerid, "/gedit [id] [Admin] [level]");

		if(admin < 0 || admin > 6)
			return Error(playerid, "invalid vip id 0 - 6.");

		gData[id][gAdmin] = admin;
	    Servers(playerid, "You have set gate to admin level.");
	    Gate_Save(id);
	}
	else if(!strcmp(type, "vip", true))
    {
		new vip;

        if(sscanf(string, "d", vip))
            return Usage(playerid, "/gedit [id] [VIP] [level]");

        if(vip < 0 || vip > 3)
            return Error(playerid, "Invalid value. Use 0 - 3 for level.");

		gData[id][gVip] = vip;
	    Servers(playerid, "You have set gate to VIP level.");
	    Gate_Save(id);
	}
	else if(!strcmp(type, "faction", true))
    {
		new fid;

        if(sscanf(string, "d", fid))
            return Usage(playerid, "/gedit [id] [faction] [faction id]");

        if(fid < 0 || fid > 22)
            return Error(playerid, "Invalid value. Use 0 - 22 for type.");

		gData[id][gFaction] = fid;
	    Servers(playerid, "You have set gate to faction.");
	    Gate_Save(id);
	}
	else if(!strcmp(type, "family", true))
    {
		new fid;

        if(sscanf(string, "d", fid))
            return Usage(playerid, "/gedit [id] [family] [family id]");

        if(fid < -1 || fid > 9)
            return Error(playerid, "Invalid value. Use -1 - 9 for family id.");

		gData[id][gFamily] = fid;
	    Servers(playerid, "You have set gate to family.");
	    Gate_Save(id);
	}
	else if(!strcmp(type, "speed", true))
    {
		new Float:speed;

        if(sscanf(string, "f", speed))
            return Usage(playerid, "/gedit [id] [Speed] [level]");

		gData[id][gSpeed] = speed;
	    Servers(playerid, " You have set gate moving speed.");
	    Gate_Save(id);
	}
	else if(!strcmp(type, "close", true))
    {
		PlayerInfo[playerid][gEdit] = 1;
		PlayerInfo[playerid][gEditID] = id;
		GetDynamicObjectPos(gData[id][gObjID], gPosX[playerid], gPosY[playerid], gPosZ[playerid]);
		GetDynamicObjectRot(gData[id][gObjID], gRotX[playerid], gRotY[playerid], gRotZ[playerid]);
		EditDynamicObject(playerid, gData[id][gObjID]);
	    Servers(playerid, " You are now editing gate closing position.");
	    Gate_Save(id);
	}
	else if(!strcmp(type, "open", true))
    {
		PlayerInfo[playerid][gEdit] = 2;
		PlayerInfo[playerid][gEditID] = id;
		GetDynamicObjectPos(gData[id][gObjID], gPosX[playerid], gPosY[playerid], gPosZ[playerid]);
		GetDynamicObjectRot(gData[id][gObjID], gRotX[playerid], gRotY[playerid], gRotZ[playerid]);
		EditDynamicObject(playerid, gData[id][gObjID]);
	    Servers(playerid, " You are now editing gate opening position.");
	}
	else if(!strcmp(type, "password", true))
    {
		new password[36];

        if(sscanf(string, "s[36]", password))
            return Usage(playerid, "/gedit [id] [password] [gate pass] (use 'none' to disable)");

        if(!strcmp(password, "none", true)) {
            format(gData[id][gPass], 36, "");
        }
        else {
            format(gData[id][gPass], 36, password);
        }
        Gate_Save(id);
        Servers(playerid, "You has adjusted the password of gate");
	}
	else if(!strcmp(type, "delete", true))
    {
		gData[id][gModel] = 0;
		gData[id][gCX] = 0;
		gData[id][gCY] = 0;
		gData[id][gCZ] = 0;
		gData[id][gCRX] = 0;
		gData[id][gCRY] = 0;
		gData[id][gCRZ] = 0;
		gData[id][gOX] = 0;
		gData[id][gOY] = 0;
		gData[id][gOZ] = 0;
		gData[id][gORX] = 0;
		gData[id][gORY] = 0;
		gData[id][gORZ] = 0;
		gData[id][gStatus] = 0;
		format(gData[id][gPass], 36, "");
		gData[id][gSpeed] = 0;

		DestroyDynamicObject(gData[id][gObjID]);
		DestroyDynamic3DTextLabel(gData[id][gText]);

		Iter_Remove(Gates, id);
		new query[128];
		mysql_format(mMysql, query, sizeof(query), "DELETE FROM gates WHERE ID=%d", id);
		mysql_tquery(mMysql, query);
		Servers(playerid, "You has deleted gate.");
	}
	return 1;
}
CMD:gotogate(playerid, params[])
{
    new id;
	if(admin_level[playerid] < 1)
		return PermissionError(playerid);

	if(sscanf(params, "i", id)) return Usage(playerid, "/gotogate [gateid]");
	if(!Iter_Contains(Gates, id)) return Error(playerid, "The gate you specified ID of doesn't exist.");

	SetPlayerPosition(playerid, gData[id][gCX], gData[id][gCY], gData[id][gCZ], 5.0);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
	Servers(playerid, "You has teleport to gate");
	return 1;
}

CMD:gate(playerid, params[])
{
    // Dynamic Gates
    foreach(new idx : Gates)
	{
	    if(gData[idx][gModel] && IsPlayerInRangeOfPoint(playerid, 8.0, gData[idx][gCX], gData[idx][gCY], gData[idx][gCZ]))
	    {
			if(gData[idx][gFaction] > 0)
			{
				if(gData[idx][gFaction] != PlayerInfo[playerid][pMember])
					return Error(playerid, "This gate only for faction.");
			}
			if(gData[idx][gFamily] > -1)
			{
				if(gData[idx][gFamily] != PlayerInfo[playerid][pFamily])
					return Error(playerid, "This gate only for family.");
			}

			if(gData[idx][gVip] > PlayerInfo[playerid][pVip])
				return Error(playerid, "Your VIP level not enough to enter this gate.");

			if(gData[idx][gAdmin] > admin_level[playerid])
				return Error(playerid, "Your admin level not enough to enter this gate.");

	        if(strlen(gData[idx][gPass]))
	        {
	            if(sscanf(params, "s[36]", params)) return Usage(playerid, "/gate [password]");
	            if(strcmp(params, gData[idx][gPass])) return Error(playerid, "Invalid gate password.");
	            if(!gData[idx][gStatus])
		        {
		            gData[idx][gStatus] = 1;
		            MoveDynamicObject(gData[idx][gObjID], gData[idx][gOX], gData[idx][gOY], gData[idx][gOZ], gData[idx][gSpeed]);
		            SetDynamicObjectRot(gData[idx][gObjID], gData[idx][gORX], gData[idx][gORY], gData[idx][gORZ]);
		        }
		        else
		        {
		            gData[idx][gStatus] = 0;
		            MoveDynamicObject(gData[idx][gObjID], gData[idx][gCX], gData[idx][gCY], gData[idx][gCZ], gData[idx][gSpeed]);
		            SetDynamicObjectRot(gData[idx][gObjID], gData[idx][gCRX], gData[idx][gCRY], gData[idx][gCRZ]);
		        }
	        }
	        else
	        {
		        if(!gData[idx][gStatus])
		        {
		            gData[idx][gStatus] = 1;
		            MoveDynamicObject(gData[idx][gObjID], gData[idx][gOX], gData[idx][gOY], gData[idx][gOZ], gData[idx][gSpeed]);
		            SetDynamicObjectRot(gData[idx][gObjID], gData[idx][gORX], gData[idx][gORY], gData[idx][gORZ]);
		        }
		        else
		        {
		            gData[idx][gStatus] = 0;
		            MoveDynamicObject(gData[idx][gObjID], gData[idx][gCX], gData[idx][gCY], gData[idx][gCZ], gData[idx][gSpeed]);
		            SetDynamicObjectRot(gData[idx][gObjID], gData[idx][gCRX], gData[idx][gCRY], gData[idx][gCRZ]);
		        }
	        }
	        return 1;
	    }
	}
	return 1;
}
CMD:togaveh(playerid) {
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if (IsWatchVehLog[playerid]) {
		IsWatchVehLog[playerid] = 0;
		SCM(playerid, -1, "Kamu telah mematikan veh destroy log!");
	}
	else {
		IsWatchVehLog[playerid] = 1;
		SCM(playerid, -1, "Kamu telah menyalakan veh destroy log!");
	}
	return 1;
}

CMD:dweb(playerid, params[])
{
	new fmt_msg[170 + 1];
    new ttext[30];
    if(PlayerInfo[playerid][pPrison] != 0) return Send(playerid, COLOR_GREY, "Tidak Bisa Digunakaan Saat Dipenjara");
	if(GetPVarInt(playerid,"pTimeDweb") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 5 Menit");
    PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
    SetPlayerChatBubble(playerid, "DARKWEB >>" ,COLOR_GREY,10.0,5000);
    ttext = "[DARKWEB]";
	format(fmt_msg, sizeof fmt_msg, "%s @%s: %s",ttext, ReturnName(playerid), params);
	SendClientMessageToAll(COLOR_GREY,  fmt_msg);
	SetPVarInt(playerid, "pTimeDweb", gettime() + 300);
	return 1;
}

CMD:mulainambang(playerid, params[])
{
