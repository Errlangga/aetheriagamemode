stock GetPlayerSqlIDByName(name[])
{
	new sql_id = INVALID_SQL_ID,
		query[80],
		Cache: result;

	mysql_format(mMysql, query, sizeof query, "SELECT pID FROM accounts WHERE pName = '%e' LIMIT 1", name);
	result = mysql_query(mMysql, query, true);

	if(cache_num_rows())
		cache_get_value_name_int(0, "pID", sql_id);

	cache_delete(result);

	return sql_id;
}

stock GetPlayerAdminBySql(name[])
{
	new level,
		query[128],
		Cache: result;

	mysql_format(mMysql, query, sizeof query, "SELECT pAdmin FROM admin WHERE `Name` = '%e' LIMIT 1", name);
	result = mysql_query(mMysql, query, true);

	if(cache_num_rows())
		cache_get_value_name_int(0, "pAdmin", level);

	cache_delete(result);

	return level;
}

