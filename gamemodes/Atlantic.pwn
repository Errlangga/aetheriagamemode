{
	format(format_string, 188, "UPDATE `house` SET `hLodgers` = '%s,%s,%s' WHERE `hID` = %i",
	    house_lodgers[h_id][0], house_lodgers[h_id][1], house_lodgers[h_id][2], h_id);

	return mysql_tquery(mMysql, format_string);
}

stock ConvertMillageNumber(Float: millage, copy_str[], size = sizeof(copy_str))
{
 	format(copy_str, size, "%.0f", millage);
	for(new i = strlen(copy_str) - 3; i > 0; i -= 3)
	strins(copy_str, "~n~", i, size);
}

stock SendPlayerOffer(playerid, to_player, type, value_1 = 0, value_2 = 0, value_3 = 0, value_4 = 0)
{
	if(GetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER) == INVALID_PLAYER_ID)
	{
	    //if(cant_make_offer[playerid] != 0) return SCMF(playerid, COLOR_GREY, "Anda tidak dapat mengirim permintaan untuk %i detik lagi.", cant_make_offer[playerid]);

		SetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER, to_player);

		//cant_make_offer[playerid] = 60;

		SetPlayerOfferInfo(to_player, O_INCOMING_PLAYER, playerid);
		SetPlayerOfferInfo(to_player, O_INCOMING_TYPE, type);

		SetPlayerOfferValue(to_player, 0, value_1);
		SetPlayerOfferValue(to_player, 1, value_2);
		SetPlayerOfferValue(to_player, 2, value_3);
		SetPlayerOfferValue(to_player, 3, value_4);
	}
	else SendClientMessage(playerid, 0xFFFFFFFF, "Gunakan {FF9900}/cancel {FFFFFF}untuk membatalkan penawaran sebelumnya");

	return 1;
}

stock CreateHouseStore(h_id, Float: x, Float: y, Float: z)
{
    DestroyHouseStore(h_id);

	HouseInfo[h_id][hStoreArea] = CreateDynamicSphere(x, y, z, 1.0, h_id, HouseInfo[h_id][hInt]);
	HouseInfo[h_id][hStore3D] = CreateDynamic3DTextLabel("Wardrobe", -1, x, y, z, 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, h_id, HouseInfo[h_id][hInt]);
}

stock DestroyHouseStore(h_id)
{
    if(HouseInfo[h_id][hStoreArea] != 0)
	{
		DestroyDynamicArea(HouseInfo[h_id][hStoreArea]);
		HouseInfo[h_id][hStoreArea] = 0;
	}

	if(HouseInfo[h_id][hStore3D] != Text3D:0)
	{
		DestroyDynamic3DTextLabel(HouseInfo[h_id][hStore3D]);
		HouseInfo[h_id][hStore3D] = Text3D: 0;
	}
}
stock ShowPlayerHouseStore(playerid)
{
    if(PlayerInfo[playerid][pLevel] < 4) return Error(playerid, "Anda harus level 4 untuk akses lemari ini.");
	new h_id = player_enter_home[playerid];
	if(h_id != GetPlayerHouse(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak di rumah Anda.");
	
	format(format_string, 144, "- Senjata\n- Obat [%i gr]", HouseInfo[h_id][hDrugs]);
	return SPD(playerid, 7184, DIALOG_STYLE_LIST, "Wardrobe", format_string, "Select", "Close");
}
stock ShowPlayerStoreWeapons(playerid)
{
    new h_id = player_enter_home[playerid];

	String = "";

	new str[64];

	new weapon_id, ammo;

	for(new i; i < 3; i++)
	{
	    weapon_id = HouseInfo[h_id][hWeaponID][i];
	    ammo = HouseInfo[h_id][hAmmo][i];
	    
	    format(str, 64, "%i. %s\t%i\n", i, GetWeaponNames(weapon_id), ammo);
	    strcat(String, str);
	}
	return SPD(playerid, 7295, DIALOG_STYLE_TABLIST, "Weapon", String, "Select", "Back");
}
stock SaveHouseStore(h_id)
{
	format(format_string, 244, "UPDATE `house` SET `hWeaponID` = '%i,%i,%i', `hAmmo` = '%i,%i,%i', `hDrugs` = %i WHERE `hID` = %i",
	    HouseInfo[h_id][hWeaponID][0], HouseInfo[h_id][hWeaponID][1], HouseInfo[h_id][hWeaponID][2],
	    HouseInfo[h_id][hAmmo][0], HouseInfo[h_id][hAmmo][1], HouseInfo[h_id][hAmmo][2],
		HouseInfo[h_id][hDrugs], h_id);

	mysql_tquery(mMysql, format_string);
}


stock ShowPlayerOfflineMembers(playerid)
{
	new page = player_mysql_page[playerid];

    format(format_string, 188, "SELECT `pID`,`pRank`,`pName`,`pfWarn` FROM `accounts` WHERE `pMember`= %d AND `pLogin`= 0 ORDER BY `pRank` ASC LIMIT %d, 20", PlayerInfo[playerid][pMember], page*20);
    new Cache: result = mysql_query(mMysql, format_string);

	new rows = cache_num_rows();

    if(!rows) return Send(playerid,COLOR_GREY, "Tidak ada staf offline."), pc_cmd_lpanel(playerid);

	new str[96], count = 0;

	String = "";

    new namepl[MAX_PLAYER_NAME], rank, fwarn, sql_id;

	for(new i; i < rows; ++i)
	{
        cache_get_value_name_int(i, "pID", sql_id);
		cache_get_value_name(i, "pName", namepl, MAX_PLAYER_NAME);
		cache_get_value_name_int(i, "pRank", rank);
		cache_get_value_name_int(i, "pfWarn", fwarn);

		format(str, 96,"%s\t%d/%d\t%d/3\n", namepl, rank, FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1, fwarn);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, sql_id);
	}

	cache_delete(result);

	if(rows == 20) strcat(String, "Lainnya\n");
	if(page > 0) strcat(String, "Kembali\n");

	return SPD(playerid,166,DIALOG_STYLE_TABLIST,"{FF9900}Anggota Organisasi Offline",String,"View","Exit");
}

stock SendPlayerMailCode(playerid, mail[], code)
{
    format(format_string, 188, "Starsrpmemangbeda.com/mailer/index.php?mail=%s&user=%s&code=%i", mail, GetPlayerNameEx(playerid), code);
    return HTTP(playerid, HTTP_GET, format_string, "", "CheckSendPlayerCode");
}

publics: CheckSendPlayerCode(playerid, response_code, data[])
{
    if(response_code != 200) return SCM(playerid, COLOR_GREY, "Error, tidak ada kode yang dikirim.");

	return SCM(playerid, COLOR_GREEN, "Kode konfirmasi telah dikirim ke surat.");
}

stock GetPlayerBackpackLimit(playerid)
{
	new limit = 500;

	if(IsPlayerHaveBackpack(playerid)) limit *= 2;

	return limit;
}

stock UpdateHotel3DTextLabel(h_id)
{
    new n_id = hotel_info[h_id][hNumber];

	new owner_name[MAX_PLAYER_NAME] = "Tidak";

	if(hotel_info[h_id][hOwned]) format(owner_name, MAX_PLAYER_NAME, hotel_info[h_id][hOwner]);

	format(format_string, 64, "Hotel #%i\nPemilik: %s", n_id + 1, owner_name);
	UpdateDynamic3DTextLabelText(hotel_info[h_id][h3D], -1, format_string);
}

