	{
 		format(String, sizeof(String), "Mask_%d Take Weapon and Ready to Shoot Anytime", maskid[playerid], params[0]);
		ProxDetector(25.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
		return 1;
	}
	format(String, 188, "%s Take Weapon and Ready to Shoot Anytime",Name(playerid), params[0]);
	ProxDetector(25.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPlayerChatBubble(playerid,params[0],0xDD90FFFF,20.0,10000);
	
 	return 1;
}

