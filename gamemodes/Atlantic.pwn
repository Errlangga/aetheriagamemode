                ShowPlayerDialog(playerid,1073,DIALOG_STYLE_INPUT,"{00FFFF}Whitelist",string,"Oke","Kembali");
            }
            else
            {
                format(string,sizeof(string),"{00FFFF}%s{FFFFFF} sudah terdaftar di whitelist!", inputtext);
                SendClientMessage(playerid,COLOR_WHITE,string);
                ShowPlayerDialog(playerid,1073,DIALOG_STYLE_INPUT,"{00FFFF}Whitelist","{FF0000}Masukan nama player\nKetik dibawah sini!","Oke","Kembali");
            }
    	}
    }
    if(dialogid == 1074)
    {
        new player[200], string[128];
        format(player,sizeof(player),"/whitelist/%s.txt",inputtext);
        if(response == 1)
        {
            if(dini_Exists(player))
            {
            dini_Remove(player);
            format(string,sizeof(string),"{00FFFF}%s{FFFFFF} berhasil dihapus dari whitelist", inputtext);
            SendClientMessage(playerid,COLOR_WHITE,"Berhasil Menghapus Whitelist");
            ShowPlayerDialog(playerid,1074,DIALOG_STYLE_MSGBOX,"{00FFFF}Whitelist",string,"Oke","Kembali");
            }
            else
            {
            format(string,sizeof(string),"{00FFFF}%s{FFFFFF} nama ini belum terdaftar!", inputtext);
            SendClientMessage(playerid,COLOR_WHITE,string);
