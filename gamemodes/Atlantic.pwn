	    OnPlayerUpdateAccountsPer(playerid, "pRouble", PlayerInfo[playerid][pRouble]);
	    SetPlayerChatBubble(playerid, "Mendapat Hadiah Rubel", 0xBFF600FF, 20.0, 7000);
	    GameTextForPlayer(playerid, "~b~Mendapat Rubel +50", 5000, 1);
	    format(YogString1, sizeof(YogString1), "%s[%d] {FFFF00}Telah Membuka Kado Dari Dewa", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_BLUE, YogString1);
	    SendClientMessage(playerid, COLOR_YELLOW, "Anda Membuka Kado Dari Dewa");
	}
    }
    else if(IsiKado == 3)
    {
    new f = MAX_KADO+1;
	for(new a = 0; a < sizeof(PosKado); a++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, PosKado[a][0], PosKado[a][1], PosKado[a][2]))
