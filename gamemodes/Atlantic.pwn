	    Update3DTextLabelText(StatusMiner[4], COLOR_BLUE, "{FFFFFF}Status: {FF0000}Waiting\n{FFFFFF}TEKAN Y");
	    SetTimerEx("WaktuMiner", 7000, false, "d", playerid);
		SetTimer("TimeMiner5", 30000, false);
		ShowProgressbar(playerid, "Mining", 7);
		GetPlayerName(playerid, playername, sizeof(playername));
	    format(merp, sizeof(merp), "* %s mulai mining dengan bantuan kedua tangan", playername);
	   	ProxDetectorx(30.0, playerid, merp, COLOR_PURPLE);
	}
	return 1;
}
CMD:mulaiminer(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid, 10, -565.9516,-1607.0324,-42.7078))
	{
		if(GetPVarInt(playerid,"pTimeMiner") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down Job 30 Menit");
	    JobMiner[playerid] = 1;
	    if(PlayerInfo[playerid][pSex] == 1) SetPlayerSkinEx(playerid, 27);
		else SetPlayerSkinEx(playerid, 131);
	    SetPlayerAttachedObject(playerid, 3, 18634, 6, 0.078999, 0.039999, 0.099999, -75.200355, -88.500114, -163.899993, 1.000000, 1.000000, 1.000000);
	    SetPlayerCheckpoint(playerid, -574.4236,-1529.3566,-33.7353, 5.0);
	    SendClientMessage(playerid, COLOR_YELLOW, "Silahkan Ke Marker Untuk Memulai Pekerjaan");
	}
	return 1;
}
CMD:selesaiminer(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid, 10, -565.9516,-1607.0324,-42.7078))
    {
	   	SetPVarInt(playerid, "pTimeMiner", gettime() + 1800);
		JobMiner[playerid] = 0;
		RemovePlayerAttachedObject(playerid, 3);
		SetPlayerSkinEx(playerid,PlayerInfo[playerid][pSkin]);
		SendClientMessage(playerid, COLOR_YELLOW, "Anda Menyelesaikan Pekerjaan");
	}
    return 1;
}
CMD:ambillogam(playerid)
{
    if(JobMiner[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Tidak Pekerja Miner");
    if(AmbilBijih[playerid] == 100) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Tidak Bisa Membawa Lebih Dari 100");
    if(JumlahMiner < 100) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF} Minimal Ada 100 Logam");
    if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 455) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Gunakan Didalam Mobil Flatbed");
    if(IsPlayerInRangeOfPoint(playerid, 10, -1818.0123,-1616.6822,23.0156))
	{
	    SetPlayerCheckpoint(playerid, 854.6157,-604.3199,18.4219, 5.0);
		// new YogString[5000];
		JumlahMiner -= 100;
		AmbilBijih[playerid] = 100;
		format(YogString, sizeof(YogString), "[PELEBURAN BATU] TEKAN Y", JumlahMiner);
		Update3DTextLabelText(HasilMiner,  COLOR_YELLOW,  YogString);
		TogglePlayerControllableEx(playerid, 0);
        GameTextForPlayer(playerid, "~b~Mendapat logam", 10000, 5);
		SetTimerEx("ClearFreeze", 10000, false, "d", playerid);
		ShowProgressbar(playerid, "Sedang_Mengambil...", 10);
		SendClientMessage(playerid, COLOR_YELLOW, "Antarkan Hasil Pada Tanda Merah");
	}
    return 1;
}
CMD:cucilogam(playerid)
{
	if(pData[playerid][pStress] > 100) return Error(playerid, "Anda Sedang Stress!");
   	if(pData[playerid][pBatuk] < 10) return Error(playerid, "Batu Kotor Tidak Cukup!(Butuh: 10).");
	if(pData[playerid][pBatu] > 100) return Error(playerid, "Batu Bersih Sudah melewati Batas!(Max: 100).");
	if(GetPVarInt(playerid,"pTimeCuci") > gettime()) return Send(playerid, COLOR_GREY, "JANGAN SPAM");
    if(IsPlayerInRangeOfPoint(playerid, 10, 2160.9284,-2245.5117,13.2896))
	{
		PlayerInfo[playerid][pBatuk] -=10;
		PlayerInfo[playerid][pBatu] +=10;
		UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+3);
		OnPlayerUpdateAccountsPer(playerid, "pBatuk", PlayerInfo[playerid][pBatu]);
		OnPlayerUpdateAccountsPer(playerid, "pBatu", PlayerInfo[playerid][pBatu]);
		RemovePlayerAttachedObject(playerid, 5);
		TogglePlayerControllable(playerid, 0);
    	ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0,1,0,0,0,0,1);
        SetTimerEx("WaktuMiner98", 10000, false, "d", playerid);
        ShowProgressbar(playerid, "Sedang_Mencuci..", 10);
    	SetPlayerChatBubble(playerid, "Sedang Mencuci Batu",COLOR_PURPLE,30.0,10000);
  	 	SetPVarInt(playerid, "pTimeCuci", gettime() + 11);
	}
    return 1;
}
