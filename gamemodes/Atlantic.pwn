stock SavePlayerToys(playerid)
{
    format(MySQLStr, 1200, "UPDATE `accounts` SET `toyModel` = '%d,%d,%d', ",
    ToyInfo[playerid][toyModel][0], ToyInfo[playerid][toyModel][1], ToyInfo[playerid][toyModel][2]);

    format(MySQLStr, 1200, "%s `toyPositionX` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyPositionX][0], ToyInfo[playerid][toyPositionX][1], ToyInfo[playerid][toyPositionX][2]);

    format(MySQLStr, 1200, "%s `toyPositionY` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyPositionY][0], ToyInfo[playerid][toyPositionY][1], ToyInfo[playerid][toyPositionY][2]);

    format(MySQLStr, 1200, "%s `toyPositionZ` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyPositionZ][0], ToyInfo[playerid][toyPositionZ][1], ToyInfo[playerid][toyPositionZ][2]);

    format(MySQLStr, 1200, "%s `toyRotationX` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyRotationX][0], ToyInfo[playerid][toyRotationX][1], ToyInfo[playerid][toyRotationX][2]);

    format(MySQLStr, 1200, "%s `toyRotationY` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyRotationY][0], ToyInfo[playerid][toyRotationY][1], ToyInfo[playerid][toyRotationY][2]);

    format(MySQLStr, 1200, "%s `toyRotationZ` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyRotationZ][0], ToyInfo[playerid][toyRotationZ][1], ToyInfo[playerid][toyRotationZ][2]);

    format(MySQLStr, 1200, "%s `toyScaleX` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyScaleX][0], ToyInfo[playerid][toyScaleX][1], ToyInfo[playerid][toyScaleX][2]);

    format(MySQLStr, 1200, "%s `toyScaleY` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyScaleY][0], ToyInfo[playerid][toyScaleY][1], ToyInfo[playerid][toyScaleY][2]);

    format(MySQLStr, 1200, "%s `toyScaleZ` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyScaleZ][0], ToyInfo[playerid][toyScaleZ][1], ToyInfo[playerid][toyScaleZ][2]);

    format(MySQLStr, 1200, "%s `toyBone` = '%d,%d,%d', ", MySQLStr,
    ToyInfo[playerid][toyBone][0], ToyInfo[playerid][toyBone][1], ToyInfo[playerid][toyBone][2]);

    format(MySQLStr, 1200, "%s `toyWear` = '%d,%d,%d' WHERE `pID` = %i", MySQLStr,
    ToyInfo[playerid][toyWear][0], ToyInfo[playerid][toyWear][1], ToyInfo[playerid][toyWear][2], PlayerInfo[playerid][pID]);

    mysql_tquery(mMysql, MySQLStr);

    return 1;
}
//END

CMD:hauling(playerid,params[])
{
		if(PlayerInfo[playerid][pLevel] < 5) return ShowWarning(playerid, "fitur ini tersedia dari level 5");
        new dedyvariabel[10000];
       	if(GetPVarInt(playerid,"pTimeHauling") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down Job 30 menit");
        //if(PlayerInfo[playerid][pJob] == 20 || PlayerInfo[playerid][pJob2] == 20) //ini variabel jobsnya jika mau di masukan ke gm ubah yang ini
	    {
		if(SedangHauling[playerid] >= 1) { SendClientMessage(playerid,COLOR_WHITE,"You Are On Delivery.."); return 1; }
		//if(PlayerInfo[playerid][pTruckingSkill] < 32) { SendClientMessage(playerid,COLOR_WHITE,"Skills anda kurang untuk melakukan Hauling Missions."); return 1; } //hanya skills level tertentu yang bisa
  		if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 403 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 514 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 515) SCM(playerid, -1, "Untuk Melakukan Pekerjaan Hauling gunakan /hauling");
	    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 403 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 514 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 515)
		{
			strcat(dedyvariabel, "Order\tPrice\n");
			format(String, sizeof(String), "Ocean Dock Imports\t%s\n", (DialogHauling[0] == true) ? ("{FF0000}Taken") : ("{33AA33}$50.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Ocean Dock Imports\t%s\n", (DialogHauling[1] == true) ? ("{FF0000}Taken") : ("{33AA33}$300.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Angel Pine Exports\t%s\n", (DialogHauling[2] == true) ? ("{FF0000}Taken") : ("{33AA33}$250.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Angel Pine Exports\t%s\n", (DialogHauling[3] == true) ? ("{FF0000}Taken") : ("{33AA33}$270.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Chilliad Deport\t%s\n", (DialogHauling[4] == true) ? ("{FF0000}Taken") : ("{33AA33}$399.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Chilliad Deport\t%s\n", (DialogHauling[5] == true) ? ("{FF0000}Taken") : ("{33AA33}$200.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Easter Import\t%s\n", (DialogHauling[6] == true) ? ("{FF0000}Taken") : ("{33AA33}$310.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Blueberry Export\t%s\n", (DialogHauling[7] == true) ? ("{FF0000}Taken") : ("{33AA33}$333.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Las Venturas Deport\t%s\n", (DialogHauling[8] == true) ? ("{FF0000}Taken") : ("{33AA33}$2.900.000"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Las Venturas Fuel & Gas\t%s", (DialogHauling[9] == true) ? ("{FF0000}Taken") : ("{33AA33}$2.555.000"));
			strcat(dedyvariabel, String);
			ShowPlayerDialog(playerid, HAULING, DIALOG_STYLE_TABLIST_HEADERS, "Hauling Missions", dedyvariabel, "Select", "Cancel");
			return 1;
		}
		SendClientMessage(playerid, COLOR_WHITE,"You`re Not In The Truck.");
		return 1;
	}
}
CMD:cancelhauling(playerid, params[])
{
	if(SedangHauling[playerid] == 0)
		return SendClientMessage(playerid, COLOR_GREY, "ERROR: You`re Not Hauling mission");
	SedangHauling[playerid] =0;
	DisablePlayerRaceCheckpoint(playerid);
	/*DialogHauling[0] = false;
 	DialogSaya[playerid][0] = false;
  	DestroyVehicle(GetVehicleTrailer(GetPlayerVehicleID(playerid)));*/
  	for(new i; i <= 9; i++) // 9 = Total Dialog , Jadi kita mau tau kalau Player Ini Apakah Ambil Dialog dari 3 tersebut apa ga !
	{
	    DialogSaya[playerid][i] = false; // Ubah Jadi Dia ga punya dialog lagi Kalau Udah Disconnect (Bukan dia lagi pemilik)
	    DialogHauling[i] = false; // Jadi ga ada yang punya nih dialog
	    DestroyVehicle(TrailerHauling[playerid]);
	}
	return 1;
}
CMD:wedding(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	new nama, nama1;
	new cowo[MAX_PLAYER_NAME], cewe[MAX_PLAYER_NAME];
	if(sscanf(params, "uu", nama, nama1)) return SendClientMessage(playerid, COLOR_WHITE, "USAGE: /wedding [cowok] [cewek]");
	if(!ProxDetectorS(5, playerid, nama)) return SCM(playerid, COLOR_GREY, "Pengantin Pria Terlalu Jauh");
	if(!ProxDetectorS(5, playerid, nama1)) return SCM(playerid, COLOR_GREY, "Pengantin Wanita Terlalu Jauh");
	GetPlayerName(nama1, cowo, sizeof(cowo));
    GetPlayerName(nama, cewe, sizeof(cewe));
	PlayerInfo[nama][pMenikah] = cewe;
	PlayerInfo[nama1][pMenikah] = cowo;
    OnPlayerUpdateAccountsPer(nama, "pMenikah", PlayerInfo[nama][pMenikah]);
    OnPlayerUpdateAccountsPer(nama1, "pMenikah", PlayerInfo[nama1][pMenikah]);
	format(format_string, sizeof(format_string), "{FFFF00}[INFO] {ffffff}Penghulu %s Telah Menikahkan %s Dengan %s", PlayerInfo[playerid][pName], PlayerInfo[nama][pName], PlayerInfo[nama1][pName]);
    SendClientMessageToAll(COLOR_BLUE, format_string);
    SCM(playerid, COLOR_YELLOW,  "[WEDDING] : {FFFFFF}Anda Sudah Tidak Menjadi Penghulu");
	return 1;
}
CMD:bukunikah(playerid, params[])
{
    extract params -> new to_player; else return SendClientMessage(playerid, -1, "/bukunikah [id pemain]");
    new nama, nama1;
   	new cowo[MAX_PLAYER_NAME], cewe[MAX_PLAYER_NAME];
	new str[116];

	String = "";
	PlayerInfo[nama][pMenikah] = cewe;
	PlayerInfo[nama1][pMenikah] = cowo;

	format(str, 116, "{ffffff}Name: {FFFF00}%s\n", PlayerInfo[nama1][pMenikah]);
	strcat(String, str);

	format(str, 116, "{ffffff}Menikah Dengan: {FFFF00}%s\n", PlayerInfo[nama][pMenikah]);
    strcat(String, str);

	format(format_string, 40, "Buku Nikah %s", Name(playerid));
	SPD(to_player, 0000, 0, format_string, String, "Ok", "");
	MeAction(playerid, "Membuka Dompet Dan Menunjukan Buku Nikah Nya");
	return 1;
}
CMD:makegun(playerid)
{
	if(!IsAArmy(playerid))
	    return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk tentara");

	if(PlayerInfo[playerid][pPrison]) return SCM(playerid, COLOR_GREY, "Tidak tersedia saat ini.");

	SPD(playerid, 4558, DIALOG_STYLE_TABLIST, "Penciptaan senjata",
		"Colt 45\t30 Ammo\t100 Logam\t70 Kartid\n\
		Desert Eagle\t14 Ammo\t100 Logam\t150 Kartid\n\
        MP5\t60 Ammo\t250 Logam\t300 Kartid\n\
        Shotgun\t10 Ammo\t200 Logam\t200 Kartid\n\
        AK-47\t60 Ammo\t350 Logam\t300 Kartid", "Buat", "Close");

	return 1;
}
CMD:makequiz(playerid, params[])
{
	if(admin_level[playerid] < 11) return Error(playerid, "You're not have permissions to accses command");
	{
		new tmp[128], string[256], str[256], pr;
		if(sscanf(params, "s", tmp)) {
		    Usage(playerid, "/makequiz [option]");
			Usage(playerid, "question, answer, price, end");
			Info(playerid, "Tolong buat jawabannya dulu.");
			return 1;
		}
		if(!strcmp(tmp, "question", true, 8))
		{
			if(sscanf(params, "s[128]s[256]", tmp, str)) return Usage(playerid, "/makequiz question [question]");
			if (quiz == 1) return Error(playerid, "Kuis sudah dimulai kamu bisa mengakhirinya dengan /makequiz end.");
			if (answermade == 0) return Error(playerid, "tolong buat jawaban dulu...");
			if (qprs == 0) return Error(playerid, "Tolong tambahkan hadiah terlebih dahulu.");
			format(string, sizeof(string), "{7fffd4}[QUIZ]: {ffff00}%s?, Hadiah {00FF00}$%d.", str, qprs);
			SendClientMessageToAll(0xFFFF00FF, string);
			SendClientMessageToAll(-1,"{ffff00}Anda bisa memberi jawaban dengan menggunakan /answer.");
			quiz = 1;
		}
		else if(!strcmp(tmp, "answer", true, 6))
		{
			if(sscanf(params, "s[128]s[256]", tmp, str)) return Usage(playerid, "/makequiz answer [answer]");
			if (quiz == 1) return Info(playerid, "Kuis sudah dimulai kamu bisa mengakhirinya dengan /makequiz end.");
			answers = str;
			answermade = 1;
			format(string, sizeof(string), "Anda telah membuat jawaban, {00FF00}%s.", str);
			SendClientMessage(playerid, 0xFFFFFFFF, string);
		}
		else if(!strcmp(tmp, "price", true, 5))
		{
			if(sscanf(params, "s[128]d", tmp, pr)) return Usage(playerid, "/makequiz price [amount]");
			if (quiz == 1) return Error(playerid, "Kuis sudah dimulai kamu bisa mengakhirinya dengan / makequiz end.");
			if (answermade == 0) return Error(playerid, " Membuat jawabannya lebih dulu...");
			if (pr <= 0) return Error(playerid, "buat harga lebih besar dari 0!");
			qprs = pr;
			format(string, sizeof(string), "Anda telah menempatkan {00FF00}%d sebagai jumlah hadiah untuk kuis.", pr);
			SendClientMessage(playerid, 0xFFFFFFFF, string);
		}
		else if(!strcmp(tmp, "end", true, 3))
		{
			if (quiz == 0) return Error(playerid, "Sayangnya tidak ada kuis dari admin server.");
			SendClientMessageToAll(0xFF0000FF, "Sayangnya Admin server telah mengakhiri kuis tersebut.");
			answermade = 0;
			quiz = 0;
			qprs = 0;
			answers = "";
		}
	}
	return 1;
}

CMD:answer(playerid, params[])
{
	new tmp[256], string[256];
	if (quiz == 0) return Error(playerid, "Sayangnya tidak ada kuis dari admin server.");
	if (sscanf(params, "s[256]", tmp)) return Usage(playerid, "/answer [jawaban]");
	if(strcmp(tmp, answers, true)==0)
	{
		GivePlayerMoneyEx(playerid, qprs, "Mantap Cuy");
  		OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
		format(string, sizeof(string), "[QUIZ]: %s telah memberikan jawaban yang benar '%s' dari kuis dan mendapatkan hadiah {00FF00}%d.", Name(playerid), answers, qprs);
		SendClientMessageToAll(0xFFFF00FF, string);
		answermade = 0;
		quiz = 0;
		qprs = 0;
		answers = "";
	}
	else
	{
		Error(playerid,"Jawaban yang salah coba keberuntungan Anda lain kali.");
	}
	return 1;
}
CMD:paytoll(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, 72.1348,-1527.5522,4.6756))
		{
		    if(tollstatus == 1) return SCM(playerid, COLOR_GREY, "Toll ditutup");
			MoveDynamicObject(Toll1, 68.0623, -1530.5416, 4.5654, 1.0, 0.0000, 0.0000, 88.0000);
   			GivePlayerMoneyEx(playerid, -3000, "Anda telah membayar tol sebesar 3000");
			SCM(playerid, -1, "TOLL: {FFFFFF}Anda telah membayar tol sebesar 3000.");
			SetTimer("TutupGate1", 3000, 0);
		}
		else if(IsPlayerInRangeOfPoint(playerid, 5.0, 32.3296,-1534.5856,4.8408))
		{
		    if(tollstatus == 1) return SCM(playerid, COLOR_GREY, "Toll ditutup");
			MoveDynamicObject(Toll2, 35.1532, -1532.6484, 4.9854, 1.0, 0.0000, 0.0000, -92.0000);
   			GivePlayerMoneyEx(playerid, -3000, "Anda telah membayar tol sebesar 3000");
			SCM(playerid, -1, "TOLL: {FFFFFF}Anda telah membayar tol sebesar 3000.");
			SetTimer("TutupGate2", 3000, 0);
		}
		//else SendClientMessage(playerid, -1, "Anda tidak berada didaerah toll.");
	}
	else SendClientMessage(playerid, -1, "Anda tidak berada didalam kendaraan.");
	return 1;
}
CMD:c(playerid,params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params,"s[144]",params[0])) return Send(playerid,-1,"Masuk: /c [pesan]");
	if(IsPlayerInAnyVehicle(playerid)) {
		new vehId;
		vehId = GetPlayerVehicleID(playerid);
		format(format_string, 188, "(IN-CAR) %s says: %s", Name(playerid), params[0]);
		SCM(playerid, COLOR_RAZGOVOR3, format_string);
		SetPlayerChatBubble(playerid, "* talking in car *", 0x6495EDFF, 5.0, 5000);
		foreach(new i : Player)
		{
			if(i == playerid) continue;
			if(!IsPlayerInAnyVehicle(i)) continue;
			if(vehId != GetPlayerVehicleID(i)) continue;
			SCM(i, COLOR_RAZGOVOR3, format_string);
		}
		return false;
	}
	return 1;
}
CMD:fixveh(playerid, params[])
{
	if(CarInfo[playerid][cHeal] > 1000.0) return Error(playerid, "Anda Tidak Bisa Menggunakan ini.");
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, "Kamu tidak berada di kursi pengemudi!");
	RepairVehicle(GetPlayerVehicleID(playerid));
	SendClientMessage(playerid, -1, "Kendaraan berhasil di perbaiki.");
	PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
	return 1;
}
CMD:fixcar(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, "Kamu tidak berada di kursi pengemudi!");
	RepairVehicle(GetPlayerVehicleID(playerid));
	SendClientMessage(playerid, -1, "Kendaraan berhasil di perbaiki.");
	PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
	return 1;
}
CMD:kasiobat(playerid, params[])
{
	if(!IsAMedic(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
    if(sscanf(params, "ud", params[0], params[1])) return Send(playerid, -1, "Masuk: /kasiobat [playerid] [jumlah]");
   	if(PlayerInfo[playerid][pHeals] < params[1]) return SCM(playerid, COLOR_GREY, "Anda Tidak Memiliki Jumlah Obat Yang Ditentukan");
    {
  	PlayerInfo[playerid][pHeals] -= params[1];
    PlayerInfo[params[0]][pHeals] += params[1];
	OnPlayerUpdateAccountsPer(playerid, "pHeals", PlayerInfo[playerid][pHeals]);
	OnPlayerUpdateAccountsPer(params[0], "pHeals", PlayerInfo[params[0]][pHeals]);
	SetPlayerChatBubble(params[0], "Berhasil Menerima Obat Dari Ems", 0xBFF600FF, 20.0, 7000);
	format(String, 188, "%s Mengasih Obat Kepada Orang Didepan",Name(playerid));
 	ProxDetector(10.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	return 1;
}
CMD:ambilobat(playerid)
{
   if(!IsAMedic(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
   if(!IsPlayerInRangeOfPoint(playerid, 5, 604.0646,-2093.4761,995.6328)) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Di Tempat Pembelian");
   if(IsPlayerInRangeOfPoint(playerid, 5, 604.0646,-2093.4761,995.6328))
   {
   SPD(playerid, 9497, DIALOG_STYLE_TABLIST, "OBAT",
   "{ffff00}10 Obat"
   ,"Ambil","Keluar");
   }
   return 1;
}
CMD:pakaimarijuana(playerid, params[])
{
    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
 	if(sscanf(params, "i", params[0])) return SCM(playerid,0x00D900AA, "[Petunjuk]: {FFFFFF}/pakaimarijuana [marijuana(1-6)]");
	if(params[0] < 1 || params[0] > 6) return SCM(playerid,0x00D900AA, "Dimungkinkan untuk menggunakan 1 - 6 gram");
	if(PlayerInfo[playerid][pMicin] < params[0]) return SCM(playerid,COLOR_GREY,"Kamu tidak punya banyak Marijuana!");

	if(GetPVarInt(playerid,"pTimeMicin") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 2 Menit");

	new Float: armour;

	GetPlayerArmour(playerid, armour);

	armour += params[0] * 2.0;

	if(armour > 50.0) armour = 50.0;
	SetPlayerArmourEx(playerid, armour);
   	UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]-30);
	PlayerInfo[playerid][pMicin] -= params[0];
    OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
    SetPlayerChatBubble(playerid,"menggunakan Marijuana",COLOR_PURPLE,30.0,10000);
	SetPVarInt(playerid, "pTimeMicin", gettime() + 120);
    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
    return SCM(playerid,0x0099FFAA,"Kamu Sedang Ngefly");
}
CMD:mulaimarijuana(playerid, params[])
{
	if(!IsPlayerInRangeOfPoint(playerid, 2, 2350.3049, -647.7251, 128.0547)) return SendClientMessage(playerid, COLOR_RED, "ANDA HARUS DI TEMPAT MARIJUANA!");
    if(IsPlayerInRangeOfPoint(playerid, 2, 2350.3049 ,-647.7251, 128.0547))
	if(GetFractionMemberAmount(FRACTION_LSPD) < 3) return Send(playerid, COLOR_GREY, "Polisi kurang dari 3 orang.");
	{
	    if(GetPVarInt(playerid, "pMicin") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down Job 5 Menit");
	    SetPVarInt(playerid, "GPS", 1);
		DutyMicin[playerid] = 1;
		CPMicin[playerid] = 1;
        new rand = random(5);
        SetPlayerCheckpoint(playerid, RandMicin[rand][0], RandMicin[rand][1], RandMicin[rand][2], 5);
        SetPlayerAttachedObject(playerid, 5, 11745, 2, -0.499000, -0.208000, 0.046999, 114.800003, 80.700042, -43.300064, 0.666000, 0.957000, 0.828999);
		SendClientMessage(playerid, COLOR_YELLOW, "Cepat Kumpulkan Marijuana Keburu Aparat Datang");
	}
    return 1;
}
CMD:selesaimarijuana(playerid, params[])
{
	if(!IsPlayerInRangeOfPoint(playerid, 2, 2350.3049, -647.7251, 128.0547)) return SendClientMessage(playerid, COLOR_RED, "ANDA HARUS DI TEMPAT MARIJUANA!");
    if(IsPlayerInRangeOfPoint(playerid, 2, 2350.3049, -647.7251, 128.0547))
	{
		if(DutyMicin[playerid] != 1) return SCM(playerid, COLOR_GREY, "Anda Tidak Bekerja Petani Ganja");
	    SetPVarInt(playerid, "GPS", 0);
		SetPVarInt(playerid, "pMicin", gettime() + 300);
		DisablePlayerCheckpoint(playerid);
	    DutyMicin[playerid] = 0;
	    CPMicin[playerid] = 0;
	    SendClientMessage(playerid, COLOR_BLUE, "Selesai Mengumpulkan Marijuana");
	}
	return 1;
}
CMD:ondutyfraksi(playerid, params[])
{
    if(!PlayerInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Anda Bukan sebuah Fraksi");
    if(form_fraction[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "Anda sudah Onduty");
    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pFrSkin]);
    form_fraction[playerid] = PlayerInfo[playerid][pMember];
    SetPlayerToTeamColor(playerid);
    SendClientMessage(playerid, 0x20A9FFFF, "Anda memulai hari kerja");
    return 1;
}
CMD:offdutyfraksi(playerid, params[])
{
    if(!PlayerInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Anda Bukan sebuah Fraksi");
    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);
    form_fraction[playerid] = 0;
    SetPlayerColor(playerid, 0xFFFFFFFF);
    SendClientMessage(playerid, 0x20A9FFFF, "Anda menyelesaikan hari kerja");
    return 1;
}
