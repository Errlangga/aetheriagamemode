stock GivePlayerMoneyEx(playerid, amount, reason[])
{
	PlayerInfo[playerid][pCash] += amount;
	OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);

    if(PlayerInfo[playerid][pCash] >= 1000000) SetPlayerMoneyCase(playerid);
	else RemovePlayerMoneyCase(playerid);

	if(amount <= -1000 || amount >= 1000)
	{
		format(format_string, 244, "INSERT INTO `money_log` (`user_id`,`amount`,`reason`,`type`) VALUES (%i,%i,'%s ($%i)',0)", GetPlayerAccountID(playerid), amount, reason, PlayerInfo[playerid][pCash]);
		mysql_tquery(mMysql, format_string);
	}

	return 1;
}

stock GivePlayerBankEx(playerid, amount, reason[])
{
	PlayerInfo[playerid][pBank] += amount;
	OnPlayerUpdateAccountsPer(playerid, "pBank", PlayerInfo[playerid][pBank]);

    if(amount <= -1000 || amount >= 1000)
	{
		format(format_string, 244, "INSERT INTO `money_log` (`user_id`,`amount`,`reason`,`type`) VALUES (%i,%i,'%s ($%i)',1)", GetPlayerAccountID(playerid), amount, reason, PlayerInfo[playerid][pBank]);
		mysql_tquery(mMysql, format_string);
	}

	return 1;
}
