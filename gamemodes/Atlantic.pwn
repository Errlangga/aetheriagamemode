stock ProductsMenu(playerid)
{
	if(player_use_bizbar[playerid] == 0) return 1;
	new i = player_use_bizbar[playerid];

	if(BizzInfo[i][bType] == 7) // toko furnitur
	{
	    if(GetPlayerHouse(playerid) == -1) return Send(playerid, COLOR_GREY, "Anda harus memiliki rumah untuk membeli furnitur.");
    	return SPD(playerid,17,DIALOG_STYLE_INPUT,"Toko furnitur",""W"1. Perabot Rumah\n2. Pintu\n3. Lukisan\n4. Bunga rumah\n5. Peralatan rumah tangga\n6. Semuanya untuk kamar mandi","Pilih","Keluarlah");
    }

    format(String, 480,
		""W"1. Ponsel\t{43CD80}%d$\n\
		"W"2. Ubah nomor\t{43CD80}%d$\n\
		"W"3. Buku telepon\t{43CD80}%d$\n\
		"W"5. Masker (1 pc)\t{43CD80}%d$\n\
		"W"7. Repair Kit (mechanic only)(1 unit)\t{43CD80}%d$\n\
		"W"8. Kaleng semprot (1000 ml)\t{43CD80}%d$\n\
		"W"9. Jam tangan\t{43CD80}%d$",
		BizzInfo[i][bPrice]*10,
		BizzInfo[i][bPrice]*2,
		BizzInfo[i][bPrice]*6,
		BizzInfo[i][bPrice]*3,
		BizzInfo[i][bPrice]*10,
		BizzInfo[i][bPrice]*3,
		BizzInfo[i][bPrice]*5,
		BizzInfo[i][bPrice]*2,
		BizzInfo[i][bPrice]*8);


	return SPD(playerid, 61, DIALOG_STYLE_TABLIST, "Shop", String, "Buy", "Cancel");
}
stock isNum(const text[])
{
	new kolvo;
	for(new i, z = strlen(text); i < z; i++)
	{
	    if('0' <= text[i] <= '9')
	    {
	        kolvo++;
			if(kolvo == strlen(text)) return false;
	    }
	}
	return true;
}
stock Convert(number)
{
	new sting[100];
	new hours = 0, mins = 0, secs = 0;
	hours = floatround(number / 3600);
	mins = floatround((number / 60) - (hours * 60));
	secs = floatround(number - ((hours * 3600) + (mins * 60)));
	if(hours > 0) format(sting, 100, "%d:%02dm", hours, mins);
	else format(sting, 100, "%d:%02d", mins, secs);
	return sting;
}

stock ConvertSeconds(time)
{
	new string[20];
	format(string, 20, "%i:%02i:%02i", floatround(time/3600), floatround(time%3600/60), time%3600%60);
	return string;
}

stock SetPlayerToTeamColor(playerid)
{
	switch(PlayerInfo[playerid][pMember])
	{
		case FRACTION_LSPD, FRACTION_SFPD, FRACTION_LVPD: SetPlayerColor(playerid, 0x110CE7FF);
		case FRACTION_FBI: SetPlayerColor(playerid, COLOR_GREY);
		case FRACTION_ARMY_LS,FRACTION_ARMY_SF,FRACTION_ARMY_LV: SetPlayerColor(playerid, COLOR_GREEN);
		case FRACTION_MAYOR: SetPlayerColor(playerid, 0xFFFF00ff);
		case FRACTION_LSMEDICS, FRACTION_SFMEDICS, FRACTION_LVMEDICS: SetPlayerColor(playerid, 0xFF6666ff);
		case FRACTION_NEWS: SetPlayerColor(playerid, 0xff4f00ff);
		case FRACTION_PEDAGANG: SetPlayerColor(playerid, COLOR_GREEN);
		case FRACTION_MECHANIK: SetPlayerColor(playerid, 0xBC8F8Fff);
		case FRACTION_BIKER: SetPlayerColor(playerid, 0x2F4F4Fff);

		case FRACTION_BALLAS: SetPlayerColor(playerid, 0x882288BB);
		case FRACTION_VAGOS: SetPlayerColor(playerid, 0xEEEE00BB);
		case FRACTION_GROVE: SetPlayerColor(playerid, 0x66AA22BB);
		case FRACTION_AZTEC: SetPlayerColor(playerid, 0x66EEEEBB);
		case FRACTION_RIFA: SetPlayerColor(playerid, 0x88CCCCBB);

		case FRACTION_YAKUZA: SetPlayerColor(playerid, 0x800000ff);
		case FRACTION_COLUMBIA: SetPlayerColor(playerid, 0xBC8F8Fff);
		case FRACTION_RUMAFIA: SetPlayerColor(playerid, 0xC0C0C0ff);
		case FRACTION_GOJEK: SetPlayerColor(playerid, COLOR_LIGHTGREEN);

		default: SetPlayerColor(playerid, TEAM_HIT_COLOR);
	}
	return 1;
}

