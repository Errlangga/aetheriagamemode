CMD:acceptdeath(playerid)
{
	if(GetPVarInt(playerid,"pTimeDeath") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 5 Menit");
	if(GetPlayerData(playerid, pInjured) == 0) return Error(playerid, "Anda Tidak Sedang Pingsan.");
	SetPlayerHealthEx(playerid, 40);
	ClearAnim(playerid);
 	ResetWeapons(playerid);
	SetPlayerData(playerid, pInjured, 0);
	update_int_mysql(playerid, "pInjured", 0);
 	for(new i; i < 12; i++) PlayerTextDrawHide(playerid, DEATHTD[playerid][i]);
	SetPVarInt(playerid, "pTimeDeath", gettime() + 120);

    return 1;
}
CMD:arevive(playerid, params[])
{
    new targetid;
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "Usage: /revive [ID]");

	if (targetid == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Player Tidak Online");
	if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
	
	SetPlayerHealthEx(targetid, 100);
	SetPlayerData(targetid, pInjured, 0);
	update_int_mysql(targetid, "pInjured", 0);
	SetPlayerDrunkLevel(targetid, 0);
	SetPlayerData(targetid, pDelayDeath, 0);
	update_int_mysql(targetid, "pDelayDeath", 0);
	ClearAnimations(targetid);
	SetPlayerHealthEx(targetid, 100);
	TogglePlayerControllable(targetid, 1);
 	for(new i; i < 12; i++) PlayerTextDrawHide(targetid, DEATHTD[targetid][i]);
  	Info(targetid, "You Have Been Revived By %s", Name(playerid));
    Info(playerid, "You Has Revive %s", Name(targetid));
	return 1;
}
CMD:revive(playerid, params[])
{
    new targetid;

    if(!IsAMedic(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "Usage: /revive [ID]");

	if (targetid == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Player Tidak Online");

    SetPlayerHealthEx(targetid, 40);
	SetPlayerData(targetid, pInjured, 0);
	update_int_mysql(targetid, "pInjured", 0);
	SetPlayerDrunkLevel(targetid, 0);
	SetPlayerData(targetid, pDelayDeath, 0);
	update_int_mysql(targetid, "pDelayDeath", 0);
	ClearAnimations(targetid);
	SetPlayerHealthEx(targetid, 40);
	TogglePlayerControllable(targetid, 1);
 	for(new i; i < 12; i++) PlayerTextDrawHide(targetid, DEATHTD[targetid][i]);
  	Info(targetid, "You Have Been Revived By %s", Name(playerid));
    Info(playerid, "You Has Revive %s", Name(targetid));

	return 1;
}
CMD:death(playerid, params[])
{
    if(GetPlayerData(playerid, pInjured) == 0) return Error(playerid, "Anda Tidak Sedang Pingsan.");
 	new hour,minuite,second;
    gettime(hour,minuite,second);

	if(PlayerInfo[playerid][pDelayDeath] > 0) SCMF(playerid, COLOR_ISPOLZUY, "Anda Menunggu %d detik untuk menggunakan /acceptdeath", PlayerInfo[playerid][pDelayDeath]);
	return 1;
}
CMD:givefood(playerid,params[])
{
    if(sscanf(params,"ud",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/givefood [id pemain] [jumlah]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;

	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain AFC ini.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(!(1 <= params[1] <= 100)) return SCM(playerid, COLOR_GREY, "Dari 1 hingga 100.");

	if(PlayerInfo[playerid][pFood] < params[1]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki begitu banyak makanan.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki persetujuan masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_GIVEFOOD, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s ambil makanan dari Anda: %i", GetPlayerNameEx(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s menawarkan (a) Anda untuk mengambil makanan darinya: %i", GetPlayerNameEx(playerid), params[1]);

    return SCM(params[0], -1, "Untuk menyetujui, Tekan Y (/accept) atau untuk penolakan ketik(/cancel)");
}

CMD:givedrink(playerid,params[])
{
    if(sscanf(params,"ud",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/givedrink [id pemain] [jumlah]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;

	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain AFC ini.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(!(1 <= params[1] <= 100)) return SCM(playerid, COLOR_GREY, "Dari 1 hingga 100.");

	if(PlayerInfo[playerid][pDrink] < params[1]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki begitu banyak minuman kemasan.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_GIVEDRINK, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s ambil minuman kemasan dari Anda: %i", GetPlayerNameEx(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s menawarkan (a) Anda untuk mengambil minuman kemasan darinya: %i", GetPlayerNameEx(playerid), params[1]);

    return SCM(params[0], -1, "Untuk menyetujui, Tekan Y (/accept) atau untuk penolakan ketik(/cancel)");
}
CMD:setaname(playerid, params[])
{
    if(admin_level[playerid] < 11) return SendClientMessage(playerid, COLOR_RED, "SERVER {FFFFFF}: Anda Tidak Bisa Melakukan ini");

    if(!strlen(params))
		return SendClientMessage(playerid, 0xCECECEFF, "Gunakan: /setaname [id pemain] [nickname]");

    extract params -> new to_player, string: message[144 + 1]; else return SendClientMessage(playerid, 0xCECECEFF, "Gunakan: /setaname [id pemain] [nickname]");

    if(!IsPlayerConnected(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");

	new fmt_str[128];
    format(fmt_str, sizeof fmt_str, "{FE0000}[SERVER] {FEF500}%s(%d) Merubah Nama Admin %s(%d) Menjadi %s", Name(playerid), playerid, Name(to_player), to_player, message);
    SendAdminMessage(0xFF9945FF, fmt_str);

    format(fmt_str, sizeof fmt_str, "SERVER: Nama Admin Anda Di Ubah Oleh %s(%d) Menjadi %s", PlayerInfo[playerid][pAname], playerid, message);
    SendClientMessage(to_player, 0xCECECEFF, fmt_str);

    new query[140];
    mysql_format(mMysql, query, sizeof query, "UPDATE `admin` SET `pAname` = '%s' WHERE `Name` = '%s'", message, GetPlayerNameEx(to_player));
	mysql_tquery(mMysql, query);

	format(PlayerInfo[to_player][pAname], MAX_PLAYER_NAME, "%s", message);

	return 1;
}

CMD:aduty(playerid, params[])
{
		
    new string[217];
    if(admin_level[playerid] < 1) return 1;
   	if(!strcmp(pData[playerid][pAname], "None"))
		return Error(playerid, "Kamu harus setting Nama Admin mu (/setaname)!");
    if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 1;
    PlayerInfo[playerid][pDutyAdmin] = 1;
    OnDuty[playerid] = 1;
    isPayToggled[playerid] = true;
    SetPlayerName(playerid, PlayerInfo[playerid][pAname]);
    GivePlayerWeapon(playerid, 0, 0);
    SetPlayerArmour(playerid, 100);
	IsWatchVehLog[playerid] = 1;
 	PlayerData[playerid][pTogTP] = 1;
    SetPlayerColor(playerid, 0xFF0000FF);
    //SetPlayerSkin(playerid, 217);
    format(string, sizeof(string),"Admin %s Sekarang Sedang Duty silahkan /report & /ask jika ada keluhan", PlayerInfo[playerid][pAname]);
    SendClientMessageToAll(0xFF0000FF, string);
   	SetPVarInt(playerid, "pTimeDuty", gettime() + 300);
    return 1;
}

CMD:oduty(playerid, params[])
{
 //   if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
 	if(GetPVarInt(playerid,"pTimeDuty") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 5 Menit");
    new string[217];
   	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
   	if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 1;
 	SetPlayerName(playerid, PlayerInfo[playerid][pName]);
 	PlayerInfo[playerid][pDutyAdmin] = 0;
 	OnDuty[playerid] = 0;
 	isPayToggled[playerid] = false;
 	ResetPlayerWeapons(playerid);
 	PlayerData[playerid][pTogTP] = 0;
 	SetPlayerArmour(playerid, 0);
 	SetPlayerColor(playerid, COLOR_WHITE);
	//SetPlayerSkinEx(params[0], PlayerInfo[params[0]][pSkin]);
	SetPlayerSkinEx(playerid,PlayerInfo[playerid][pSkin]);
    format(string, sizeof(string),"Adminisrator %s Sekarang Sudah Off Duty", PlayerInfo[playerid][pAname]);
    SendClientMessageToAll(COLOR_LIME, string);
    return 1;
}

CMD:sethbe(playerid, params[]) {
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

	new siapa, jumlah;

	if(sscanf(params, "dd", siapa, jumlah)) return SendClientMessage(playerid, 0xCECECEFF, "/sethbe [playerid] [jumlah]");

	PlayerInfo[siapa][pThirst] = jumlah;
	PlayerInfo[siapa][pSatiety] = jumlah;
	PlayerInfo[siapa][pStress] = 0;
	UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]);
	UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]);
	UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]);
	new cgs[128], cgs1[128];
	format(cgs, sizeof(cgs), "Administrator %s telah merubah hbe anda ke %d", PlayerInfo[playerid][pAname], jumlah);
	format(cgs1, sizeof(cgs1), "Anda telah merubah hbe %s ke %d", GetName(siapa), jumlah);
	SCM(siapa, -1, cgs);
	SCM(playerid, -1, cgs1);
	return 1;
}

CMD:agivecompo(playerid,params[])
{
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

	new targetid, jumlah;
    if(sscanf(params,"dd", targetid, jumlah)) return SendClientMessage(playerid, 0xafafafff, "/agivecompo [id pemain] [jumlah]");
    if(PlayerInfo[targetid][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(!(1 <= jumlah <= 500)) return SCM(playerid, COLOR_GREY, "Dari 1 hingga 500.");

	PlayerInfo[targetid][pComponent] += jumlah;

	OnPlayerUpdateAccountsPer(targetid, "pComponent", PlayerInfo[playerid][pComponent]);

	SCMF(targetid, -1, "- Admin %s give component ke %s", GetName(playerid), GetName(targetid));
	SCMF(playerid, -1, "- Anda memberikan component ke %s.", GetName(targetid));

    return 1;
}

CMD:agivemm(playerid, params[])
{
	if(admin_level[playerid] < 8) return 1;
	{
		new amount;
		if(sscanf(params, "d", amount)) return SendClientMessage(playerid, COLOR_WHITE, "USAGE: /agivemm [amount]");

		foreach(Player, p)
		{
			PlayerInfo[p][pFood] = amount;
			PlayerInfo[p][pDrink] = amount;
			OnPlayerUpdateAccountsPer(p, "pDrink", PlayerInfo[p][pDrink]);
			OnPlayerUpdateAccountsPer(p, "pFood", PlayerInfo[p][pFood]);
			format(String, sizeof(String), "SERVER: {FFFFFF}Administrator %s telah memberi makan dan minum dengan jumlah %d", PlayerInfo[playerid][pAname],amount);
			SendClientMessage(p,COLOR_LIGHTBLUE,String);
		}
	}
	return 1;
}

