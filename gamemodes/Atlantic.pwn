    new string[512];
	format(string, sizeof string,"Nama tidak sesuai format untuk server mode roleplay.\nPenggunaan nama harus mengikuti format Firstname_Lastname.\nSebagai contoh, Steven_Dreschler, Nick_Raymond, dll.");
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX,"{7fff00}No Name Roleplay", string, "Oke","Keluar");
	SetTimerEx("KickPlayer1", 1000, 0, "i", playerid);
	return 1;
}
forward KickPlayer1(playerid);
