					    GivePlayerMoneyEx(i, amount,"");
					}
				    KillTimer(TimerCratesEx[i]);
				    CrateModel[i] = -1;
		        }
	        }
	    }
	}
 	else
 	{
		switch(rand)
		{
   			case 0..12:
  			{
                format(gString, 65, "Bullet ~n~~w~~h~you have %d crates.", totalcrates(i));
