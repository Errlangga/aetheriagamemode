		      callcmd::nambang1(playerid, "");
		}
		if(IsPlayerInRangeOfPoint(playerid, 10.0, 1911.7911,-1877.2695,13.5186))
		{
		  callcmd::tuangbatu(playerid, "");
		}

  		callcmd::taruhbox(playerid, "");
		callcmd::ambilbox(playerid, "");
		callcmd::ambilpupuk(playerid, "");
		callcmd::taruhpadi(playerid, "");
		callcmd::ambilsemen(playerid, "");
		callcmd::taruhsemen(playerid, "");
	 	callcmd::ambilayam(playerid);
  		callcmd::potongayam(playerid, "");
  		callcmd::accept(playerid);
	}
	if(newkeys & 17 && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)// Tombol ctrl
	{
		if(IsPlayerInRangeOfPoint(playerid, 2, 905.0016,-1211.4996,17.0579))
		{
		  callcmd::jualbatu(playerid);
		}
		if(IsPlayerInRangeOfPoint(playerid, 2, 919.3361,-1211.3817,17.0579))
		{
		  callcmd::jualdaging(playerid);
		}
		if(IsPlayerInRangeOfPoint(playerid, 2, 920.0007,-1219.1080,17.0641))
		{
		  callcmd::jualsemen(playerid);
		}
		if(IsPlayerInRangeOfPoint(playerid, 2, 911.7372,-1221.5040,17.0579))
		{
		  callcmd::jualemas(playerid);
		}
		if(IsPlayerInRangeOfPoint(playerid, 2, 904.9653,-1203.9758,17.0579))
		{
		  callcmd::jualsusu(playerid);
		}
		if(IsPlayerInRangeOfPoint(playerid, 2, 911.3123,-1216.9374,17.0579))
		{
