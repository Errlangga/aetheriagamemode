stock SendError(playerid, Tulisan[])
{
    new text[7000];
    format(text, sizeof(text), "ERROR: {FFFFFF}%s", Tulisan);
    SCM(playerid, COLOR_RED, text);
    return 1;
}

stock CreateVehicle_MODIFI(modelid, Float:x, Float:y, Float:z, Float:angle, color1, color2, respawn_delay, addsiren=0)
{
	if(modelid == 0) return 1;

	new vehicleid = CreateVehicle(modelid, x, y, z, angle, color1, color2, respawn_delay, addsiren);

    ClearVehicleData(vehicleid);

	VehInfo[vehicleid][vModel] = modelid;
    VehInfo[vehicleid][vColors1] = color1;
    VehInfo[vehicleid][vColors2] = color1;
    VehInfo[vehicleid][vFuel] = 100.0;
    VehicleCreate[vehicleid] = false;

	return vehicleid;
}
#if defined CreateVehicle
    #undef CreateVehicle
#endif

#define CreateVehicle CreateVehicle_MODIFI
stock AddStaticVehicle_MODIFI(modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:angle, color1, color2)
{
	new vehicleid = AddStaticVehicle(modelid, spawn_x, spawn_y, spawn_z, angle, color1, color2);

    ClearVehicleData(vehicleid);

	VehInfo[vehicleid][vModel] = modelid;
    VehInfo[vehicleid][vColors1] = color1;
    VehInfo[vehicleid][vColors2] = color1;
    VehicleCreate[vehicleid] = false;

	return vehicleid;
}
#if defined AddStaticVehicle
    #undef AddStaticVehicle
#endif

#define AddStaticVehicle AddStaticVehicle_MODIFI

stock DestroyVehicle_MODIFI(vehicleid)
{
	if(vehicleid == INVALID_VEHICLE_ID) return 0;

	if(attachobject_car[vehicleid] != 0)
	{
	    DestroyDynamicObject(attachobject_car[vehicleid]);
	    attachobject_car[vehicleid] = 0;
	}

	VehInfo[vehicleid][vModel] = 0;
    DestroyVehicle(vehicleid);

    return 1;
}
#if defined DestroyVehicle
    #undef DestroyVehicle
#endif

#define DestroyVehicle DestroyVehicle_MODIFI

stock AddStaticVehicleEx_MODIFI(modelid, Float:spawn_x, Float:spawn_y, Float:spawn_z, Float:angle, color1, color2, respawn_delay, addsiren=0)
{
	new vehicleid = AddStaticVehicleEx(modelid, spawn_x, spawn_y, spawn_z, angle, color1, color2, respawn_delay, addsiren);

    ClearVehicleData(vehicleid);

	VehInfo[vehicleid][vModel] = modelid;
    VehInfo[vehicleid][vColors1] = color1;
    VehInfo[vehicleid][vColors2] = color1;
    VehInfo[vehicleid][vFuel] = 100.0;
    VehicleCreate[vehicleid] = false;

	return vehicleid;
}
