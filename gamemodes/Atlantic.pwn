CMD:nambang(playerid, params[])
{
	if(PlayerInfo[playerid][pPickupnambang] >= 1) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Sudah menambang ini");
	if(PlayerInfo[playerid][pDutynambang] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Sedang Tidak On Duty penambang!");
	if(pData[playerid][pEmas] > 100) return Error(playerid, "Emas Sudah melewati Batas!(Max: 100).");
	{
	    if(!IsPlayerInRangeOfPoint(playerid, 2, 1939.4403,-1867.6506,13.8741)) return SendClientMessage(playerid, COLOR_RED, "[RADIO] Anda Tidak Berada Di Tempat penambang!");
        if(IsPlayerInRangeOfPoint(playerid, 2, 1939.4403,-1867.6506,13.8741))
