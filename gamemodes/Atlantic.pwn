CMD:loadgun(playerid)
{
	if(!IsAArmy(playerid)) return 1;

	return PlayerWantLoadGun(playerid, true);
}

CMD:unloadgun(playerid)
{
	if(!IsAArmy(playerid)) return 1;

	return PlayerWantLoadGun(playerid, false);
}

stock PlayerWantLoadGun(playerid, bool: is_load)
{
	if(is_load && !PlayerToPoint(30.0, playerid, 2136.6138,-88.3013,2.8688))
	{
	    SetPlayerGPS(playerid, 2136.6138,-88.3013,2.8688);
		return SCM(playerid, COLOR_GREY, "Anda jauh dari posisi boot, tempat ini ada di peta.");
	}

	if(!is_load)
	{
		if(!PlayerToPoint(30.0, playerid, 335.2584,1943.1689,17.6406) &&
			!PlayerToPoint(30.0, playerid, -303.6902,1533.2164,75.3594) &&
			!PlayerToPoint(30.0, playerid, 1568.4247,-1694.7701,5.8906) &&
			!PlayerToPoint(30.0, playerid, 1406.1659,-1791.5538,13.5469) &&
			!PlayerToPoint(30.0, playerid, 339.2802,2468.9412,20.2886) && //Angkatan Udara
			!PlayerToPoint(30.0, playerid, -1289.4197,374.9855,7.1343) && //Angkatan Laut
			!PlayerToPoint(30.0, playerid, -1606.3179,672.1406,-4.9063) && //SFPD
			!PlayerToPoint(30.0, playerid, 2296.8242,2468.6787,10.8203)) //LVPD
	    return SCM(playerid, COLOR_GREY, "Anda Yaaleko dari titik bongkar(Polisi, Balai Kota, FBI, Gudang Tentara).");
	}

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	    return SCM(playerid, COLOR_GREY, "Anda tidak berada di belakang kursi pengemudi.");

	new vehicleid = GetPlayerVehicleID(playerid);

	new model = GetVehicleModel(vehicleid);

	if(model != 470 && model != 433)
		return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam transport khusus untuk memuat PSU.");

	if(army_veh_pickup[vehicleid] != 0)
	    return SCM(playerid, COLOR_GREY, "Memuat transport sudah ada di Hat.");

    new Float: x, Float: y, Float: z, Float: a;

	if(!is_load) SCM(playerid, COLOR_YELLOW, "Untuk mengisi kembali gudang faksi: Ambil kotak dari transportasi dan taruh di gudang.");

	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, a);

	GetXYInFront(x, y, a, model == 470 ? -3.5 : -5.5);

	army_veh_pickup[vehicleid] = CreateDynamicPickup(19133, 23, x, y, z);

	new limit_amount = GetVehicleModel(vehicleid) == 470 ? 5 : 20;

	format(format_string, 64, "Amunisi dimuat: %i/%i", army_veh_amount[vehicleid], limit_amount);
	army_veh_3d[vehicleid] = CreateDynamic3DTextLabel(format_string, COLOR_WHITE, x, y, z, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);

	RemovePlayerFromVehicleEx(playerid);

	return SCMF(playerid, COLOR_GREEN, "You got %s ammo.", is_load ? ("load") : ("unload"));
}

CMD:delad(playerid)
{
	if(admin_level[playerid] == 0) return 1;

	for(new i; i < MAX_ADVERTS; i++)
	{
	    AdvertInfo[i][aText]=
		AdvertInfo[i][aName]=
		AdvertInfo[i][aNumber]=0;

		AdvertInfo[i][aEditor] = INVALID_PLAYER_ID;
	}

	return SCM(playerid, COLOR_GREEN, "Anda menghapus semua iklan.");
}

CMD:kpk(playerid)
{
    if(player_quest_info[playerid][quest_id] != GQUEST_TYPE_KEYPDSTEAL || player_quest_info[playerid][quest_status] != 1 || player_quest_info[playerid][quest_progress] != 1)
	    return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini sekarang.");

	new vehicleid = GetPlayerVehicleID(playerid);

	if(vehicleid == INVALID_VEHICLE_ID) return SCM(playerid, COLOR_GREY, "Anda tidak berada di dalam kendaraan.");

	if(VehInfo[vehicleid][vFr] != FRACTION_LSPD && VehInfo[vehicleid][vFr] != FRACTION_SFPD && VehInfo[vehicleid][vFr] != FRACTION_LVPD) return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam kendaraan polisi.");

    player_quest_info[playerid][quest_status] = 2;

    OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

    SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 6);

	callcmd::me(playerid, "mendapatkan semua informasi tentang Lance_Wilson dari database Yann");

    return SCM(playerid, COLOR_YELLOW, "Anda mempelajari koordinat rahMalavida , beri tahu Ryder mereka.");
}

CMD:ograb(playerid, params[])
{
	if(player_quest_info[playerid][quest_id] != GQUEST_TYPE_KEYPDSTEAL || player_quest_info[playerid][quest_status] != 1 || player_quest_info[playerid][quest_progress] != 0)
	    return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini sekarang.");

	extract params -> new to_player; else return SCM(playerid, -1, "/ograb [id pemain]");

	if(!IsACop(to_player)) return SCM(playerid, COLOR_GREY, "Pemain bukan polisi.");

	new Float: x, Float: y, Float: z, Float: a;

	GetPlayerPos(to_player, x, y, z);
	GetPlayerFacingAngle(to_player, a);

	new Float: old_x = x,
		Float: old_y = y;

	GetXYInFront(x, y, a, -1.0);

	if(!PlayerToPoint(1.0, playerid, x, y, z))
	    return SCM(playerid, COLOR_GREY, "Anda tidak berada di belakang pemain ini.");

	SetPlayerFaceToPoint(playerid, old_x, old_y);

	ApplyAnimation(playerid,"MISC","GRAB_R",4.0, 0, 0, 0, 0, 0,1);

	player_quest_info[playerid][quest_progress] = 1;

	SetTimerEx("SendPlayerQuestInfoSMS", 15000, false, "ii", playerid, 5);

	return SCMF(playerid, COLOR_YELLOW, "Anda mencuri kunci dari kendaraan polisi dari {FFFFFF}%s", GetPlayerNameEx(to_player));
}

CMD:gquest(playerid)
{
    //if(!(5 <= DayOfWeak() <= 7)) return SCM(playerid, COLOR_GREY, "Waktu untuk menyelesaikan misi sudah berakhir.");

    new q_id = player_quest_info[playerid][quest_id];
	new q_status = player_quest_info[playerid][quest_status];

	if(q_id == GQUEST_TYPE_END)
	    return SCM(playerid, COLOR_GREY, "Anda telah menyelesaikan semua tantangan.");

	switch(player_quest_info[playerid][quest_id])
	{
	    case GQUEST_TYPE_CARJACK, GQUEST_TYPE_MONEY:
	    {
	        if(q_status == 1)
	        {
		        new vehicleid = player_quest_info[playerid][quest_vehicle_id];

		        new Float: x, Float: y, Float: z;

                if(GetPlayerVehicleID(playerid) == vehicleid)
				{
				    if(q_id == GQUEST_TYPE_CARJACK) x = 1945.6772, y = -2084.2949, z = 13.5495;
				    if(q_id == GQUEST_TYPE_MONEY) x = 2813.3657, y = -1182.7249, z = 25.2697;
				}
				else GetVehiclePos(vehicleid, x, y, z);

		        SetPlayerGPS(playerid, x, y, z);

				if(q_id == GQUEST_TYPE_CARJACK && GetPlayerVehicleID(playerid) != vehicleid) SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 0);

				return Send(playerid, -1, "Tempat itu ditandai di peta {ff0000}dengan tanda {ffffff}merah");
			}
	    }
	    case GQUEST_TYPE_DRUGMARK:
	    {
	        if(q_status == 1)
	        {
	            new rand = player_quest_info[playerid][quest_progress];

	            new Float: x = stash_pos[rand][0],
					Float: y = stash_pos[rand][1],
					Float: z = stash_pos[rand][2];

				SetPlayerGPS(playerid, x, y, z);

				return Send(playerid, -1, "Tempat itu ditandai di peta {ff0000}dengan tanda {ffffff}merah");
	        }
	    }
	    case GQUEST_TYPE_MATS:
	    {
	        if(q_status == 1)
	        {
	            new g_id = GetFractionGangID(playerid);

		        new vehicleid = player_quest_info[playerid][quest_vehicle_id];

		        new Float: x, Float: y, Float: z;

                if(GetPlayerVehicleID(playerid) == vehicleid)
				{
					x = quest_fraction_mats[g_id][0],
					y = quest_fraction_mats[g_id][1],
					z = quest_fraction_mats[g_id][2];
				}
				else GetVehiclePos(vehicleid, x, y, z);

		        SetPlayerGPS(playerid, x, y, z);

				SetTimerEx("SendPlayerQuestInfoSMS", 2000, false, "ii", playerid, 0);

				return Send(playerid, -1, "Tempat itu ditandai di peta {ff0000}dengan tanda {ffffff}merah");
			}
	    }
	    default: ShowPlayerQuestInfoText(playerid);
	}

	return 1;
}

CMD:drop(playerid)
{
	if(player_take_collector[playerid] != -1)
	{
        RemovePlayerAttachedObject(playerid, 4);
        return player_take_collector[playerid] = -1;
	}

    if(GetPVarInt(playerid, "take_mats")) return RemovePlayerAmmoBox(playerid);

    if(!GetPVarInt(playerid, "take_pizza"))
        return SCM(playerid, COLOR_GREY, "Anda tidak memiliki pizza di tangan Anda.");

    DeletePVar(playerid, "take_pizza");

    SCM(playerid, COLOR_GREY, "Anda menjatuhkan pizza Anda.");

	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(playerid, 4);

	return 1;
}
CMD:okay(playerid, params[])
{
	if(admin_level[playerid] == 0) return 1;

    extract params -> new to_player; else return SendClientMessage(playerid, -1, "/okay [id pemain]");

	new new_nick[MAX_PLAYER_NAME];

	GetPVarString(to_player, "change_name", new_nick, MAX_PLAYER_NAME);

	if(strlen(new_nick) < 4)
	    return SCM(playerid, COLOR_GREY, "Pemain ini tidak mengajukan permintaan untuk mengubah nama panggilannya.");

	DeletePVar(to_player, "change_name");

	format(format_string, 144, "[A] Admin %s mengubah nama panggilan pemain %s menjadi %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player), new_nick);
	SendClientMessageToAll(-1, format_string);

    PlayerChangeName(to_player, new_nick);

	return 1;
}

CMD:nookay(playerid, params[])
{
    if(admin_level[playerid] == 0) return 1;

    extract params -> new to_player; else return SendClientMessage(playerid, -1, "/okay [id pemain]");

	new new_nick[MAX_PLAYER_NAME];

	GetPVarString(to_player, "change_name", new_nick, MAX_PLAYER_NAME);

	if(strlen(new_nick) < 4)
	    return SCM(playerid, COLOR_GREY, "Pemain ini tidak mengajukan permintaan untuk mengubah nama panggilannya.");

    DeletePVar(to_player, "change_name");

	format(format_string, 144, "[A] Administrator %s menolak untuk mengubah nama panggilan %s", GetPlayerNameEx(playerid), GetPlayerNameEx(to_player));
	SendAdminMessage(-1, format_string);

	SCMF(to_player, -1, "Administrator %s menolak untuk mengubah nama panggilan Anda.", GetPlayerNameEx(playerid));

	return 1;
}

CMD:park(playerid)
{
    new use_car = GetPlayerUseHomeCar(playerid);

    if(use_car == -1) return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam transportasi pribadi.");

	for(new i, z = sizeof block_park_pos; i < z; i++)
	    if(PlayerToPoint(30.0, playerid, block_park_pos[i][0], block_park_pos[i][1], block_park_pos[i][2]))
	        return SCM(playerid, COLOR_GREY, "Tidak ada parkir di area ini.");

    GetPlayerPos(playerid, player_car_park[playerid][use_car][0], player_car_park[playerid][use_car][1], player_car_park[playerid][use_car][2]);
    GetPlayerFacingAngle(playerid, player_car_park[playerid][use_car][3]);

    SavePlayerCarPark(playerid);
    DestroyVehicleLabel(use_car);
	SaveCars(playerid);
	
    SCMF(playerid, COLOR_YELLOW, "Posisi kendaraan baru(#%i) disimpan.", use_car);

	return 1;
}

CMD:car(playerid)
{
	if(CarInfo[playerid][cModel][0] == 0 && CarInfo[playerid][cModel][1] == 0 && CarInfo[playerid][cModel][2] == 0 && CarInfo[playerid][cModel][4] == 0 && CarInfo[playerid][cModel][4] == 0)
	    return SCM(playerid, COLOR_GREY, "Anda tidak memiliki transportasi yang tersedia.");

    String = "";

	new str[96];

	new count = 0;

	for(new i; i < MAX_PLAYER_VEHICLES; i++)
	{
	    if(CarInfo[playerid][cModel][i] == 0) continue;

		format(str, 96, "{a86cfc}%i.\t{ffffff}%s\t%s\n",
			i+1,
			VehicleNames[CarInfo[playerid][cModel][i]-400],
			player_home_car[playerid][i] == INVALID_VEHICLE_ID ? ("Menunggu") : ("Dimuat"));

		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	return SPD(playerid, 4710, DIALOG_STYLE_TABLIST, "Pemilihan slot", String, "Pilih", "Kembali");
}


alias:engine("en");
CMD:engine(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid, COLOR_GREY, "Anda tidak berada di belakang kursi pengemudi.");

    new vehicleid = GetPlayerVehicleID(playerid);
    if(CloseEngine(vehicleid)) return 1; //Transportasi tanpa mesin


	if(!IsVehicleHaveFuel(vehicleid))
	{
		GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
    	return SetVehicleParamsEx(vehicleid,!engine,lights,alarm,doors,bonnet,boot,objective);
	}

	if(Fuell[vehicleid] < 1.0) return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Notice", "{FFFFFF}Tidak ada bahan bakar di dalam kendaraan.", "Close", "");

	if(IsAGang(playerid) && VehInfo[vehicleid][vFr] == FRACTION_LSPD) return 1; //Larang memulai misi


    GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);

    if(engine == 1)
	{
		format(String, 188, "* %s Stopping Engine %s Vehicle", ReturnName(playerid), VehicleNames[GetVehicleModel(vehicleid) - 400]);
		ProxDetector(25.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
		GameTextForPlayer(playerid, "~w~stop ~r~engine", 5000,6);
	    SetPlayerChatBubble(playerid, "Stopping Engine",COLOR_PURPLE,30.0,10000);
		return SetVehicleParamsEx(vehicleid,0,lights,alarm,doors,bonnet,boot,objective);
	}

	new Float: health;
    GetVehicleHealth(vehicleid, health);

	if(health <= 400.0) return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Notice", "{FFFFFF}Kendaraan dalam kondisi kritis.", "Close", "");

	if(vehicle_owner_id[vehicleid] != INVALID_PLAYER_ID)
	{
	    new owner_id = vehicle_owner_id[vehicleid];

	    for(new x; x < MAX_PLAYER_VEHICLES; x++)
			if(vehicleid == player_home_car[owner_id][x] && player_car_keys[owner_id][x] == 0)
				return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Notice", "{FFFFFF}Tidak ada kunci dalam kunci kontak, gunakan: /key atau /en.", "Close", "");
	}
	format(String, 188, "* %s Starting Engine %s Vehicle", ReturnName(playerid), VehicleNames[GetVehicleModel(vehicleid) - 400]);
	GameTextForPlayer(playerid, "~w~start ~r~engine", 5000,6);
	ProxDetector(25.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPlayerChatBubble(playerid, "Starting Engine",COLOR_PURPLE,20.0,10000);

	return SetVehicleParamsEx(vehicleid,1,lights,alarm,doors,bonnet,boot,objective);
}

CMD:trashinfo(playerid)
{
	if(PlayerInfo[playerid][pJob] != 4) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak menjalankan truk sampah!");

	new str[64], count = 0;

	command_text = "{FFFFFF}";

	for(new i; i < MAX_TRASH; i++)
	{
	    if(trash_info[i][t_amount] < 40) continue;

	    if(count == 25) break;

	    format(str, 64, "[%i] Ketentuan: %i/100\n", i, trash_info[i][t_amount]);
	    strcat(command_text, str);

	    count++;
	}

	strcat(command_text, "\nMasukkan nomor tempat sampah:");

	return SPD(playerid, 227, DIALOG_STYLE_INPUT, "Trash can location", command_text, "Select", "Close");
}
CMD:fishing(playerid)// Memancing
{
	if(player_job[playerid] != 4) return SendClientMessage(playerid,0xB4B5B7FF,"Kesalahan: Anda bukan nelayan");
	if(GetPVarInt(playerid,"pTimeMancing") > gettime()) return Send(playerid, COLOR_GREY, "JANGAN SPAM");
	if(pData[playerid][pFish] > 100) return Error(playerid, "Ikan Sudah melewati Batas!(Max: 100).");
	if(!IsPlayerInRangeOfPoint(playerid, 30.0, 3141.27, -2220.47, 1.51)) return SendClientMessage(playerid, 0xFFFF00FF, "FISHING: {FFFFFF}Kamu tidak berada di tempat pemancingan!");
	if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, 0xFFFF00FF, "FISHING: {FFFFFF}Keluar dari kendaraan untuk memancing!");
	{
		TogglePlayerControllableEx(playerid, 0);
    	SetPlayerAttachedObject(playerid, 0,18632,6,0.079376,0.037070,0.007706,181.482910,0.000000,0.000000,1.000000,1.000000,1.000000);
		ApplyAnimation(playerid,"SWORD","sword_block",50.0,0,1,0,1,1);
        SetTimerEx("WaktuMancing98", 10000, false, "d", playerid);
        ShowProgressbar(playerid, "Sedang_Mancing...", 10);
    	SetPlayerChatBubble(playerid, "Mulai Memancing",COLOR_PURPLE,30.0,10000);
  	 	SetPVarInt(playerid, "pTimeMancing", gettime() + 11);
	}
	return true;
}
alias:licenses("lic");
CMD:licenses(playerid, params[])
{
    extract params -> new to_player; else return SendClientMessage(playerid, -1, "/licenses(/lic) [id pemain]");

	if(!IsPlayerConnected(to_player))
		return SendClientMessage(playerid, 0x999999FF, "Tidak ada pemain seperti itu");

	if(!ProxDetectorS(4.0, playerid, to_player)) return Send(playerid, COLOR_GREY,"Pemain terlalu senang");

	if(GetPVarInt(playerid,"pLicTime") > gettime()) return Send(playerid, COLOR_GREY, "Tunggu sebentar.");
	new str[86];

	String = "";

	format(str, 86, "%s\t"W"SIM %s\n", (PlayerInfo[playerid][pLicenses][0]) ? ("{FA8072}Ya") : ("{FF4500}Tidak"));
	strcat(String, str);

	format(str, 86, "%s\t"W"Lisensi pilot %s\n", (PlayerInfo[playerid][pLicenses][1]) ? ("{FA8072}Ya") : ("{FF4500}Tidak"));
    strcat(String, str);

	format(str, 86, "%s\t"W"Lisensi transportasi air %s\n",(PlayerInfo[playerid][pLicenses][2]) ? ("{FA8072}Ya") : ("{FF4500}Tidak"));
    strcat(String, str);

	format(str, 86, "%s\t"W"Lisensi senjata %s\n",(PlayerInfo[playerid][pLicenses][3]) ? ("{FA8072}Ya") : ("{FF4500}Tidak"));
    strcat(String, str);
	format(format_string, 40, "Lisensi %s", Name(playerid));
	SPD(to_player, 0000, 0, format_string, String, "Ok", "");
	MeAction(playerid,"menunjukkan lisensi saya");
	SetPVarInt(playerid, "pLicTime", gettime() + 15);
	return 1;
}
CMD:pass(playerid, params[])//0x999999FF
{
	extract params -> new to_player; else return SendClientMessage(playerid, -1, "/pass [id pemain]");

	if(!IsPlayerConnected(to_player))
		return SendClientMessage(playerid, 0x999999FF, "Tidak ada pemain seperti itu");

	if(!ProxDetectorS(4.0, playerid, to_player)) return Send(playerid, COLOR_GREY,"Pemain terlalu jauh");

	if(GetPVarInt(playerid,"pPassTime") > gettime()) return Send(playerid, COLOR_GREY, "Tunggu sebentar...");

	new atext[20];
	if(PlayerInfo[playerid][pSex] == 1) atext = "Laki-laki";
	else atext = "Perempuan";

	new htext[10];
	if(GetPlayerHouse(playerid) != -1) format(htext, sizeof(htext), "Nomor rumah%d", GetPlayerHouse(playerid));
	else if(PlayerInfo[playerid][pHotel] != -1) format(htext, sizeof(htext), "No. hotel%d", PlayerInfo[playerid][pHotel]);
	else htext = "Tunawisma";


	new fmt_str[128];
	MeAction(playerid, "menunjukkan paspornya");

	format(fmt_str, sizeof fmt_str, "Nama depan: %s  |  Usia: %d  |  Gender: %s |  Akomodasi: %s", GetPlayerNameEx(playerid), PlayerInfo[playerid][pLevel], atext, htext);
	SendClientMessage(to_player, 0xFFFFFFFF, fmt_str);

	format(fmt_str, sizeof fmt_str, "Bekerja: %s  |  Organisasi/Posisi: %s / %s", NamesJob(playerid), FracInfo[PlayerInfo[playerid][pMember]][fName], FracRank[PlayerInfo[playerid][pMember]][PlayerInfo[playerid][pRank]]);
	SendClientMessage(to_player, 0xFFFFFFFF, fmt_str);

	format(fmt_str, sizeof fmt_str, "Nomor telepon: %d  |  Tingkat yang diinginkan: %d  |  Ketaatan hukum: %d", PlayerInfo[playerid][pNumber], PlayerInfo[playerid][pWanted], PlayerInfo[playerid][pZakon]);
	SendClientMessage(to_player, 0xFFFFFFFF, fmt_str);

    SetPVarInt(playerid, "pPassTime", gettime() + 15);
	return 1;
}
