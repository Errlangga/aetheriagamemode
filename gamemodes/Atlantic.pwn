stock ALogin(playerid)
{
	if(admin_level[playerid] == 0) return 1;
	//SendClientMessage(playerid,0xffffffff,"Untuk memulai, masuk ke panel admin");
	if(!strcmp(PlayerInfo[playerid][pAdminKey], "0", true)) return SPD(playerid, 6, DIALOG_STYLE_INPUT, "Register password", ""W"Masukkan sandi yang diinginkan untuk mengakses panel admin:\n\n- Kata sandi tidak boleh mengandung karakter Diluar Batas\n- Kata sandi harus terdiri dari 4 hingga 12 karakter", "Enter", "Exit");
	else SPD(playerid, 7, 1, "Authorization", "{ffffff}Masukkan kode dari panel", "Login", "Cancel");
	return true;
}

stock Trucker_StopJob(playerid)
{
	if(IsPlayerInAnyVehicle(playerid)) RemovePlayerFromVehicleEx(playerid);

	if(rent_job_vehicle[playerid] != INVALID_VEHICLE_ID)
		SetVehicleToRespawn(rent_job_vehicle[playerid]);	// Paksa respawn
	pTemp[playerid][pTrucker_Unit] = 0;
	pTemp[playerid][pTrucker] = -1;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

	pTemp[playerid][pTrucker_Access] = false;
	return 1;
}

@TruckerTimer(playerid);
@TruckerTimer(playerid)
{
	new newcar = GetPlayerVehicleID(playerid);
	TogglePlayerControllable(playerid, true);

	DisablePlayerCheckpoint(playerid);

	switch(pTemp[playerid][pTrucker]) {
		case 0:
		{
			pTemp[playerid][pTrucker] = 1;

			SendClientMessage(playerid, -1, !"Truck dimuat, pergi ke lokasi bongkar");

			new str[64];
			format(str, sizeof str, "[Jumlah kargo: %d/%i]", pTemp[playerid][pTrucker_Unit], MAX_UNIT);

			if(gruz_3d[newcar] == Text3D:0)
				gruz_3d[newcar] = CreateDynamic3DTextLabel(str, -1, 0.0, 0.0, 0.0, 15.0, INVALID_PLAYER_ID, rent_job_vehicle[playerid]);
			else
				UpdateDynamic3DTextLabelText(gruz_3d[newcar], -1, str);

			new index = sizeof(trucker_checkpoints)-1;
			SetPlayerCheckpoint(playerid, trucker_checkpoints[index][0], trucker_checkpoints[index][1], trucker_checkpoints[index][2], 10.0);
		}
		case 1:
		{
			pTemp[playerid][pTrucker] = -1;
			new money = pTemp[playerid][pTrucker_Unit]*UNIT_PRICE;
			GivePlayerMoneyEx(playerid, money+floatround(money*SALARY_PRECENTAGE), "bongkar kargo");
			pTemp[playerid][pTrucker_Unit] = 0;
			///Send(playerid, -1, "Unload WindowsHen");
			SCMF(playerid,-1,"Unloading windowsHen, Anda memperoleh: %d", money+(money*SALARY_PRECENTAGE));
			new str[64];
			format(str, sizeof str, "[Jumlah kargo: %d/%i]", pTemp[playerid][pTrucker_Unit], MAX_UNIT);
			UpdateDynamic3DTextLabelText(gruz_3d[newcar], -1, str);
			SPD(playerid, 231, DIALOG_STYLE_INPUT, !""CAPTION_WAREHOUSE_SELECTION"", !""INFO_WAREHOUSE_SELECTION"", "More", "Cancel");
		}
	}
	return 1;
}

stock Pilot_StopJob(playerid) {
	if(IsPlayerInAnyVehicle(playerid))
		RemovePlayerFromVehicleEx(playerid);
	pTemp[playerid][pPilot_Access] = false;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
	pTemp[playerid][pPilot] =
	pTemp[playerid][pPilot_Checkpoint] = 0;
	return 1;
}

