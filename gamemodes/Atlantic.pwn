CMD:addnitro11(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                new otherid;
                if(sscanf(params, "u", otherid))
                    return Usage(playerid, "/addnitro [id player]");

                if(otherid == INVALID_PLAYER_ID)
                    return Error(playerid, "Player disconnect");

                if(!IsPlayerDriver(otherid))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pelanggan harus mengemudi");

                pData[playerid][pTarget] = otherid;
                ShowPlayerDialog(playerid, DIALOG_ADDNITRO, DIALOG_STYLE_LIST, "Nitro Vehicle", "Nitro 2x\nNitro 5x\nNitro 10x", "Select", "Cancel");
            }
        }
    }
    return 1;
}

CMD:repairws(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                new vehicleid = GetPlayerVehicleID(playerid);
                if(PlayerInfo[playerid][pComponent] < 15) return SCM(playerid, COLOR_GREY, "Component Anda Tidak Cukup");
                if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, "Kamu tidak berada di kursi pengemudi!");
                RepairVehicle(GetPlayerVehicleID(playerid));
                SetVehicleHealth(vehicleid, 1000.0);
                SendClientMessage(playerid, -1, "Kendaraan berhasil di perbaiki.");
                PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
            }
        }
    }
    return 1;
}

