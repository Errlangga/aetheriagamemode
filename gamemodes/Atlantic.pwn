public OnPlayerClickDynamicTextdraw(playerid, PlayerText:playertextid)
{
    for(new i; i < sizeof(WppIndexConv[]); i++)
	{
		if(playertextid == WppIndexConv[playerid][i][3])
		{
			SetPVarInt(playerid, "Conversa_Aberta_Index", i);
