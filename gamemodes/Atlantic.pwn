    strins(new_nick, mobile_text, strlen(new_nick));
    strins(new_nick, status_text, strlen(new_nick));
    strins(new_nick, GetPlayerNameEx(playerid), strlen(new_nick));

	printf("%s %i", new_nick, SetPlayerName(playerid, new_nick));
}

