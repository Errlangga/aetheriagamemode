stock CreatePlayerSatietyBar(playerid)
{
	if(IsPlayerConnected(playerid))
	{
		PlayerProgressBar[playerid][0] = CreatePlayerProgressBar(playerid, 58.000000, 241.000000, 62.000000, 4.000000, -1, 100.000000, 0);
		ShowPlayerProgressBar(playerid, PlayerProgressBar[playerid][0]);
		SetPlayerProgressBarValue(playerid, PlayerProgressBar[playerid][0], PlayerInfo[playerid][pSatiety]);

		PlayerProgressBar[playerid][1] = CreatePlayerProgressBar(playerid, 58.000000, 257.000000, 62.000000, 4.000000, -1, 100.000000, 0);
		ShowPlayerProgressBar(playerid, PlayerProgressBar[playerid][1]);
		SetPlayerProgressBarValue(playerid, PlayerProgressBar[playerid][1], PlayerInfo[playerid][pThirst]);

		PlayerProgressBar[playerid][2] = CreatePlayerProgressBar(playerid, 57.000000, 273.000000, 62.000000, 4.000000, -1, 100.000000, 0);
		ShowPlayerProgressBar(playerid, PlayerProgressBar[playerid][2]);
		SetPlayerProgressBarValue(playerid, PlayerProgressBar[playerid][2], PlayerInfo[playerid][pStress]);
	}
	return 1;
}
stock UpdatePlayerSatiety(playerid, Float: satiety)
{
	if(satiety > 100) satiety = 100;
	if(satiety < 0) satiety = 0;

    PlayerInfo[playerid][pSatiety] = satiety;
    if(PlayerInfo[playerid][pSatietyBarActive] == 1 && IsValidPlayerProgressBar(playerid, PlayerProgressBar[playerid][0])) SetPlayerProgressBarValue(playerid, PlayerProgressBar[playerid][0], PlayerInfo[playerid][pSatiety]);

	return 1;
}
stock UpdatePlayerThirst(playerid, Float: thirst)
{
	if(thirst > 100) thirst = 100;
	if(thirst < 0) thirst = 0;

    PlayerInfo[playerid][pThirst] = thirst;
    if(PlayerInfo[playerid][pSatietyBarActive] == 1 && IsValidPlayerProgressBar(playerid, PlayerProgressBar[playerid][1])) SetPlayerProgressBarValue(playerid, PlayerProgressBar[playerid][1], PlayerInfo[playerid][pThirst]);

	return 1;
}
stock UpdatePlayerStress(playerid, Float: stress)
{
	if(stress > 100) stress = 100;
	if(stress < 0) stress = 0;

    PlayerInfo[playerid][pStress] = stress;
    if(PlayerInfo[playerid][pSatietyBarActive] == 1 && IsValidPlayerProgressBar(playerid, PlayerProgressBar[playerid][2])) SetPlayerProgressBarValue(playerid, PlayerProgressBar[playerid][2], PlayerInfo[playerid][pStress]);

	return 1;
}
stock use_bd(playerid, time = 60)
{
	TextDrawHideForPlayer(playerid, black_display[playerid]), KillTimer(GetPVarInt(playerid, "black@display")), DeletePVar(playerid, "displ");
	SetPVarInt(playerid, "black@display",SetTimerEx("black_screen", time, true, "i", playerid));
}
epublic: black_screen(playerid)
{
    SetPVarInt(playerid, "displ",GetPVarInt(playerid, "displ") +2);
    switch(GetPVarInt(playerid, "displ"))
    {
        case 2: TextDrawBoxColor(black_display[playerid], 0x00000049), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 4: TextDrawBoxColor(black_display[playerid], 0x00000069), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 6: TextDrawBoxColor(black_display[playerid], 0x00000079), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 8: TextDrawBoxColor(black_display[playerid], 0x00000089), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 10: TextDrawBoxColor(black_display[playerid], 0x000000ff), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 12: TextDrawBoxColor(black_display[playerid], 0x00000089), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 14: TextDrawBoxColor(black_display[playerid], 0x00000069), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 16: TextDrawBoxColor(black_display[playerid], 0x00000049), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 18: TextDrawBoxColor(black_display[playerid], 0x00000019), TextDrawShowForPlayer(playerid,black_display[playerid]);
        case 20: TextDrawHideForPlayer(playerid,black_display[playerid]), KillTimer(GetPVarInt(playerid, "black@display")), DeletePVar(playerid, "displ");
    }

    return 1;
}
