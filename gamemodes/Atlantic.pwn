CMD:remap(playerid) {
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	SendRconCommand("reloadfs MapLoader");
	SCM(playerid, -1, "Map reloaded!");
	return 1;
}
CMD:createpom(playerid, params[])
{
    if(strcmp(Name(playerid), PROJECT_FOUNDER, true) != 0)
        return Info(playerid, "Command Ini Hanya Untuk Developer");

    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;

    new idx = TotalABizz,
        Float: bizpos[3],
        kontol[700];

    new price;
    if(sscanf(params, "d", price)) return Send(playerid, COLOR_WHITE, "USAGE: /createpom [price]");

    GetPlayerPos(playerid, bizpos[0], bizpos[1], bizpos[2]);

    BizzAInfo[idx][aAreaFillX] = bizpos[0];
    BizzAInfo[idx][aAreaFillY] = bizpos[1];
    BizzAInfo[idx][aAreaFillZ] = bizpos[2];
    BizzAInfo[idx][aBuyPrice] = price;
    BizzAInfo[idx][aOwned] = 0;
    BizzAInfo[idx][aPrice] = 100;
    BizzAInfo[idx][aProducts] = 10000;
    mysql_escape_string("Fuel Station", BizzAInfo[idx][aMessage], 64);

    format(kontol, sizeof(kontol), "INSERT INTO `bizz_fuel` (`aID`,`aOwned`,`aMessage`,`aBuyPrice`,`aProducts`,`aAreaFillX`,`aAreaFillY`,`aAreaFillZ`) VALUES ('%i', '%d', '%s', '%d', '%d', '%f', '%f','%f')", idx, BizzAInfo[idx][aOwned],
    BizzAInfo[idx][aMessage], BizzAInfo[idx][aBuyPrice], BizzAInfo[idx][aProducts], BizzAInfo[idx][aAreaFillX],
    BizzAInfo[idx][aAreaFillY], BizzAInfo[idx][aAreaFillZ]);
    mysql_tquery(mMysql, kontol);

    BizzAInfo[idx][aEntranceArea] = CreateDynamicSphere(bizpos[0], bizpos[1], bizpos[2],5);
    format(String, sizeof(String), "{0099FF}Pesan '%s'\n"W"Harga untuk 1 liter: %d$\n\n{EBBD00}Pompa bensin dijual\nHarga: %d$\n{66CC00}/buyfuelst untuk pembelian",BizzAInfo[idx][aMessage], BizzAInfo[idx][aPrice], BizzAInfo[idx][aBuyPrice]);
    BizzAInfo[idx][aLabel] = Create3DTextLabel(String, -1, bizpos[0], bizpos[1], bizpos[2],15.0,0,1);
    CreateDynamicMapIcon(bizpos[0], bizpos[1], bizpos[2], 47, -1, 0, -1, -1);

    TotalABizz++;
    SCMF(playerid, COLOR_RED, "AdmCmd: {FFFFFF}Anda Membuat POM ID: {FF0000}%i", idx);
    return 1;
}
CMD:givemoneybank(playerid, params[])
{
    if(admin_level[playerid] < 11) return true;
    if(sscanf(params, "ud", params[0], params[1])) return Send(playerid, -1, "Masuk: /givemoneybank [playerid] [value]");
    if(params[1] < 1 || params[1] > 10000000) return SendClientMessage(playerid, 0xB4B5B7FF,"dari 1 hingga 10.000.000");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");
    if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini di AFK");

    GivePlayerBankEx(params[0], params[1], "admin yang dikeluarkan");

    format(format_string, sizeof(format_string), "Administrator %s[%d] memberi %s $%d",Name(playerid), playerid,Name(params[0]),params[1]);
    AddAdminLog(playerid, format_string);
    SendAdminMessage(COLOR_RED, format_string);
    return 1;
}
cmd:sethouse(playerid,params[])
{
    if(admin_level[playerid] < 7) return true;
    if(sscanf(params, "id", params[0], params[1])) return Send(playerid, -1,"/sethouse [ID rumah] [harga]");
    HouseInfo[params[0]][hValue] = params[1];
    SaveHouse(params[0]);
    SCMF(playerid,0x27C400FF,"Anda telah berhasil menginstal di rumah: %i biaya negara: %d", params[0], params[1]);
    return true;
}

CMD:setinteriorhouse(playerid,params[])
{
    if(admin_level[playerid] < 11) return true;
    if(sscanf(params, "id", params[0], params[1])) return Send(playerid, -1,"/setinteriorhouse [ID rumah] [int]");
    HouseInfo[params[0]][hKlass] = params[1];
    SaveHouse(params[0]);
    Info(playerid, "Anda Berhasil Mengubah Interior ID RUMAH: %i Interior: %d", params[0], params[1]);
    return true;
}

CMD:setcarpos(playerid,params[])
{
    if(admin_level[playerid] < 1) return true;
    new Float: X,Float:Y,Float:Z;
    GetPlayerPos(playerid,X,Y,Z);
    if(sscanf(params, "id", params[0])) return Send(playerid, -1,"/setcarpos [ID rumah]");
    HouseInfo[params[0]][hCarx] = X, HouseInfo[params[0]][hCary] = Y, HouseInfo[params[0]][hCarz] = Z;
    SaveHouse(params[0]);
    Info(playerid, "Anda Berhasil Set Kordinat Car Pos: %i", params[0]);
    return true;
}
CMD:race(playerid, params[])
{
    new type[24], string[128], Float:pos[3];
    GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
    if(sscanf(params, "s[24]S()[128]", type, string))
    {
        SendSyntaxMessage(playerid, "/race [names]");
        SendClientMessage(playerid, COLOR_SERVER, "NAMES: {FFFFFF}savecp(1-5), finishcp, invite, start, kick");
        return 1;
    }
    if(!strcmp(type, "savecp1", true))
    {
        RaceData[playerid][racePos1][0] = pos[0];
        RaceData[playerid][racePos1][1] = pos[1];
        RaceData[playerid][racePos1][2] = pos[2];

        SendServerMessage(playerid, "Checkpoint recorded!");
    }
    else if(!strcmp(type, "savecp2", true))
    {
        RaceData[playerid][racePos2][0] = pos[0];
        RaceData[playerid][racePos2][1] = pos[1];
        RaceData[playerid][racePos2][2] = pos[2];

        SendServerMessage(playerid, "Checkpoint recorded!");
    }
    else if(!strcmp(type, "savecp3", true))
    {
        RaceData[playerid][racePos3][0] = pos[0];
        RaceData[playerid][racePos3][1] = pos[1];
        RaceData[playerid][racePos3][2] = pos[2];

        SendServerMessage(playerid, "Checkpoint recorded!");
    }
    else if(!strcmp(type, "savecp4", true))
    {
        RaceData[playerid][racePos4][0] = pos[0];
        RaceData[playerid][racePos4][1] = pos[1];
        RaceData[playerid][racePos4][2] = pos[2];

        SendServerMessage(playerid, "Checkpoint recorded!");
    }
    else if(!strcmp(type, "savecp5", true))
    {
        RaceData[playerid][racePos5][0] = pos[0];
        RaceData[playerid][racePos5][1] = pos[1];
        RaceData[playerid][racePos5][2] = pos[2];

        SendServerMessage(playerid, "Checkpoint recorded!");
    }
    else if(!strcmp(type, "finishcp", true))
    {
        RaceData[playerid][raceFinish][0] = pos[0];
        RaceData[playerid][raceFinish][1] = pos[1];
        RaceData[playerid][raceFinish][2] = pos[2];

        SendServerMessage(playerid, "Finish checkpoint recorded!");
    }
    else if(!strcmp(type, "kick", true))
    {
        new targetid;
        if(sscanf(string, "u", targetid))
            return SendSyntaxMessage(playerid, "/race [kick] [playerid/name]");

        if (targetid == INVALID_PLAYER_ID || !IsPlayerNearPlayer(playerid, targetid, 5.0))
            return SendErrorMessage(playerid, "That player is disconnected or not near you.");

        if(PlayerInfo[targetid][pRaceWith] != playerid)
            return SendErrorMessage(playerid, "That player is not on your race!");


        PlayerInfo[targetid][pRaceWith] = INVALID_PLAYER_ID;
        PlayerInfo[targetid][pRaceIndex] = 0;
        DisablePlayerRaceCheckpoint(targetid);
        SendServerMessage(playerid, "You've kick %s from your race!", ReturnName(targetid));
        SendServerMessage(targetid, "You've been kicked by %s from their race!", ReturnName(playerid));
    }
    else if(!strcmp(type, "invite", true))
    {
        new targetid;
        if(sscanf(string, "u", targetid))
            return SendSyntaxMessage(playerid, "/race [invite] [playerid/name]");

        if (targetid == INVALID_PLAYER_ID || !IsPlayerNearPlayer(playerid, targetid, 5.0))
            return SendErrorMessage(playerid, "That player is disconnected or not near you.");

        if(PlayerInfo[targetid][pRaceWith] != INVALID_PLAYER_ID)
            return SendErrorMessage(playerid, "That player is already in any Race's!");

        if(PlayerInfo[targetid][pRaceWith] == playerid)
            return SendErrorMessage(playerid, "That player is already in your race!");

        PlayerInfo[targetid][pRaceWith] = playerid;
        SendServerMessage(playerid, "You've invite %s to join your race!", ReturnName(targetid));
        SendServerMessage(targetid, "You've been invited by %s to join their race!", ReturnName(playerid));
    }
    else if(!strcmp(type, "start", true))
    {
        if(RaceData[playerid][racePos1][0] == 0.0)
            return SendErrorMessage(playerid, "You must record your CP's first!");

        if(RaceData[playerid][racePos2][0] == 0.0)
            return SendErrorMessage(playerid, "You must record your CP's first!");

        if(RaceData[playerid][racePos3][0] == 0.0)
            return SendErrorMessage(playerid, "You must record your CP's first!");

        if(RaceData[playerid][racePos4][0] == 0.0)
            return SendErrorMessage(playerid, "You must record your CP's first!");

        if(RaceData[playerid][racePos5][0] == 0.0)
            return SendErrorMessage(playerid, "You must record your CP's first!");

        if(RaceData[playerid][raceFinish][0] == 0.0)
            return SendErrorMessage(playerid, "You must record your Finish CP's first!");

        foreach(new i : Player) if(PlayerInfo[i][pRaceWith] == playerid)
        {
            SetRaceCP(i, 2, RaceData[PlayerInfo[i][pRaceWith]][racePos1][0], RaceData[PlayerInfo[i][pRaceWith]][racePos1][1], RaceData[PlayerInfo[i][pRaceWith]][racePos1][2], 5.0);
            PlayerInfo[i][pRaceIndex] = 1;
            GameTextForPlayer(i, "Race Started!", 3000, 5);
        }
    }
    return 1;
}
forward RadioBroadCast(playerid, color, string[]);
public RadioBroadCast(playerid, color, string[])
{
    new MiscString[128]; //Float: aaaPositions[3];
    foreach(new i : Player)
    {
        if(pData[i][pRadioFreq] == pData[playerid][pRadioFreq] )
        {
            //GetPlayerPos(i, aaaPositions[0], aaaPositions[1], aaaPositions[2]);
            //SendClientMessageEx(i, COLOR_LIME, "[WT] "WHITE_E"%s has joined in to this channel!", GetPlayerNameEx(playerid));
            format(MiscString, sizeof(MiscString), "[WT:%d] {75AE5D}%s : %s", pData[playerid][pRadioFreq], ReturnName(playerid), string);
            SendClientMessageEx(i, COLOR_YELLOW, MiscString);
            format(MiscString, sizeof(MiscString), "[<WT>]\n%s", string);
            SetPlayerChatBubble(i,MiscString,0x75AE5D00,15.0,5000);
        }
    }
}

CMD:wt(playerid, params[])
{
    if(PlayerInfo[playerid][pInjured] >= 1) return 1;
    if(pData[playerid][pRadio] == 0)
    {
        if(isnull(params))
        {
            Send(playerid, COLOR_WHITE, "{B0C4DE}SYNTAX:{FFFFFF} /wt [chat]");
            Send(playerid, COLOR_WHITE, "[Hint] Type /setfreq to set the frequency of your portable radio.");
            return 1;
        }

        if(pData[playerid][pRadioFreq] >= 1 || pData[playerid][pRadioFreq] <= -1)
        {
            RadioBroadCast(playerid, COLOR_GREY, params);
            return 1;
        }
        else
        {
            Send(playerid, COLOR_WHITE, "The frequency of your radio is set to 0, you can not broadcast over that frequency.");
        }
    }
    return 1;
}
CMD:togwt(playerid)
{
    switch(PlayerData[playerid][pRadioFreq])
    {
        case 0:
        {
            pData[playerid][pRadioFreq] = 1;
            Info(playerid, "Anda Berhasil Menyalakan Walkie Talkie");
        }
        case 1:
        {
            pData[playerid][pRadioFreq] = 0;
            Info(playerid, "Anda Berhasil Mematikan Walkie Talkie");
        }
    }
    return 1;
}
