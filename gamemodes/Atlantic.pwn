   						rent_job_vehicle[playerid] = vehid;
   						pTemp[playerid][pPilot] = 1;
       				}
       				else if(GetVehicleModel(vehid) == 519) {
   						pTemp[playerid][pPilot_Access] = true;
   						rent_job_vehicle[playerid] = vehid;
   						pTemp[playerid][pPilot] = random(2)+2;	// Rute Penerbangan Acak
       				}
                    if(pTemp[playerid][pPilot_Access]) {
						switch(pTemp[playerid][pPilot])	{
							case 1:
							{
								if(PlayerInfo[playerid][pCash] < strval(PRICE_BEAGLE))
								{
			   						SendClientMessage(playerid, -1, !"Anda tidak punya cukup uang untuk menyewa pesawat!");
			   						Pilot_StopJob(playerid);
		   						}
			   					else
				   				{
			   						pTemp[playerid][pPilot_Access] = false;
			   						// Anda harus menambahkan baris yang sama:
						   			PlayerInfo[playerid][pCash] -= strval(PRICE_BEAGLE);
						   			OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
									//GivePlayerMoney(playerid, -strval(PRICE_BEAGLE));
									SendClientMessage(playerid, -1, !"[Dispatcher]: Mulailah perjalanan Anda di sepanjang rute");

									SetPlayerRaceCheckpoint(playerid,
										checkpoints_beagle[pTemp[playerid][pPilot_Checkpoint]][typepoint],
										checkpoints_beagle[pTemp[playerid][pPilot_Checkpoint]][check_X],
										checkpoints_beagle[pTemp[playerid][pPilot_Checkpoint]][check_Y],
										checkpoints_beagle[pTemp[playerid][pPilot_Checkpoint]][check_Z],
