		}
	}
	return 1;
}*/
CMD:wanted(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	new sctring[128];
	String = "";

    foreach(new i : Player)
	{
		if(PlayerInfo[i][pWanted] == 0) continue;

	    if(PlayerInfo[i][pWanted] > 4)
		{
		    //String = "{FF8300}Daftar orang yang dicari oleh Federal:"W"\n\n";
	    	format(sctring, 128, ""W"%s[%d]\t\t|\t"W"Tingkat yang diinginkan: {FF8300}%i\n",Name(i), i, PlayerInfo[i][pWanted]);
	    	strcat(String,sctring);
	    }
	    else
	    {
	        format(sctring, 128, ""W"%s[%d]\t\t|\t"W"Tingkat yang diinginkan: {FF8300}%i\n",Name(i), i, PlayerInfo[i][pWanted]);
	    	strcat(String,sctring);
		}
   	}
	if(strlen(sctring) > 1)
	{
		SPD(playerid, 0, DIALOG_STYLE_MSGBOX, ""W"Dicari", String, "Tutup", "");
		MeAction(playerid,"mengeluarkan dan membuka PDA");
	 	MeAction(playerid,"login ke database yang diinginkan");
	}
	else Send(playerid, 0xB4B5B7FF,"Tidak ada orang yang dicari di staf.");
	return 1;
}
CMD:arrest(playerid, params[])
{
    if(!IsACop(playerid)) return 1;
	if(sscanf(params, "u",params[0],params[1])) return Send(playerid, -1,"Masuk: /arrest [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(!ProxDetectorS(4.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Pemain tidak di dekat Anda");
	if(PlayerInfo[params[0]][pWanted] < 1) return Send(playerid, COLOR_GREY,"Orang ini tidak diinginkan");

	new place = 0;
	new time = (PlayerInfo[params[0]][pWanted]*10)*60;

	if(PlayerCuffed[params[0]])
	{
		GameTextForPlayer(params[0],"~g~uncuffed", 5000, 3);
		if(IsPlayerAttachedObjectSlotUsed(params[0], 8)) RemovePlayerAttachedObject(params[0], 8);
		SetPlayerSpecialAction(params[0], 0);
		PlayerCuffed[params[0]] = 0;
	}
	if(PlayerToPoint(15.0, playerid, 714.97, -91.12, 21.68)) //LSPD
	{
		SetPPos(params[0], 706.3516,-104.2773,21.6811, 0.0, 6, 1, false);
		place = 1;
	}
	else if(PlayerToPoint(15.0, playerid, 200.3945,158.2982,1003.0234) && GetPlayerInterior(playerid) == 3 && GetPlayerVirtualWorld(playerid) == 2) // FBI
	{
		SetPPos(params[0],198.4545,161.8394,1003.0300, 0.0, 3, 2, false);
		place = 2;
	}
	else if(PlayerToPoint(15.0, playerid, 217.0850,120.8270,999.0156) && GetPlayerInterior(playerid) == 10 && GetPlayerVirtualWorld(playerid) == 2) //SFPD
	{
		SetPPos(params[0], 219.2213,109.6325,999.0156,100.2528, 10, 2, false);
		place = 3;
	}
	else if(PlayerToPoint(15.0, playerid, 200.2648,158.2574,1003.0234) && GetPlayerInterior(playerid) == 3 && GetPlayerVirtualWorld(playerid) == 8) //LVPD
	{
		SetPPos(params[0], 198.4545,161.8394,1003.0300, 0.0, 3, 8, false);
		place = 4;
	}
	else return Send(playerid, COLOR_GREY,"Anda harus berada di dekat sel-sel penahanan.");

	SetPlayerPrison(params[0], place, time);

	ResetWeapons(params[0]);
	TogglePlayerControllableEx(params[0], 1);

	SCMF(playerid, 0xFFFF00FF, "Anda menanam %s[%d] pada %d detik", Name(params[0]), params[0], time);
    SCMF(params[0], 0xFFFF00FF, "%s[%d] menanam Anda %d detik", Name(playerid), playerid, time);
	GivePlayerPayCheck(playerid, 300);
	PlayerInfo[params[0]][pWanted] = 0;
	PlayerCuffed[params[0]] = 0;
	if(follow_id[params[0]] != INVALID_PLAYER_ID)
	{
		ClearAnimations(params[0], true);
        follow_id[params[0]] = INVALID_PLAYER_ID;
	}
	MeAction(playerid,"memborgol seorang tersangka");
	MeAction(playerid,"mengirim penjahat ke bullpen");
	return 1;
}

CMD:offmute(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "is[32]",params[0],params[1])) return Send(playerid, -1,"Masuk: /offmute [menit] [nama panggilan]");

    if(params[0] > 180 || params[0] < 10) return Send(playerid, COLOR_GREY, "Anda tidak dapat menentukan nilai lebih dari 180 menit atau kurang dari 10 menit.");

    if(Getplayerid(params[1]) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain online.");

    if(GetPlayerAdminBySql(params[1])) return SCM(playerid, COLOR_GREY, "Pemain ini adalah admin.");

	mysql_format(mMysql, format_string, 144, "SELECT `pID`, `pMuted` FROM `accounts` WHERE `pName` = '%e' LIMIT 1", params[1]);
	new Cache: result = mysql_query(mMysql, format_string);

	if(cache_num_rows() == 0) return SCMF(playerid, COLOR_GREY, "Pemain %s tidak ditemukan.", params[1]);

    new seconds, sql_id;
	cache_get_value_name_int(0, "pID", sql_id);
    cache_get_value_name_int(0, "pMuted", seconds);

	cache_delete(result);

	if(seconds) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki mut.");

    PlayerInfo[playerid][pAdmMute]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmMute", PlayerInfo[playerid][pAdmMute]);

    format(format_string, 144, "Administrator %s memberi Anda larangan ngobrol di %i min.", GetPlayerNameEx(playerid), params[0]);
    AddPlayerNotifyBySQL(sql_id, format_string);

	format(format_string, 144, "[A][OFFLINE] Administrator %s[%d] mengeluarkan larangan ngobrol %s pada %d menit.", Name(playerid), playerid, params[1], params[0]);
	SendAdminMessage(COLOR_GREY, format_string);
	AddAdminLog(playerid, format_string);

	format(format_string, 144, "UPDATE `accounts` SET `pMuted` = %i WHERE `pName` = '%s'", params[0] * 60, params[1]);
	mysql_tquery(mMysql, format_string);

	return 1;
}

CMD:offjail(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "is[32]",params[0],params[1])) return Send(playerid, -1,"Masuk: /offjail [menit] [nama panggilan]");

    if(params[0] > 300 || params[0] < 10) return Send(playerid, COLOR_GREY, "Anda tidak dapat menentukan nilai lebih dari 300 menit atau kurang dari 10 menit.");

    if(Getplayerid(params[1]) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sedang online.");

	if(GetPlayerAdminBySql(params[1])) return SCM(playerid, COLOR_GREY, "Pemain ini adalah admin.");

	mysql_format(mMysql, format_string, 144, "SELECT `pID`, `pPrison` FROM `accounts` WHERE `pName` = '%e' LIMIT 1", params[1]);
	new Cache: result = mysql_query(mMysql, format_string);

	if(cache_num_rows() == 0) return SCMF(playerid, COLOR_GREY, "Pemain %s tidak ditemukan.", params[1]);

    new seconds, sql_id;

    cache_get_value_name_int(0, "pID", sql_id);
	cache_get_value_name_int(0, "pPrison", seconds);

	cache_delete(result);

	if(seconds) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki kesimpulan.");

    format(format_string, 144, "Administrator %s menempatkanmu %i min.", GetPlayerNameEx(playerid), params[0]);
    AddPlayerNotifyBySQL(sql_id, format_string);

    PlayerInfo[playerid][pAdmPrison]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmPrison", PlayerInfo[playerid][pAdmPrison]);

	format(format_string, 144, "[A][OFFLINE] Administrator %s[%d] ditanam %s pada %d menit.", Name(playerid), playerid, params[1], params[0]);
	SendAdminMessage(COLOR_GREY, format_string);
	AddAdminLog(playerid, format_string);

	format(format_string, 144, "UPDATE `accounts` SET `pPrison` = %i, `pMestoPrison` = 0 WHERE `pName` = '%s'", params[0] * 60, params[1]);
	mysql_tquery(mMysql, format_string);

	return 1;
}

CMD:unmute(playerid, params[])
{
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /unmute [playerid]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
 	if(params[0] == playerid) return SCM(playerid, COLOR_GREY, "Anda telah memasukkan ID Anda");

	if(PlayerInfo[params[0]][pMuted] == 0) return SCM(playerid, COLOR_GREY, "Pemain tidak memiliki lelucon.");

	PlayerInfo[params[0]][pMuted] = 0;
	format(format_string, 96, "Administrator %s[%d] menghapus larangan ngobrol dari pemain %s[%d]", Name(playerid), playerid, Name(params[0]), params[0]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);


	return 1;
}

CMD:mute(playerid, params[])
{
//    if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "uds[32]",params[0],params[1],params[2])) return Send(playerid, -1,"Masuk: /mute [playerid] [menit] [alasan]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
 	if(params[0] == playerid) return SCM(playerid, COLOR_GREY, "Anda telah memasukkan ID Anda");

	if(PlayerInfo[params[0]][pMuted] > 0)
	{
		PlayerInfo[params[0]][pMuted] = 0;
		format(format_string, 96, "Administrator %s[%d] menghapus larangan ngobrol dari pemain %s[%d]", Name(playerid), playerid, Name(params[0]), params[0]);
		SendClientMessageToAll(COLOR_LIGHTRED, format_string);
    	format(String, sizeof(String), "~y~<CMD> ~w~%s[%d] unmuted player %s[%d]", Name(playerid), playerid, Name(params[0]), params[0]);
   		SendAdminMessage(COLOR_RED, String);
    	return 1;
	}
	if(params[1] > 180 || params[1] < 10) return Send(playerid, COLOR_GREY, "Anda tidak dapat menentukan nilai lebih dari 180 menit atau kurang dari 10 menit.");

    if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat memblokir administrator atas / sama di tingkat.");

	PlayerInfo[playerid][pAdmMute]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmMute", PlayerInfo[playerid][pAdmMute]);

	PlayerInfo[params[0]][pMuted] = params[1]*60;
	format(format_string, 144, "Administrator %s mengeluarkan larangan ngobrol %s[%d] pada %d menit. Alasan: %s", PlayerInfo[playerid][pAname], Name(params[0]), params[0], params[1], params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);

	return 1;
}
CMD:eject(playerid, params[])
{
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return Send(playerid,COLOR_GREY,"Anda harus mengendarai mobil.");
	if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Masuk: /eject [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return SendClientMessage(playerid, -1,"Pemain AFC ini.");//+
	if(params[0] == playerid || !IsPlayerInVehicle(params[0],GetPlayerVehicleID(playerid))) return 1;

	SCMF(params[0], 0x6BB3FFAA, "%s[%d] menendangmu keluar dari mobil", Name(playerid), playerid);
    SCMF(playerid, 0x6BB3FFAA, "Kamu melempar %s[%d] keluar dari mobil", Name(params[0]), params[0]);
	RemovePlayerFromVehicleEx(params[0]);
	return 1;
}
CMD:settime(playerid, params[])
{
    if(admin_level[playerid] < 2) return true;
	if(sscanf(params, "d", params[0])) return Send(playerid, 0xafafafff, "/settime [0-24]");
	if(params[0] < 0 || params[0] > 24) return Send(playerid, -1, "Waktu dalam sehari hanya dapat diatur dari 0 hingga 24");
	SetWorldTime(params[0]);
	format(format_string, sizeof(format_string), "[A]: Administrator %s[%d] mengubah waktu hari",Name(playerid), params[0]);
	SendAdminMessage(COLOR_GREY, format_string);
	return true;
}
CMD:heal(playerid, params[])
{
    if(!IsAMedic(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
    if(PlayerInfo[playerid][pMember] != form_fraction[playerid]) return SCM(playerid, COLOR_GREY, "Anda tidak memulai hari kerja.");
	if(sscanf(params, "dd",params[0],params[1])) return Send(playerid, -1, "Masuk: /heal [id] [harga]");
	if(params[1] < 50 || params[1] > 100000) return Send(playerid,0xafafafff,"Anda tidak boleh menetapkan kurang dari $50 dan lebih dari $100k");
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"[Kesalahan] Anda menunjukkan ID");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid, COLOR_GRAD1, "Kamu terlalu jauh.");
	//if(!PlayerToPoint(55.0,playerid,-628.1243,-922.2409,1436.8002)) return SCM(playerid, COLOR_GREY, "Hanya tersedia di rumah sakit.");

	format(format_string,sizeof(format_string), "{ffffff}%s %s[%i] menawarkan perawatan cepat untuk Anda %d$\n\n\tApakah kamu setuju?",FracRank[PlayerInfo[playerid][pMember]][PlayerInfo[playerid][pRank]],Name(playerid),playerid,params[1]);
	SPD(params[0],221,DIALOG_STYLE_MSGBOX, "Perawatan", format_string, "Ya", "Tidak");
	HealOffer[params[0]] = playerid;
	HealPrice[params[0]] = params[1];
	format(format_string,128,"Anda menyarankan {27C400}%s{ffffff} perawatan cepat untuk {27C400}%d${ffffff}",Name(params[0]),params[1]);
	Send(playerid, -1, format_string);

	return 1;
}
CMD:ad(playerid, params[])
{
	if(PlayerInfo[playerid][pLogin] == 0) return true;
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(PlayerInfo[playerid][pLevel] < 2) return Send(playerid, COLOR_GREY, "Iklan dapat dikirimkan memiliki 2 level permainan!");
	if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki ponsel.");
	if(advert_block[playerid] > gettime()) return SCM(playerid,COLOR_GREY,"Tidak satu menit berlalu dari iklan yang terakhir dikirim");
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, 2239.90, -1115.21, 1054.45)) return SendClientMessage(playerid, 0xCECECEFF, "Anda harus di Kantor San News");
	//if(lNews[playerid] == 1) return Send(playerid, -1, "Nyalakan radio terlebih dahulu");
	if(sscanf(params, "s[120]", params[0])) return Send(playerid, -1, "Masuk: /ad [teks]");
	if(strlen(params[0]) < 1 || strlen(params[0]) > 100) return SendClientMessage(playerid, 0xB4B5B7FF,"Hanya boleh lebih dari 1 dan kurang dari 100 karakter");
	if(strfind(params[0], "{", true) != -1) return Send(playerid,-1,"Anda memasukkan tanda larangan! ( { )");
	if(PlayerInfo[playerid][pSummaNumber] < 200) return Send(playerid, -1, "Tidak cukup uang di saldo ponsel Anda!");

	for(new i; i<MAX_ADVERTS; i++)
	{
		if(AdvertInfo[i][aName]!=0) continue;

		format(AdvertInfo[i][aName],24,GN(playerid));
		format(AdvertInfo[i][aText],128,params[0]);
		AdvertInfo[i][aNumber]=PlayerInfo[playerid][pNumber];
		PlayerInfo[playerid][pSummaNumber] -= 200;
		format(format_string,80,"[SA News] Para editor menerima pengumuman dari {FFFFFF}%s[%d]",GN(playerid),playerid);
		SendFrac(6,COLOR_GREEN,format_string);

		advert_block[playerid] = gettime() + 60;

		SCM(playerid, COLOR_WHITE, "Iklan Anda telah dikirim untuk ditinjau, telepon Anda telah dibebankan biaya: $200");
		return SCM(playerid, COLOR_GREEN, "Tunggu, sementara staf editorial sedang mengeditnya!");
	}
	return SCM(playerid,COLOR_GREY,"Studio memiliki banyak iklan, tunggu, sementara mereka dilihat");
}

CMD:npanel(playerid)
{
    if(PlayerInfo[playerid][pMember] != FRACTION_NEWS) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk karyawan BERITA.");

	if(PlayerInfo[playerid][pRank] < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari peringkat 2.");

    if(!form_fraction[playerid]) return Send(playerid,COLOR_GREY,"Anda tidak memulai hari kerja!");

	new vehicleid = GetPlayerVehicleID(playerid);

    if(PlayerToPoint(25.0, playerid, 2243.68, -1098.06, 1060.76) ||
		vehicleid != INVALID_VEHICLE_ID && VehInfo[vehicleid][vFr] == FRACTION_NEWS)
	{
	    format(format_string, 144, "- %s eter\n- Undang seorang tamu\n- Usir Tamu", !player_news_live[playerid] ? ("Mulai") : ("Sampai selesai"));
	    return SPD(playerid, 3723, DIALOG_STYLE_LIST, "Menu berita", format_string, "Pilih", "Tutup");
	}

	return SCM(playerid, COLOR_GREY, "Apakah Anda jauh dari pusat siaran atau tidak dalam transportasi BERITA.");
}

CMD:edit(playerid)
{
    if(PlayerInfo[playerid][pMember] != FRACTION_NEWS) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk karyawan BERITA.");
	if(PlayerInfo[playerid][pRank] < 2) return Send(playerid,0xafafafff,"Dimungkinkan untuk mengedit pengumuman dari pos 'Insinyur radio'");
	if(form_fraction[playerid] == 0) return Send(playerid,COLOR_GREY,"Anda tidak memulai hari kerja!");
    AdvertList(playerid);
    return true;
}
CMD:free(playerid, params[])
{
    if(PlayerInfo[playerid][pMember] != FRACTION_MAYOR && PlayerInfo[playerid][pRank] != 4) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
    if(form_fraction[playerid] == 0) return Send(playerid,COLOR_GREY,"Anda harus siap!");
    if(sscanf(params, "dd",params[0],params[1])) return Send(playerid, -1, "Masuk: /free [id] [harga (dari 5.000 sebelumnya 10.000$)]");
    if(params[1] < 5000 || params[1] > 10000) return Send(playerid, COLOR_GREY, "Harga mungkin tidak lebih rendah 5.000 dan lebih tinggi 10.000!");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain AFC ini.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(10.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");
	if(IsACop(params[0])) return Send(playerid, COLOR_GREY,"Anda tidak dapat menggunakan pada legalis.");
	if(PlayerInfo[params[0]][pPrison] < 0) return Send(playerid, COLOR_GREY, "Pemain tidak di penjara!");
	format(format_string, sizeof(format_string), "{ffffff}Pengacara %s[%i] mengundang Anda untuk dibebaskan $%i\n\n\tKamu setuju?", Name(playerid),playerid,params[1]);
	SPD(params[0], 220, DIALOG_STYLE_MSGBOX, " ",format_string, "Ya", "Tolak");
	//SendClientMessage(playerid,-1,"Anda menyarankan %s pergi gratis %i",Name(params[0]),params[1]);
	FreeOffer[params[0]] = playerid;
	FreePrice[params[0]] = params[1];
    return true;
}
CMD:prison(playerid, params[])
{
    if(admin_level[playerid] < 2) return true;
	if(sscanf(params, "dds[24]",params[0],params[1],params[2])) return Send(playerid, -1, "Masuk: /prison [id] [menit] [alasan]");
 	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(params[1] > 300) return Send(playerid,COLOR_GREY,"Tidak dapat ditanam lebih dari 300 menit (5 jam)");

	if(PlayerCuffed[params[0]])
	{
		GameTextForPlayer(params[0],"~g~uncuffed", 5000, 3);
		if(IsPlayerAttachedObjectSlotUsed(params[0], 8)) RemovePlayerAttachedObject(params[0], 8);
		SetPlayerSpecialAction(params[0],0), PlayerCuffed[params[0]] = 0;
		PlayerCuffed[params[0]] = 0;
	}
	if(params[1] <= 0)
	{
	    format(String, sizeof(String), "~y~<CMD> ~w~%s[%d] unjailed player %s[%d]", Name(playerid), playerid, Name(params[0]), params[0]);
    	SendAdminMessage(COLOR_RED, String);
	    PlayerInfo[params[0]][pPrison] = 0;
	    PlayerInfo[params[0]][pMestoPrison] = 0;
	    SetPlayerHealth(params[0], 100.0);
	    return SpawnPlayerEx(params[0]);
 	}

	PlayerInfo[playerid][pAdmPrison] ++;
	OnPlayerUpdateAdminPer(playerid, "pAdmPrison", PlayerInfo[playerid][pAdmPrison]);

	SetPlayerPrison(params[0], 5, params[1]*60);

 	t_SetPlayerPos(params[0], 3518.8623,1075.6036,17.1577), SetPlayerFacingAngle(params[0], 90.7966);
 	SetPlayerVirtualWorld(params[0], 1), SetPlayerInterior(params[0], 0);
	SetCameraBehindPlayer(params[0]);

	format(format_string, sizeof(format_string), "Administrator %s[%d] menempatkan pemain %s[%d] di demorgan on %d min. Alasan: %s", Name(playerid), playerid, Name(params[0]), params[0], params[1], params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);
    format(String, sizeof(String), "~y~<CMD> ~w~%s[%d] put in jail player %s[%d] for %d min", Name(playerid), playerid, Name(params[0]), params[0], params[1]);
   	SendAdminMessage(COLOR_RED, String);
	return 1;
}

CMD:unjail(playerid, params[])
{
//    if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
	if(admin_level[playerid] < 2) return 1;
    if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /unjail [id]");
 	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;

	//if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat memblokir administrator atas/sama di tingkat.");

	if(!PlayerInfo[params[0]][pPrison]) return SCM(playerid, COLOR_GREY, "Pemain tidak menyimpulkan.");

    PlayerInfo[params[0]][pPrison] = 0;
    PlayerInfo[params[0]][pMestoPrison] = 0;
    SpawnPlayerEx(params[0]);

	SCMF(params[0], -1, "Administrator %s menarikmu keluar dari penjara.", GetPlayerNameEx(playerid));

    format(format_string, sizeof(format_string), "[A] Administrator %s[%d] dibebaskan %s dari penjara.", Name(playerid), playerid, Name(params[0]));
	SendAdminMessage(COLOR_GREY, format_string);
	AddAdminLog(playerid, format_string);

	return true;
}

CMD:jail(playerid, params[])
{
	if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
	if(admin_level[playerid] < 2) return 1;
    if(sscanf(params, "dds[24]",params[0],params[1],params[2])) return Send(playerid, -1, "Masuk: /jail [id] [menit] [alasan]");
 	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(params[1] > 300) return Send(playerid,COLOR_GREY,"Tidak dapat ditanam lebih dari 300 menit (5 jam)");
	//if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat memblokir administrator atas/sama di tingkat.");

	if(PlayerCuffed[params[0]])
	{
		GameTextForPlayer(params[0],"~g~uncuffed", 5000, 3);
		if(IsPlayerAttachedObjectSlotUsed(params[0], 8)) RemovePlayerAttachedObject(params[0], 8);
		SetPlayerSpecialAction(params[0],0), PlayerCuffed[params[0]] = 0;
		PlayerCuffed[params[0]] = 0;
	}
	if(params[1] <= 0)
	{
	    PlayerInfo[params[0]][pPrison] = 0;
	    PlayerInfo[params[0]][pMestoPrison] = 0;
	    return SpawnPlayerEx(params[0]);
 	}
    t_SetPlayerPos(params[0], 704.2828,-107.0174,21.6811);
	SetPlayerInterior(params[0], 0), SetPlayerVirtualWorld(params[0], 0);

    PlayerInfo[playerid][pAdmPrison]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmPrison", PlayerInfo[playerid][pAdmPrison]);

	SetPlayerPrison(params[0], 1, params[1] * 60);

	SetPlayerWantedLevel(params[0], 0);
	ResetWeapons(params[0]);
	TogglePlayerControllableEx(params[0], 1);

    format(format_string, sizeof(format_string), "Administrator %s[%d] menempatkan pemain %s[%d] masuk penjara %d min. Alasan: %s", PlayerInfo[playerid][pAname], playerid, Name(params[0]), params[0], params[1], params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);

	PlayerInfo[params[0]][pWanted] = 0;

	return true;
}

CMD:giveheal(playerid,params[])
{
    if(sscanf(params,"ui",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/giveheal [id pemain] [jumlah]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;

	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain AFC ini.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(!(1 <= params[1] <= 2)) return SCM(playerid, COLOR_GREY, "Dari 1 hingga 2.");

	if(PlayerInfo[playerid][pHeals] < params[1]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki begitu banyak kotak P3K.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_GIVEHEALS, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s ambil kit P3K dari Anda: %i", GetPlayerNameEx(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s menawarkan (a) Anda untuk mengambil peralatan P3K darinya: %i", GetPlayerNameEx(playerid), params[1]);

    return SCM(params[0], -1, "Untuk menyetujui, Tekan Y (/accept) atau untuk penolakan ketik(/cancel)");
}

CMD:givemask(playerid,params[])
{
    if(sscanf(params,"ui",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/givemask [id pemain] [jumlah]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;

	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain AFC ini.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(!(1 <= params[1] <= 2)) return SCM(playerid, COLOR_GREY, "Dari 1 hingga 2.");

	if(PlayerInfo[playerid][pMask] < params[1]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki begitu banyak topeng.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_GIVEMASK, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s ambil topeng darimu: %i", GetPlayerNameEx(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s mengundang Anda untuk mengambil topeng darinya: %i", GetPlayerNameEx(playerid), params[1]);

    return SCM(params[0], -1, "Untuk menyetujui, klik Y(/accept) atau untuk penolakan N(/cancel)");
}
CMD:givepart(playerid,params[])
{
    if(sscanf(params,"ui",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/givepart [id pemain] [jumlah]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;

	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini ada di AFK.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(!(1 <= params[1] <= 500)) return SCM(playerid, COLOR_GREY, "1 hingga 500.");

	if(PlayerInfo[playerid][pPatron] < params[1]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki begitu banyak kartrid.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_GIVEPATR, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s ambil kartrid dari Anda: %i", GetPlayerNameEx(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s mengundang Anda untuk mengambil kartrid darinya: %i", GetPlayerNameEx(playerid), params[1]);

    return SCM(params[0], -1, "Untuk menyetujui, Tekan Y (/accept) atau untuk penolakan ketik(/cancel)");
}

CMD:givemetall(playerid,params[])
{
    if(sscanf(params,"ui",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/givemetall [id pemain] [jumlah]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;

	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(!(1 <= params[1] <= 500)) return SCM(playerid, COLOR_GREY, "Dari 1 hingga 500.");

	if(PlayerInfo[playerid][pMetall] < params[1]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki banyak unit. senjata.");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_GIVEMETALL, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s ambil darimu logam: %i", GetPlayerNameEx(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s menyarankan Anda untuk mengambil logam dari dia. jumlah: %i", GetPlayerNameEx(playerid), params[1]);

    return SCM(params[0], -1, "Untuk menyetujui, Tekan Y (/accept) atau untuk penolakan ketik(/cancel)");
}

CMD:sellskin(playerid,params[])
{
	if(!PlayerToPoint(50.0, playerid, 1292.1204,-1868.7453,13.6328)) return SCM(playerid, COLOR_GREY, "Anda tidak di toko baju.");

	if(GetPlayerSkin(playerid) != PlayerInfo[playerid][pSkin]) return SCM(playerid, COLOR_GREY, "Anda tidak mengenakan pakaian dasar.");

    if(sscanf(params,"ii",params[0], params[1])) return SendClientMessage(playerid, 0xafafafff, "/sellskin [id pemain] [jumlahnya]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	//if(IsACop(params[0])) return SendClientMessage(playerid,0xafafafff,"Pemain polisi");
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakannya untuk diri sendiri.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(GetPlayerSkin(params[0]) != PlayerInfo[params[0]][pSkin]) return SCM(playerid, COLOR_GREY, "Pemain tidak memakai pakaian dasar.");

	if(!(1 <= params[1] <= 1000000)) return SCM(playerid, COLOR_GREY, "Jumlah yang tersedia dari 1 hingga $1.000.000");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_SELLSKIN, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s pertukaran pakaian dengan biaya tambahan: $%i", GetPlayerNameEx(params[0]), params[1]);
	SCMF(params[0], 0x6BB3FFAA, "%s menawarkan (a) pertukaran pakaian dengan biaya tambahan Anda: $%i", GetPlayerNameEx(playerid), params[1]);

    return SCM(params[0], -1, "Untuk menyetujui, Tekan Y (/accept) atau untuk penolakan ketik(/cancel)");
}

CMD:ticket(playerid,params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Status hanya tersedia. struktur.");

    if(sscanf(params,"iis[64]",params[0], params[1], params[2])) return SendClientMessage(playerid, 0xafafafff, "/ticket [id pemain] [jumlahnya] [alasan]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	//if(IsACop(params[0])) return SendClientMessage(playerid,0xafafafff,"Pemain polisi");
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menempatkan diri di borgol.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

	if(!(1 <= params[1] <= 50000)) return SCM(playerid, COLOR_GREY, "Jumlah yang tersedia dari 1 hingga $50.000");

	if(GetPlayerOfferInfo(params[0], O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

    SendPlayerOffer(playerid, params[0], OFFER_TYPE_TICKET, params[1]);

	SCMF(playerid, 0x6BB3FFAA, "Anda telah menulis denda %s dalam jumlah $%i. Alasan: %s", GetPlayerNameEx(params[0]), params[1], params[2]);
	SCMF(params[0], 0x6BB3FFAA, "%s menulis denda $%i. Alasan: %s", GetPlayerNameEx(playerid), params[1], params[2]);

    return SCM(params[0], -1, "Untuk menyetujui, Tekan Y (/accept) atau untuk penolakan ketik(/cancel)");
}

CMD:gt(playerid,params[])
{
    if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Status hanya tersedia. struktur.");

    if(sscanf(params,"i",params[0])) return SendClientMessage(playerid, 0xafafafff, "/gotome [id pemain]");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid,0xafafafff, "Pemain offline");
	if(IsACop(params[0])) return SendClientMessage(playerid,0xafafafff,"Pemain polisi");
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain AFC ini.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menempatkan diri di borgol.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");
	if(IsACop(params[0])) return Send(playerid, COLOR_GREY,"Anda tidak dapat memborgol seorang legalis.");
	if(!PlayerCuffed[params[0]]) return Send(playerid, COLOR_GREY,"Pemain tidak diborgol");
	if(!PlayerInfo[params[0]][pWanted]) return Send(playerid, COLOR_GREY,"Manusia bukan penjahat");
	if(GetPlayerState(params[0]) != PLAYER_STATE_ONFOOT) return SCM(playerid, COLOR_GREY, "Pemain ini tidak berjalan kaki.");

    if(follow_id[params[0]] != INVALID_PLAYER_ID)
	{
		ClearAnimations(params[0], true);
        follow_id[params[0]] = INVALID_PLAYER_ID;
        SCM(playerid, COLOR_BLUE, "Anda telah menonaktifkan berjalan untuk pemain.");
	}
	else
	{
		follow_id[params[0]] = playerid;

		SCMF(playerid,-1,"Anda mulai menahan pemain: {FF7F50}%s[%d]", Name(params[0]),params[0]);
		SendClientMessage(playerid,-1,"Gunakan {FF7F50}/gt{ffffff} sekali lagi untuk membatalkan penangkapan");

		MeAction(playerid,"ambil(tapi) tangan kriminal");
		MeAction(playerid,"pakai(tapi) borgol pada penjahat");
		MeAction(playerid,"dipimpin(tapi) penjahat di belakangnya");
		SPD(params[0], 0, DIALOG_STYLE_MSGBOX, "{E5D81E}Perhatian!", ""W"Anda dinetralkan\nSeorang polisi telah memulai penahanan Anda!", "Tutup", "");
	}
	return 1;
}
CMD:cuff(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
	if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Masuk: /cuff [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum masuk. ");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menempatkan diri di borgol.");
 	if(IsPlayerInAnyVehicle(playerid)) return Send(playerid,COLOR_GREY,"Keluar dari mobil");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");
	if(IsACop(params[0])) return Send(playerid, COLOR_GREY,"Anda tidak dapat memborgol seorang legalis.");
	if(PlayerCuffed[params[0]]) return Send(playerid, COLOR_GREY,"Pemain sudah diborgol");
	if(!PlayerInfo[params[0]][pWanted]) return Send(playerid, COLOR_GREY,"Manusia bukan penjahat");
	if(PlayerInfo[params[0]][pPrison] > 0) return Send(playerid, COLOR_GREY, "Pemain itu ada di penjara");

    TogglePlayerControllable(params[0], false);

	if(GetPVarInt(params[0], "fTazzer"))
	{
		KillTimer(timer_tazer[params[0]]);
		DeletePVar(params[0], "fTazzer");
	}
	SCMF(params[0], 0xEAC700FF, "%s memborgol kamu", Name(playerid));
	SCMF(playerid, 0xEAC700FF, "Anda diborgol terus %s", Name(params[0]));
	GameTextForPlayer(params[0],"~r~cuffed", 5000, 3);
	SetPlayerAttachedObject(params[0], 8, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000);
	SetPlayerSpecialAction(params[0],SPECIAL_ACTION_CUFFED);
	TogglePlayerControllableEx(params[0], 0);
	PlayerCuffed[params[0]] = 1;
	return 1;
}
CMD:uncuff(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /uncuff [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"ID Pemain tidak valid");
	if(!PlayerCuffed[params[0]]) return Send(playerid, COLOR_GREY,"Pemain yang diborgol");
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");

    TogglePlayerControllable(params[0], true);

	GameTextForPlayer(params[0],"~g~uncuffed", 5000, 3);
	SCMF(playerid, 0xEAC700FF, "Anda melepaskan borgol dari %s", Name(params[0]));
	if(IsPlayerAttachedObjectSlotUsed(params[0], 8)) RemovePlayerAttachedObject(params[0], 8);
	SetPlayerSpecialAction(params[0], 0);
	TogglePlayerControllableEx(params[0], 1);
	PlayerCuffed[params[0]] = 0;
	return 1;
}

alias:megaphone("m");
CMD:megaphone(playerid,params[])
{
    if(!IsACop(playerid) && !IsAArmy(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
    if(sscanf(params, "s[128]",params[0])) return Send(playerid, -1, "Masuk: (/m)egaphone [teks]");
    if(player_gos_time[playerid] > 0) return Send(playerid, COLOR_GREY, "Anda tidak dapat menulis ke megafon lebih dari sekali setiap 5 detik!");

    new vehicleid = GetPlayerVehicleID(playerid);

	if(VehInfo[vehicleid][vFr] != PlayerInfo[playerid][pMember]) return Send(playerid,COLOR_GREY,"Anda harus berada di dalam mobil patroli!");
	format(String, 188, "[Megafon] %s %s[%d]: %s", FracRank[PlayerInfo[playerid][pMember]][PlayerInfo[playerid][pRank]], Name(playerid), playerid, params[0]);
	ProxDetector(80.0, playerid, String,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW,COLOR_YELLOW);

	player_gos_time[playerid] = 5;

	return 1;
}
CMD:r(playerid,params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

	if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara.") & 0;

	if(!form_fraction[playerid] || IsAGang(playerid) || IsAMafia(playerid)) return Send(playerid,COLOR_GREY,"Anda bukan anggota organisasi atau Anda belum mengenakan seragam");
	if(sscanf(params, "s[128]", params[0])) return Send(playerid, -1,"Masuk: /r [teks]");

    if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, 188, "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_GREY, format_string);
		return 1;
	}
	if(form_fraction[playerid] >= 1 && !IsAGang(playerid) && !IsAMafia(playerid))
	{
	    format(format_string, 188, "[R] %s %s: %s", FracRank[PlayerInfo[playerid][pMember]][PlayerInfo[playerid][pRank]], Name(playerid), params);
	    SendFrac(PlayerInfo[playerid][pMember], 0x42B66FFF, format_string);
		return 1;
	}
	else return Send(playerid,COLOR_GREY,"Perintah ini tidak tersedia untuk Anda");
}

CMD:rn(playerid,params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

	if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara.") & 0;

	if(!form_fraction[playerid] || IsAGang(playerid) || IsAMafia(playerid)) return Send(playerid,COLOR_GREY,"Anda bukan anggota organisasi atau Anda belum mengenakan seragam");
	if(sscanf(params, "s[128]", params[0])) return Send(playerid, -1,"Masuk: /r [teks]");

    if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, 188, "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_GREY, format_string);
		return 1;
	}
	if(form_fraction[playerid] >= 1 && !IsAGang(playerid) && !IsAMafia(playerid))
	{
	    format(format_string, 188, "[R] %s %s[%d]: (( %s ))", FracRank[PlayerInfo[playerid][pMember]][PlayerInfo[playerid][pRank]], Name(playerid), playerid, params);
	    SendFrac(PlayerInfo[playerid][pMember], 0x42B66FFF, format_string);
		return 1;
	}
	else return Send(playerid,COLOR_GREY,"Perintah ini tidak tersedia untuk Anda");
}

CMD:rj(playerid,params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(rent_job_vehicle[playerid] == INVALID_VEHICLE_ID) return Send(playerid,COLOR_GREY,"Anda tidak menyewa mobil yang berfungsi.");
	if(sscanf(params, "s[128]", params[0])) return Send(playerid, -1,"Masuk: /rj [teks]");

    if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, 188, "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_GREY, format_string);
		return 1;
	}

    format(format_string, 188, "[RJ] %s[%d]: %s", Name(playerid), playerid, params);
    return SendFrac(PlayerInfo[playerid][pJob], 0x42B66FFF, format_string);
}
CMD:d(playerid, params[])
{
	if(!IsACop(playerid) && !IsAArmy(playerid) && !IsAMedic(playerid) && PlayerInfo[playerid][pMember] != FRACTION_MAYOR) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakannya.");

	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara.") & 0;
	if(!form_fraction[playerid]) return Send(playerid,COLOR_GREY,"Anda tidak mengenakan seragam");
	if(sscanf(params, "s[128]", params[0])) return Send(playerid, -1,"Masuk: /d [teks]");
	if(player_gos_time[playerid] > 0) return Send(playerid, COLOR_GREY, "Saluran sibuk... Mohon tunggu!");

	if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_GREY, format_string);
		return 1;
	}
	player_gos_time[playerid] = 5;
	format(format_string, sizeof(format_string), "[%s] %s %s[%d]: %s", FracInfo[PlayerInfo[playerid][pMember]][fTag], FracRank[PlayerInfo[playerid][pMember]][PlayerInfo[playerid][pRank]], Name(playerid), playerid ,params);
	SendTeamMessage(COLOR_ALLDEPT, format_string);
	return 1;
}

CMD:dn(playerid, params[])
{
    if(!IsACop(playerid) && !IsAArmy(playerid) && !IsAMedic(playerid) && PlayerInfo[playerid][pMember] != FRACTION_MAYOR) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakannya.");

	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Kamu muntah, kamu tidak bisa bicara.") & 0;
	if(!form_fraction[playerid]) return Send(playerid,COLOR_GREY,"Anda tidak mengenakan seragam");
	if(sscanf(params, "s[128]", params[0])) return Send(playerid, -1,"Masuk: /d [teks]");

	if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_GREY, format_string);
		return 1;
	}

	format(format_string, sizeof(format_string), "[%s] %s %s[%d]: (( %s ))", FracInfo[PlayerInfo[playerid][pMember]][fTag], FracRank[PlayerInfo[playerid][pMember]][PlayerInfo[playerid][pRank]], Name(playerid), playerid ,params);
	SendTeamMessage(COLOR_ALLDEPT, format_string);
	return 1;
}

alias:suspect("su");
CMD:suspect(playerid, params[])
{
    if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk polisi dan FBI.");

	if(PlayerInfo[playerid][pMember] != FRACTION_FBI && PlayerInfo[playerid][pRank] < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari peringkat 2.");

	if(sscanf(params, "dds[36]", params[0], params[1], params[2])) return Send(playerid, -1,"Masuk: /suspect(/su) [playerid] [jumlah bintang] [alasan]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, COLOR_GREY,"Pemain sedang offline");//+
 	if(GetPlayerData(playerid, pInjured) == 1) return Error(playerid, "Anda Tidak Bisa Melakukan Ini saat Pingsan");
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, COLOR_GREY,"Pemain belum login");//+;
	if(PlayerInfo[playerid][pRank] < 3) return Send(playerid, COLOR_GREY, "Anda dapat melamar yang diinginkan dari peringkat 3.");
 	if(PlayerInfo[params[0]][pPrison] > 0) return Send(playerid, COLOR_GREY, "Man di penjara!");
 	if(params[0] == playerid) return Send(playerid, COLOR_GREY, "Anda tidak dapat mencari sendiri.");
    if(IsACop(params[0])) return Send(playerid, COLOR_GREY, "Orang ini adalah anggota LSPD atau FBI.!");
    if(!ProxDetectorS(10.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Pemain harus berada di dekat Anda!");

    if(params[1] <= PlayerInfo[params[0]][pWanted]) return SCMF(playerid, 0xB4B5B7FF, "Pemain ini sudah memiliki %d tingkat yang diinginkan.", PlayerInfo[params[0]][pWanted]);
 	if(PlayerInfo[playerid][pMember] == 1 && params[1] > 4) return Send(playerid, 0xB4B5B7FF,"Polisi tidak bisa memasukkan penjahat ke daftar orang yang dicari federal!");

	PlayerInfo[params[0]][pWanted] = params[1];
	SetPlayerCriminal(params[0], Name(playerid), params[2]);
	SetPlayerWantedLevel(params[0], params[1]);
	MeAction(playerid,"mengeluarkan PDA");
	MeAction(playerid,"membuka tab Add Criminal");
	MeAction(playerid,"memasukkan nama tersangka ke dalam basis data");
	return 1;
}
CMD:agl(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d", params[0])) return Send(playerid, -1, "Masuk: /agl [id]");
	SetPVarInt(playerid, "AglLicenses", params[0]);
	return SPD(playerid, 182,DIALOG_STYLE_LIST, "Perizinan", ""W"1. SIM\n2. Lisensi Penerbangan\n3. Izin Transportasi Air\n4. Lisensi senjata\n5. Set lisensi", "Berikan", "Tutup");

}

CMD:fullgwh(playerid)
{
	if(admin_level[playerid] < 7) return 1;

	for(new i, z = sizeof wh_pickup; i < z; i++)
	{
	    if(wh_ammo_gang[i] < 30000) wh_ammo_gang[i] = 30000;
	    if(wh_weapon_gang[i] < 30000) wh_weapon_gang[i] = 30000;

	    UpdateGangWH3DTextLabel(i);
	}

	return SCM(playerid, COLOR_GREEN, "Anda mengisi raksasa ilegal.");
}

CMD:lpanel(playerid)
{
    if(!PlayerInfo[playerid][pMember]) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
    if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1) return Send(playerid,COLOR_GREY,"Anda bukan pemimpin/wakil pemimpin!");
    if(form_fraction[playerid] == 0) return Send(playerid,COLOR_GREY,"Anda tidak memulai hari kerja!");

	String = ""W"1. Komposisi fraksi online\n2. Komposisi offline(manajemen)\n3. Manajemen transportasi";

	if(IsAGang(playerid) || IsAMafia(playerid) || PlayerInfo[playerid][pMember] == FRACTION_BIKER)
	{
	    new gang_id = GetPlayerGangWHID(playerid);

	    strcat(String, "\n4. Akses gudang(Nilai)");

		format(format_string, 48, "\n5. Akses gudang | %s", wh_state_gang[gang_id] ? ("Buka") : ("Tertutup"));
		strcat(String, format_string);
	}

    return SPD(playerid,165,DIALOG_STYLE_LIST,"Panel pemimpin", String,"Pilih","Tutup");
}
CMD:invite(playerid,params[])
{
    if(!PlayerInfo[playerid][pMember]) return 1;
	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1 || form_fraction[playerid] == 0) return Send(playerid,COLOR_GREY,"Anda bukan pemimpin/wakil pemimpin");
	if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Masuk: /invite [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
 	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat menerima diri sendiri");
	if(PlayerInfo[params[0]][pMember] != 0) return Send(playerid,COLOR_GREY,"Pemain sudah ada di organisasi");
	if(!ProxDetectorS(4.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Pemain terlalu jauh");
	if(PlayerInfo[params[0]][pWarn] > 0) return Send(playerid,COLOR_GREY,"Pemain memiliki Warn");
	if(PlayerInfo[params[0]][pLevel] < 3) return Send(playerid,COLOR_GREY,"Pemain ini Belum cukup umur");

	if(PlayerInfo[params[0]][pLevel] < FracInfo[PlayerInfo[playerid][pMember]][fLevel]) return SCMF(playerid, COLOR_GREY, "Untuk bergabung dengan organisasi Anda, seorang pemain harus memiliki %d tingkat permainan.", FracInfo[PlayerInfo[playerid][pMember]][fLevel]);
	if(IsPlayerInAnyVehicle(params[0])) return Send(playerid,COLOR_GREY,"Orang ini di mobil, minta dia keluar");

 	format(String,128, ""W"%s(%i) mengundang Anda untuk bergabung dengan fraksi %s\n\nTerima undangannya?", Name(playerid), playerid, FracInfo[PlayerInfo[playerid][pMember]][fName]);
	SPD(params[0], 164, DIALOG_STYLE_MSGBOX, "Bergabung dengan fraksi", String, "Ya", "Tidak");

	SCMF(playerid, 0x6BB3FFAA, "Anda mengundang %s(%i) ke organisasi %s", Name(params[0]), params[0], FracInfo[PlayerInfo[playerid][pMember]][fName]);

	SetPVarInt(params[0],"InvID",playerid), SetPVarInt(params[0],"Inv",1);
	return 1;
}
CMD:auninvite(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "us[128]",params[0], params[1])) return Send(playerid, -1,"Masuk: /auninvite [playerid] [alasan]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(!PlayerInfo[params[0]][pMember]) return Send(playerid, COLOR_GREY,"Pemain ini bukan anggota dari fraksi mana pun.!");

  	if(params[0] == playerid) SCMF(playerid, COLOR_GREY, "[A] Anda melepas kepemimpinan fraksi %s", FracInfo[PlayerInfo[params[0]][pMember]][fName]);

    if(PlayerInfo[params[0]][pLeader] > 0 && params[0] != playerid)
	{
	    SetPVarInt(playerid, "aUninviteID", params[0]);
	    SetPVarString(playerid, "aUninviteReason", params[1]);
		format(String, 144, "{FF7A0A}Perhatian!"W" Apakah Anda mencoba memecat pemimpin faksi %s\n\nAnda yakin ingin memecat pemimpin?", FracInfo[PlayerInfo[params[0]][pMember]][fName]);
        SPD(playerid,183,DIALOG_STYLE_MSGBOX,"Peringatan",String,"Ya","Tidak");
        return 1;
  	}

	if(params[0] != playerid)
	{
    	format(format_string, sizeof(format_string), "[A] Administrator %s[%d] menembakkan pemain %s[%d] dari fraksi %s. Alasan: %s", Name(playerid), playerid, Name(params[0]), params[0], FracInfo[PlayerInfo[params[0]][pMember]][fName], params[1]);
		SendAdminMessage(COLOR_GREY, format_string);
		SCMF(params[0], 0x6BB3FFAA, "Administrator %s(%i) memecatmu dari organisasi (%s). Alasan: %s", Name(playerid), playerid, FracInfo[PlayerInfo[params[0]][pMember]][fName], params[1]);
    	SCMF(playerid, 0x6BB3FFAA, "Anda dipecat %s(%i) dari organisasi (%s). Alasan: %s", Name(params[0]), params[0], FracInfo[PlayerInfo[params[0]][pMember]][fName], params[1]);
    }
    PlayerInfo[params[0]][pLeader] = 0;
    PlayerInfo[params[0]][pSetSpawn] = 1;
    PlayerInfo[params[0]][pMember] = 0;
    PlayerInfo[params[0]][pRank] = 0;
    PlayerInfo[params[0]][pfWarn] = 0;
	form_fraction[params[0]] = 0;

	SetPlayerSkinEx(params[0], PlayerInfo[params[0]][pSkin]);
	SetPlayerToTeamColor(params[0]);

	SavePlayerFraction(params[0]);

	return 1;
}
CMD:vipuninvite(playerid)
{
	if(PlayerInfo[playerid][pVip] < 3 && PlayerInfo[playerid][pUpdPlayer][2] == 0) return SCM(playerid, COLOR_GREY, "Anda bukan VIP Level 3 atau Anda tidak memiliki peningkatan 'Ketegasan'.");

    if(PlayerInfo[playerid][pLeader]) return Send(playerid, COLOR_GREY,"Pemimpin tidak dapat menggunakan perintah ini.!");

    if(!PlayerInfo[playerid][pMember]) return Send(playerid, COLOR_GREY,"Anda bukan anggota dari fraksi mana pun!");

    foreach(new i : capture_zone_list)
	{
	    if(PlayerInfo[playerid][pMember] != GZInfo[i][gFraction] && PlayerInfo[playerid][pMember] != GZInfo[i][gAttack]) continue;

		for(new j; j < 9; j++) TextDrawHideForPlayer(playerid, GZInfo[i][gTD][j]);

		break;
	}

	PlayerInfo[playerid][pLeader] = 0;
    PlayerInfo[playerid][pSetSpawn] = 1;
    PlayerInfo[playerid][pMember] = 0;
    PlayerInfo[playerid][pRank] = 0;
    PlayerInfo[playerid][pfWarn] = 0;
	form_fraction[playerid] = 0;

	SavePlayerFraction(playerid);

	SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);
	SetPlayerToTeamColor(playerid);
	Send(playerid, -1, "Panduan Pemilik.");
	return true;
}
CMD:uninvite(playerid, params[])
{
    if(!PlayerInfo[playerid][pMember]) return 1;
	if(sscanf(params, "us[128]",params[0], params[1])) return Send(playerid, -1,"Masuk: /uninvite [playerid] [alasan]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1) return Send(playerid,COLOR_GREY,"Anda bukan pemimpin/wakil pemimpin");
	if(PlayerInfo[playerid][pMember] != PlayerInfo[params[0]][pMember]) return Send(playerid,COLOR_GREY,"Pemain tidak ada di organisasi Anda.");
	if(PlayerInfo[playerid][pRank] <= PlayerInfo[params[0]][pRank] || PlayerInfo[params[0]][pLeader] > 0) return Send(playerid,COLOR_GREY,"Anda tidak dapat memecat pemain ini");
	if(params[0] == playerid) return Send(playerid,COLOR_GREY,"Anda tidak dapat mengusir diri sendiri!");

	foreach(new i : capture_zone_list)
	{
	    if(PlayerInfo[playerid][pMember] != GZInfo[i][gFraction] && PlayerInfo[playerid][pMember] != GZInfo[i][gAttack]) continue;

		for(new j; j < 9; j++) TextDrawHideForPlayer(params[0], GZInfo[i][gTD][j]);

		break;
	}

	SCMF(params[0], 0x6BB3FFAA, "%s(%i) memecatmu dari organisasi (%s). Alasan: %s", Name(playerid), playerid, FracInfo[PlayerInfo[playerid][pMember]][fName], params[1]);
    SCMF(playerid, 0x6BB3FFAA, "Anda dipecat %s(%i) dari organisasi (%s). Alasan: %s", Name(params[0]), params[0], FracInfo[PlayerInfo[playerid][pMember]][fName], params[1]);

    PlayerInfo[params[0]][pSetSpawn] = 1;
    PlayerInfo[params[0]][pMember] = 0;
    PlayerInfo[params[0]][pRank] = 0;
    PlayerInfo[params[0]][pfWarn] = 0;
	form_fraction[params[0]] = 0;

	SetPlayerSkinEx(params[0], PlayerInfo[params[0]][pSkin]);
	SetPlayerToTeamColor(params[0]);

    SavePlayerFraction(params[0]);

	return 1;
}
CMD:giverank(playerid,params[])
{
    if(!PlayerInfo[playerid][pMember]) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-2) return Send(playerid,COLOR_GREY,"Anda tidak dapat menggunakan perintah ini.");
	if(sscanf(params, "ud", params[0],params[1])) return Send(playerid, -1,"Masuk: /giverank [playerid] [peringkat]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login.");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	//if(!form_fraction[playerid] || IsAGang(playerid) || IsAMafia(playerid)) return Send(playerid,COLOR_GREY,"Anda tidak memulai hari kerja!");
	if(PlayerInfo[playerid][pMember] != PlayerInfo[params[0]][pMember]) return Send(playerid,COLOR_GREY,"Pemain tidak ada di organisasi Anda..");
	if(params[1] >= FracInfo[PlayerInfo[playerid][pMember]][fRankMax] || params[1] < 1) return Send(playerid,COLOR_GREY,"Peringkat itu salah.");
	if(params[1] >= PlayerInfo[playerid][pRank]) return Send(playerid,COLOR_GREY,"Anda tidak bisa memberi orang peringkat itu..");
	if(PlayerInfo[playerid][pRank] <= PlayerInfo[params[0]][pRank] || PlayerInfo[params[0]][pLeader] > 0) return Send(playerid,COLOR_GREY,"Anda tidak dapat mengubah peringkat pemain ini.");

	if(params[1] < PlayerInfo[params[0]][pRank]) SCMF(params[0], 0x1CCCE6FF, "%s(%i) menurunkan Anda ke %i peringkat (%s)", Name(playerid), playerid, params[1], FracRank[PlayerInfo[playerid][pMember]][params[1]]);
	if(params[1] > PlayerInfo[params[0]][pRank]) SCMF(params[0], 0x1CCCE6FF, "%s(%i) mempromosikan Anda untuk %i peringkat (%s)", Name(playerid), playerid, params[1], FracRank[PlayerInfo[playerid][pMember]][params[1]]);

	PlayerInfo[params[0]][pRank] = params[1];
	SCMF(playerid,0x1CCCE6FF,"Anda dibesarkan %s ke peringkat %s(%d peringkat)",Name(params[0]), FracRank[PlayerInfo[playerid][pMember]][params[1]],params[1]);

    SavePlayerFraction(params[0]);

	return 1;
}

CMD:leaders(playerid, params[])// Para pemimpin
{
    format(MySQLStr, 244, "SELECT acc.`pName`, acc.`pLeader`, acc.`pNumber` FROM `accounts` acc WHERE acc.`pLeader` > 0 AND NOT EXISTS (SELECT * FROM `admin` adm WHERE acc.pName = adm.Name)");
	return mysql_tquery(mMysql, MySQLStr, "OnMySQL_Query","dd", playerid, 28);
}

CMD:members(playerid, params[])
{
	if(!PlayerInfo[playerid][pMember]) return SCM(playerid, COLOR_GREY, "Anda bukan faksi.");

	new want_text[188], count = 0;
	new m_id = PlayerInfo[playerid][pMember];

	String = "";

    foreach(new i:Player)
    {
        if(PlayerInfo[i][pMember] != m_id) continue;

		new rank = PlayerInfo[i][pRank];

		format(want_text, 188, ""W"Level: %d | Nilai: %s(%d) | Telp: %s | Nama depan: %s[%i]\n",
			PlayerInfo[i][pLevel], FracRank[m_id][rank], PlayerInfo[i][pRank], PlayerInfo[i][pNumber] ? IntToString(PlayerInfo[i][pNumber]) : ("Tidak"), Name(i), i);

		strcat(String, want_text);

		count++;
    }

    if(count == 0) strcat(String, ""W"Informasi tidak ditemukan");

	return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Anggota online", String, "Tutup", "");
}
CMD:csetspawn(playerid)
{
  	SendClientMessageEx(playerid, COLOR_WHITE," anda membatalkan spawn otomatis");
	PlayerInfo[playerid][pSetSpawn] = 0;
}
CMD:setspawn(playerid)
{
    SPD(playerid, 8, DIALOG_STYLE_LIST, "Tempat Bibit", "1. Los Santos\n2. Rumah\n3. Hotel\n4. Rumah keluarga", "Pilih", "Batalkan");
	return 1;
}
CMD:changeskin(playerid, params[])
{
	if(PlayerInfo[playerid][pMember] == 0) return Send(playerid,COLOR_GREY,"Anda bukan faksi.");
    if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1) return Send(playerid,COLOR_GREY,"Hanya tersedia untuk pemimpin dan wakil.");

	if(sscanf(params, "ud",params[0],params[1])) return SCMF(playerid, -1, "Masuk: /changeskin [playerid] [0 - %d]", FracInfo[PlayerInfo[playerid][pMember]][fSkinKolvo]-1);

	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(PlayerInfo[playerid][pMember] != PlayerInfo[params[0]][pMember]) return Send(playerid,COLOR_GREY,"Orang ini bukan dari faksi Anda.");
	if(params[1] > FracInfo[PlayerInfo[params[0]][pMember]][fSkinKolvo]-1 || params[1] < 0) return SCMF(playerid, COLOR_GREY, "Semua yang ada di organisasi Anda %d kulit. Gunakan dari 0 hingga %d", FracInfo[PlayerInfo[params[0]][pMember]][fSkinKolvo], FracInfo[PlayerInfo[params[0]][pMember]][fSkinKolvo]-1);
	if(!IsAMafia(playerid) && !IsAGang(playerid) && form_fraction[params[0]] == 0) return Send(playerid, COLOR_GREY, "Pemain tidak akan berubah menjadi bentuk kerja.");

	SetPlayerSkinEx(params[0], FracInfo[PlayerInfo[params[0]][pMember]][fSkin][params[1]]);
	PlayerInfo[params[0]][pFrSkin] = FracInfo[PlayerInfo[params[0]][pMember]][fSkin][params[1]];

	SCMF(params[0], 0x1CCCE6FF, "Pemimpin fraksi %s[%d] mengganti kulitmu %d-th", Name(playerid), playerid, params[1]);
    SCMF(playerid, 0x1CCCE6FF, "Anda mengubah kulit %s[%d] pada %d-th", Name(params[0]), params[0], params[1]);

	return 1;
}
CMD:templeader(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;

    if(IsPlayerInAnyVehicle(playerid)) return Send(playerid,COLOR_GREY,"Keluar dari mobil");

	String = "";

	new str[42];

	new count = 0;

	for(new i = 1; i < MAX_FRACTIONS; i++)
	{
		format(str, 42, "%i. %s\n", i, FracInfo[i][fName]);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	return SPD(playerid, 7618, DIALOG_STYLE_LIST, GetPlayerNameEx(playerid), String, "Pilih", "Tutup");
}
CMD:makeleader(playerid, params[])
{
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

	if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Masuk: /makeleader [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+
	if(PlayerInfo[params[0]][pWarn] > 0) return Send(playerid,-1,"Pemain telah Peringatkan");
	if(IsPlayerInAnyVehicle(params[0])) return Send(playerid,COLOR_GREY,"Orang ini di mobil, minta dia keluar");

	SetPlayerUseListitem(playerid, params[0]);

	String = "";

	new str[42];

	new count = 0;

	for(new i = 1; i < MAX_FRACTIONS; i++)
	{
		format(str, 42, "%i. %s\n", i, FracInfo[i][fName]);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, i);
	}

	return SPD(playerid, 7617, DIALOG_STYLE_LIST, GetPlayerNameEx(params[0]), String, "Pilih", "Tutup");
}
CMD:neon(playerid,params[])
{
 	new vehicleid = GetPlayerVehicleID(playerid);
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendClientMessage(playerid, -1, "{F81414}ERROR: {FFFFFF}You must be the driver of a vehicle to use this.");
	if(vehicleid == IsABike(vehicleid)) return Error(playerid, "{F81414}ERROR: {FFFFFF}You can't use neon on this vehicle.");
	ShowPlayerDialog(playerid, DIALOG_NEONTYPES, DIALOG_STYLE_LIST, "Neon Menu", "Solid Neon/No Flash\nSimultaneous Flash\nAlternating Flash\nRemove All Neon", "Select", "Cancel");
	return 1;
}
