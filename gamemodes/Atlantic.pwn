CMD:hood(playerid, params[])
{
	new vehicleid = GetNearbyVehicle(playerid);

	if(vehicleid == INVALID_VEHICLE_ID)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not in range of any vehicle.");
	}
	if(!VehicleHasWindows(vehicleid))
	{
	    return SCM(playerid, COLOR_SYNTAX, "This vehicle has no hood.");
	}

	if(!GetVehicleParams(vehicleid, VEHICLE_BONNET))
	{
	    SetVehicleParams(vehicleid, VEHICLE_BONNET, true);
	    format(String, 188, "%s Membuka hood mobil dengan bantuan kedua tangan",Name(playerid));
  		ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid, "Membuka hood mobil",COLOR_PURPLE,20.0,10000);
	}
	else
	{
	    SetVehicleParams(vehicleid, VEHICLE_BONNET, false);
	    format(String, 188, "%s Menutup hood mobil dengan bantuan kedua tangan",Name(playerid));
  		ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid, "Menutup hood mobil",COLOR_PURPLE,20.0,10000);
	}

	return 1;
}
stock GetVehicleRelativePos(vehicleid, &Float:x, &Float:y, &Float:z, Float:xoff=0.0, Float:yoff=0.0, Float:zoff=0.0)
{
    new Float:rot;
    GetVehicleZAngle(vehicleid, rot);
    rot = 360 - rot;    // Making the vehicle rotation compatible with pawns sin/cos
    GetVehiclePos(vehicleid, x, y, z);
    x = floatsin(rot,degrees) * yoff + floatcos(rot,degrees) * xoff + x;
    y = floatcos(rot,degrees) * yoff - floatsin(rot,degrees) * xoff + y;
    z = zoff + z;

    /*
       where xoff/yoff/zoff are the offsets relative to the vehicle
       x/y/z then are the coordinates of the point with the given offset to the vehicle
       xoff = 1.0 would e.g. point to the right side of the vehicle, -1.0 to the left, etc.
    */
    return 1;
}

CMD:light(playerid)
{
        new vehicleid = GetPlayerVehicleID(playerid);
		if(GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 510) return SendClientMessage(playerid,COLOR_WHITE,"This command can't be used in this vehicle.");
		SetVehicleLights(vehicleid, playerid);
		return 1;
}
CMD:trunk(playerid, params[])
{
	for(new i; i < MAX_PLAYER_VEHICLES; i++)
	{
		new vehicleid = player_home_car[playerid][i];
		new vehid = GetPlayerVehicleID(playerid);

		if(vehicleid == INVALID_VEHICLE_ID) continue;

	    new Float:cx,Float:cy,Float:cz;
		GetVehiclePos(vehicleid, cx, cy, cz);
		if(!PlayerToPoint(5.0, playerid, cx, cy, cz)) continue;

	    new use_car = GetPlayerUseListitem(playerid);

	    if(vehicleid == IsABike(vehid)) return Error(playerid, "Ini adalah motor tidak memiliki bagasi");

	    if(vehicleid == IsABicycle(vehid)) return Error(playerid, "Ini adalah sepeda tidak memiliki bagasi");

	    if(vehicleid == INVALID_VEHICLE_ID) return Error(playerid, "Kamu tidak didekat mobil manapun");

	    if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "Keluar dari mobil");

	    // if(vehicleid != player_home_car[playerid][use_car]) return Error(playerid, "Ini bukan mobil anda");

	    new Float:cX, Float:cY, Float:cZ;
	    new Float:dX, Float:dY, Float:dZ;
	    GetVehicleModelInfo(vehicleid, VEHICLE_MODEL_INFO_REAR_BUMPER_Z, cX, cY, cZ);
	    GetVehicleRelativePos(vehicleid, dX, dY, dZ, cX, cY = -3.0, cZ);

	    if(!IsPlayerInRangeOfPoint(playerid, 1.2, dX, dY, dZ))
	        return Error(playerid, "Kamu harus berada di belakang mobil");

	    if(!GetVehicleParams(vehicleid, VEHICLE_BOOT))
	    {
	        SetVehicleParams(vehicleid, VEHICLE_BOOT, true);
	        ProxDetector(20.0, playerid, "membuka trunk mobil dengan bantuan kedua tangan", COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	        SetPlayerChatBubble(playerid, "Membuka trunk mobil",COLOR_PURPLE,20.0,10000);
	        format(format_string, 244, "Makanan: {ffff00}%d\n{ffffff}Minuman: {ffff00}%d\nBatu Bersih: {ffff00}%d\n{ffffff}Batu Kotor: {ffff00}%d\n{ffffff}Logam: {ffff00}%d\n{ffffff}Component: {ffff00}%d\n{ffffff}Senjata: {ffff00}%d",
		    CarInfo[playerid][cFood][use_car], CarInfo[playerid][cDrink][use_car], CarInfo[playerid][cBatu][use_car], CarInfo[playerid][cBatuk][use_car], CarInfo[playerid][cMetall][use_car], CarInfo[playerid][cComponent][use_car], CarInfo[playerid][cGun][use_car]);
	        return SPD(playerid, 9773, DIALOG_STYLE_LIST, "Isi Bagasi", format_string, "Gunakan", "Tutup");
	    }
	    else
	    {
	        SetVehicleParams(vehicleid, VEHICLE_BOOT, false);
	        ProxDetector(20.0, playerid, "menutup trunk mobil dengan bantuan kedua tangan", COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	        SetPlayerChatBubble(playerid, "Menutup trunk mobil",COLOR_PURPLE,20.0,10000);
	    }
	}
    return Error(playerid,"Anda terlalu jauh dari mobil pribadi Anda.");
}

