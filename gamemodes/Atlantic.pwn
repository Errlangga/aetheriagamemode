	if(PlayerInfo[playerid][pDutynambang] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Sedang Tidak On Duty Kuli!");
	{
    	if(!IsPlayerInRangeOfPoint(playerid, 8, 1911.7911,-1877.2695,13.5186)) return SendClientMessage(playerid, COLOR_RED, "[RADIO] Anda Tidak Berada Di peleburan!");
        if(IsPlayerInRangeOfPoint(playerid, 8, 1911.7911,-1877.2695,13.5186))
        {
            PlayerInfo[playerid][pPickupnambang] -= 4;
    		RemovePlayerAttachedObject(playerid, 8);
    		TogglePlayerControllableEx(playerid, 0);
        	ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0,1,0,0,0,0,1);
         	SetTimerEx("WaktuNambang1", 10000, false, "d", playerid);
         	ShowProgressbar(playerid, "Waiting...", 10);
        	SetPlayerCheckpoint(playerid, 1939.4403,-1867.6506,13.8741, 2.0);
            SetPVarInt(playerid, "GPS", 1);
            SendClientMessage(playerid, COLOR_YELLOW, "[RADIO] Silakan Ke Checkpoint Untuk Melanjutkan Pekerjaan");
        }
    }
    return 1;
}

