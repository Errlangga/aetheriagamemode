	if(dialogid == 97) // Age
    {
        if(isnull(inputtext)) {
            return ShowPlayerDialog(playerid,97,DIALOG_STYLE_INPUT,"Umur","Berapa umurmu? (16 - 50)","Oke","Cancel");
        }
        else {
            new
                Age = strval(inputtext);

            if(Age >= 16 && Age <= 50)
            {
                new szMessage[128], hari[3];

                getdate(hari[0], hari[1], hari[2]);
                format(szMessage, sizeof(szMessage), "Kamu telah mengatur karakter kamu dengan umur %d (Lahir pada tahun %d).", Age, hari[0] - Age);
                SendClientMessage(playerid, COLOR_YELLOW, szMessage);
                PlayerInfo[playerid][pOrigin] = 0;
                PlayerInfo[playerid][pAge] = Age;
                OnPlayerUpdateAccountsPer(playerid, "pAge", PlayerInfo[playerid][pAge]);
                PlayerInfo[playerid][pTut] = 1;
                TogglePlayerControllable(playerid, 1);
				PlayerInfo[playerid][pKtp] += 1;
				OnPlayerUpdateAccountsPer(playerid, "pKtp", PlayerInfo[playerid][pKtp]);
				SCM(playerid, COLOR_YELLOW, "Anda Berhasil Membuat Paspor");
                SCM(playerid, COLOR_RED, "Server: Anda Mendapatkan Pakaian Dari Pemerintah");
                if(PlayerInfo[playerid][pSex] == 1)
                {
                    SetPlayerSkinEx(playerid, 2);
                }
                else if(PlayerInfo[playerid][pSex] == 2)
                {
                    SetPlayerSkinEx(playerid, 85);
                }
            }
            else
            {
                SendClientMessage(playerid, COLOR_WHITE, "Karakter kamu tidak bisa kurang dari 16 Tahun dan Lebih dari 50 Tahun.");
                return ShowPlayerDialog(playerid,97,DIALOG_STYLE_INPUT,"Umur","Berapa umurmu? (16 - 50)","Oke","Cancel");
            }
        }
    }
            

    if(dialogid == DIALOG_BM_GUN)
	{
		if(response)
		{
			switch(listitem)
			{
				case 0:
				{
					if(pData[playerid][pMetall] < 100) return Error(playerid, "Bahan tidak cukup!(Butuh: 100).");

                    PlayerInfo[playerid][pMetall] -= 100;
					OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);

					TogglePlayerControllable(playerid, 0);
					PlayerInfo[playerid][pGaeGun] += 1;
					ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 0, 0, 0, 0, 0, 1);
					pData[playerid][pArmsDealer] = SetTimerEx("CreateGun", 1000, true, "idd", playerid, 25, 50);
                    SendClientMessage(playerid, COLOR_PURPLE, "Anda Sedang Merakit Senjata Shotgun Ilegal");
                    format(format_string,70, "%s Merakit Senjata Shotgun Dengan Kedua Tangan",Name(playerid));
                	SetPlayerChatBubble(playerid, format_string, COLOR_PURPLE, 20.0, 7000);
				}
				case 1: //deagle
				{
					if(pData[playerid][pMetall] < 200) return Error(playerid, "Bahan tidak cukup!(Butuh: 200).");
					if(!IsAGang(playerid) && !IsAMafia(playerid) && PlayerInfo[playerid][pMember] != FRACTION_BIKER) return SCM(playerid, COLOR_GREY, "{FF0000}Anda tidak Bisa buat Ini");

                    PlayerInfo[playerid][pMetall] -= 200;
					OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);

					TogglePlayerControllable(playerid, 0);
					PlayerInfo[playerid][pGaeGun] += 1;
					ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 0, 0, 0, 0, 0, 1);
					pData[playerid][pArmsDealer] = SetTimerEx("CreateGun", 1000, true, "idd", playerid, WEAPON_DEAGLE, 50);
					SendClientMessage(playerid, COLOR_PURPLE, "Anda Sedang Merakit Senjata Deagle Ilegal");
                    format(format_string,70, "%s Merakit Senjata Deagle Dengan Kedua Tangan",Name(playerid));
                	SetPlayerChatBubble(playerid, format_string, COLOR_PURPLE, 20.0, 7000);
				}
				case 2: //AK47
				{
					if(pData[playerid][pMetall] < 350) return Error(playerid, "Bahan tidak cukup!(Butuh: 350).");
					if(!IsAMafia(playerid) && PlayerInfo[playerid][pMember] != FRACTION_BIKER) return SCM(playerid, COLOR_GREY, "Warga gabisa buat senjata ini");
     				if(pData[playerid][pLevel] < 5) return Error(playerid, "Kamu Belom Cukup Umur Untuk Memegang Senjata ini.");
					if(PlayerInfo[playerid][pGaeGun] >= 3) return SCM(playerid, COLOR_GREY, "Kamu Sudah Buat Senjata, Datang Lagi Lain Kali!");

					pData[playerid][pMetall] -= 350;

					TogglePlayerControllable(playerid, 0);
					PlayerInfo[playerid][pGaeGun] += 1;
					ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 0, 0, 0, 0, 0, 1);
					pData[playerid][pArmsDealer] = SetTimerEx("CreateGun", 1000, true, "idd", playerid, 30, 50);
					SendClientMessage(playerid, COLOR_PURPLE, "Anda Sedang Merakit Senjata AK-47 Ilegal");
                    format(format_string,70, "%s Merakit Senjata AK-47 Dengan Kedua Tangan",Name(playerid));
                	SetPlayerChatBubble(playerid, format_string, COLOR_PURPLE, 20.0, 7000);
				}
				case 3: //MP5
				{
					if(pData[playerid][pMetall] < 500) return Error(playerid, "Bahan tidak cukup!(Butuh: 500).");
					if(!IsAGang(playerid) && !IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Warga gabisa buat senjata ini");
    				if(pData[playerid][pLevel] < 5) return Error(playerid, "Kamu Belom Cukup Umur Untuk Memegang Senjata ini.");
					if(PlayerInfo[playerid][pGaeGun] >= 3) return SCM(playerid, COLOR_GREY, "Kamu Sudah Buat Senjata, Datang Lagi Lain Kali!");

                    PlayerInfo[playerid][pMetall] -= 500;
					OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);

					TogglePlayerControllable(playerid, 0);
					PlayerInfo[playerid][pGaeGun] += 1;
					ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 0, 0, 0, 0, 0, 1);
					pData[playerid][pArmsDealer] = SetTimerEx("CreateGun", 1000, true, "idd", playerid, 29, 50);
                    SendClientMessage(playerid, COLOR_PURPLE, "Anda Sedang Merakit Senjata mp5 Ilegal");
                    format(format_string,70, "%s Merakit Senjata mp5 Dengan Kedua Tangan",Name(playerid));
                	SetPlayerChatBubble(playerid, format_string, COLOR_PURPLE, 20.0, 7000);
				}
			}
		}
		return 1;
	}

