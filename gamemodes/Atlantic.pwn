CMD:mulaipetani(playerid, params[])
{
		if(IsPlayerInRangeOfPoint(playerid, 5, -1093.1405,-1614.1300,76.3671))
		{
		if(GetPVarInt(playerid,"pTimePetani") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down Job 30 Menit");
		if(PlayerInfo[playerid][pSex] == 1) SetPlayerSkinEx(playerid,158);
		else SetPlayerSkinEx(playerid,157);
		DutyGanjos[playerid] = 1;
		SetPlayerCheckpoint(playerid, -1088.1015,-1614.3225,76.3671, 5.0);
		SendClientMessage(playerid,COLOR_YELLOW, "Mulai Bekerja Sebagai Petani Padi");
		}
		return 1;
}
CMD:selesaipetani(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 5, -1093.1405,-1614.1300,76.3671))
	{
	SetPVarInt(playerid, "pTimePetani", gettime() + 1800);
    if(DutyGanjos[playerid] != 1) return SCM(playerid, COLOR_GREY, "Anda Tidak Bekerja Petani Padi");
    SetPlayerSkinEx(playerid,PlayerInfo[playerid][pSkin]);
    SendClientMessage(playerid,-1,"{ffff00}Anda Menyelesaikan Pekerjaan");
    DisablePlayerCheckpoint(playerid);
    DutyGanjos[playerid] = 0;
    CPGanjos[playerid] = 0;
    BibitGanjos[playerid] = 0;
    PanenGanjos[playerid] = 0;
	}
	return 1;
}
CMD:rpbibit(playerid, params[])
{
	new merp[125], dorp[125], playername[MAX_PLAYER_NAME +1];
	GetPlayerName(playerid, playername, sizeof(playername));
    format(merp, sizeof(merp), "* %s Menanam bibit padi dengan bantuan kedua tangan", playername);
   	format(dorp, sizeof(dorp), "Selesai ((%s))", playername);
   	ProxDetectorx(30.0, playerid, merp, COLOR_PURPLE);
 	ProxDetectorx(30.0, playerid, dorp, COLOR_PURPLE);
 	return 1;
}
CMD:ambilpupuk(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 5, -1088.1015,-1614.3225,76.3671))
	{
    if(DutyGanjos[playerid] != 1) return 1;
    if(BibitGanjos[playerid] == 1) return 1;
    BibitGanjos[playerid] = 1;
    CPGanjos[playerid] = 1;
   	SetPlayerAttachedObject(playerid, 5, 11745, 2,-0.499000,-0.208000,0.046999,114.800003,80.700042,-43.300064,0.666000,0.957000,0.828999);
    SetPlayerCheckpoint(playerid, -1073.1682,-1624.3367,76.3671, 1);
    SendClientMessage(playerid,COLOR_YELLOW, "Pergi Ke Tanda Merah Dipeta");
	}
	return 1;
}
CMD:taruhpadi(playerid, params[])
{
	if(pData[playerid][pPadi] > 100) return Error(playerid, "Padi Sudah melewati Batas!(Max: 100).");
    if(IsPlayerInRangeOfPoint(playerid, 5, -1116.1982,-1637.4880,76.3671))
	{
	    if(DutyGanjos[playerid] != 1) return 1;
	    if(PanenGanjos[playerid] == 0) return 1;
	    RemovePlayerAttachedObject(playerid, 5);
	    DisablePlayerCheckpoint(playerid);
	    BibitGanjos[playerid] = 0;
	    PanenGanjos[playerid] = 0;
	    SetPlayerCheckpoint(playerid, -1088.1015,-1614.3225,76.3671, 3);
	    new rand = RandomEx(10, 80);
	    PlayerInfo[playerid][pPadi] += rand;
	    OnPlayerUpdateAccountsPer(playerid, "pPadi", PlayerInfo[playerid][pPadi]);
	   	UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]-11);
		UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]-9);
		UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+3);
		format(String, sizeof(String), "Anda Mendapatkan %d Padi", rand);
	    SendClientMessage(playerid,COLOR_YELLOW, String);
	}
	return 1;
}
