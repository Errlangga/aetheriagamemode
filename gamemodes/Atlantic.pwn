CMD:kick(playerid, params[])
{
   	if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;

	if(sscanf(params, "ds[128]",params[0], params[1])) return Send(playerid, -1, "Masuk: /kick [id] [alasan]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan. / tidak resmi.");
	if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, COLOR_GREY, "Anda tidak dapat memblokir administrator atas/rekan.");

	format(format_string, sizeof(format_string), "Server: {ffff00}Administrator %s menendang pemain %s. Alasan: %s", Name(playerid), Name(params[0]), params[1]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);

	PlayerInfo[playerid][pAdmKick] ++;
	OnPlayerUpdateAdminPer(playerid, "pAdmKick", PlayerInfo[playerid][pAdmKick]);

	KickD(params[0], "");
	return true;
}
CMD:skick(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan. / tidak resmi.");
    if(sscanf(params, "d",params[0],params[1])) return Send(playerid, -1, "Masuk: /skick [id]");
    if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, COLOR_GREY, "Anda tidak dapat memblokir administrator atas/rekan.");

    PlayerInfo[playerid][pAdmKick] ++;
    OnPlayerUpdateAdminPer(playerid, "pAdmKick", PlayerInfo[playerid][pAdmKick]);

	SCMF(params[0], COLOR_GREY, "Anda ditendang oleh administrator %s untuk pelanggaran aturan server.", Name(playerid));
	KickD(params[0], "");
	//
	format(format_string, sizeof(format_string), "[A] Administrator %s[%d] menendang pemain %s[%d] tidak ada suara", Name(playerid), playerid, Name(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, format_string);
	return true;
}
