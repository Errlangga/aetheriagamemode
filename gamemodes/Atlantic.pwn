epublic: Fresh()
{
    new hour, minute, second;
	gettime(hour, minute, second);

	getdate(day, month, year);

	static str[64];

	if(Timer <= gettime() && Timer != 0)
	{
	    Timer = gettime()+1;

	    new newhour, newminute, newseconds;
		gettime(newhour, newminute, newseconds);

		if(newhour != ghour)
		{
		    PayDay();
		    ghour = newhour;
  		}
  	}

	PlayerUpdate();

	if(second == 00 && minute == 00)
	{
	    if(ship_metall_amount < 50000) ship_metall_amount = 50000;
	    if(ship_ammo_amount < 50000) ship_ammo_amount = 50000;
	}

	if(second == 00 && (minute % 5) == 0)
	{
		new ask_amount = 0;

		for(new i; i < MAX_REPORTS; i++)
		{
		    if(report_info[i][r_id] == INVALID_PLAYER_ID) continue;

		    SCM(report_info[i][r_id], COLOR_GREY, "[REPORT] Pertanyaan Anda belum dijawab. Coba tanyakan dia yang baru.");

		    report_info[i][r_id] = INVALID_PLAYER_ID;
			report_info[i][r_time] = 0;

			ask_amount++;
		}

		format(format_string, 96, "[A]: Daftar pertanyaan (/arep) sudah dibersihkan. Masalah dihapus: %i", ask_amount);
		SendAdminMessage(COLOR_GREY, format_string);
	}

    for(new i; i < MAX_REPORTS; i++) report_info[i][r_time]++;

	if(hour == 15 && minute == 00 && second == 0 && DayOfWeak() == 5)
	{
	    foreach(Player, i)
	    	player_quest_info[i][quest_id] = player_quest_info[i][quest_status] = player_quest_info[i][quest_progress] = 0;

        mysql_tquery(mMysql, "UPDATE `accounts` SET `warehouse_quest_id` = 0, `warehouse_quest_status` = 0, `warehouse_quest_progress` = 0");
	}

	if(hour == 23 && minute == 59 && second == 59 && DayOfWeak() == 7)
	{
	    foreach(Player, i) DeletePlayerQuestData(i);
	}

	for(new i; i < MAX_CRANES; i++)
	{
	    if(crane_refresh[i] == 0) continue;

	    crane_refresh[i]--;

		if(crane_refresh[i] == 0) DestroyDynamicObject(crane_obj[i][2]);
	}

	if(crane_unload_refresh != 0)
	{
	    crane_unload_refresh--;

		if(crane_unload_refresh == 0)crane_unload_obj[0] = CreateDynamicObject(1251, 2785.223632, -2457.605468, 27.420410, 90.000000, 0.000000, 0.000000, map_world, map_int, -1, 300.00, 300.00);
	}

	if(pb_state != 0)
	{
	    pb_time--;

	    if(pb_state == 1)
	    {
			if(pb_time == 299) SendClientMessageToAll(-1, "[PB] 5 menit sebelum acara.");
			if(pb_time == 119) SendClientMessageToAll(-1, "[PB] Sebelum acara 2 menit.");

			if(pb_time == 0)
			{
			    new team_players[2];

			    foreach(Player, i)
			    {
			        if(player_reg_pb[i] == 0) team_players[0]++;
			        if(player_reg_pb[i] == 1) team_players[1]++;
			    }

			    if(team_players[0] > 0 && team_players[1] > 0)
				{
				    foreach(Player, i)
				    {
						if(player_reg_pb[i] == -1) continue;

						new t_id = player_reg_pb[i];

						TogglePlayerControllable(i, false);

						new rand = random(5);

						SetPlayerPos(i, team_pos_pb[t_id][rand][0], team_pos_pb[t_id][rand][1], team_pos_pb[t_id][rand][2]);
						SetPlayerFacingAngle(i, team_pos_pb[t_id][rand][3]);

						player_kills_pb[i] = 0;

						GivePlayerWeapon(i, 24, 100);
						GivePlayerWeapon(i, 25, 50);
						GivePlayerWeapon(i, 31, 300);

						SetPlayerColor(i, t_id ? COLOR_RED : COLOR_BLUE);

						SetPlayerInterior(i, 0);
						SetPlayerVirtualWorld(i, 5);
				    }

				    pb_blue_kills = pb_red_kills = 0;

				    pb_state = 2;
				    pb_time = 5;
				}
				else
				{
				    foreach(Player, i)
					{
						if(player_reg_pb[i] == -1) continue;

						player_reg_pb[i] = -1;
						GivePlayerMoneyEx(i, 2000, "pengembalian uang untuk PB");

						SCM(i, COLOR_YELLOW, "[PB] Mereka mengembalikan uang itu kepada Anda.");
				    }

				    pb_state = pb_time = 0;

				    SendClientMessageToAll(-1, "[PB] Game dibatalkan, tidak cukup banyak peserta.");
				}
			}
	    }
	    else if(pb_state == 2)
	    {
	        if(pb_time > 0) format(str, 16, "~r~%i", pb_time);
	        else str = "~g~GO";

	        foreach(Player, i) if(player_reg_pb[i] != -1) GameTextForPlayer(i, str, 1200, 4);

			if(pb_time == 0)
			{
			    foreach(Player, i) if(player_reg_pb[i] != -1) TogglePlayerControllable(i, true);

			    pb_state = 3;
			    pb_time = 300;
			}
	    }
	    else if(pb_state == 3)
	    {
	        new red_team, blue_team;

			format(str, 32, "TIME: %s~n~KILLS: %i/%i", Convert(pb_time), pb_blue_kills, pb_red_kills);

			foreach(Player, i)
			{
				if(player_reg_pb[i] == 0) blue_team++;
				if(player_reg_pb[i] == 1) red_team++;

				if(player_reg_pb[i] != -1) GameTextForPlayer(i, str, 1200, 4);
			}

			if(blue_team == 0) StopGamePB(1);

			if(red_team == 0) StopGamePB(0);

			if(pb_time == 0)
			{
			    if(pb_blue_kills > pb_red_kills) StopGamePB(0);
			    else if(pb_red_kills > pb_blue_kills) StopGamePB(1);
			    else StopGamePB(-1);

			    pb_state = 0;
			    pb_time = 0;
			}
	    }
	}

	if(race_state != 0)
	{
		if(race_time != 0) race_time--;

		if(race_state == 1)
		{
		    if(race_time == 300) SendClientMessageToAll(COLOR_SERVER, "[Balapan]:"W" 5 menit sebelum acara. Gunakan: /gps ({afafaf}Hiburan => Acara balapan{ffffff})");
			if(race_time == 120) SendClientMessageToAll(COLOR_SERVER, "[Balapan]:"W" 2 menit sebelum acara. Gunakan: /gps ({afafaf}Hiburan => Acara balapan{ffffff})");

			if(race_time == 0)
			{
			    new carid, count = 0;

			    foreach(Player, i) if(player_race_reg{i}) count++;

			    if(count > 1)
			    {
				    foreach(Player, i)
				    {
				        if(!player_race_reg{i}) continue;

				        TogglePlayerControllable(i, false);

				        SetPlayerInterior(i, 0);
				        SetPlayerVirtualWorld(i, 1);

				        SetPlayerPos(i, race_vehicle_pos[count][0], race_vehicle_pos[count][1], race_vehicle_pos[count][2]);

				        carid = CreateVehicle(541, race_vehicle_pos[count][0], race_vehicle_pos[count][1], race_vehicle_pos[count][2], race_vehicle_pos[count][2], random(90), random(90), 3600);
						SetVehicleVirtualWorld(carid, 1);

						count++;

						VehInfo[carid][vFuel] = 0.0;
						VehInfo[carid][vSost] = 100;
						VehInfo[carid][vStatus] = 2;

						Fuell[carid] = MAX_VEHICLE_FUEL;

						player_race_vehicle[i] = carid;

						PutPlayerInVehicle(i, carid, 0);
						SetVehicleParamsEx(carid,1,1,0,0,0,0,0);

						SetPlayerArmedWeapon(i, 0);

						player_race_mark[i] = 0;

						UpdatePlayerRaceMark(i);
				    }

				    race_state = 2;
			    	race_time = 20;
			    }
			    else
			    {
			        foreach(Player, i) player_race_reg{i} = 0;

			        SendClientMessageToAll(COLOR_SERVER, "[Balapan]:"W" Pendaftaran dibatalkan, tidak cukup banyak peserta.");

			        race_state = race_time = 0;
			    }
			}
		}
		else if(race_state == 2)
		{
		    if(race_time > 0) format(str, 16, "~r~%i", race_time);
		    else str = "~g~GO";

		    foreach(Player, i)
		    {
		        if(!player_race_reg{i}) continue;

		        GameTextForPlayer(i, str, 1100, 4);

		        if(race_time == 0) TogglePlayerControllable(i, true);
		 	}

		 	if(race_time == 0)
		 	{
		 	    race_state = 3;
		 	    race_time = 600;
		 	}
		}
		else if(race_state == 3)
		{
		    if(race_finish_id == 0)
			{
			    if(GetRacePlayersAmount() == 0) SendClientMessageToAll(COLOR_SERVER, "[Balapan]:"W" Acara selesai, semua pemain meninggalkan balapan.");

			    race_time = 0;
	       	}

			if(race_time == 0) race_state = 0;
		}
	}

	//Mulai
	if(pb_state == 0 && second == 00 && minute == 00 && (hour == 11 || hour == 15 || hour == 21))
	{
	    StartPaint();
	}

	if(second == 00)
	{
	    for(new i; i < MAX_BIZZ_TAXI; i++)
	    {
	    	for(new x; x < MAX_TAXI_VEHICLES; x++)
	    	{
	    	    new vehicleid = taxi_bizz_vehicles[i][x];

	    	    taxi_bizz_fuels[i][x] = Fuell[vehicleid];

	    	    if(hour == 00) SaveTaxiBizzVehicle(i, x);
	    	}
	    }

	    for(new i; i < 8; i++) wh_zones_gang[i] = wh_graffiti_gang[i] = 0;

	    for(new i; i < MAX_ZONES; i++)
	    {
	        if(GZInfo[i][gFraction] == FRACTION_BALLAS) wh_zones_gang[0] ++;
	        if(GZInfo[i][gFraction] == FRACTION_VAGOS) wh_zones_gang[1] ++;
	        if(GZInfo[i][gFraction] == FRACTION_GROVE) wh_zones_gang[2] ++;
	        if(GZInfo[i][gFraction] == FRACTION_AZTEC) wh_zones_gang[3] ++;
	        if(GZInfo[i][gFraction] == FRACTION_RIFA) wh_zones_gang[4] ++;
	    }

	    for(new i; i < MAX_GRAFFITI; i++)
	    {
	        if(graffiti_fraction[i] == FRACTION_BALLAS) wh_graffiti_gang[0] ++;
	        if(graffiti_fraction[i] == FRACTION_VAGOS) wh_graffiti_gang[1] ++;
	        if(graffiti_fraction[i] == FRACTION_GROVE) wh_graffiti_gang[2] ++;
	        if(graffiti_fraction[i] == FRACTION_AZTEC) wh_graffiti_gang[3] ++;
	        if(graffiti_fraction[i] == FRACTION_RIFA) wh_graffiti_gang[4] ++;
	    }

	    for(new i; i < MAX_BIZZ; i++)
	    {
	        if(BizzInfo[i][bMafia] == FRACTION_YAKUZA) wh_zones_gang[5]++;
	        if(BizzInfo[i][bMafia] == FRACTION_COLUMBIA) wh_zones_gang[6]++;
	        if(BizzInfo[i][bMafia] == FRACTION_RUMAFIA) wh_zones_gang[7]++;
	    }

	    for(new i; i < 8; i++) UpdateGangWH3DTextLabel(i);

		//

		new time = gettime();

		for(new i; i < MAX_HOTELS; i++)
		{
		    if(hotel_info[i][hOwned] == 0) continue;
		    if(hotel_info[i][hRentTime] > time) continue;

			new pId = Getplayerid(hotel_info[i][hOwner]);

			if(IsPlayerConnected(pId))
			{
			    PlayerInfo[pId][pHotel] = -1;

	       		if(player_hotel_id[pId] != -1) PlayerLeaveHotelNumber(pId);

	       		SCM(pId, -1, "Anda telah diusir dari kamar hotel karena tidak membayar.");
			}
			else
			{
			    new sql_id = GetPlayerSqlIDByName(hotel_info[i][hOwner]);

			    AddPlayerNotifyBySQL(sql_id, "Kamar hotel Anda dijual tanpa pembayaran.");
			}

	        hotel_info[i][hOwned] = 0;

	        UpdateHotel3DTextLabel(i);

	        format(format_string, 96, "UPDATE `hotels` SET `hOwned` = %i WHERE `id` = %i", hotel_info[i][hOwned], i);
	       	mysql_tquery(mMysql, format_string);

	       	format(format_string, 128, "UPDATE `accounts` SET `pHotel` = -1 WHERE `pName` = '%s'", hotel_info[i][hOwned], hotel_info[i][hOwner]);
	       	mysql_tquery(mMysql, format_string);
		}
	}

	for(new i, z = MAX_BONE_TABLES; i < z; i++)
	{
	    new players = 0;

	    for(new x; x < 4; x++)
	    {
			//new playerid = bones_table_players[i][x];

			if(bones_player_bet[i][x]) players++;

			format(str, 32, "PLAYERS:_%i/4", players);
			TextDrawSetString(bones_table_td[i][1], str);
	    }

	    if(bones_table_state[i] == 1)
	    {
	        bones_table_time[i]--;

	        format(format_string, 16, "%i", bones_table_time[i]);
	        foreach(Player, x) if(player_bone_table[x] == i) GameTextForPlayer(x, format_string, 1100, 4);

	        if(bones_table_time[i] == 1)
			{
				for(new x; x < 4; x++)
				{
					if(bones_table_players[i][x] == INVALID_PLAYER_ID) continue;

					bones_table_dice[i][x] = 3 + random(9);

     				//format(format_string, 96, "? %s jumlahnya turun: %i", PlayerInfo[bones_table_players[i][x]][pName], bones_table_dice[i][x]);
			        //SendBoneTableMessage(i, format_string);
				}
	        }

	        if(bones_table_time[i] == 0)
	        {
	            new win_id = -1, win_dice = -1;

	            for(new x; x < 4; x++)
			    {
			        if(bones_table_players[i][x] == INVALID_PLAYER_ID || bones_player_bet[i][x] == false) continue;

			        if(bones_table_dice[i][x] >= win_dice)
			        {
			            win_id = bones_table_players[i][x];
			            win_dice = bones_table_dice[i][x];
			        }
				}

                for(new x; x < 4; x++)
			    {
			        if(bones_table_players[i][x] == INVALID_PLAYER_ID || bones_player_bet[i][x] == false) continue;

					if(win_id != bones_table_players[i][x]) PlayerPlaySound(bones_table_players[i][x], 1085, 0.0, 0.0, 0.0);

					//SCMF(bones_table_players[i][x], -1, "Anda mendapat nomor: {CC3AFF}%i", bones_table_dice[i][x]);

			        bones_player_bet[i][x] = false;
				}

				if(win_id != -1)
				{
				    new reward = bones_table_bet[i] * players;
				    format(format_string, 144, "Selamat! Anda memenangkan dadu: {FF4500}$%i",reward);
					SendClientMessage(win_id, 0x2eb0ffaa, format_string);
			        format(format_string, 96, "{E79833}%s {FFFFFF}menang dalam dadu (jumlahnya jatuh: {FF4500}%i{FFFFFF})", PlayerInfo[win_id][pName], win_dice);
			        SendBoneTableMessage(i, format_string);

			        GivePlayerMoneyEx(win_id, reward, "tulang");

			        PlayerPlaySound(win_id, 31000, 0.0, 0.0, 0.0);

			        new croup_id = IsBoneTableHaveCroupie(i);

			        if(croup_id != INVALID_PLAYER_ID) GivePlayerPayCheck(croup_id, (bones_table_bet[i] / 100) * 2);
				}

				bones_table_bet[i] = 0;

	            bones_table_state[i] = 0;
	        }
	    }
	}

	if((minute == 15 || minute == 30 || minute == 45 || minute == 59) && second == 00)
	{
		for(new i; i < MAX_TRASH; i++) if(trash_info[i][t_amount] <= 90) UpdateTrashAmount(i, 10);
		for(new i; i < TotalAtms; i++) if(AtmsInfo[i][c_amount] <= 10) UpdateCollectorAmount(i, 40);
	}

	switch(hour)
	{
	    case 10, 12, 15, 16, 18, 21:
	    {
	        if(minute == 3 || minute == 25 || minute == 26)
	        {
	            if(race_state == 0) StartRace();
	        }
	    }
	}

	if(fraction_steal_block != 0) fraction_steal_block--;

 	if(minute == 00 && second == 50) SetWorldTime(hour);

    if(minute == 10 && second == 00 || minute == 30 && second == 00 || minute == 50 && second == 00)
	{
		switch(random(5))
		{
	   		case 2: SendClientMessageToAll(0xa86cfcff,"? {ffffff}Undang teman Anda dan dapatkan {a86cfc}50.000$"W" mata uang game saat menjangkau teman {a86cfc}4-pergi"W" level");
			case 3: SendClientMessageToAll(0xa86cfcff,"? {ffffff}Bergabunglah dengan grup server kami: {a86cfc}https://discord.gg/gpDUB5n"W" dan sadarilah semua berita terbaru!");
			case 4: SendClientMessageToAll(0xa86cfcff,"? {ffffff}Anda dapat mengisi kembali akun Anda hanya di situs web resmi: {0000ff}Malavida ..website "W"> {a86cfc}Selesai");
		}
	}
	if(minute == 37 && second == 00)
	{
		if(hour % 2 == 0) SaveHouseAll(), print("[MySQL R41-3]: Rumah dan mobil telah berhasil diselamatkan.");
		else SaveBizzAll(), SaveABizzAll(), print("[MySQL R41-3]: Bisnis dan pompa bensin berhasil diselamatkan.");
    }
 	if(hour == 23 && minute == 55 && second == 00)
 	{
 	    new strstre[16];
		format(strstre, 16, "%d/%d/%d",year,month,day);

	    for(new i; i < TotalBizz; i++)
	    {
	        if(!BizzInfo[i][bOwned]) continue;

            if(BizzInfo[i][bOplata]) BizzInfo[i][bOplata] --;
            if(BizzInfo[i][bOplata] <= 0) BizzInfo[i][bOplata] = 0, BizzInfo[i][bSlet] = 1;

    		format(MySQLStr, 144, "INSERT INTO `bizz_stats`(`bID`, `bData`, `bSumma`) VALUES (%d,'%s',%d)", i, strstre, BizzInfo[i][bRaschet]);
			mysql_tquery(mMysql, MySQLStr, "", "");

			BizzInfo[i][bRaschet] = 0;
			SaveBizz(i);
		}
  	}
  	if(hour == 23 && minute == 58 && second == 00)
 	{
 	    new strstre[16];
		format(strstre,sizeof(strstre), "%d/%d/%d",year,month,day);

	    for(new i=1; i <= TotalABizz; i++)
	    {
	        if(!BizzAInfo[i][aOwned]) continue;

            if(BizzAInfo[i][aOplata]) BizzAInfo[i][aOplata] --;
            if(BizzAInfo[i][aOplata] <= 0) BizzAInfo[i][aOplata] = 0, BizzAInfo[i][aSlet] = 1;

    		format(MySQLStr, 144, "INSERT INTO `bizz_astats`(`aID`, `aData`, `aSumma`) VALUES (%d,'%s',%d)", i, strstre, BizzAInfo[i][aRaschet]);
			mysql_tquery(mMysql, MySQLStr, "", "");

			BizzAInfo[i][aRaschet] = 0;
			SaveABizz(i);
		}
  	}
  	if(hour == 00 && minute == 00 && second == 30)
 	{
 	    for(new i; i < MAX_HOUSES; i++)
		{
		    if(HouseInfo[i][hOwned] == 1)
		    {
				if(HouseInfo[i][hOplata] >= 1) HouseInfo[i][hOplata] --;
				if(HouseInfo[i][hOplata] <= 0) HouseInfo[i][hOplata] = 0, HouseInfo[i][hSlet] = 1;
				SaveHouse(i);
			}
  	   	}
  	}
  	for(new v = 0; v < MAX_VEHICLES; v++)
	{
	    if(pizza_veh_time{v})
	    {
	        pizza_veh_time{v}--;
	        if(pizza_veh_time{v} == 0) pizza_veh_have{v} = 0;
	    }

		GetVehicleParamsEx(v,engine,lights,alarm,doors,bonnet,boot,objective);
		if(engine && Fuell[v] > 0.0 && IsVehicleHaveFuel(v))
		{
			if(GetVehicleSpeed(v) < 1.0) Fuell[v] -= 0.01;
			else if(1.0 <= GetVehicleSpeed(v) <= 60.0) Fuell[v] -= 0.02;
		    else Fuell[v] -= 0.03;

			if(vehicle_owner_id[v] != INVALID_PLAYER_ID)
			{
			    new owner_id = vehicle_owner_id[v];

			    for(new i; i < MAX_PLAYER_VEHICLES; i++)
			    {
			        if(v != player_home_car[owner_id][i]) continue;

                    CarInfo[owner_id][cFuel][i] = Fuell[v];
					CarInfo[owner_id][cProbeg][i] = Milliage[v];
			    }
			}
		}
	}

	new Float: health;

	for(new i; i < MAX_VEHICLES; i++)
	{
		GetVehicleHealth(i, health);
		if(health < 350.0)
		{
			SetVehicleHealth(i, 350.0);

			GetVehicleParamsEx(i,engine,lights,alarm,doors,bonnet,boot,objective);
    		return SetVehicleParamsEx(i, 0,lights,alarm,doors,bonnet,boot,objective);
		}
	}

	return 1;
}
stock PlayerUpdate()
{
    new hour, minute, second,stateEx;
	gettime(hour, minute, second);

	if(hour == 23 && minute == 59 && second == 59)
	{
	    foreach(Player, i) PlayerInfo[i][pInGameSeconds] = PlayerInfo[i][pInGameAFKSeconds] = 0;

		format(format_string, 188, "UPDATE `accounts` SET `pInGameSeconds` = 0, `pInGameAFKSeconds` = 0, `last_curdate` = %i WHERE `pLogin` = 1", getdate());
		mysql_tquery(mMysql, format_string);
	}

	foreach(Player, playerid)
	{
		if(PlayerInfo[playerid][TempatHealing])
	    {
	        stresstimer[playerid] = SetTimerEx("StressBerkurang", 5000, true, "d", playerid);
	    }
	    if(PlayerInfo[playerid][pStress] <= 15)
	    {
	        PlayerInfo[playerid][TempatHealing] = false;
	        KillTimer(stresstimer[playerid]);
	    }
	    stateEx = GetPlayerState(playerid);

		if(GetPVarInt(playerid, "LoginOgran") != -1)
		{
			SetPVarInt(playerid, "LoginOgran", GetPVarInt(playerid, "LoginOgran") -1);

			if(GetPVarInt(playerid, "LoginOgran") == 0) return KickD(playerid, "Anda telah lama ditendang dalam mode otorisasi / registrasi!");
		}

		if(cant_make_offer[playerid]) cant_make_offer[playerid]--;

		if(GetPVarInt(playerid,"Drug_Time"))
		{
			SetPVarInt(playerid,"Drug_Time",GetPVarInt(playerid,"Drug_Time") - 1);
			if(GetPVarInt(playerid,"Drug_Time") == 100) SetPlayerWeather(playerid, weather_id);
		}

		if(PlayerInfo[playerid][pLogin] && GetPlayerDistanceFromPoint(playerid, 0.0, 0.0, 0.0) < 10.0)
		{
            /*SpawnPlayerEx(playerid);
            printf("[FIX-SPAWN] %s[%i] | %i %i", GetPlayerNameEx(playerid), playerid, PlayerInfo[playerid][pSetSpawn], PlayerInfo[playerid][pMember]);*/
		}

		if((beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_DRIVER && PlayerInfo[playerid][pLicenses][0] ||
			beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_PHONE && PlayerInfo[playerid][pProducts][0] ||
			beg_quest_info[playerid][b_quest_id] == QUEST_TYPE_FRACTION && PlayerInfo[playerid][pMember]) && beg_quest_info[playerid][b_quest_status] == 1)
		{
	        SCM(playerid, COLOR_YELLOW, "[QUEST] {FFFFFF}Quest quest telah selesai, cukup serahkan.");

	        beg_quest_info[playerid][b_quest_status] = 2;

	        OnPlayerUpdateAccountsPer(playerid, "b_quest_status", 2);
		}

		if(follow_id[playerid] != INVALID_PLAYER_ID)
		{
			new to_player = follow_id[playerid];

		    if(!IsPlayerInAnyVehicle(to_player) && !IsPlayerInAnyVehicle(playerid))
			{
				if(GetDistanceBetweenPlayers(playerid, to_player) < 1.5) ClearAnimations(playerid), TogglePlayerControllable(playerid, false);
				else if(1.5 <= GetDistanceBetweenPlayers(playerid, to_player) <= 10.0)
				{
				    TogglePlayerControllable(playerid,true);
					SetPlayerToFacePlayer(playerid, to_player);
					ApplyAnimation(playerid, "ped", "WALK_civi", 6.0, 1, 1, 1, 1, 0, 1);
				}
				else if(GetDistanceBetweenPlayers(playerid, to_player) > 10.0)
				{
					new Float: x, Float: y, Float: z;

					GetPlayerPos(to_player, x, y, z);

				    SetPPos(playerid, x, y + 0.3, z, 0.0, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), false);

                    SetPlayerToFacePlayer(playerid, to_player);

					/*SCMF(to_player,COLOR_REDD,"Anda telah pindah terlalu jauh dari %s[%i], yang Anda pimpin!",GetPlayerNameEx(to_player),to_player);
					follow_id[playerid] = INVALID_PLAYER_ID;
					TogglePlayerControllable(playerid,false);*/
				}
		  	}
	        else
			{
				follow_id[playerid] = INVALID_PLAYER_ID;
				ClearAnimations(playerid);
			}
		}

		if(gSpectateID[playerid] != INVALID_PLAYER_ID)
		{
		    new spec_id = gSpectateID[playerid];

		    if(IsPlayerConnected(spec_id))
		    {
			    if(GetPlayerInterior(playerid) != GetPlayerInterior(spec_id)) SetPlayerInterior(playerid, GetPlayerInterior(spec_id));
			    if(GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(spec_id)) SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(spec_id));
			}
			else StopSpectate(playerid);
		}

		if(pTemp[playerid][uborka_timer] != 0)
		{
		    pTemp[playerid][uborka_timer]--;

		    format(format_string, 16, "~r~%i", pTemp[playerid][uborka_timer]);
		    GameTextForPlayer(playerid, format_string, 1100, 4);

		    if(pTemp[playerid][uborka_timer] == 0) spawned_uborka(playerid);
		}

		if(pTemp[playerid][bus_timer] != 0)
		{
		    pTemp[playerid][bus_timer]--;

		    format(format_string, 16, "~r~%i", pTemp[playerid][bus_timer]);
		    GameTextForPlayer(playerid, format_string, 1100, 4);

		    if(pTemp[playerid][bus_timer] == 0) spawned_bus(playerid);
		}

		if(player_rob_id[playerid] != -1 && player_rob_progress[playerid] > 0)
		{
		    new rob_id = player_rob_id[playerid];

	     	if(player_rob_progress[playerid] == 1)
	     		for(new i; i < 2; i++)
				 	TextDrawShowForPlayer(playerid, rob_global_td[i]);

			player_rob_progress[playerid]++;

		    PlayerTextDrawTextSize(playerid, rob_player_td[playerid], 273.6195 + ((78.3805 / 100) * (player_rob_progress[playerid] * 10)), 0.0000);

			PlayerTextDrawHide(playerid, rob_player_td[playerid]);
			PlayerTextDrawShow(playerid, rob_player_td[playerid]);

			ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 0, 0, 0, 0, 0,1);

			if(player_rob_progress[playerid] == 10)
			{
				new h_id = rob_info[rob_id][r_house];

				player_rob_progress[playerid] = 0;

				HouseInfo[h_id][hLock] = 0;

				PlayerStopTryOpenDoor(playerid);

				SendMessageToRobPlayers(rob_id, 0x6495EDff, "[ROB]: "W"Gubuk {6495ED}diretas, lalat.");
			}
		}

		new vehicleid = GetPlayerVehicleID(playerid);

		if(vehicleid != INVALID_VEHICLE_ID && (70 <= PlayerInfo[playerid][pJob] <= 72) && (70 <= VehInfo[vehicleid][vFr] <= 72) && player_taxi_passanger[playerid] != INVALID_PLAYER_ID)
		{
		    new Float: distance = GetPlayerDistanceFromPoint(playerid, player_taxi_X[playerid], player_taxi_Y[playerid], player_taxi_Z[playerid]);

		    if(distance > 500.0)
		    {
		        new b_id = PlayerInfo[playerid][pJob];

		        new passanger_id = player_taxi_passanger[playerid];
		        new price = BizzInfo[b_id][bPrice];

		        if(PlayerInfo[passanger_id][pCash] < price)
		        {
		            player_taxi_passanger[playerid] = INVALID_PLAYER_ID;

		            SearchNextClientForTaxi(vehicleid, passanger_id);

		            RemovePlayerFromVehicleEx(passanger_id);
		            SendClientMessage(playerid, -1, "Penumpang tidak memiliki dana untuk melanjutkan perjalanan!");
					SendClientMessage(passanger_id, COLOR_GREY, "Anda tidak memiliki dana untuk melanjutkan perjalanan Anda!");
		        }
		        else
		        {
	                GivePlayerMoneyEx(playerid, price, "gaji taksi");
		            GivePlayerMoneyEx(passanger_id, -price, "pembayaran taksi");

		            format(format_string, 32, "~g~+~w~$%i", price);
		            GameTextForPlayer(playerid, format_string, 3000, 3);

		            format(format_string, 32, "~r~-~w~$%i", price);
		            GameTextForPlayer(passanger_id, format_string, 3000, 3);
		        }

		        GetPlayerPos(playerid, player_taxi_X[playerid], player_taxi_Y[playerid], player_taxi_Z[playerid]);
		    }
		}

		if(player_quest_info[playerid][quest_block] != 0)
		{
		    player_quest_info[playerid][quest_block]--;

		    if(player_quest_info[playerid][quest_block] == 0)
		    {
		        switch(player_quest_info[playerid][quest_id])
		        {
		            case GQUEST_TYPE_GRAFFITI..GQUEST_TYPE_DRUGMARK: SCM(playerid, 0xffff00ff, "SMS: Saya punya pekerjaan untuk Anda, lihat saya ketika ada waktu. | Pengirim: Ryder Wilson");
		            case GQUEST_TYPE_DOCSTEAL: SCM(playerid, 0xffff00ff, "SMS: Datang kepada saya segera, saya butuh bantuan Anda! | Pengirim: Ryder Wilson");
		        }

		        OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_block", 0);
		    }
		}

		//new vehicleid = GetPlayerVehicleID(playerid);

		if(PlayerInfo[playerid][pVip] > 0)
		{
			if(PlayerInfo[playerid][pVipTime] < gettime())
			{
			    PlayerInfo[playerid][pVip] = 0;
			    PlayerInfo[playerid][pVipTime] = 0;

			    SendClientMessage(playerid, COLOR_YELLOW, "VIP kedaluwarsa.");

			    format(format_string, 144, "UPDATE `accounts` SET `pVip` = 0, `pVipTime` = 0 WHERE `pID` = %i", PlayerInfo[playerid][pID]);
			    mysql_tquery(mMysql, format_string);
			}
		}

		if(graffiti_player_id[playerid] != -1 && GetPVarInt(playerid,"ColorFire") && GetPlayerWeapon(playerid) == 41)
		{
		    new g_id = graffiti_player_id[playerid];

	        if(IsPlayerInRangeOfPoint(playerid,2.0,graffiti_obj_pos[g_id][0],graffiti_obj_pos[g_id][1],graffiti_obj_pos[g_id][2]))
			{
			    new Float:angle;
			    GetPlayerFacingAngle(playerid, angle);

				if(graffiti_obj_pos[g_id][4]-30.0 < angle < graffiti_obj_pos[g_id][4]+30.0)
			    {
			        graffiti_player_progress[playerid]++;

			        PlayerTextDrawTextSize(playerid, graffiti_player_td[playerid], 273.6195 + ((78.3805 / 100) * (graffiti_player_progress[playerid] * 10)), 0.0000);

					if(graffiti_player_progress[playerid] == 1)
					{
					    for(new i; i < 2; i++) TextDrawShowForPlayer(playerid, graffiti_global_td[i]);
						PlayerTextDrawShow(playerid, graffiti_player_td[playerid]);
					}

					PlayerTextDrawHide(playerid, graffiti_player_td[playerid]);
					PlayerTextDrawShow(playerid, graffiti_player_td[playerid]);

			        if(graffiti_player_progress[playerid] >= 10 || graffiti_fraction[g_id] == PlayerInfo[playerid][pMember])
			        {
			            graffiti_block[g_id] = gettime() + 3600;

			            if(graffiti_fraction[g_id] != PlayerInfo[playerid][pMember])
						{
			            	format(format_string, 188, "UPDATE `graffiti` SET `owner_frac` = %i, `color_owner` = '%s', `block` = %i WHERE `id` = %i", PlayerInfo[playerid][pMember], GetPlayerNameEx(playerid), graffiti_block[g_id], g_id);
			            	mysql_tquery(mMysql, format_string);

							format(graffiti_colored[g_id], MAX_PLAYER_NAME, GetPlayerNameEx(playerid));
						}

			            if(player_quest_info[playerid][quest_id] == GQUEST_TYPE_GRAFFITI && player_quest_info[playerid][quest_status] == 1)
			            {
			                player_quest_info[playerid][quest_progress]++;

			                if(player_quest_info[playerid][quest_progress] >= 1)
			                {
			                    player_quest_info[playerid][quest_status] = 2;

			                    OnPlayerUpdateAccountsPer(playerid, "warehouse_quest_status", 2);

			                    SetTimerEx("SendPlayerQuestInfoSMS", 15000, false, "ii", playerid, 1);
			                }
			                else SCMF(playerid, COLOR_YELLOW, "[QUEST] Grafiti: %i/10", player_quest_info[playerid][quest_progress]);
			            }

						graffiti_fraction[g_id] = PlayerInfo[playerid][pMember];

			            UpdateGraffitiGang(g_id);

			            PlayerStopRestyleGraffiti(playerid);
			        }
			    }
			}
		}

	    //new tickcount1 = GetTickCount();
		if(player_lecenie[playerid] != -1)
		{
		    new Float:shealth;
			GetPlayerHealth(playerid, shealth);
		    if(shealth < 100)
			{
			    SetPVarInt(playerid, "OplataLecenie", GetPVarInt(playerid, "OplataLecenie")+2);
				GameTextForPlayer(playerid, "~h~~g~+1hp", 1000, 5);
				SetPlayerHealthEx(playerid, shealth+1);
			}
		    else
			{
			    PlayerInfo[playerid][pBolnica] = 0;
			    Send(playerid, 0xFDEAA8FF, "Anda benar-benar sembuh...");

			    format(String, 144, ""W"Anda keluar dari rumah sakit.\nPembayaran untuk layanan publik berjumlah: %d$", GetPVarInt(playerid, "OplataLecenie"));
			    SPD(playerid,9995,DIALOG_STYLE_MSGBOX,"{E5D81E}Pernyataan", String, "Tutup","");

			    PlayerLeaveHospitalBed(playerid);
			}
		}
	    if(PlayerInfo[playerid][pCash] != GetPlayerMoney(playerid)) ResetPlayerMoney(playerid), GivePlayerMoney(playerid, PlayerInfo[playerid][pCash]);

		if(!PlayerToPoint(3.0, playerid, PosPic[playerid][0][0], PosPic[playerid][0][1], PosPic[playerid][0][2])) ac_pickups[playerid][0] = -1; // antiflood pickup
	    if(!PlayerToPoint(3.0, playerid, PosPic[playerid][1][0], PosPic[playerid][1][1], PosPic[playerid][1][2])) ac_pickups[playerid][1] = -1; // antiflood pickup

		if(stateEx == PLAYER_STATE_DRIVER)
		{
			new Float:ms = (SpeedVehicle(playerid)/8.6)/600;
			if(ms > 0) Milliage[GetPlayerVehicleID(playerid)] += ms;
	  	}
		//if(minute == 10 && second == 00 || minute == 35 && second == 00 || minute == 50 && second == 00) Quest(playerid);
		//
		if(second == 00)
	 	{
	 	    new f_id = PlayerInfo[playerid][pMember];
			if(f_id && form_fraction[playerid])
			{
			    new rang_id = PlayerInfo[playerid][pRank];

			    GivePlayerPayCheck(playerid, FracInfo[f_id][fSalary][rang_id] / 60);
			}

		    if(PlayerInfo[playerid][pDrunk]) GivePlayerDrunkLevel(playerid, -1);

	 	    //
            new Float:health;
			GetPlayerHealth(playerid,health);

			if(PlayerInfo[playerid][pSatiety] > 0 && !PlayerInfo[playerid][pInfSatiety]) UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety] - 0.4);

			if(health > 10)
			{
   			if(PlayerInfo[playerid][pUpdPlayer][0] == 1 && PlayerInfo[playerid][pSatiety] < 5) SetPlayerHealthEx(playerid, health - 1.0);
			}
			if(PlayerInfo[playerid][pThirst] > 0 && !PlayerInfo[playerid][pInfSatiety]) UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst] - 1.0);
			if(PlayerInfo[playerid][pSatiety] > 0 && !PlayerInfo[playerid][pInfSatiety]) UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety] - 0.5);
			
			if(health > 10)
			{
   			if(PlayerInfo[playerid][pUpdPlayer][0] == 1 && PlayerInfo[playerid][pThirst] < 0) SetPlayerHealthEx(playerid, health - 1.4);
			}
		}

		if(player_road_school[playerid] == 2 && player_school_back[playerid] != 0)
		{
		    player_school_back[playerid]--;

		    format(format_string, 32, "TIME: %i", player_school_back[playerid]);
		    GameTextForPlayer(playerid, format_string, 1200, 0);

		    if(player_school_back[playerid] == 0)
		    {
		        player_road_school[playerid] = 0;
				player_road_id[playerid] = -1;

				new school_veh_id = GetPVarInt(playerid, "school_vehicle");

				SetVehicleToRespawn(school_veh_id);

				DisablePlayerRaceCheckpoint(playerid);

		        SendClientMessage(playerid, COLOR_GREY, "Anda tidak kembali ke transportasi, ujian gagal.");

		        DeletePVar(playerid, "school_vehicle");
		    }
		}

		if(killer_clear[playerid])
		{
		    killer_clear[playerid]--;

		    if(killer_clear[playerid] == 0) killer_id[playerid] = INVALID_PLAYER_ID;
		}

	    if(trash_player_back[playerid])
	    {
	        trash_player_back[playerid]--;
	        if(trash_player_back[playerid] == 0)
	        {
	            SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
				player_jobvehicle_time[playerid] = 0;
	            rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

	            SendClientMessage(playerid, COLOR_RED, "Anda tidak punya waktu untuk kembali ke transportasi dan menghilang!");
	        }
	    }
	    if(collector_player_back[playerid] != 0)
	    {
	        collector_player_back[playerid]--;
	        if(collector_player_back[playerid] == 0)
	        {
	            SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
				player_jobvehicle_time[playerid] = 0;
	            rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

	            SendClientMessage(playerid, COLOR_RED, "Anda tidak punya waktu untuk kembali ke transportasi dan menghilang!");
	        }
	    }

		PlayerInfo[playerid][pInGameHourSeconds]++;

  		PlayerInfo[playerid][pInGameSeconds]++;

		new play_time = PlayerInfo[playerid][pInGameSeconds] - PlayerInfo[playerid][pInGameAFKSeconds];

		if(play_time > 0 && (play_time % 3600) == 0 && afk_time[playerid] == 0)
		{
		    PlayerInfo[playerid][pFreeRoulet]++;
		  	OnPlayerUpdateAccountsPer(playerid, "pFreeRoulet", PlayerInfo[playerid][pFreeRoulet]);

		  	SCMF(playerid, COLOR_YELLOW, "[Perhatikan] {FFFFFF}Anda bermain 1 jam dan mendapat roulette pemintalan gratis(/roulette), total: %i", PlayerInfo[playerid][pFreeRoulet]);
		}

		// AFK
		new StringF[50];
	 	if(afk_tick[playerid] > 10000) afk_tick[playerid] = 1, afk_check[playerid] = 0;
	 	if(afk_check[playerid] < afk_tick[playerid] && GetPlayerState(playerid)) afk_check[playerid] = afk_tick[playerid], afk_time[playerid] = 0;
	 	if(afk_check[playerid] == afk_tick[playerid] && GetPlayerState(playerid))
	  	{
	   		afk_time[playerid]++;
	     	if(afk_time[playerid] > 2)
	      	{
	      	    PlayerInfo[playerid][pInGameAFKSeconds]++;

	       		format(StringF,sizeof(StringF), "[AFK] [%s detik]",Convert(afk_time[playerid]-2));
				SetPlayerChatBubble(playerid, StringF, COLOR_RED, 15.0, 1200);
	    	}
      		if(afk_time[playerid] > 120 && !admin_level[playerid])
            {
                new str[80];
                format(str, sizeof(str), "Bot MVRP: %s Has Been Kicked. Reason: AFK 2 Minute", Name(playerid));
                SendAdminMessage(COLOR_LIGHTRED, str);
                //SendClientMessageToAll(COLOR_RED, str);
                Kick(playerid);
            }
	    }
	    if(GetPVarInt(playerid, "AntiSbiv") <= gettime() && GetPVarInt(playerid, "AntiSbiv") != 0)
	    {
			DeletePVar(playerid,"AntiSbiv");
			if(player_job[playerid] == 1)
			{
				new bablo[50];
				SetPVarInt(playerid,"Saw",0);
				ClearAnimations(playerid);
				new rand = random(20);
				SetPlayerCheckpoint(playerid, RandomSaw[rand][0], RandomSaw[rand][1], RandomSaw[rand][2], 2.0);
				SetPVarInt(playerid,"Saw_",rand);
				GivePlayerMoneyEx(playerid, 25000, "memotong kayu"); //TEST
				SetPVarInt(playerid,"JobMoney",GetPVarInt(playerid,"JobMoney")+25000);
				format(bablo,32,"~g~+25000$~n~~b~TOTAL:~w~ %i$",GetPVarInt(playerid,"JobMoney"));
				GameTextForPlayer(playerid,bablo, 25000, 1);
				SendClientMessage(playerid,-1,"Anda telah berhasil menebang pohon, melanjutkan pekerjaan Anda");
			}
			else if(player_job[playerid] == 3)
			{
				ClearAnimations(playerid);
				DestroyObject(PlantObject[playerid]);
				PlantObject[playerid] = -1;
				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
				DisablePlayerCheckpoint(playerid);
				SetPlayerCheckpoint(playerid,2564.6721,-1292.9766,1044.1250,2.0);
				SetPVarInt(playerid,"CHECKPOINTID",5);
				SendClientMessage(playerid,-1,"Anda telah mengumpulkan produk, bawa ke gudang. {afafaf}(spidol merah)");

				SetPlayerAttachedObject(playerid, 2 , 2358, 1,0.11,0.36,0.0,0.0,90.0);
			}
			else if(player_job[playerid] == 4)
			{
				new rand = RandomEx(1,30);
				new stirng[155];
				RemovePlayerAttachedObject(playerid,0);
				SetPVarInt(playerid,"RibaKG",GetPVarInt(playerid,"RibaKG")+rand);
				TogglePlayerControllableEx(playerid, 1);
				ApplyAnimation(playerid, "CARRY", "crry_prtial", 2.0, 0, 0, 0, 0, 0);
				format(stirng, 155,"Anda menangkap ikan {20A9FF}%d{FFFFFF} kg. Semua yang kamu tangkap {20A9FF}%d{FFFFFF}. {afafaf}(Penghasilan: %i)",rand,GetPVarInt(playerid,"RibaKG"),GetPVarInt(playerid,"RibaKG")*2);
				SendClientMessage(playerid, -1, stirng);
				DeletePVar(playerid,"Fishing");
				ClearAnimations(playerid);
			}
		}
	 	if(IsAWorkbench(playerid) && GetPVarInt(playerid,"Metall") == 1 && player_job[playerid] == 3)
		{
			new Float:x,Float:y,Float:z,Float:a;
			GetPlayerPos(playerid,x,y,z);
			if(IsPlayerAttachedObjectSlotUsed(playerid,2)) RemovePlayerAttachedObject(playerid,2);
			DeletePVar(playerid,"Metall");
			SetPVarInt(playerid,"AntiSbiv",gettime()+20);
			GetPlayerFacingAngle(playerid,a);
			ClearAnimations(playerid);
			if(floatround(a) > 130 && floatround(a) < 300) PlantObject[playerid] = CreateObject(1356,x,y-0.85,1044.20703125,0.00000000,0.00000000,0.00000000);
			else PlantObject[playerid] = CreateObject(1356,x,y+0.85,1044.20703125,0.00000000,0.00000000,0.00000000);
			ApplyAnimation(playerid,"CAR_CHAT","CAR_Sc4_BL",4.0,1,1,1,0,0,0);
		}
	    // cars
	    if(player_jobvehicle_time[playerid] > 0)
		{
			player_jobvehicle_time[playerid]--;
			format(String, 64, "~y~TIME:~n~~b~%d", player_jobvehicle_time[playerid]);
			GameTextForPlayer(playerid, String, 1000, 4);

			if(player_jobvehicle_time[playerid] <= 0)
			{
			    player_product_id[playerid] = -1;

			    Send(playerid, COLOR_GREY, "Transportasi kerja disita...");
				SetVehicleToRespawnEx(rent_job_vehicle[playerid]);
				player_jobvehicle_time[playerid] = 0;
				rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
				DisablePlayerRaceCheckpoint(playerid);
				DisablePlayerCheckpoint(playerid);
				if(GetPVarInt(playerid, "GPS") != 0) SetPVarInt(playerid, "GPS", 0);
				if(PlayerInfo[playerid][pJob] == 7 && pTemp[playerid][pPilot_Access] == true) {
				    pTemp[playerid][pPilot_Access] = false;
				 	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
					pTemp[playerid][pPilot] =
					pTemp[playerid][pPilot_Checkpoint] = 0;
				}
				if(player_take_collector[playerid] != -1) RemovePlayerAttachedObject(playerid, 4);
				if(PlayerInfo[playerid][pJob] == WORK_TYPE_DELIVERY)
				{
					DestroyDeliveryObject(playerid);
				}
				if(PlayerInfo[playerid][pJob] == 6 && pTemp[playerid][pTrucker_Access] == true)
				{
					pTemp[playerid][pTrucker_Unit] = 0;
					pTemp[playerid][pTrucker] = -1;
					rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;

					pTemp[playerid][pTrucker_Access] = false;
				}
			}
		}
		//
	    if(afk_time[playerid] > 1200 && admin_level[playerid] == 0) KickD(playerid, "Anda telah lama ditendang dalam mode AFK.");

		if(CellTime[playerid] > 0)
		{
			CellTime[playerid]++;
			if(Mobile[Mobile[playerid]] == -1 && CellTime[playerid] == 5)
			{
				CellTime[playerid] = 0;
				format(String, 53, "Di %s telepon berdering", Name(Mobile[playerid])), SetPlayerChatBubble(Mobile[playerid], String, COLOR_PURPLE, 10.0, 5000);
				PlayerPlaySound(Mobile[playerid], 20600, 0.0, 0.0, 0.0);
			}
		}
		if(player_search_player[playerid] != -1)
		{
		    new Float:X,Float:Y,Float:Z;
			GetPlayerPos(player_search_player[playerid], X,Y,Z);

			if(GetPlayerVirtualWorld(player_search_player[playerid]) != 0) return Send(playerid,COLOR_GREY,"Komunikasi dengan satelit terputus, mungkin pemain memasuki interior atau menghadiri suatu acara."), player_search_player[playerid] = -1;
			if(GetPlayerInterior(player_search_player[playerid]) != 0) return Send(playerid,COLOR_GREY,"Komunikasi dengan satelit terputus, mungkin pemain telah memasuki interior."), player_search_player[playerid] = -1;
			DisablePlayerCheckpoint(playerid), SetPlayerCheckpoint(playerid, X,Y,Z, 3);
		}
 	// timers
		if(PlayerInfo[playerid][pPrison] > 0)
		{
			PlayerInfo[playerid][pPrison]--;

			if(PlayerInfo[playerid][pPrison] == 0)
			{
				if(PlayerInfo[playerid][pMestoPrison] == 1) t_SetPlayerPos(playerid, 1542.4401,-1675.5422,13.6468), SetPlayerFacingAngle(playerid, 87.3740);
				else if(PlayerInfo[playerid][pMestoPrison] == 2) t_SetPlayerPos(playerid, -304.1972,1537.6333,75.5625), SetPlayerFacingAngle(playerid, 184.3335);
				else SpawnPlayerEx(playerid);

				PlayerInfo[playerid][pMestoPrison] = 0;
				Send(playerid, COLOR_ISPOLZUY, "Anda telah membayar hutang Anda kepada masyarakat, sekarang Anda bebas!");
				if(PlayerInfo[playerid][pCash] >= 500) GivePlayerMoneyEx(playerid, -500, "jailbreak");
				PlayerInfo[playerid][pWanted] = 0;
				SetPlayerWantedLevel(playerid, 0);
				SetPlayerVirtualWorld(playerid, 0), SetPlayerInterior(playerid, 0);
				SetCameraBehindPlayer(playerid);
				GameTextForPlayer(playerid,"~g~Freedom", 3000, 1);
			}
		}
        if(PlayerInfo[playerid][pDelayDeath] > 0)
		{
			PlayerInfo[playerid][pDelayDeath]--;

			if(PlayerInfo[playerid][pDelayDeath] == 0)
			{

				PlayerInfo[playerid][pDelayDeath] = 0;
			}
		}
		if(PlayerInfo[playerid][pMuted] > 0) PlayerInfo[playerid][pMuted]--;
		for(new i=1; i <= TotalActor; i++) { if(ActorInfo[i][aAntiFlood] > 0) ActorInfo[i][aAntiFlood] --; }

		if(second == 00 || second == 30 || second == 45) { if(player_warning_ac[playerid] != 0) player_warning_ac[playerid]--; }

		if(player_gos_time[playerid] > 0) player_gos_time[playerid]--;
		if(player_veh_damage[playerid] > 0) player_veh_damage[playerid]--;
	}

	return 1;
}
epublic:UpdateSpeedometr(playerid)
{
 	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
	    if(!IsPlayerMobile(playerid) || GetPVarInt(playerid, "test_speed"))
		{
		    for(new i; i < 6; i++)
			{
			    PlayerTextDrawHide(playerid, Speedo_Majestic[playerid][i]);
			}
		    /*for(new i; i < 9; i++)
			{
			    TextDrawHideForPlayer(playerid, speed_global_td[i]);
			}
			PlayerTextDrawHide(playerid, speed_player_td[playerid][0]);
			PlayerTextDrawHide(playerid, speed_player_td[playerid][1]);
			PlayerTextDrawHide(playerid, speed_player_td[playerid][2]);
			HidePlayerProgressBar(playerid, FuelBar[playerid]);*/
	    }

		return 0;
	}

	new vehicleid = GetPlayerVehicleID(playerid);
	new model = GetVehicleModel(vehicleid);
	if(model)
	{
		new str3[116];
		new Float: fuel = Fuell[vehicleid], speed = SpeedVehicle(playerid);
		new Float: carhp;
        if(!IsPlayerMobile(playerid) || GetPVarInt(playerid, "test_speed"))
        {
        	GetVehicleHealth(vehicleid, carhp);
        	
        	//
            PlayerTextDrawSetString(playerid, Speedo_Majestic[playerid][1], IntToString(speed));
          
            format(str3, 32, "%0.00fL", fuel);
            PlayerTextDrawSetString(playerid, Speedo_Majestic[playerid][3], str3);
            
            format(str3, 32, "%0.0f%", carhp);
            PlayerTextDrawSetString(playerid, Speedo_Majestic[playerid][5], str3);
            //

        	format(str3, 32, "%0.0f%", carhp);
            PlayerTextDrawSetString(playerid, speed_player_td[playerid][0], str3);

            PlayerTextDrawSetString(playerid, speed_player_td[playerid][1], IntToString(speed));

			SetPlayerProgressBarValue(playerid, FuelBar[playerid], fuel);

    	}

    	//Perfomance Tuning
        #define _TDW_BOOSTER_INACCURACY (0.15)
        #define _TDW_BOOSTER_BOOST_SPEED (2.5)
        #define _TDW_BOOSTER_MIN_SPEED (5.0)

        static Float:z_angle_old[MAX_VEHICLES],
            Float:z_angle,
            Float:angle_tmp,
            Float:tmp;

        new Keys,ud,lr;
        GetPlayerKeys(playerid,Keys,ud,lr);

        GetVehicleZAngle(vehicleid, z_angle);

        new engine_level;

        for(new i; i < 5; i++) if(VehInfo[vehicleid][vEngineTune][i]) engine_level++;

        new max_speed = VehStats[model - 400][vMaxSpeed] + (VehStats[model - 400][vMaxSpeed] / 10) * engine_level;

        if(engine_level != 0 && Keys == KEY_SPRINT && (30 <= speed <= max_speed))
        {
            tmp = z_angle_old[vehicleid] = floatround(floatabs(floatadd(z_angle_old[vehicleid], _TDW_BOOSTER_INACCURACY)));
            angle_tmp = floatround(floatabs(z_angle));

            if (_:(tmp > angle_tmp || tmp < angle_tmp) == 0)
            {
                if (_:(speed < _TDW_BOOSTER_MIN_SPEED || IsVehicleBackwordsDirection(vehicleid)) == 0)
                    SetVehicleSpeed(vehicleid, speed + (_TDW_BOOSTER_BOOST_SPEED * engine_level));
            }
        }

        new brake_level;

        for(new i; i < 5; i++) if(VehInfo[vehicleid][vBrakeTune][i]) brake_level++;

        if(brake_level != 0 && (Keys == KEY_HANDBRAKE || Keys == KEY_JUMP) && speed > 30)
        {
            SetVehicleSpeed(vehicleid, speed - (_TDW_BOOSTER_BOOST_SPEED * brake_level));
        }

        z_angle_old[vehicleid] = z_angle;

	}
	return SetTimerEx("UpdateSpeedometr", 250, false, "d", playerid);
}

stock SetVehicleSpeed(vehicleid, Float:speed)
{
	if(speed <= 0) return true;
    new Float:cr[3];
    GetVehicleVelocity(vehicleid, cr[0], cr[1], cr[2]);
    new Float:test = floatsqroot(floatadd(floatadd(floatpower(cr[0], 2), floatpower(cr[1], 2)),  floatpower(cr[2], 2))) * 100.0;
    new Float:dif =  speed / test;
    if(dif != 0 && test != 0) SetVehicleVelocity(vehicleid,cr[0]*dif,cr[1]*dif,cr[2]);// && GetPlayerPing(playerid) < 200
    return true;
}

stock IsVehicleBackwordsDirection(vehicleid)
{
	new
		Float:x,
		Float:y,
		Float:z;

	if (GetVehicleVelocity(vehicleid, x, y, z))
	{
		new Float:z_angle;

		GetVehicleZAngle(vehicleid, z_angle);

		if (z_angle < 90.0) {
			if (x > 0.0 && y < 0.0)
				return 1;
		} else if (z_angle < 180.0) {
			if (x > 0.0 && y > 0.0)
				return 1;
		} else if (z_angle < 270.0) {
			if (x < 0.0 && y > 0.0)
				return 1;
		} else {
			if (x < 0.0 && y < 0.0)
				return 1;
		}
	}
	return 0;
}

stock GetVehicleSpeed(vehicleid)
{
	new Float:ST[4];
	GetVehicleVelocity(vehicleid,ST[0],ST[1],ST[2]);

	ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 100.0;
	return floatround(ST[3]);
}

stock SpeedVehicle(playerid)
{
	new Float:ST[4];
	if(IsPlayerInAnyVehicle(playerid)) GetVehicleVelocity(GetPlayerVehicleID(playerid),ST[0],ST[1],ST[2]);
	else GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);

	ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 100.0;
	return floatround(ST[3]);
}
//MICIN ILEGAL
epublic: TimeMicin(playerid)
{
	new rand = random(5);
	SetPlayerCheckpoint(playerid, RandMicin[rand][0], RandMicin[rand][1], RandMicin[rand][2], 2.0);
	CPMicin[playerid] = 1;
	ClearAnimations(playerid);
	TogglePlayerControllableEx(playerid, 1);
	PlayerInfo[playerid][pMicin] += 3;
	UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+2);
    OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
	GameTextForPlayer(playerid, "~b~+3 Gram~w~Marijuana", 3000, 0);
	return 1;
}
epublic:KickPublic(playerid) return Kick(playerid);

stock KickD(playerid, message[])
{
	if(strlen(message) > 0) SendClientMessage(playerid, COLOR_LIGHTRED, message);
	SetTimerEx("KickPublic", 200, false, "d", playerid);
	return true;
}
stock MySQLConnect()
{
    new MySQLOpt: option_id = mysql_init_options();
	mysql_set_option(option_id, AUTO_RECONNECT, true); // it automatically reconnects when loosing connection to mysql server

	LoadMySQLSettings();

	//mMysql = mysql_connect("194.9.62.152", "u197_nTwX3nF9ba", "^fLaNWqzkP@vj6CeV06JKoMF", "s197_malavida", option_id); // sebuah database
	mMysql = mysql_connect(MySQLSettings[DOOME_HOST], MySQLSettings[DOOME_USERNAME], MySQLSettings[DOOME_PASSWORD], MySQLSettings[DOOME_DATABASE], option_id); //DB CONNECT
    //if(!mysql_errno()) print("Koneksi basis data aktif!");
	//else return print("Koneksi basis data tidak aktif!");

    //mysql_log(ALL);

    LoadVehicles();

	//mysql_tquery(mMysql, "SET NAMES 'cp1251'", "", "");
	mysql_set_charset("cp1251");

    LoadBizz();

	mysql_tquery(mMysql, "SELECT * FROM `taxi_bizz`", "LoadTaxiBizz", "");

	mysql_tquery(mMysql, "SELECT * FROM `fraction` ORDER BY `fID` ASC", "LoadFractions", "");
	mysql_tquery(mMysql, "SELECT * FROM `bizz_fuel`", "LoadABizz", "");
	mysql_tquery(mMysql, "SELECT * FROM `enters`", "LoadEnters", "");
	mysql_tquery(mMysql, "SELECT * FROM `actors`", "LoadActors", "");
	mysql_tquery(mMysql, "SELECT * FROM `atms`", "LoadAtms", "");
	mysql_tquery(mMysql, "SELECT * FROM `doors`", "LoadDoors", "");
	mysql_tquery(mMysql, "SELECT * FROM `others`", "LoadOthers", "");
	mysql_tquery(mMysql, "SELECT * FROM `gangzone`", "LoadGangZones", "");
    mysql_tquery(mMysql, "SELECT * FROM `graffiti`", "LoadGraffiti", "");
    mysql_tquery(mMysql, "SELECT * FROM `elecations`", "LoadElecations", "");
    mysql_tquery(mMysql, "SELECT * FROM `fraction_wh`", "LoadFractionWH", "");
    mysql_tquery(mMysql, "SELECT * FROM `family`", "LoadFamily", "");
    mysql_tquery(mMysql, "SELECT * FROM `house`", "LoadHouse", "");
	mysql_tquery(mMysql, "SELECT * FROM `hotels`", "LoadHotels", "");
	mysql_tquery(mMysql, "SELECT * FROM `gates`", "LoadGates", "");
	mysql_tquery(mMysql, "SELECT * FROM `actor`", "LoadActor");
	mysql_tquery(mMysql, "SELECT * FROM `workshop`", "LoadWorkshop");

    mysql_tquery(mMysql, "UPDATE `accounts` SET `pLogin` = 0");

	// others
	for(new x; x < MAX_HOSPITALS; x++)
	{
	    for(new i; i < MAX_HOSPITAL_BEDS; i++)
		{
			format(String, 144, "Menggunakan tempat tidur No: %d\n Dengan Biaya Negara:{34c924} Gratis"W". \n {bbbbbb}Menggunakan:{fde910} ALT", i + 1);
			Koika[x][i] = CreateDynamic3DTextLabel(String,0xFFFFFFFF, LoadKoika[i][0], LoadKoika[i][1], LoadKoika[i][2] - 1.0, 10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 0, hospital_worlds[x], 8);
		}
	}

	printf("[Medbed]: Muat dengan tempat tidur yang dimuat: %d", MAX_HOSPITALS);

	SetTimer("Fresh", 1000, true);

	return 1;
}/*
