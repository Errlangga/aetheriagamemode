		 //callcmd::book(playerid, "");
         format(MySQLStr, 144, "SELECT `nName`, `nNumber`, `nID`, `plID` FROM `book` WHERE `plID` = %d", PlayerInfo[playerid][pID]);
	     mysql_tquery(mMysql, MySQLStr, "LoadMyNumber", "d", playerid);
