CMD:ransel(playerid, params[])
{
	if(IsPlayerConnected(playerid))
	{
		if(ransel[playerid] == 1)//Memerika jika pemain sudah menggunakan ransel
		{
			SendClientMessage(playerid, -1, "Anda berhasil melepas ransel");
			RemovePlayerAttachedObject(playerid, 1); //
			ransel[playerid] = 0;
		}
		else if(ransel[playerid] == 0)//Memeriksa jika pemain belum menggunakan ransel
		{
			SendClientMessage(playerid, -1, "Anda berhasil menggunakan tas");
			SetPlayerAttachedObject(playerid,1,3026,1,-0.176000, -0.066000, 0.0000,0.0000, 0.0000, 0.0000, 1.07600, 1.079999, 1.029000); //
			ransel[playerid] = 1;
		}
	}
	return 1;
}

CMD:mulaiayam(playerid, params[])
{
	if(!IsPlayerInRangeOfPoint(playerid, 8, 270.4139,1419.2269,10.4885)) return SendClientMessage(playerid, COLOR_RED, "Anda Harus Di Tempat Ayam");
	{
    	if(GetPVarInt(playerid,"pTimeAyam") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down Job 30 menit");
    	SetPlayerCheckpoint(playerid, 272.8714,1446.0522,10.5859, 5.0);
    	SetPVarInt(playerid, "GPS", 1);
    	PlayerInfo[playerid][pDutyAyam] = 1;
    	SetPlayerSkin(playerid, 168);
    	SendClientMessage(playerid, COLOR_YELLOW, "Anda Sudah On Duty Kerja Ayam");
    	SendClientMessage(playerid, COLOR_YELLOW, "[MVRP] Silakan Mengikuti Checkpoint");
	}
	return 1;
}
CMD:selesaiayam(playerid, params[])
{
	if(!IsPlayerInRangeOfPoint(playerid, 8, 270.4139,1419.2269,10.4885)) return SendClientMessage(playerid, COLOR_RED, "Anda Harus Di Tempat Ayam");
	{
    	SetPVarInt(playerid, "pTimeAyam", gettime() + 1800);
    	PlayerInfo[playerid][pDutyAyam] = 0;
    	SetPlayerSkinEx(playerid,PlayerInfo[playerid][pSkin]);
    	DisablePlayerCheckpoint(playerid);
    	SetPVarInt(playerid, "GPS", 0);
    	SendClientMessage(playerid, COLOR_YELLOW, "Anda Sudah Off Duty Kerja Ayam");
	}
	return 1;
}
CMD:ambilayam(playerid)
{
  	if(PlayerInfo[playerid][pKuliAyam] >= 1) return 1;
	if(PlayerInfo[playerid][pDutyAyam] == 0) return 1;
	if(pData[playerid][pAyam] > 100) return Error(playerid, "Ayam potong Sudah melewati Batas!(Max: 100).");
	if(pData[playerid][pStress] > 100) return Error(playerid, "Anda Sedang Stress!");
	{
    	if(!IsPlayerInRangeOfPoint(playerid, 8, 272.8714,1446.0522,10.5859)) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 8, 272.8714,1446.0522,10.5859))
        {
            PlayerInfo[playerid][pKuliAyam] += 1;
  	 		ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,1,1,1,1,1,1);
   			SetPlayerAttachedObject(playerid, 8, 19137, 1, 0.139, 0.549, 0.000, 5.000, 12.000, 32.000, 1.000, 1.000, 1.000);
    		SetPlayerChatBubble(playerid, "Mulai Ambil Ayam",COLOR_PURPLE,30.0,10000);
            SetPlayerCheckpoint(playerid, 244.8822,1444.4252,10.5859, 5.0);
            SetPVarInt(playerid,"CHECKPOINTID",3);
            SendClientMessage(playerid, COLOR_YELLOW, "[MVRP] Anda Telah Mengambil Ayam");
            SendClientMessage(playerid, COLOR_YELLOW, "[MVRP] Silakan Ke Checkpoint Untuk Memotong ayam");
        }
    }
    return 1;
}
CMD:potongayam(playerid, params[])
{
	if(PlayerInfo[playerid][pKuliAyam] < 1) return 1;
	if(PlayerInfo[playerid][pDutyAyam] == 0) return 1;
	{
    	if(!IsPlayerInRangeOfPoint(playerid, 8, 244.8822,1444.4252,10.5859)) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 8, 244.8822,1444.4252,10.5859))
        {
            PlayerInfo[playerid][pKuliAyam] -= 1;
    		RemovePlayerAttachedObject(playerid, 8);
        	ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0,1,0,0,0,0,1);
            SetTimerEx("WaktuAyam", 10000, false, "d", playerid);
            new rand = RandomEx(5, 20);
            PlayerInfo[playerid][pAyam] += rand;
  		 	UpdatePlayerThirst(playerid, PlayerInfo[playerid][pThirst]-7);
			UpdatePlayerSatiety(playerid, PlayerInfo[playerid][pSatiety]-3);
			UpdatePlayerStress(playerid, PlayerInfo[playerid][pStress]+3);
            OnPlayerUpdateAccountsPer(playerid, "pAyam", PlayerInfo[playerid][pAyam]);
            ShowProgressbar(playerid, "Sedang_Memotong...", 10);
    		SetPlayerChatBubble(playerid, "Mulai Memotong",COLOR_PURPLE,30.0,10000);
            SetPlayerCheckpoint(playerid, 272.8714,1446.0522,10.5859, 5.0);
            SetPVarInt(playerid,"CHECKPOINTID",3);
            SendClientMessage(playerid, COLOR_YELLOW, "[MVRP] Anda Telah Memotong Ayam ");
            SendClientMessage(playerid, COLOR_YELLOW, "[MVRP] Silakan Ke Checkpoint Untuk Melanjutkan Pekerjaan");
        }
    }
    return 1;
}
CMD:cmdpedagang(playerid,params[])
{
	new string[500];
	strcat(string, "{00C0FF}Commands List:\t\t\n\n");
	strcat(string, "/takestock memasak makanan di kompor\n/isitas cek stock makanan\n/jualmakan menjual makanan\n/jualminum menjual minuman");
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, "{00C0FF}CMD PEDAGANG",string, "Oke", "");
	return 1;
}
CMD:gendong2(playerid, params[])
{
    new yangdigendong;
    if(GetDistanceBetweenPlayers(playerid, yangdigendong) < 2)
    {
        if(Targetgendong[yangdigendong] == 1 && Yangmenggendong[playerid] == 1)
        {
            Targetgendong[yangdigendong] = 0;
            Yangmenggendong[playerid] = 0;
            ClearAnimations(playerid);
            KillTimer(gendongtimer[yangdigendong]);
        }
        else
        {
        	SendClientMessage(playerid, -1, "{FF0000}>> [ERROR] {FFFFFF}Anda tidak sedang digendong.");
		}
    }
    return 1;
}
CMD:miner(playerid)
{
	new merp[125], /*dorp[125],*/ playername[MAX_PLAYER_NAME +1];
	if(IsPlayerInRangeOfPoint(playerid, 5, -562.5238,-1506.3422,-33.7426))
	{
		if(StatusMiner1[0] == 1) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Sedang Dalam Proses Restock");
		if(JobMiner[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Tidak Pekerja Miner");
		if(pData[playerid][pStress] > 100) return Error(playerid, "Anda Sedang Stress!");
		if(pData[playerid][pBatuk] > 100) return Error(playerid, "Batu Kotor Sudah melewati Batas!(Max: 100).");
		StatusMiner1[0] = 1;
		TogglePlayerControllableEx(playerid, 0);
		ApplyAnimation(playerid, "BASEBALL", "Bat_4", 3.1, 0, 0, 0, 0, 20000, 1);
	    Update3DTextLabelText(StatusMiner[0], COLOR_BLUE, "{FFFFFF}Status: {FF0000}Waiting\n{FFFFFF}TEKAN Y");
	    SetTimerEx("WaktuMiner", 7000, false, "d", playerid);
		SetTimer("TimeMiner1", 30000, false);
		ShowProgressbar(playerid, "Mining", 7);
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, -568.520812,-1506.711547,-33.735336))
	{
		if(StatusMiner1[1] == 1) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Sedang Dalam Proses Restock");
		if(JobMiner[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Tidak Pekerja Miner");
		if(pData[playerid][pBatuk] > 99) return Error(playerid, "Batu Kotor Sudah melewati Batas!(Max: 100).");
		StatusMiner1[1] = 1;
		TogglePlayerControllableEx(playerid, 0);
		ApplyAnimation(playerid, "BASEBALL", "Bat_4", 3.1, 0, 0, 0, 0, 20000, 1);
	    Update3DTextLabelText(StatusMiner[1], COLOR_BLUE, "{FFFFFF}Status: {FF0000}Waiting\n{FFFFFF}TEKAN Y");
	    SetTimerEx("WaktuMiner", 7000, false, "d", playerid);
		SetTimer("TimeMiner2", 30000, false);
		ShowProgressbar(playerid, "Mining", 7);
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, -568.5682,-1517.5083,-33.7426))
	{
		if(StatusMiner1[2] == 1) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Sedang Dalam Proses Restock");
		if(JobMiner[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Tidak Pekerja Miner");
		if(pData[playerid][pBatuk] > 99) return Error(playerid, "Batu Kotor Sudah melewati Batas!(Max: 100).");
		StatusMiner1[2] = 1;
		TogglePlayerControllableEx(playerid, 0);
		ApplyAnimation(playerid, "BASEBALL", "Bat_4", 3.1, 0, 0, 0, 0, 20000, 1);
	    Update3DTextLabelText(StatusMiner[2], COLOR_BLUE, "{FFFFFF}Status: {FF0000}Waiting\n{FFFFFF}TEKAN Y");
	    SetTimerEx("WaktuMiner", 7000, false, "d", playerid);
		SetTimer("TimeMiner3", 30000, false);
		ShowProgressbar(playerid, "Mining", 7);
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, -570.9373,-1527.1009,-33.7353))
	{
		if(StatusMiner1[3] == 1) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Sedang Dalam Proses Restock");
		if(JobMiner[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Tidak Pekerja Miner");
		if(pData[playerid][pBatuk] > 99) return Error(playerid, "Batu Kotor Sudah melewati Batas!(Max: 100).");
		StatusMiner1[3] = 1;
		TogglePlayerControllableEx(playerid, 0);
		ApplyAnimation(playerid, "BASEBALL", "Bat_4", 3.1, 0, 0, 0, 0, 20000, 1);
		Update3DTextLabelText(StatusMiner[3], COLOR_BLUE, "{FFFFFF}Status: {FF0000}Waiting\n{FFFFFF}TEKAN Y");
		SetTimerEx("WaktuMiner", 7000, false, "d", playerid);
		SetTimer("TimeMiner4", 30000, false);
		ShowProgressbar(playerid, "Mining", 7);
	}
	else if(IsPlayerInRangeOfPoint(playerid, 5, -580.1791,-1531.8448,-33.7426))
	{
		if(StatusMiner1[4] == 1) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Sedang Dalam Proses Restock");
		if(JobMiner[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Tidak Pekerja Miner");
		if(pData[playerid][pBatuk] > 99) return Error(playerid, "Batu Kotor Sudah melewati Batas!(Max: 100).");
		StatusMiner1[4] = 1;
		TogglePlayerControllableEx(playerid, 0);
