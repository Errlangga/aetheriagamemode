	SCM(playerid, COLOR_RED, "RP OTHER:/crash, /relax, /takegun, /savegun, /rpheal.");
 	return 1;
}
CMD:ahelp(playerid, params[])
{
	if(admin_level[playerid] >= 1)
	{
		Send(playerid, 0xffff00ff, "Perintah yang tersedia:");
	 	Send(playerid, 0xB8860BFF, "Tingkat 1: /delad /gtv /arep /pm /getstats /getoffstats /voff /re /adminkey /hp");
	 	Send(playerid, 0xB8860BFF, "Tingkat 1: /mute /admins /astats /slap /getmypos /alogin /reoff /az");
	}
	if(admin_level[playerid] >= 2) Send(playerid, 0xB8860BFF, "Tingkat 2: /setvw /setint /freeze /(un)jail /goto /setskin /getip /chat");
	if(admin_level[playerid] >= 2) Send(playerid, 0xB8860BFF, "Tingkat 2: /kick /agetip /apaint /arace /amembers");
	if(admin_level[playerid] >= 3) Send(playerid, 0xB8860BFF, "Tingkat 3: /templeader /gethere /warn /ban /sban /unwarn /mpmenu");
	if(admin_level[playerid] >= 4) Send(playerid, 0xB8860BFF, "Tingkat 4: /getonline /offmute /offjail /offban /offwarn /gzcolor /veh /unban /dvehall /svehrad /dveh /o /asms");
	if(admin_level[playerid] >= 5) Send(playerid, 0xB8860BFF, "Tingkat 5: /fpanel /getipinfo /getfake /makeleader /banip /skick /iban /auninvite /offleaders");
	if(admin_level[playerid] >= 6) Send(playerid, 0xB8860BFF, "Tingkat 6: /alog /addnotify /unbanip /offadmins /spawncars /clearchat");
	if(admin_level[playerid] >= 7) Send(playerid, 0xB8860BFF, "Tingkat 7: /setadmin /setsupport /bsetmafia /fullgwh /elecation /abiz /offsupports /afuel");
	if(admin_level[playerid] >= 8)
	{
		Send(playerid, 0xB8860BFF, "Tingkat 8: /delacc /agl /saveall /payday /cca /bonus /createpromo /promo");
		Send(playerid, 0xB8860BFF, "Tingkat 8: /asellbiz /asellfuelst /asellhouse /setms");
	}
	return 1;
}
CMD:agetip(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;

    if(sscanf(params, "s[32]", params)) return Send(playerid, -1, "Masuk: /agetip [Alamat IP]");
    //if(!strcmp(params, "109.185.237.81")) return Send(playerid,-1, "Kesalahan! Tidak mungkin melihat akun dari alamat IP ini.");

    format(MySQLStr, 96, "SELECT * FROM `accounts` WHERE `pIp` = '%s'", params);
	mysql_tquery(mMysql, MySQLStr, "OnMySQL_Query","iis", playerid, 9, params);
	return 1;
}
CMD:iban(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "dds[128]",params[0],params[1],params[2])) return Send(playerid, -1, "Masuk: /ban [id] [hari] [alasan]");
    if(!PlayerInfo[params[0]][pLogin]) return Send(playerid,-1,"Pemain tidak diotorisasi!");
    if(params[1] > 14) return Send(playerid, -1,"Maksimal dapat diblokir selama 14 hari");
    if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat memblokir administrator atas/rekan.");

    new days[20];
	switch(params[1])
	{
	    case 1: days = "hari";
	    case 2..4: days = "hari ini";
		default: days = "hari";
	}

	PlayerInfo[playerid][pAdmBan]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmBan", PlayerInfo[playerid][pAdmBan]);

    format(format_string, sizeof(format_string), "Administrator %s melarang pemain %s pada %d %s. Alasan: %s",Name(playerid),Name(params[0]), params[1], days, params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);
    AddAdminLog(playerid, format_string);

	BlockAccounts(Name(params[0]), params[2], Name(playerid), gettime() + (86400 * params[1]));

    mysql_format(mMysql, MySQLStr, 144, "SELECT * FROM `banips` WHERE `ipadress` = '%e' AND `lockstate` = '1' LIMIT 0,1", GetPlayerIpEx(params[0]));
	mysql_tquery(mMysql, MySQLStr, "OnPlayerBanIP", "issii", playerid, GetPlayerIpEx(params[0]), params[2], false, 14);
	return 1;
}
CMD:banip(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

    new param[MAX_IP_ADRESS];
    if(sscanf(params, "s[24]ds[64]", param, params[0], params[1])) return Send(playerid,-1, "Masuk: /banip [Alamat IP] [hari] [alasan]");
    //if(!strcmp(param, "109.185.237.81")) return Send(playerid,-1, "Kesalahan! Tidak mungkin melihat akun dari alamat IP ini.");
    if(params[0] > 90 && params[0] <= 0) return Send(playerid,-1, "Anda dapat memblokir alamat IP selama maksimal 90 hari!");

    mysql_format(mMysql, MySQLStr, 144, "SELECT * FROM `banips` WHERE `ipadress` = '%e' AND `lockstate` = '1' LIMIT 0,1", param);
	mysql_tquery(mMysql, MySQLStr, "OnPlayerBanIP", "issii", playerid, param, params[1], false, params[0]); //iplocktype 0 larangan untuk periode tertentu
	return 1;
}
CMD:unbanip(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;

	if(sscanf(params, "s[40]", params[0])) return Send(playerid,-1, "Masuk: /unbanip [Alamat IP]");

    mysql_format(mMysql, MySQLStr, 144, "SELECT * FROM `banips` WHERE `ipadress` = '%e' AND `lockstate` = '1' LIMIT 0,1", params[0]);
	mysql_tquery(mMysql, MySQLStr, "OnPlayerCheckUnBanIP", "is", playerid, params[0]);
	return 1;
}

CMD:sethp(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    new targetid,heal,armor;
    if(sscanf(params, "ui", targetid, heal))
        return Send(playerid, -1, "Gunakan: /sethp [id] [heal] [armor]");
	if(!IsPlayerConnected(targetid))
        return Send(playerid, -1, "Tidak ada pemain seperti itu di server.");

    if(!(0 <= heal <= 100))
        return Send(playerid, -1, "Jumlah kesehatan dan pelindung dari 0 hingga 100.");

	//Jika baju besi yang ditunjukkan, maka masalah
    if(!sscanf(params, "uii", targetid, heal, armor)) SetPlayerArmour(targetid, armor);

    SetPlayerHealth(targetid, heal);
	format(format_string, 96, "[A] Administrator %s mengubah HP %s.", Name(playerid), Name(targetid));
	SendAdminMessage(COLOR_GREY, format_string);
	return true;
}

CMD:spawn(playerid, params[])
{
 //   if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    new targetid;
    if(sscanf(params, "u", targetid))
        return Send(playerid, -1, "Gunakan: /spawn [id]");
	if(!IsPlayerConnected(targetid))
        return Send(playerid, -1, "Tidak ada pemain seperti itu di server.");

    if(afk_time[targetid] > 2) return Send(playerid, -1,"Pemain ini AFK.");//+

	SpawnPlayer(targetid);
	format(format_string, sizeof(format_string), "[A] Administrator %s menelurkan %s.", PlayerInfo[playerid][pAname], Name(targetid));
	if(admin_level[targetid] == 0) SCM(targetid, COLOR_GREY, format_string);
	SendAdminMessage(COLOR_LIGHTRED, format_string);
    return 1;
}
CMD:warn(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "ds[128]",params[0],params[1])) return Send(playerid, -1, "Masuk: /warn [id] [alasan]");
    if(!PlayerInfo[params[0]][pLogin]) return Send(playerid,-1,"Pemain tidak diotorisasi!");
    //if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat mengeluarkan varn ke administrator level tertinggi/sederajat.");

    if(PlayerInfo[playerid][pWarn] >= 2)
    {
        PlayerInfo[playerid][pAdmBan]++;
        OnPlayerUpdateAdminPer(playerid, "pAdmBan", PlayerInfo[playerid][pAdmBan]);

    	format(format_string, sizeof(format_string), "Administrator %s melarang pemain %s selama 7 hari [3/3] peringatan. Alasan: %s",Name(playerid), Name(params[0]), params[1]);
		SendClientMessageToAll(COLOR_LIGHTRED, format_string);
        AddAdminLog(playerid, format_string);

		mysql_format(mMysql, MySQLStr, 144, "DELETE FROM `warninfo` WHERE `plID` = %d", PlayerInfo[params[0]][pID]);
		mysql_tquery(mMysql, MySQLStr, "", "");

		BlockAccounts(Name(params[0]), params[1], Name(playerid), gettime() + (86400 * 7));

		return 1;
    }

	PlayerInfo[playerid][pAdmWarn]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmWarn", PlayerInfo[playerid][pAdmWarn]);

	format(format_string, sizeof(format_string), "Administrator %s mengeluarkan peringatan kepada pemain %s [%i/3]. Alasan: %s", Name(playerid), Name(params[0]), PlayerInfo[playerid][pWarn]+1, params[1]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);

    format(format_string, 144, "UPDATE `accounts` SET `pLeader` = 0, `pMember` = 0 WHERE `pID` = %i", GetPlayerAccountID(params[0]));
	mysql_tquery(mMysql, format_string);

	mysql_format(mMysql, MySQLStr, 344, "INSERT INTO `warninfo` (`plID`, `wReasonWarn`, `wAdminWarn`, `wWarnDate`, `wUnWarnDate`) VALUES (%d, '%e', '%e', %d, %d)", PlayerInfo[params[0]][pID], params[1], Name(playerid), gettime(), gettime() + (86400 * 7));
	mysql_tquery(mMysql, MySQLStr);

	KickD(params[0], "");

	return 1;
}

CMD:offwarn(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

	new x_warn[30];
	if(sscanf(params, "s[24]S()[30]",params[0],x_warn)) return Send(playerid, -1,"Masuk: /offwarn [nama panggilan] [alasan]");

    if(Getplayerid(params[0]) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain online.");

    if(GetPlayerAdminBySql(params[0])) return SCM(playerid, COLOR_GREY, "Pemain ini adalah admin.");

	//

	mysql_format(mMysql, format_string, 144, "SELECT `pID` FROM `accounts` WHERE `pName` = '%e' LIMIT 1", params[0]);
	new Cache: result = mysql_query(mMysql, format_string);

	if(cache_num_rows() == 0) return SCMF(playerid, COLOR_GREY, "Pemain %s tidak ditemukan.", params[0]);

	cache_delete(result);

	//

	format(format_string, 144, "SELECT * FROM `banlog` WHERE `nameplayer` = '%s' AND `lockstate` = 1", params[0]);
	result = mysql_query(mMysql, format_string);

	if(cache_num_rows()) return SCMF(playerid, COLOR_GREY, "Pemain %s diblokir.", params[0]);

    cache_delete(result);

	//

	new sql_id = GetPlayerSqlIDByName(params[0]);

	format(format_string, 144, "SELECT * FROM `warninfo` WHERE `plID` = %i", sql_id);
	result = mysql_query(mMysql, format_string);

	new rows = cache_num_rows();

	cache_delete(result);

	//

	if(rows + 1 == 3)
	{
	    PlayerInfo[playerid][pAdmBan]++;
	    OnPlayerUpdateAdminPer(playerid, "pAdmBan", PlayerInfo[playerid][pAdmBan]);

    	format(format_string, sizeof(format_string), "[OFFLINE] Administrator %s melarang pemain %s selama 7 hari [3/3] peringatan. Alasan: %s",Name(playerid), params[0], x_warn);
		SendAdminMessage(COLOR_LIGHTRED, format_string);
		AddAdminLog(playerid, format_string);

    	mysql_format(mMysql, MySQLStr, 144, "DELETE FROM `warninfo` WHERE `plID` = %d", sql_id);
		mysql_tquery(mMysql, MySQLStr);

    	BlockAccounts(params[0], x_warn, Name(playerid), gettime() + (86400 * 7));

    	return 1;
	}

    //

    PlayerInfo[playerid][pAdmWarn]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmWarn", PlayerInfo[playerid][pAdmWarn]);

    format(format_string, sizeof(format_string), "[OFFLINE] Administrator %s mengeluarkan peringatan kepada pemain %s [%i/3]. Alasan: %s", Name(playerid), params[0], rows+1, x_warn);
	SendAdminMessage(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);

	format(format_string, 144, "UPDATE `accounts` SET `pLeader` = 0, `pMember` = 0 WHERE `pID` = %i", sql_id);
	mysql_tquery(mMysql, format_string);

	mysql_format(mMysql, MySQLStr, 344, "INSERT INTO `warninfo` (`plID`, `wReasonWarn`, `wAdminWarn`, `wWarnDate`, `wUnWarnDate`) VALUES (%d, '%e', '%e', %d, %d)", sql_id, x_warn, Name(playerid), gettime(), gettime() + (86400 * 7));
	mysql_tquery(mMysql, MySQLStr, "", "");

	return 1;
}


CMD:ban(playerid, params[])
{
 //   if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "dds[128]",params[0],params[1],params[2])) return Send(playerid, -1, "Masuk: /ban [id] [hari] [alasan]");
    //if(!strcmp(PlayerInfo[params[0]][pIp], "109.185.237.81")) return Send(playerid,-1, "tobi cunt");
    if(!PlayerInfo[params[0]][pLogin]) return Send(playerid,-1,"Pemain tidak diotorisasi!");
    if(params[1] > 1000000) return Send(playerid, -1,"Maksimal dapat diblokir selama 1000000 hari");
    if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat memblokir administrator atas/rekan.");

    new days[20];
	switch(params[1])
	{
	    case 1: days = "hari";
	    case 2..4: days = "hari ini";
		default: days = "hari";
	}

	PlayerInfo[playerid][pAdmBan]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmBan", PlayerInfo[playerid][pAdmBan]);

    format(format_string, sizeof(format_string), "Administrator %s melarang pemain %s pada %d %s. Alasan: %s",PlayerInfo[playerid][pAname],Name(params[0]), params[1], days, params[2]);
	SendClientMessageToAll(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);

    BlockAccounts(Name(params[0]), params[2], Name(playerid), gettime() + (86400 * params[1]));

    format(format_string, 144, "[A] L-IP: %s | R-IP: %s", GetPlayerIpEx(params[0]), PlayerInfo[params[0]][pIpReg]);
    SendAdminMessage(COLOR_GREY, format_string);

	return 1;
}

CMD:sban(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "dds[128]",params[0],params[1],params[2])) return Send(playerid, -1, "Masuk: /sban [id] [hari] [alasan]");
    //if(!strcmp(PlayerInfo[params[0]][pIp], "109.185.237.81")) return Send(playerid,-1, "tobi cunt");
    if(!PlayerInfo[params[0]][pLogin]) return Send(playerid,-1,"Pemain tidak diotorisasi!");
    if(params[1] > 30) return Send(playerid, -1,"Maksimal dapat diblokir selama 30 hari");
    if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat memblokir administrator atas/sama di tingkat.");

    new days[20];
	switch(params[1])
	{
	    case 1: days = "hari";
	    case 2..4: days = "hari ini";
		default: days = "hari";
	}

	PlayerInfo[playerid][pAdmBan]++;
	OnPlayerUpdateAdminPer(playerid, "pAdmBan", PlayerInfo[playerid][pAdmBan]);

	new text_string[244];

	format(text_string, 244, "[A] Administrator %s melarang pemain %s pada %d %s. Alasan: %s",Name(playerid),Name(params[0]), params[1], days, params[2]);
	SendAdminMessage(COLOR_GREY, text_string);
	AddAdminLog(playerid, text_string);

	SCM(params[0], COLOR_LIGHTRED, text_string);

    BlockAccounts(Name(params[0]), params[2], Name(playerid), gettime() + (86400 * params[1]));

    format(format_string, 144, "[A] L-IP: %s | R-IP: %s", GetPlayerIpEx(params[0]), PlayerInfo[params[0]][pIpReg]);
    SendAdminMessage(COLOR_GREY, format_string);

	return 1;
}

CMD:offban(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

	new x_warn[30];
	if(sscanf(params, "is[24]S()[30]",params[0],params[1],x_warn)) return Send(playerid, -1,"Masuk: /offban [hari] [nama panggilan] [alasan]");

    if(params[0] > 30 || params[0] < 1) return Send(playerid, COLOR_GREY, "Anda tidak dapat menentukan nilai lebih dari 30 atau kurang dari 1.");

    if(Getplayerid(params[1]) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sedang online.");

    if(GetPlayerAdminBySql(params[1])) return SCM(playerid, COLOR_GREY, "Pemain ini adalah admin.");

	//

	mysql_format(mMysql, format_string, 144, "SELECT `pID` FROM `accounts` WHERE `pName` = '%e' LIMIT 1", params[1]);
	new Cache: result = mysql_query(mMysql, format_string);

	if(cache_num_rows() == 0) return SCMF(playerid, COLOR_GREY, "Pemain% s tidak ditemukan.", params[1]);

	cache_delete(result);

	//

	format(format_string, 144, "SELECT * FROM `banlog` WHERE `nameplayer` = '%s' AND `lockstate` = '1'", params[1]);
	result = mysql_query(mMysql, format_string);

	if(cache_num_rows()) return SCMF(playerid, COLOR_GREY, "Pemain %s diblokir.", params[1]);

    cache_delete(result);

    //

	new days[20];
	switch(params[1])
	{
	    case 1: days = "hari";
	    case 2..4: days = "hari ini";
		default: days = "hari";
	}

	PlayerInfo[playerid][pAdmBan]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmBan", PlayerInfo[playerid][pAdmBan]);

	format(format_string, sizeof(format_string), "[OFFLINE] pada %s melarang pemain %s pada %d %s. Alasan: %s",Name(playerid), params[1], params[0], days, x_warn);
	SendAdminMessage(COLOR_LIGHTRED, format_string);
	AddAdminLog(playerid, format_string);

	BlockAccounts(params[1], x_warn, Name(playerid), gettime() + (86400 * params[0]));

	return 1;
}

CMD:unban(playerid, params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "s[64]", params[0])) return Send(playerid,-1, "Masuk: /unban [Nick_Player]");

    mysql_format(mMysql, MySQLStr, 144, "SELECT * FROM `banlog` WHERE `nameplayer` = '%e' AND `lockstate` = '1' LIMIT 0,1", params[0]);
	mysql_tquery(mMysql, MySQLStr, "OnPlayerCheckUnBanAcc", "is", playerid, params[0]);
	return 1;
}

forward OnPlayerRequestClass(playerid, classid);
public OnPlayerRequestClass(playerid, classid)
{
	//toll
    SetPlayerPos(playerid, 1958.3783, 1343.1572, 15.3746);
	SetPlayerCameraPos(playerid, 1958.3783, 1343.1572, 15.3746);
	SetPlayerCameraLookAt(playerid, 1958.3783, 1343.1572, 15.3746);
	
    if(PlayerInfo[playerid][pLogin] == 1) return SpawnPlayerEx(playerid);
    //CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK);
	new query[86];

    mysql_format(mMysql, query, sizeof(query), "SELECT * FROM `banips` WHERE `ipadress` = '%e' LIMIT 0,1", GetPlayerIpEx(playerid));
	mysql_tquery(mMysql, query, "OnPlayerCheckBanIP", "is", playerid, GetPlayerIpEx(playerid));
	// CheckWhitelist(playerid);
	PreloadAnimLibs(playerid);
	return 1;
}

public OnPlayerRequestSpawn(playerid)
{
    //CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK);
	return 1;
}

public OnPlayerConnect(playerid)
{
   	PlayerInfo[playerid][pSetSpawn] = 0;
    PlayerData[playerid][pTogTP] = 0;
	pData[playerid][pTogPm] = 1;
	adostatus[playerid] = 0;
	LoadingPlayerBar[playerid] = 0;
	if(PlayerInfo[playerid][pLevel] < 3)
	{
 		SetPlayerHealth(playerid, 99999999);
	}
	isPayToggled[playerid] = true;
	masked[playerid] = 0;
    disconectstatus[playerid] = 0;
	FecharWhatsapp(playerid);
	TextDrawHideForPlayer(playerid, CrateTD[0]);
	TextDrawHideForPlayer(playerid, CrateTD[1]);
	TextDrawHideForPlayer(playerid, CrateTD[2]);
