		format(str, 64, "%i. %s\t%i\t$%i\n", i + 1, GetWeaponNames(bizz_weapons[i]), bizz_weapons_ammo[i], BizzInfo[b_id][bPrice] * (i + 1));
		strcat(String, str);
	}

	return SPD(playerid, 8157, DIALOG_STYLE_TABLIST, "weapon list", String, "Buy", "Close");
}

