CMD:tgde (playerid)
{
	if(GetPVarInt(playerid,"pTimeRp2") > gettime()) return 1;
	format(String, 188, "%s Take a 'Deagle' and Ready to Shoot Anytime",ReturnName(playerid));
	ProxDetector(25.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPVarInt(playerid, "pTimeRp2", gettime() + 30);
 	return 1;
}
