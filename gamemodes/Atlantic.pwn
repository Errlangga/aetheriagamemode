CMD:stats(playerid, params[])
{
    ShowPlayerStats(playerid, playerid);
    return 1;
}

stock ShowPlayerStats(playerid, otherid)
{
    new coordsString[1512], playerstats[1512], idiot[128], Float:hp;

    new infojob[64];
    if(PlayerInfo[otherid][pJob] == 0 && PlayerInfo[otherid][pMember] == 0) infojob = "Menganggur";
    else if(PlayerInfo[otherid][pJob] != 0) format(infojob, sizeof(infojob), "%s", NamesJob(otherid));
    else if(PlayerInfo[otherid][pMember] != 0) format(infojob, sizeof(infojob), "%s", FracRank[PlayerInfo[otherid][pMember]][PlayerInfo[otherid][pRank]]);

    new drank[20];
    switch(PlayerInfo[otherid][pLevel])
    {
        case 1..2: drank = "Pemula";
        case 3..5: drank = "Pemula";
        case 6..11: drank = "Tentu";
        case 12..15: drank = "Pemain reguler";
        case 16..20: drank = "Dikuasai";
        case 21..25: drank = "Kakek";
        default: drank = "Veteran";
    }

    GetPlayerHealth(otherid, hp);
    GetPlayerArmour(otherid, PlayerInfo[playerid][pArmour]);

    new htext[32], h_id = GetPlayerHouse(otherid);
    if(GetPlayerHouse(otherid) != -1) htext = "Tuna wisma";
    else format(htext, sizeof(htext), "House = %d", GetPlayerHouse(otherid));
    if(h_id != -1) format(htext, sizeof(htext), "House = %d ($%i)", h_id, HouseInfo[h_id][hValue]);
    else if(PlayerInfo[playerid][pHotel] != -1) format(htext, sizeof(htext), "Hotel = %d", PlayerInfo[otherid][pHotel]);
    else htext = "Tidak Mempunyai";

    new btext[64], b_id = GetPlayerBizz(otherid);
    if(b_id == -1) btext = "Tidak";
    else format(btext, sizeof(btext), "%s ($%i)", BizzInfo[b_id][bMessage], BizzInfo[b_id][bMoney]);

    new azctext[64], a_id = GetPlayerABizz(otherid);
    if(a_id == 0) azctext = "Tidak";
    else format(azctext, sizeof(azctext), "%s ($%i)", BizzAInfo[a_id][aMessage], BizzAInfo[a_id][aMoney]);

    new infofrac[32];
    if(PlayerInfo[otherid][pMember] == 0) infofrac = "-";
    else format(infofrac, sizeof(infofrac), "%s", FracInfo[PlayerInfo[otherid][pMember]][fName]);    

    new family[1280];
    new f_id = GetPlayerData(otherid, pFamily);
    if(f_id == -1) family = "None";
    else format(family, sizeof(family), "%s", family_info[f_id][f_name]);    

    format(idiot, sizeof(idiot), "{FFFFFF}Name: {00CCFF}%s {FFFFFF}| Database ID: {00CCFF}%d {FFFFFF}| Level: {00CCFF}%d {FFFFFF}| Exp {00CCFF}%d", GetPlayerNameEx(otherid), PlayerData[otherid][pID], PlayerData[otherid][pLevel], pData[otherid][pExp]);
    format(coordsString, sizeof(coordsString), "{F7FF00}IC Information:\n");
    strcat(playerstats, coordsString);
    format(coordsString, sizeof(coordsString), "{FFFFFF}Gender: [{ADD8E6}%s{FFFFFF}] Bank Money: [{009000}%d{FFFFFF}] Phone number: [{C6E2FF}%d{FFFFFF}] Money: [{009000}%d{FFFFFF}] Pulsa Telepon: [{C6E2FF}%d{FFFFFF}]\n", (PlayerData[otherid][pSex] == 2) ? ("Perempuan") : ("Laki-Laki"), PlayerInfo[otherid][pBank], PlayerData[otherid][pNumber], PlayerData[otherid][pCash], PlayerInfo[otherid][pSummaNumber]);
    strcat(playerstats, coordsString);
    format(coordsString, sizeof(coordsString), "{FFFFFF}Mask ID: [{ADD8E6}%d{FFFFFF}] Job: [{C6E2FF}%s{FFFFFF}] Rumah: [{FF0000}%s{FFFFFF}] Faction: [{00FFFF}%s{FFFFFF}] Family: [{00FFFF}%s{FFFFFF}]\n", PlayerData[otherid][pMaskID], infojob, htext, infofrac, family);
    strcat(playerstats, coordsString);
    format(coordsString, sizeof(coordsString), "{FFFFFF}Business: [{ADD8E6}%d{FFFFFF}] Pom Stasion: [{C6E2FF}%s{FFFFFF}] Umur/Age: [{C6E2FF}%d{FFFFFF}] Status Players: [{FF0000}%s{FFFFFF}] Health [{00FFFF}%0.2f{FFFFFF}] Armour [{FFFFFF}%0.2f]\n\n", btext, azctext, PlayerData[otherid][pAge], drank, hp, PlayerInfo[otherid][pArmour]);
    strcat(playerstats, coordsString);    
    format(coordsString, sizeof(coordsString), "{F7FF00}OOC Information:\n");
    strcat(playerstats, coordsString);
    format(coordsString, sizeof(coordsString), "{FFFFFF}Status VIP: [{ADD8E6}%s{FFFFFF}] Rouble Coin: [%d{FFFFFF}] Email [{00FFFF}%s{FFFFFF}] Playing Hours [{00FFFF}%s{FFFFFF}] AFK Per Hari [{FFFFFF}%s]\n", VipNames(otherid), PlayerData[otherid][pRouble], PlayerData[otherid][pMail], ConvertSeconds(PlayerInfo[otherid][pInGameSeconds]), ConvertSeconds(PlayerInfo[otherid][pInGameAFKSeconds]));
    strcat(playerstats, coordsString);
    format(coordsString, sizeof(coordsString), "{FFFFFF}Staff: ["RED_E"%s"WHITE_E"] {FFFFFF}Device: [{FF0000}%s{FFFFFF}] Asal [Indonesia{FFFFFF}] Server [Malavida {FFFFFF}] Character Story: [%s{FFFFFF}]", RAN(otherid), IsPlayerMobile(otherid) ? (""YELLOW_E"Android") : (""GREEN_E"PC"), !pData[otherid][pCS] ? ("{FF0000}None") : ("{00FF00}Active"));
    strcat(playerstats, coordsString);
    ShowPlayerDialog(playerid, DIALOG_UNUSED, DIALOG_STYLE_MSGBOX, idiot,playerstats,"Close","");
    return 1;
}

CMD:levels(playerid, params[])
{
    new output[1000], oldvalue, points;

    for(new i = 1; i <= 49; i++)
    {
        points = ((i + 1) * 4);
        strcat(output, sprintf("Level: %d\t%d exp\n", i + 1, points));

        oldvalue += points;
    }
    ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_TABLIST, "Level Target", output, "Close", "");
    return 1;
}

CMD:getstats(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "u",params[0])) return Send(playerid, -1, "Masuk: /getstats [id]");

	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, COLOR_GREY, "Pemain belum login!");

	ShowPlayerStats(playerid, params[0]);

	return 1;
}

CMD:getoffstats(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "s[32]",params[0])) return Send(playerid, -1, "Masuk: /getoffstats [nick]");

	if(Getplayerid(params[0]) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain dalam game.");

	mysql_format(mMysql, format_string, 144, "SELECT * FROM `accounts` WHERE `pName` = '%s'", params[0]);
	mysql_tquery(mMysql, format_string, "ShowPlayerOfflineStats", "is", playerid, params[0]);

	return 1;
}

publics: ShowPlayerOfflineStats(playerid, nick[])
{
    new rows;
    cache_get_row_count(rows);

	if(!rows) return SCM(playerid, COLOR_GREY, "Pemain tidak ditemukan.");

	new result_string[64];

	new sql_id, hotel_id, sex, level, exp, leader, member, rang, job, cash, bank, number, vip, models[3], costs[3];
	new drugs, ammo, metall, drug_dep, game_sec, game_afk_sec, game_hour_sec, last_ip[16], reg_ip[16];

	cache_get_value_int(0, "pID", sql_id);
	cache_get_value_int(0, "pSex", sex);
	cache_get_value_int(0, "pHotel", hotel_id);
	cache_get_value_int(0, "pLevel", level);
	cache_get_value_int(0, "pExp", exp);

	cache_get_value_int(0, "pLeader", leader);
	cache_get_value_int(0, "pMember", member);
	cache_get_value_int(0, "pRank", rang);
	cache_get_value_int(0, "pJob", job);

	cache_get_value_int(0, "pCash", cash);
	cache_get_value_int(0, "pBank", bank);
	cache_get_value_int(0, "pNumber", number);

	cache_get_value_int(0, "pDrugs", drugs);
	cache_get_value_int(0, "pPatron", ammo);
	cache_get_value_int(0, "pMetall", metall);
	cache_get_value_int(0, "pDrugDep", drug_dep);

	cache_get_value_int(0, "pVip", vip);

	cache_get_value_int(0, "pInGameSeconds", game_sec);
	cache_get_value_int(0, "pInGameAFKSeconds", game_afk_sec);
	cache_get_value_int(0, "pInGameHourSeconds", game_hour_sec);

	cache_get_value_name(0, "pIp",last_ip);
	cache_get_value_name(0, "pIpReg",reg_ip);

	cache_get_value_name(0, "cModel",result_string);
	sscanf(result_string, "p<,>a<i>[5]", models);

	cache_get_value_name(0, "cCost",result_string);
	sscanf(result_string, "p<,>a<i>[3]", costs);

    new str[324];

	new atext[200], jtext[200];
	if(sex == 1) atext = "Laki-laki", jtext = "Menikah dengan:\t\t\t-\n";
	else atext = "Perempuan", jtext = "Menikah dengan:\t\t\t-\n";

	new htext[10], h_id = GetPlayerHouseBySqlName(nick);
	if(h_id != -1) format(htext, sizeof(htext), "Nomor rumah%d ($%i)", h_id, HouseInfo[h_id][hValue]);
	else if(hotel_id != -1) format(htext, sizeof(htext), "No. hotel%d", hotel_id);
	else htext = "Tunawisma";

	new btext[64], b_id = GetPlayerBizzBySqlName(nick);
	if(b_id == -1) btext = "Tidak";
	else format(btext, sizeof(btext), "%s ($%i)", BizzInfo[b_id][bMessage], BizzInfo[b_id][bMoney]);

	new azctext[64], a_id = GetPlayerABizzBySqlName(nick);
	if(a_id == 0) azctext = "Tidak";
	else format(azctext, sizeof(azctext), "%s ($%i)", BizzAInfo[a_id][aMessage], BizzAInfo[a_id][aMoney]);

	new drank[20];
	switch(level)
	{
 		case 1..2: drank = "Pemula";
 		case 3..5: drank = "Pemula";
	 	case 6..11: drank = "Tentu";
	 	case 12..15: drank = "Pemain reguler";
	 	case 16..20: drank = "Dikuasai";
	 	case 21..25: drank = "Kakek";
	 	default: drank = "Veteran";
	}

	new namejobs[64];
	switch(job)
	{
	    case 1: namejobs= "Pengangkut Makanan/Bahan Bakar";
		case 2: namejobs= "Sopir bus";
		case 3: namejobs= "Pembersih jalan";
		case 4: namejobs= "Pengemudi truk sampah";
		case 5: namejobs= "Kolektor";
		case 6: namejobs= "Pengemudi truk";
		case 7: namejobs= "Pilot";
		case 13: namejobs= "Penangan kontainer";
		case WORK_TYPE_PIZZA: namejobs = "Pria pengiriman pizza";
		case WORK_TYPE_BULLDOZER: namejobs = "Pengemudi buldoser";
		case 70..72: namejobs= "Supir taksi";
		default: namejobs= "Menganggur";
	}

	new vipname[20+1];
	switch(vip)
	{
	    case 1: vipname= "{CD853F}BRONZE VIP";
		case 2: vipname= "{afafaf}SILVER VIP";
		case 3: vipname= "{ffff00}GOLD VIP";
		default: vipname= "Tidak";
	}

	if(leader) drank = "Pemimpin";

	new infofrac[32];
	if(member == 0) infofrac = "-";
	else format(infofrac, sizeof(infofrac), FracInfo[member][fName]);

	new infojob[64];
	if(job == 0 && member == 0) infojob = "Menganggur";
	else if(job != 0) format(infojob, sizeof(infojob), namejobs);
	else if(member != 0) format(infojob, sizeof(infojob), FracRank[member][rang]);

	String = "";
	format(str, sizeof(str), "\
	{ffffff}Nama depan:\t\t\t\t{1A8FA9}%s\n\
	"W"Level:\t\t\t%d (%i dari %i)\n\
 	Uang ada di tangan:\t\t%d$\n\
	Uang di bank:\t\t%d$\n\
	Nomor telepon:\t\t%d\n\
	Obat-obatan:\t\t\t%d gr\n\
	Ammo:\t\t\t%d pcs\n\
	Logam:\t\t\t%d kg\n\
	Gender:\t\t\t\t%s\n\
	Kecanduan:\t\t\t%i\n",
	nick, level, exp, (level+1)*4, cash, bank, number, drugs,
	ammo, metall, atext, drug_dep);
	strcat(String,str);

	format(str, sizeof(str), "\
	%s\n\
	Organisasi:\t\t\t%s\n\
	Bekerja / posisi:\t\t%s\n\n\
	Akomodasi:\t\t\t%s\n\
	Perusahaan:\t\t\t%s\n\
    SPBU:\t\t\t\t%s\n\n\
    Status Game:\t\t%s\n\
	Status VIP:\t\t\t%s\n",
 	jtext, infofrac, infojob, htext, btext, azctext, drank, vipname);
	strcat(String,str);

	if(admin_level[playerid])
	{
	    strcat(String, "\nTransportasi:\n\n");

		for(new i; i < MAX_PLAYER_VEHICLES; i++)
		{
		    if(models[i] == 0)
		    {
		        format(str, 48, "%i. Kosong\n", i + 1);
			    strcat(String, str);
		    }
		    else
			{
				format(str, 48, "%i. %s ($%i)\n", i + 1, VehicleNames[models[i] - 400], costs[i]);
			    strcat(String, str);
			}
		}
	}

    format(str, 324,
        "\nDimainkan dalam sehari: %s\n\
		AFK per hari: %s\n\
		Menang tanpa AFK: %s\n\
		Menang dalam satu jam terakhir: %s\n\
		L-IP: %s\n\
		R-IP: %s",
		ConvertSeconds(game_sec),
		ConvertSeconds(game_afk_sec),
		ConvertSeconds(game_sec - game_afk_sec),
		ConvertSeconds(game_hour_sec),
		last_ip,
		reg_ip);

	strcat(String ,str);

	return SPD(playerid,0,DIALOG_STYLE_MSGBOX,"{E5D81E}Statistik pemain resmi",String, "Tutup", "");
}

CMD:gtv(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /gtv [id]");

	if(!(0 <= params[0] <= MAX_VEHICLES-1)) return SCMF(playerid, COLOR_GREY, "ID yang tersedia dari 0 hingga %i", MAX_VEHICLES - 1);

	new vehicleid = params[0];

	new Float: x, Float: y, Float: z;

	GetVehiclePos(vehicleid, x, y, z);

	SetPlayerPos(playerid, x, y, z);

	return SCMF(playerid, -1, "Anda diteleportasi untuk diangkut %i", vehicleid);
}

alias:gethere("gh");
CMD:gethere(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /gethere(/gh) [id]");

	if(!IsPlayerConnected(params[0])) return SCM(playerid, COLOR_GREY, "Pemain tidak terhubung.");

	new Float:plocx,Float:plocy,Float:plocz;
	new inter = GetPlayerInterior(playerid);
	new world = GetPlayerVirtualWorld(playerid);

	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, COLOR_GREY, "Pemain tidak diotorisasi!");
	if(GetPlayerState(params[0]) != 1 && GetPlayerState(params[0]) != 2 && GetPlayerState(params[0]) != 3) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan!");
	if(afk_time[params[0]] > 5) return Send(playerid, COLOR_GREY, "Pemain ini dalam mode AFK!");
	if(PlayerInfo[params[0]][pPrison] != 0) return Send(playerid, COLOR_GREY, "Pemain ini ada di penjara!");

	GetPlayerPos(playerid, plocx, plocy, plocz);

	if(GetPlayerState(params[0]) == 2)
	{
		new tmpcar = GetPlayerVehicleID(params[0]);
		SetVehiclePos(tmpcar, plocx, plocy+4, plocz+1);
	}
	else SetPlayerPos(params[0],plocx,plocy+2, plocz);
    SetPlayerInterior(params[0], inter);
	SetPlayerVirtualWorld(params[0], world);

	SCMF(params[0], COLOR_GREY, "Administrator %s[%d] teleport kamu ke dirimu sendiri.", Name(playerid), playerid);
	SCMF(playerid, COLOR_GREY, "Pemain %s[%d] diteleportasikan kepada Anda!", Name(params[0]), params[0]);
    format(String, sizeof(String), "~y~<CMD> ~w~%s[%d] teleported player %s[%d]", Name(playerid), playerid, Name(params[0]), params[0]);
   	SendAdminMessage(COLOR_RED, String);
	return true;
}

alias:goto("g");
CMD:goto(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /g(oto) [id]");

	new Float:plocx,Float:plocy,Float:plocz;
	if(!IsPlayerConnected(params[0])) return 1;
	if(GetPlayerState(params[0]) != 1 && GetPlayerState(params[0]) != 2 && GetPlayerState(params[0]) != 3) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan.!");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return Send(playerid, COLOR_GREY, "Pemain dalam mode observasi!");

	GetPlayerPos(params[0], plocx, plocy, plocz);
	if(GetPlayerState(playerid) == 2)
	{
		new tmpcar = GetPlayerVehicleID(playerid);
		SetVehiclePos(tmpcar, plocx, plocy+4, plocz+1);
	}
	else SetPlayerPos(playerid,plocx,plocy+2, plocz), SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(params[0])), SetPlayerInterior(playerid, GetPlayerInterior(params[0]));

	format(format_string, 144, "[A] %s teleport ke pemain %s[%i]", GetPlayerNameEx(playerid), GetPlayerNameEx(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, format_string);

	return 1;
}

CMD:gotoco(playerid, params[])
{
	if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
		
	new Float: pos[3], int;
	if(sscanf(params, "fffd", pos[0], pos[1], pos[2], int)) return Send(playerid, -1, "/gotoco [x coordinate] [y coordinate] [z coordinate] [interior]");

	Servers(playerid, "You have been teleported to the coordinates specified.");
	SetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	SetPlayerInterior(playerid, int);
	return 1;
}

CMD:o(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;

	if(sscanf(params, "s[128]",params[0])) return Send(playerid, -1, "Masuk: /o [teks]");
	
 	new leveladmins[128];
 	
   	if(admin_level[playerid]        <=7)    leveladmins = "Staff";
	if(admin_level[playerid]        ==7)    leveladmins = "Staff";
	if(admin_level[playerid]        ==10)    leveladmins = "Staff";
	if(admin_level[playerid]        ==11)    leveladmins = "Management";
	
	format(format_string, sizeof(format_string), "(( {FF0000}%s {FFFFFF}%s {FFFFFF}: %s ))", leveladmins, PlayerInfo[playerid][pAname], params[0]);
	SendClientMessageToAll(COLOR_WHITE, format_string);
	return true;
}
CMD:satiety(playerid, params[])
{
	format(String, 322, ""W"Jika karakter Anda penuh - Bilah HP tidak akan berkurang.\nIkuti diet karakter Anda untuk menghindari penyakit.\nAnda dapat melacak kebutuhan karakter secara online, lebih banyak di 'Pengaturan pribadi'.\n\nKepenuhan karakter adalah {B0BA06}%.0f persen.", PlayerInfo[playerid][pSatiety]);
    return SPD(playerid,0,DIALOG_STYLE_MSGBOX, "Karakter kenyang", String, "Tutup", "");
}
CMD:present(playerid, params[])
{
	if(GetPlayerWeapon(playerid) != 14) return Send(playerid,-1,"Ambil bunga untuk diberikan.");
	if(sscanf(params, "d", params[0])) return Send(playerid, -1, "Masuk: /present [ID pemain]");
	if(params[0] == playerid) return Send(playerid, -1, "Anda tidak dapat mentransfer bunga ke diri sendiri.");
	if(!ProxDetectorS(3.0, playerid, params[0])) return Send(playerid, -1, "Anda terlalu jauh, mendekatlah.");
	new rguna,rammoa;
	GetPlayerWeaponData(playerid,10,rguna,rammoa);
	GivePlayerWeapon(params[0],GetPlayerWeapon(playerid),rammoa);
	GivePlayerWeapon(playerid,GetPlayerWeapon(playerid),-rammoa);
	SetPlayerArmedWeapon(playerid, 0);
	ApplyAnimation(playerid, "DEALER", "DEALER_DEAL",4.0,0,0,0,0,0,1);
	ApplyAnimation(params[0], "DEALER", "DRUGS_BUY",4.0,0,0,0,0,0,1);

	SCMF(playerid, -1, "Anda memberi buket bunga kepada pemain %s", Name(params[0]));
	SCMF(params[0], -1, "%s memberimu buket bunga", Name(playerid));
 	format(String, 86,"%s memberi buket bunga %s", Name(playerid), Name(params[0]));
 	ProxDetector(15.0, playerid, String, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	return true;
}
CMD:drink(playerid, params[])
{
    new i = player_use_bizbar[playerid];

	if(player_use_bizbar[playerid] == -1) return SCM(playerid, COLOR_GREY, "Anda tidak berada di bar mana pun.");

    if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 1 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
	    if(BizzInfo[i][bLocked] == 1) return Send(playerid,COLOR_GREY, "Restoran ditutup oleh pemilik!");

		format(String, 322,
			"[0] Air putih\t{32CD32}%d$\n\
			[1] tea manis\t{32CD32}%d$\n\
			[2] Coca-Cola\t{32CD32}%d$\n\
			[3] Susu Milk\t{32CD32}%d$\n\
			[4] Kopi Susu\t{32CD32}%d$\n\
			[5] Milk Tea\t{32CD32}%d$\n\
			[6] Tea Hijau\t{32CD32}%d$\n\
			[7] Fanta\t{32CD32}%d$\n\
			[8] Sprite\t{32CD32}%d$",

		BizzInfo[i][bPrice],BizzInfo[i][bPrice]*2,BizzInfo[i][bPrice]*3,BizzInfo[i][bPrice]*4,BizzInfo[i][bPrice]*5,BizzInfo[i][bPrice]*6,BizzInfo[i][bPrice]*7,BizzInfo[i][bPrice]*8,BizzInfo[i][bPrice]*9);

		SPD(playerid, 72, DIALOG_STYLE_LIST, "Menu bar", String, "Pilih", "Batalkan");
	}
	else SCM(playerid, COLOR_GREY, "Anda jauh dari bar.");

	return 1;
}
CMD:buy(playerid, params[])
{
    if(GetPVarInt(playerid, "VibClothes") != 0)
    {
	    new choose_id = player_choose_skin[playerid];

		new sex = PlayerInfo[playerid][pSex];

		new s_id = sex == 1 ? SkinMan[choose_id] : SkinMale[choose_id];

		new price = gSkins[s_id][skinPrice];

		new skin_id = gSkins[s_id][skinID];

	    format(String, 244, "{FFFFFF}Kulitmu {FFFF00}[ID: %d]{FFFFFF} akan diganti oleh kulit {FFFF00}[ID: %d]($%i){FFFFFF}\n\nAnda yakin ingin membeli kulit ini?", PlayerInfo[playerid][pSkin], skin_id, price);
		return SPD(playerid,126,DIALOG_STYLE_MSGBOX, "Peringatan", String, "Untuk membeli", "Batalkan");
	}

	new i = player_use_bizbar[playerid];
	if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 3 || BizzInfo[i][bType] == 7 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return Send(playerid,-1, "Bisnis ditutup oleh pemilik.");

 		ProductsMenu(playerid);
	}
	return true;
}
CMD:fillcar(playerid, params[])
{
    if(GetPVarInt(playerid, "kanistra") == 0) return Send(playerid, -1, "Anda tidak memiliki tabung, Anda dapat membelinya di pom bensin mana pun.");

    if(IsPlayerInAnyVehicle(playerid)) return Send(playerid,-1,"Tidak dapat digunakan di dalam mobil.");
    if(GetNearestVehicle(playerid) == 0) return Send(playerid,-1,"Anda harus pergi ke tangki bensin mobil yang ingin Anda isi ulang.");

    SPD(playerid, 60, DIALOG_STYLE_MSGBOX, "SPBU", ""W"Anda yakin ingin mengisi mobil ini dengan 50 liter?", "Ya", "Tidak");
	return 1;
}
CMD:business(playerid, params[])
{
	if(GetPlayerBizz(playerid) == -1) return Send(playerid, -1, "Anda tidak memiliki perusahaan.");
	return ShowBizz(playerid, GetPlayerBizz(playerid));
}
CMD:fuelst(playerid, params[])
{
	if(GetPlayerABizz(playerid) == 0) return Send(playerid, -1, "Anda tidak memiliki pompa bensin.");
	return ShowABizz(playerid, GetPlayerABizz(playerid));
}
CMD:abiz(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /abiz [biznumber]");
	if(params[0] > TotalBizz || params[0] < 0) return Send(playerid, -1, "Tidak ada bisnis yang ditemukan dengan ID ini.");

    SetPVarInt(playerid, "next_area", gettime() + 3);

	SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid, 0);
	SetPlayerPos(playerid, BizzInfo[params[0]][bEntranceX] + 2.0, BizzInfo[params[0]][bEntranceY] + 2.0, BizzInfo[params[0]][bEntranceZ]);
	return SCMF(playerid, -1, "Anda telah diteleport ke bisnis {FFE569}%s(%d).", BizzInfo[params[0]][bMessage], params[0]);
}
CMD:afuel(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /afuel [fuelnumber]");
	if(params[0] > TotalABizz || params[0] <= 0) return Send(playerid, -1, "Tidak ada pompa bensin dengan ID ini ditemukan.");

	SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid,0);
	SetPlayerPos(playerid, BizzAInfo[params[0]][aAreaFillX], BizzAInfo[params[0]][aAreaFillY], BizzAInfo[params[0]][aAreaFillZ]);
	return SCMF(playerid, -1, "Anda telah diteleportasi ke pompa bensin {FFE569}%s(%d).", BizzAInfo[params[0]][aMessage], params[0]);
}
CMD:ahouse(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /ahouse [housenumber]");
	if(params[0] > MAX_HOUSES-1 || params[0] <= 0) return Send(playerid, -1, "Tidak ada rumah dengan ID ini ditemukan.");

	SetPlayerInterior(playerid, 0), SetPlayerVirtualWorld(playerid,0);
	SetPlayerPos(playerid, HouseInfo[params[0]][hEntrancex], HouseInfo[params[0]][hEntrancey], HouseInfo[params[0]][hEntrancez]);
	return SCMF(playerid, -1, "Anda dipindahkan ke rumah {FFE569}%d.", params[0]);
}

CMD:freeze(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;

    new to_player, toggle;

    if(sscanf(params, "ui",to_player, toggle)) return Send(playerid, -1, "Masuk: /freeze [id] [0 - membeku, 1 - mencairkan es]");

	if(!(0 <= toggle <= 1)) return Send(playerid, -1, "Masuk: /freeze [id] [0 - membeku, 1 - mencairkan es]");

	TogglePlayerControllable(to_player, toggle);

	SCMF(playerid, -1, "Kamu adalah %s pemain %s.", toggle ? ("dicairkan") : ("membeku"), GN(to_player));
	SCMF(to_player, -1, "Administrator %s %s Kamu.", Name(playerid), toggle ? ("membeku") : ("dicairkan"));

	return 1;
}

CMD:gun(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "ddd",params[0],params[1],params[2])) return Send(playerid, -1, "Masuk: /gun [id] [id lengan] [ammo]");
	if(params[2] < 1 || params[2] > 5000) return Send(playerid, -1, "Anda tidak boleh membagikan kurang dari 1 dan lebih dari 1000 putaran!");
	GivePlayerWeapon(params[0],params[1],params[2]);

	SCMF(playerid, -1, "Anda memberi pemain %s[%d] senjata sementara {1A8FA9}%s (%d Jumlah.)", Name(params[0]), params[0], weapname[params[1]], params[2]);
	SCMF(params[0], -1, "Administrator %s[%d] memberimu senjata sementara {1A8FA9}%s (%d Jumlah.)", Name(playerid), playerid, weapname[params[1]], params[2]);
	format(String, sizeof(String), "~y~<CMD> ~w~%s[%d] gave gun %s to the player %s[%d]", Name(playerid), playerid, weapname[params[1]], Name(params[0]), params[0]);
	SendAdminMessage(COLOR_RED, String);
	return 1;
}

CMD:key(playerid)
{
	new car_id = GetPlayerUseHomeCar(playerid);
	// new merp[125], dorp[125], playername[MAX_PLAYER_NAME +1];

	if(car_id == -1)
	    return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam transportasi pribadi.");

    player_car_keys[playerid][car_id] = !player_car_keys[playerid][car_id];

	new vehicleid = GetPlayerVehicleID(playerid);

    GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
    if(!player_car_keys[playerid][car_id]) SetVehicleParamsEx(vehicleid,0,lights,alarm,doors,bonnet,boot,objective);


	SCMF(playerid, -1, "Kamu telah %s kunci kendaraan.", player_car_keys[playerid][car_id] ? ("memasukan") : ("mengambil"));

	return 1;
}
CMD:lock(playerid, params[])
{
	for(new i; i < MAX_PLAYER_VEHICLES; i++)
 	{
      	new vehicleid = player_home_car[playerid][i];

    	if(vehicleid == INVALID_VEHICLE_ID) continue;

    	new Float:cx,Float:cy,Float:cz;
    	GetVehiclePos(vehicleid, cx, cy, cz);
    	if(!PlayerToPoint(5.0, playerid, cx, cy, cz)) continue;

	    GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);

        if(doors == 0)
		{
		    if(lights == 0) SetVehicleParamsEx(vehicleid,engine,1,alarm,1,bonnet,boot,objective);
			else SetVehicleParamsEx(vehicleid,engine,0,alarm,1,bonnet,boot,objective);
			GameTextForPlayer(playerid, "~w~vehicle ~r~locked", 5000,6);
			CarInfo[playerid][cLock][i] = 1;
		}
		else
		{
			if(lights == 0) SetVehicleParamsEx(vehicleid,engine,1,alarm,0,bonnet,boot,objective);
			else SetVehicleParamsEx(vehicleid,engine,0,alarm,0,bonnet,boot,objective);
			GameTextForPlayer(playerid, "~w~vehicle ~r~unlocked", 5000,6);
			CarInfo[playerid][cLock][i] = 0;
		}

		SetPlayerChatBubble(playerid, !doors ? ("pintu mobil tertutup") : ("membuka pintu mobil"),COLOR_PURPLE,30.0,10000);

		PlayerPlaySoundEx(24600, cx, cy, cz);
		SetTimerEx("LightOff", 1000, false, "dd", playerid, vehicleid);
				
		return 1;
	}

	return Send(playerid,COLOR_GREY,"Anda terlalu jauh dari mobil pribadi Anda.");
}

CMD:id(playerid, params[])
{
	if(!strlen(params)) return SCM(playerid, -1, "Masuk: /id [part of name]");

	if(!(2 <= strlen(params) <= MAX_PLAYER_NAME - 1)) return SCM(playerid, COLOR_GREY, "Panjang nama panggilan tersedia dari 2 hingga 32 karakter.");

	new count = 0;

	foreach(Player, i)
	{
	    if(count == 10) break;

	    if(strfind(GetPlayerNameEx(i), params, true) == -1) continue;

	    SCMF(playerid, -1, "[%i] %s[%i]", count, GetPlayerNameEx(i), i);

	    count++;
	}

	return SCMF(playerid, -1, "Para pemain ditemukan: %i", count);
}

CMD:spawnbikes(playerid)
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

	new count = 0;

    for(new i; i < MAX_VEHICLES; i++)
    {
		if(VehInfo[i][vStatus] != 2) continue;
		if(GetVehicleModel(i) != 510) continue;
		if(vehicle_driver[i] != INVALID_PLAYER_ID) continue;

		count++;
		SetVehicleToRespawn(i);
    }

	return SCMF(playerid, -1, "Itu melahirkan: %i pcs.", count);
}

CMD:svehrad(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

    if(sscanf(params, "d", params[0])) return SCM(playerid, -1, "Masuk: /svehrad [jarak]");

	if(!(1 <= params[0] <= 50)) return SCM(playerid, COLOR_GREY, "Jarak yang tersedia dari 1 hingga 50.");

    new count = 0;

    new Float: x, Float: y, Float: z;

    for(new i; i < MAX_VEHICLES; i++)
    {
		if(!IsValidVehicle(i)) continue;
		if(vehicle_driver[i] != INVALID_PLAYER_ID) continue;

		GetVehiclePos(i, x, y, z);

        if(GetPlayerDistanceFromPoint(playerid, x, y, z) > params[0]) continue;

		count++;
		SetVehicleToRespawn(i);
    }

	return SCMF(playerid, -1, "Transport yang dibuat telah muncul(%i meter.): %i pcs.", params[0], count);
}
CMD:spawnveh(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

    if(sscanf(params, "d", params[0])) return SCM(playerid, -1, "Masuk: /spawnveh [ID]");
    SetVehicleToRespawn(params[0]);
    SCMF(playerid, -1, "Mobil %d dikirim untuk respawn", params[0]);
	return true;
}
CMD:dvehall(playerid)
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;

    new count = 0;

    for(new i; i < MAX_VEHICLES; i++)
    {
		if(!IsValidVehicle(i)) continue;
        if(!VehicleCreate[i]) continue;

		count++;
		DestroyVehicle(i);
    }

	return SCMF(playerid, -1, "Transport yang dibuat telah dihapus.: %i pcs.", count);
}

CMD:veh(playerid, params[])// Buat mobil
{
   	if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
    //new car = GetPlayerVehicleID(playerid);
	if(sscanf(params, "ddd", params[0],params[1],params[2])) return SendClientMessage(playerid, -1, "Masuk: /veh [id mobil] [warna 1] [warna 2]");
	if(params[0] > 611 || params[0] < 400) return SendClientMessage(playerid, -1, "ID transportasi dari 400 ke 611");
	if(params[1] > 255 || params[1] < 0) return SendClientMessage(playerid, -1, "ID warna dari 0 hingga 255");
	if(params[2] > 255 || params[2] < 0) return SendClientMessage(playerid, -1, "ID warna dari 0 hingga 255");
	new Float:X,Float:Y,Float:Z;
	GetPlayerPos(playerid, X,Y,Z);

	new carid = AddStaticVehicle(params[0], X,Y,Z, 0.0, params[1], params[2]);

	VehInfo[carid][vSost] = 100;
	VehInfo[carid][vStatus] = 2;

	Fuell[carid] = MAX_VEHICLE_FUEL;

	PutPlayerInVehicle(playerid, carid, 0);
	SetVehicleParamsEx(carid,1,0,0,0,0,0,0);

	SendClientMessage(playerid, 0x27C400FF, "Transportasi dibuat");
	VehicleCreate[carid] = true;
	return true;
}
CMD:dveh(playerid,params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	if(IsPlayerInAnyVehicle(playerid))
	{
	    new vehicleid = GetPlayerVehicleID(playerid);

	    if(VehicleCreate[vehicleid] != false)
	    {
	        DestroyVehicle(vehicleid);
			SCMF(playerid, -1, "Id mobil: {afafaf}%d {ffffff}dihapus", vehicleid);
	    }
	    else SendClientMessage(playerid, COLOR_GREY, "Perlu dibuat oleh - lalu transportasi!");
	}
	else SendClientMessage(playerid, COLOR_GREY, "Anda tidak dalam transportasi");
	return 1;
}
CMD:getmypos(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	return SCMF(playerid, -1, "INT: %d| VW: %d", GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
}
CMD:mbuy(playerid, params[])
{
	if(GetPlayerHouse(playerid) == -1) return Send(playerid, -1, "Anda tidak punya rumah!");
    return SPD(playerid,17,DIALOG_STYLE_LIST,"Memilih bagian yang diperlukan",""W"- Perabot Rumah\n- Pintu\n- Lukisan\n- Bunga rumah\n- Peralatan rumah tangga\n- Semuanya untuk kamar mandi","Pilih","Keluarlah");
}

CMD:hotel(playerid)
{
	new h_id = PlayerInfo[playerid][pHotel];

	if(h_id == -1) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki kamar hotel.");

    new days = GetElapsedTime(hotel_info[h_id][hRentTime], gettime(), CONVERT_TIME_TO_DAYS);

	format(command_text, 244,
		"[1] Pintu: %s\n\
		[2] Kirim kendaraan ke garasi\n\
		[3] Sewa [%i hari]\n\
		[4] Batalkan sewa",
		hotel_info[h_id][hLock] ? ("Tertutup") : ("Buka"),
		days);

	return ShowPlayerDialog(playerid, 8847, DIALOG_STYLE_LIST, "Menu hotel", command_text, "Pilih", "Tutup");
}

CMD:home(playerid, params[])
{
	new house = GetPlayerHouse(playerid);

	if(house == -1) house = GetPlayerHouseLodger(playerid);

	if(house == -1) return Send(playerid, -1, "Kamu tidak punya rumah!");

	new klass[20];

	switch(HouseInfo[house][hKlass])
	{
	    case 0: klass = "Kelas rendah";
	    case 1: klass = "Kelas menengah";
	    case 2: klass = "Kelas tinggi";
	    case 3: klass = "Kelas atas";
	    case 4: klass = "Rumah mewah";
	    case 5: klass = "Rumah VIP";
 	}

	format(String, 400,
		""W"Nomor rumah:\t\tNo %d\n\
		Jenis / nama:\t\t{CD950C}%s\n\
		"W"Pemilik:\t\t{1A8FA9}%s\n\n\
		"W"Kota / area:\t%s\n\
		Distrik:\t\t\t%s\n\
		"W"Biaya:\t\t%d$\n\
		Sewa:\t\t%d$ dalam sehari\n\n\
		Kotak P3K:\t\t%d pcs.\n\
		"W"Rumah dibayar:\t\tpada %d hari.\n\
		"W"Status rumah:\t\t%s",
		house,
		klass,
		HouseInfo[house][hOwner],
		GetTownName(HouseInfo[house][hEntrancex], HouseInfo[house][hEntrancey]),
		GetAreaName(HouseInfo[house][hEntrancex], HouseInfo[house][hEntrancey]),
		HouseInfo[house][hValue],
		HouseInfo[house][hTakings],
		HouseInfo[house][hHel],
		HouseInfo[house][hOplata],
		HouseInfo[house][hLock] ? ("{FF6347}Rumah itu sudah tutup") : ("{33AA33}Rumah itu terbuka"));

	if(HouseInfo[house][hSlet] != 0) strcat(String,"\n\n{FFE569}Rumah Anda dijelaskan dan dapat dijual ke negara bagian..");
	else strcat(String,"\n\n{56FB4E}Untuk membuka panel kontrol Anda\nklik rumah 'Edit'");

	SPD(playerid,15,DIALOG_STYLE_MSGBOX,"Informasi Rumah", String, "Edit","Keluar");
	return 1;
}
CMD:makecure(playerid, params[])
{
    new i = GetPlayerHouse(playerid);
	if(i == -1) return 1;
	if(GetPlayerVirtualWorld(playerid) != i) return Send(playerid, -1, "Untuk menetapkan titik perawatan, Anda harus di rumah.");
	if(HouseInfo[i][hUpdHel] == 0) return Send(playerid, -1, "Perbaikan diperlukan untuk mengatur item perawatan 'Kotak P3K'.");

	if(HouseInfo[i][hAreaHeal] == 0) SPD(playerid, 35, DIALOG_STYLE_MSGBOX, "Instalasi First Aid Kit", ""W"Yakin ingin memulai pemasangan titik perawatan?", "Ya", "Tidak");
	else SPD(playerid, 35, DIALOG_STYLE_MSGBOX, "Kotak P3K bergerak", ""W"Yakin ingin memindahkan titik perawatan di rumah?", "Ya", "Tidak");
	return 1;
}

CMD:buyfuelst(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari level 2.");

    new i = player_enter_fuel[playerid];
    if(i == 0) return Send(playerid, -1, "Anda harus berada di pompa bensin yang ingin Anda beli.");
    if(BizzAInfo[i][aOwned] != 0) return SCMF(playerid, -1, "Bisnis ini sudah diambil oleh pemain %s", BizzAInfo[i][aOwner]);
    if(GetPlayerABizz(playerid) != 0)  return SCMF(playerid, -1, "Anda sudah memiliki bisnis {FFF74D}%s[%d]"W", gunakan /sellfulest untuk menjual.", BizzAInfo[GetPlayerABizz(playerid)][aMessage], GetPlayerABizz(playerid));

    format(String, 322, ""W"Judul:\t\tSPBU {EBBD00}'%s'\n"W"Biaya:\t\t{0BB5BF}%d$\n"W"Biaya sewa:\t{0BB5BF}%d$", BizzAInfo[i][aMessage], BizzAInfo[i][aBuyPrice], BizzAInfo[i][aArenda]);
    SPD(playerid,64,DIALOG_STYLE_MSGBOX, "Beli pompa bensin", String, "Ya", "Tidak");
    return 1;
}
CMD:buybiz(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari level 2.");

	for(new i; i < MAX_BIZZ; i++)
	{
        if(!PlayerToPoint(10.0, playerid, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ])) continue;

		if(BizzInfo[i][bOwned] != 0) return SCMF(playerid, -1, "Bisnis ini sudah diambil oleh pemain %s", BizzInfo[i][bOwner]);
		if(GetPlayerBizz(playerid) != -1)  return SCMF(playerid, -1, "Anda sudah memiliki bisnis {FFF74D}%s[%d]"W", gunakan /sellbiz untuk menjual.", BizzInfo[GetPlayerBizz(playerid)][bMessage], GetPlayerBizz(playerid));

	 	format(String,322, ""W"Membeli bisnis: {1A8FA9}%s\n\n{43CD80}Informasi:\n"W"Negara dapat merebut bisnis, jika:\n\
			\n1. Anda memiliki hutang untuk sewa tempat\n\nJika semua persyaratan terpenuhi, tidak akan ada masalah dengan bisnis.\n\nHarga bisnis: %d$\n{EEEED1}Anda menyetujui ketentuan ini.?", BizzInfo[i][bMessage], BizzInfo[i][bBuyPrice]);

		SPD(playerid,51,DIALOG_STYLE_MSGBOX, "Ketentuan kesepakatan",String, "Ya", "Tidak");

		player_enter_biz[playerid] = i;

		return 1;
	}

	return SCM(playerid, COLOR_GREY, "Tidak ada bisnis di dekat Anda.");
}

CMD:sellbiz(playerid)
{
    new bizz = GetPlayerBizz(playerid);
    if(bizz == -1) return Send(playerid, -1, "Anda tidak punya bisnis.");
	if(BizzInfo[bizz][bSlet] != 0) return SPD(playerid,0,DIALOG_STYLE_MSGBOX,"Penjualan bisnis", ""W"Anda tidak dapat menjual bisnis Anda, karena dijelaskan oleh negara.\n\
	Anda dapat secara prematur mengajukan pengusiran di Balaikota.", "Baiklah","");
	if(!PlayerToPoint(10, playerid,BizzInfo[bizz][bEntranceX], BizzInfo[bizz][bEntranceY], BizzInfo[bizz][bEntranceZ])) return Send(playerid,-1,"Gunakan fitur ini di dekat bisnis Anda.");

	SPD(playerid, 7646, DIALOG_STYLE_LIST, "Bagaimana Anda ingin menjual bisnis?", "- Ke negara\n- Pemain", "Pilih", "Tutup");

    return 1;
}
CMD:sellfuelst(playerid)
{
	if(pData[playerid][pLevel] < 3) return Error(playerid, "Anda harus level 3 atau seterusnya.");
    new bizz = GetPlayerABizz(playerid);
    if(bizz == 0) return Send(playerid, -1, "Anda tidak memiliki pom bensin.");
	if(BizzAInfo[bizz][aSlet] != 0) return SPD(playerid,0,DIALOG_STYLE_MSGBOX,"Penjualan pompa bensin", ""W"Anda tidak dapat menjual pompa bensin, karena dijelaskan oleh negara.\n\
	Anda dapat secara prematur mengajukan pengusiran di Balaikota.", "Baiklah","");
	if(!PlayerToPoint(10, playerid, BizzAInfo[bizz][aAreaFillX], BizzAInfo[bizz][aAreaFillY], BizzAInfo[bizz][aAreaFillZ])) return Send(playerid,-1,"Gunakan fungsi ini di dekat pom bensin Anda..");

    SPD(playerid, 7346, DIALOG_STYLE_LIST, "Bagaimana Anda ingin menjual pompa bensin?", "- Ke negara\n- Pemain", "Pilih", "Tutup");

    return 1;
}
CMD:sellhouse(playerid)
{
	if(pData[playerid][pLevel] < 3) return Error(playerid, "Anda harus level 3 atau seterusnya.");
	new house = GetPlayerHouse(playerid);
    if(house == -0) return Send(playerid, -1, "Kamu tidak di rumah");
	if(HouseInfo[house][hSlet] != 0) return SPD(playerid,0,DIALOG_STYLE_MSGBOX,"Membeli rumah", ""W"Anda tidak dapat menjual rumah Anda, karena dijelaskan oleh negara.\n\
	Anda dapat secara prematur mengajukan pengusiran di Balaikota.", "Baiklah","");
	new h_class = HouseInfo[house][hKlass];
	if(!PlayerToPoint(10, playerid,house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2])) return Send(playerid,-1,"Gunakan fitur ini di dalam rumah Anda.");

    SPD(playerid, 7246, DIALOG_STYLE_LIST, "Bagaimana Anda ingin menjual rumah?", "- Ke negara\n- Pemain", "Pilih", "Tutup");

	return true;
}

CMD:sellsim(playerid, params[])
{
	if(!PlayerInfo[playerid][pNumber]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki kartu SIM.");

    new i = player_enter_biz[playerid];
	if(!PlayerToPoint(15.0, playerid,BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ]) || BizzInfo[i][bType] != 3)
		return SCM(playerid, COLOR_GREY, "Anda tidak di toko 24/7!");

	new to_player, price;

    if(sscanf(params,"ui",to_player, price)) return Send(playerid,0xafafafff,"Gunakan: /sellsim [playerid] [price]");

    if(!(1 <= price <= 5000000)) return SCM(playerid, COLOR_GREY, "Jumlah yang tersedia dari $1 hingga $5.000.000");

    if(playerid == to_player)
	    return SCM(playerid, COLOR_GREY, "Anda menunjukkan diri Anda sendiri.");

	if(!ProxDetectorS(5.0, playerid, to_player))
	    return SCM(playerid, COLOR_GREY, "Anda jauh dari pemain ini.");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELLSIM, price);

	SCMF(playerid, -1, "Anda menyarankan %s beli nomor kamu t. %i. Harga: $%i", GetPlayerNameEx(to_player), PlayerInfo[playerid][pNumber], price);

	SCMF(to_player, -1, "%s menyarankan (a) Anda membeli dari dia nomor t. %i. Harga: $%i", GetPlayerNameEx(playerid), PlayerInfo[playerid][pNumber], price);
    return SCM(to_player, -1, "Untuk menyetujui, klik Y(/accept) atau untuk penolakan N(/cancel)");
}

CMD:sellcar(playerid)
{
	if(GetPlayerOfferInfo(playerid, O_INCOMING_PLAYER) != INVALID_PLAYER_ID)
	    return SCM(playerid, COLOR_GREY, "Tidak tersedia dengan penawaran penjualan aktif.");

	new u_car = GetPlayerUseHomeCar(playerid);

	if(u_car == -1)
	    return SCM(playerid, COLOR_GREY, "Anda tidak berada dalam transportasi pribadi.");

    SetPlayerUseListitem(playerid, u_car);

	return SPD(playerid, 3329, DIALOG_STYLE_LIST, "Penjualan kendaraan", "Kepada siapa Anda ingin menjual transportasi?\n- Ke negara\n- Pemain", "Pilih", "Kembali");
}
CMD:enter(playerid, params[])
{
	if(PlayerInfo[playerid][pInjured] == 0)
    {
		foreach(new did : Doors)
		{
			if(IsPlayerInRangeOfPoint(playerid, 2.8, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ]))
			{
				if(dData[did][dGarage] == 1 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && IsPlayerInAnyVehicle(playerid))
				{
					if(dData[did][dIntposX] == 0.0 && dData[did][dIntposY] == 0.0 && dData[did][dIntposZ] == 0.0)
						return Error(playerid, "Interior entrance masih kosong, atau tidak memiliki interior.");

					if(dData[did][dLocked])
						return Error(playerid, "Bangunan ini di Kunci untuk sementara.");

					if(dData[did][dFaction] > 0)
					{
						if(dData[did][dFaction] != PlayerInfo[playerid][pMember])
							return Error(playerid, "Pintu ini hanya untuk fraksi.");
					}
					if(dData[did][dFamily] > 0)
					{
						if(dData[did][dFamily] != PlayerInfo[playerid][pFamily])
							return Error(playerid, "Pintu ini hanya untuk Family.");
					}

					if(dData[did][dVip] > PlayerInfo[playerid][pVip])
						return Error(playerid, "VIP Level mu tidak cukup.");

					if(dData[did][dAdmin] > admin_level[playerid])
						return Error(playerid, "Admin level mu tidak cukup.");

					if(strlen(dData[did][dPass]))
					{
						if(sscanf(params, "s[256]", params)) return Usage(playerid, "/enter [password]");
						if(strcmp(params, dData[did][dPass])) return Error(playerid, "Password Salah.");

						if(dData[did][dCustom])
						{
							SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						else
						{
							SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						PlayerInfo[playerid][pInDoor] = did;
						SetPlayerInterior(playerid, dData[did][dIntint]);
						SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
						SetCameraBehindPlayer(playerid);
						SetPlayerWeather(playerid, 0);
					}
					else
					{
						if(dData[did][dCustom])
						{
							SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						else
						{
							SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						PlayerInfo[playerid][pInDoor] = did;
						SetPlayerInterior(playerid, dData[did][dIntint]);
						SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
						SetCameraBehindPlayer(playerid);
						SetPlayerWeather(playerid, 0);
					}
				}
				else
				{
					if(dData[did][dIntposX] == 0.0 && dData[did][dIntposY] == 0.0 && dData[did][dIntposZ] == 0.0)
						return Error(playerid, "Interior entrance masih kosong, atau tidak memiliki interior.");

					if(dData[did][dLocked])
						return Error(playerid, "Pintu ini ditutup sementara");

					if(dData[did][dFaction] > 0)
					{
						if(dData[did][dFaction] != PlayerInfo[playerid][pMember])
							return Error(playerid, "Pintu ini hanya untuk faction.");
					}
					if(dData[did][dFamily] > 0)
					{
						if(dData[did][dFamily] != PlayerInfo[playerid][pFamily])
							return Error(playerid, "Pintu ini hanya untuk family.");
					}

					if(dData[did][dVip] > PlayerInfo[playerid][pVip])
						return Error(playerid, "Your VIP level not enough to enter this door.");

					if(dData[did][dAdmin] > admin_level[playerid])
						return Error(playerid, "Your admin level not enough to enter this door.");

					if(strlen(dData[did][dPass]))
					{
						if(sscanf(params, "s[256]", params)) return Usage(playerid, "/enter [password]");
						if(strcmp(params, dData[did][dPass])) return Error(playerid, "Invalid door password.");

						if(dData[did][dCustom])
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						else
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						PlayerInfo[playerid][pInDoor] = did;
						SetPlayerInterior(playerid, dData[did][dIntint]);
						SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
						SetCameraBehindPlayer(playerid);
						SetPlayerWeather(playerid, 0);
					}
					else
					{
						if(dData[did][dCustom])
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						else
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						PlayerInfo[playerid][pInDoor] = did;
						SetPlayerInterior(playerid, dData[did][dIntint]);
						SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
						SetCameraBehindPlayer(playerid);
						SetPlayerWeather(playerid, 0);
					}
				}
			}
			if(IsPlayerInRangeOfPoint(playerid, 2.8, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ]))
			{
				if(dData[did][dGarage] == 1 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER && IsPlayerInAnyVehicle(playerid))
				{
					if(dData[did][dFaction] > 0)
					{
						if(dData[did][dFaction] != PlayerInfo[playerid][pMember])
							return Error(playerid, "Pintu ini hanya untuk faction.");
					}

					if(dData[did][dCustom])
					{
						SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);
						LoadingObject(playerid);
					}
					else
					{
						SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);
						LoadingObject(playerid);
					}
					PlayerInfo[playerid][pInDoor] = -1;
					SetPlayerInterior(playerid, dData[did][dExtint]);
					SetPlayerVirtualWorld(playerid, dData[did][dExtvw]);
					SetCameraBehindPlayer(playerid);
					//SetPlayerWeather(playerid, WorldWeather);
				}
				else
				{
					if(dData[did][dFaction] > 0)
					{
						if(dData[did][dFaction] != PlayerInfo[playerid][pMember])
							return Error(playerid, "Pintu ini hanya untuk faction.");
					}

					if(dData[did][dCustom])
						SetPlayerPosition(playerid, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);

					else
						SetPlayerPosition(playerid, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);

					PlayerInfo[playerid][pInDoor] = -1;
					SetPlayerInterior(playerid, dData[did][dExtint]);
					SetPlayerVirtualWorld(playerid, dData[did][dExtvw]);
					SetCameraBehindPlayer(playerid);
					//SetPlayerWeather(playerid, WorldWeather);
				}
			}
        }
    }
    return 1;
}
CMD:exit(playerid)
{
    if(player_bone_table[playerid] != -1) PlayerLeaveBoneTable(playerid);

	if(player_hotel_id[playerid] != -1) PlayerLeaveHotelNumber(playerid);

    if(GetPVarInt(playerid, "VibClothes") != 0) return PlayerExitFromClothesShop(playerid);

	new i = player_enter_home[playerid];

	if(i == -1) return 1;

	new h_class = HouseInfo[i][hKlass];

	if(PlayerToPoint(3.0, playerid,house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2]))
	{
        SetPlayerInterior(playerid,0), SetPlayerVirtualWorld(playerid,0);
		SetPlayerPos(playerid,HouseInfo[i][hEntrancex],HouseInfo[i][hEntrancey],HouseInfo[i][hEntrancez]);

		player_enter_home[playerid] = -1;
	}
	else SCM(playerid, COLOR_GREY, "Anda jauh dari meninggalkan rumah.");

	return true;
}
CMD:setjob(playerid, params[])
{
	if(sscanf(params,"ii",params[0],params[1])) return Send(playerid,0xafafafff,"Gunakan: /setjob [playerid] [job]");
	PlayerInfo[params[0]][pJob] = params[1];
	return true;
}
CMD:alogin(playerid, params[])
{
	if(admin_level[playerid] < 1) return 1;
	if(!strcmp(PlayerInfo[playerid][pAdminKey], "0", true)) return SPD(playerid, 6, DIALOG_STYLE_INPUT, "Registrasi Kata Sandi", ""W"Masukkan kata sandi yang diinginkan untuk mengakses panel admin:\n\n- Kata sandi tidak boleh mengandung karakter Rusia\n- Kata sandi harus antara 4 dan 12 karakter", "Masuk", "Keluar");
 	//SPD(playerid, 7, DIALOG_STYLE_INPUT, "Login", ""W"Masukkan kata sandi dari panel admin:", "Masuk", "Keluar");
 	ALogin(playerid);
	return true;
}

CMD:setveh(playerid, params[])
{
    if(admin_level[playerid] <11) return 1;
    if(sscanf(params, "dds[24]",params[0],params[1])) return Send(playerid, -1, "Masuk: /setveh [id player] [model]");
    if(params[1] > 611 || params[1] < 400) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}ID transportasi dari 400 ke 611");
    if(!IsPlayerConnected(params[0])) return Send(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemain sedang offline");
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemain belum login");
    if(afk_time[params[0]] > 2) return Send(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemain ini di AFK");
    if(GetPlayerVirtualWorld(playerid) > 0) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemain Berada Di Interior");
    if(GetPlayerInterior(playerid) > 0) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemain Berada Di Interior");
    if(player_spawn_car_slot[playerid] != -1) return SendError(playerid, "Silakan Menyuruh Pemain Ini Untuk Membongkar Kendaraan Dia Terlebih Dahulu");

    new u_car_1 = GetPlayerFreeCarSlot(params[0]);

    if(u_car_1 == -1)
    {
        return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemain Ini Tidak Memiliki Slot Kosong");
    }

    CarInfo[params[0]][cModel][u_car_1] = params[1];
    CarInfo[params[0]][cColor1][u_car_1] = 0;
    CarInfo[params[0]][cColor2][u_car_1] = 0;
    CarInfo[params[0]][cFuel][u_car_1] = 100.0;
    CarInfo[params[0]][cProbeg][u_car_1] = 0.0;
    CarInfo[params[0]][cCost][u_car_1] = 1000;
    CarInfo[params[0]][cWheels][u_car_1] = 0;
    CarInfo[params[0]][cSpoiler][u_car_1] = 0;
    CarInfo[params[0]][cBumper1][u_car_1] = 0;
    CarInfo[params[0]][cBumper2][u_car_1] = 0;
    CarInfo[params[0]][cPaintJobs][u_car_1] = 255;
    CarInfo[params[0]][cNitro][u_car_1] = 0;
    CarInfo[params[0]][cHydrawlic][u_car_1] = 0;
    CarInfo[params[0]][cHood][u_car_1] = 0;
    CarInfo[params[0]][cRoof][u_car_1] = 0;
    CarInfo[params[0]][cSideskirt][u_car_1] = 0;
    CarInfo[params[0]][cLamps][u_car_1] = 0;
    CarInfo[params[0]][cExhaust][u_car_1] = 0;
    CarInfo[params[0]][cStereo][u_car_1] = 0;
    CarInfo[params[0]][cVentRight][u_car_1] = 0;
    CarInfo[params[0]][cVentLeft][u_car_1] = 0;
    CarInfo[params[0]][cHeal][u_car_1] = 1000.0;
    CarInfo[params[0]][cLock][u_car_1] = 0;
    CarInfo[params[0]][cDamagePanel][u_car_1] = 0;
    CarInfo[params[0]][cDamageDoors][u_car_1] = 0;
    CarInfo[params[0]][cDamageLights][u_car_1] = 0;
    CarInfo[params[0]][cDamageTires][u_car_1] = 0;
    CarInfo[params[0]][cGun][u_car_1] = 0;
    CarInfo[params[0]][cAmmo][u_car_1] = 0;
    CarInfo[params[0]][cFood][u_car_1] = 0;
    CarInfo[params[0]][cDrink][u_car_1] = 0;
    CarInfo[params[0]][cBatu][u_car_1] = 0;
    CarInfo[params[0]][cBatuk][u_car_1] = 0;
    CarInfo[params[0]][cMetall][u_car_1] = 0;
    CarInfo[params[0]][cComponent][u_car_1] = 0;
    CarInfo[params[0]][cGarkot][u_car_1] = 0;
    CarInfo[params[0]][cInGarkot][u_car_1] = 0;

    GetPlayerPos(params[0], player_car_park[params[0]][u_car_1][0], player_car_park[params[0]][u_car_1][1], player_car_park[params[0]][u_car_1][2]);
    GetPlayerFacingAngle(params[0], player_car_park[params[0]][u_car_1][3]);

    SavePlayerCarPark(params[0]);
    SaveCars(params[0]);

    format(format_string, sizeof(format_string), "INFO: {FFFFFF}Admin {ff0000}%s {ffffff}Mengasih Mu Mobil {ffff00}%s {ffffff}Silakan Cek /car", Name(playerid), VehicleNames[params[1]-400]);
    SCM(params[0], COLOR_YELLOW, format_string);
    format(format_string, sizeof(format_string), "AdmCmd: {FFFFFF}Anda Berhasil Memberikan Mobil {ffff00}%s {ffffff}Kepada {ffff00}%s", VehicleNames[params[1]-400], Name(params[0]));
    SCM(playerid, COLOR_YELLOW, format_string);
    return 1;
}

CMD:sstats(playerid, params[])
{
	if(admin_level[playerid] == 0 && PlayerInfo[playerid][pSupport] == 0) return 1;

	if(sscanf(params, "d", params[0])) return Send(playerid, -1, "Masuk: /sstats [id]");
	if(!PlayerInfo[params[0]][pLogin]) return Send(playerid, -1,"Pemain tidak diotorisasi!");

	if(PlayerInfo[params[0]][pSupport] == 0) return SCM(playerid, COLOR_GREY, "Pemain tidak mendukung.");

	ShowSupportStats(playerid, params[0]);

	return 1;
}

CMD:astats(playerid, params[])
{
	if(admin_level[playerid] == 0) return 1;

    if(admin_level[playerid] < 6) return ShowAdminStats(playerid, playerid);

	if(sscanf(params, "d", params[0])) return SCM(playerid, COLOR_GREY, "/astats [id]");

	if(!PlayerInfo[params[0]][pLogin]) return Send(playerid, -1,"Pemain tidak diotorisasi!");

	if(admin_level[params[0]] == 0) return SCM(playerid, COLOR_GREY, "Pemain bukan administrator.");

	if(admin_level[params[0]] > admin_level[playerid]) return SCM(playerid, COLOR_GREY, "Pemain berada di atas level Anda.");

	ShowAdminStats(playerid, params[0]);

	return 1;
}
CMD:adminkey(playerid, params[])
{
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	SPD(playerid, 6, DIALOG_STYLE_INPUT, "Daftarkan kata sandi baru", ""W"Masukkan kata sandi yang diinginkan untuk mengakses panel admin:\n\n- Kata sandi tidak boleh mengandung karakter Rusia\n- Kata sandi harus antara 4 dan 12 karakter", "Masuk", "Keluar");
	return true;
}
CMD:gzcolor(playerid,params[])
{
    if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
//    if(PlayerInfo[playerid][pLogin] == 0) return 1;
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, 0xafafafff, "/gzcolor [parameter]");
	for(new i; i < MAX_ZONES;i++)
	{
		if(PlayerToKvadrat(playerid,GZInfo[i][gPos][0], GZInfo[i][gPos][1],GZInfo[i][gPos][2],GZInfo[i][gPos][3]))
		{
			GZInfo[i][gFraction] = params[0];
			GangZoneStopFlashForAll(GZInfo[i][gID]);
			GangZoneHideForAll(GZInfo[i][gID]);
			GangZoneShowForAll(GZInfo[i][gID],GetGangZoneColor(i));
			SaveGZ(i);
			format(format_string,sizeof(format_string),"Zona berhasil dicat ulang.. {afafaf}(id zone:%i/id fraction: %i)",GZInfo[i][gID],params[0]);
			SendClientMessage(playerid, -1, format_string);
			return true;
		}
	}
	return true;
}
CMD:shelp(playerid, params[])
{
    if(PlayerInfo[playerid][pSupport] == 0) return 1;

	Send(playerid, 0xB8860BFF, "/stats /ans /ask /supports /sc");

	return 1;
}

CMD:number(playerid, params[])
{
	if(!PlayerInfo[playerid][pProducts][1]) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki buku telepon.");

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "Gunakan: /number [id]");

	new to_player = strval(params);

	if(!PlayerInfo[to_player][pLogin]) return SCM(playerid, COLOR_GREY, "Pemain tidak mengautentikasi.");

	if(!PlayerInfo[to_player][pNumber]) return SCM(playerid, COLOR_GREY, "Pemain ini tidak memiliki nomor telepon.");

	return SCMF(playerid, COLOR_YELLOW, "Nomor telepon %s: t. %i", GetPlayerNameEx(to_player), PlayerInfo[to_player][pNumber]);
}

CMD:placeboombox(playerid, params[])
{
	if (IsPlayerInGreenZone(playerid)) return SendClientMessage(playerid, COLOR_RED, "TIDAK BOLEH DI GZ!");
    new string[128], Float:BBCoord[4];
    GetPlayerPos(playerid, BBCoord[0], BBCoord[1], BBCoord[2]);
    GetPlayerFacingAngle(playerid, BBCoord[3]);
    SetPVarFloat(playerid, "BBX", BBCoord[0]);
    SetPVarFloat(playerid, "BBY", BBCoord[1]);
    SetPVarFloat(playerid, "BBZ", BBCoord[2]);
    GetPlayerName(playerid,PlayerInfo[playerid][pName],MAX_PLAYER_NAME);
    BBCoord[0] += (2 * floatsin(-BBCoord[3], degrees));
   	BBCoord[1] += (2 * floatcos(-BBCoord[3], degrees));
   	BBCoord[2] -= 1.0;
	//if(Boombox[playerid] == 0) return SCM(playerid, COLOR_WHITE, "You don't have a Boombox - Ask a Admin for one"); // Part of Variable
	if(GetPVarInt(playerid, "PlacedBB")) return SCM(playerid, -1, "Anda telah menempatkan Boombox - gunakan / pickupboombox");
	foreach(Player, i)
	{
 		if(GetPVarType(i, "PlacedBB"))
   		{
  			if(IsPlayerInRangeOfPoint(playerid, 30.0, GetPVarFloat(i, "BBX"), GetPVarFloat(i, "BBY"), GetPVarFloat(i, "BBZ")))
			{
   				SendClientMessage(playerid, COLOR_WHITE, "Anda tidak dapat meletakkan boombox Anda di Radius ini karena boombox sudah ditempatkan dalam radius ini");
			    return 1;
			}
		}
	}
	// new string2[128];
	format(format_string, 128, "%s menaruh boombox di lantai", GetPlayerNameEx(playerid));
	SetPVarInt(playerid, "PlacedBB", CreateDynamicObject(2226, BBCoord[0], BBCoord[1], BBCoord[2], 0.0, 0.0, 0.0, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)));
	format(string, 244, "Pemilik boombox: %s\nGunakan /setboombox untuk set boombox anda\n/pickupboombox untuk mengambil boombox Anda", GetPlayerNameEx(playerid));
	SetPVarInt(playerid, "BBLabel", _:CreateDynamic3DTextLabel(string, -1, BBCoord[0], BBCoord[1], BBCoord[2]+0.6, 5, .worldid = GetPlayerVirtualWorld(playerid), .interiorid = GetPlayerInterior(playerid)));
	SetPVarInt(playerid, "BBArea", CreateDynamicSphere(BBCoord[0], BBCoord[1], BBCoord[2], 30.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid)));
	SetPVarInt(playerid, "BBInt", GetPlayerInterior(playerid));
	SetPVarInt(playerid, "BBVW", GetPlayerVirtualWorld(playerid));
	ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
    ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.0,0,0,0,0,0);
	return 1;
}

CMD:setboombox(playerid, params[])
{
	if(GetPVarType(playerid, "PlacedBB"))
	{
		if(IsPlayerInRangeOfPoint(playerid, 3.0, GetPVarFloat(playerid, "BBX"), GetPVarFloat(playerid, "BBY"), GetPVarFloat(playerid, "BBZ")))
		{
			ShowPlayerDialog(playerid,DIALOG_BOOMBOX,DIALOG_STYLE_LIST,"Radio List","Jazz\nPop\nRap\nR&B and Urban\nRock\n\nMasukan URL\nMatikan Boombox","Pilih", "Batal");
		}
		else
		{
   			return SendClientMessage(playerid, -1, "Anda tidak dekat di Boombox Anda!");
		}
    }
    else
    {
        SendClientMessage(playerid, -1, " Anda tidak memiliki boombox yang dipasang!");
	}
	return 1;
}

CMD:pickupboombox(playerid, params [])
{
	if(!GetPVarInt(playerid, "PlacedBB"))
    {
        SendClientMessage(playerid, -1, "Anda belum menaruh Boombox!");
    }
	if(IsPlayerInRangeOfPoint(playerid, 3.0, GetPVarFloat(playerid, "BBX"), GetPVarFloat(playerid, "BBY"), GetPVarFloat(playerid, "BBZ")))
    {
        PickUpBoombox(playerid);
        SendClientMessage(playerid, -1, "Boombox berhasil diangkat.");
    }
    return 1;
}

