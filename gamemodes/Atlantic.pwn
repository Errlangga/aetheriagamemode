        SendClientMessage(playerid, COLOR_PURPLE, "Anda Sedang Membuka Twitter ");
        format(format_string,70, "%s Membuka Twitter Di Handphone",Name(playerid));
	    SetPlayerChatBubble(playerid, format_string, 0xBFF600FF, 20.0, 7000);
		SimpanHp(playerid);
	}
	//PHONE SYSTEM
	if(playertextid == TRANSFER[playerid])
	{
		//ShowPlayerDialog(playerid, DIALOG_BANKREKENING, DIALOG_STYLE_INPUT, "HopeIndo - Transfer", "Mohon masukan jumlah uang yang ingin di transfer:", "Transfer", "Batal");
	}
